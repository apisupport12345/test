<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="true"%>
<%@ page import="com.jdbc.IPOMonitorService" %>
<%@ page import="com.jdbc.IPOMonitorService.QueryResult" %>
<%@ page import="java.util.*" %>
<%
    String ajax = request.getParameter("ajax");
    if ("fetch".equals(ajax)) {
        Map<String, QueryResult> results = IPOMonitorService.runAll();
        StringBuilder sb = new StringBuilder("{");
        int i = 0;
        for (Map.Entry<String, QueryResult> e : results.entrySet()) {
            if (i++ > 0) sb.append(",");
            sb.append("\"").append(IPOMonitorService.esc(e.getKey())).append("\":");
            sb.append(IPOMonitorService.toJson(e.getValue()));
        }
        sb.append("}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }
%>
<!DOCTYPE html>
<html>
<head>
    <title>IPO Monitoring Dashboard</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root {
            --bg-0: #06090f;
            --bg-1: #0c1119;
            --bg-2: #121a26;
            --bg-3: #1a2330;
            --border: #1c2735;
            --border-2: #293849;
            --text-0: #ffffff;
            --text-1: #dfe6f0;
            --text-2: #9aa5b5;
            --text-3: #62708a;
            --accent: #2e7fff;
            --accent-2: #60a5fa;
            --green: #00d68f;
            --green-bg: rgba(0,214,143,0.10);
            --amber: #ffb020;
            --amber-bg: rgba(255,176,32,0.10);
            --red: #ff4d4f;
            --red-bg: rgba(255,77,79,0.10);
            --purple: #a855f7;
            --cyan: #22d3ee;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100vh;
            overflow: hidden;
            font-family: 'Inter', 'Segoe UI', -apple-system, Roboto, sans-serif;
            background: var(--bg-0);
            color: var(--text-1);
            font-size: 13px;
            -webkit-font-smoothing: antialiased;
        }

        .app {
            display: grid;
            grid-template-rows: 60px 1fr;
            height: 100vh;
        }

        /* ================= HEADER ================= */
        .header {
            background: linear-gradient(90deg, #080d15 0%, #0f1826 100%);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 24px;
            gap: 18px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.7);
            z-index: 100;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 18px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.3px;
        }
        .logo-mark {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, #2e7fff, #1a5ecc);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: 17px;
            box-shadow: 0 4px 16px rgba(46,127,255,0.5);
        }
        .logo-sub {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--text-3);
            padding: 3px 9px;
            background: rgba(255,255,255,0.05);
            border-radius: 7px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .header-spacer { flex: 1; }

        .hdr-stats {
            display: flex;
            gap: 8px;
            font-size: 11.5px;
        }
        .hdr-stat {
            padding: 7px 13px;
            background: var(--bg-2);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-2);
        }
        .hdr-stat b { color: var(--text-0); font-weight: 800; }
        .hdr-stat .dot { width: 6px; height: 6px; border-radius: 50%; }
        .hdr-stat .dot.g { background: var(--green); box-shadow: 0 0 8px var(--green); }
        .hdr-stat .dot.a { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
        .hdr-stat .dot.r { background: var(--red); box-shadow: 0 0 8px var(--red); }

        .live-badge {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 7px 13px;
            background: rgba(0,214,143,0.08);
            border: 1px solid rgba(0,214,143,0.3);
            border-radius: 8px;
            font-size: 11.5px;
            font-weight: 800;
            color: var(--green);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .live-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 10px var(--green);
            animation: pulse 1.4s infinite;
        }
        @keyframes pulse {
            0%,100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }

        .countdown {
            font-size: 12px;
            color: var(--text-2);
            font-weight: 700;
            padding: 7px 14px;
            background: var(--bg-1);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-variant-numeric: tabular-nums;
            min-width: 135px;
            text-align: center;
        }
        .countdown b { color: var(--accent); font-weight: 800; }

        .btn-icon {
            width: 36px; height: 36px;
            background: var(--bg-2);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-1);
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            transition: 0.2s;
        }
        .btn-icon:hover { background: var(--bg-3); border-color: var(--accent); color: var(--accent); }
        .btn-icon:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-icon.spinning { animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ================= MAIN ================= */
        .main {
            padding: 14px 18px;
            display: grid;
            grid-template-rows: 92px 1fr;
            gap: 12px;
            overflow: hidden;
            min-height: 0;
        }

        /* ================= KPI ROW ================= */
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
        }
        .kpi {
            background: linear-gradient(135deg, var(--bg-1) 0%, var(--bg-2) 100%);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 16px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            transition: 0.2s;
        }
        .kpi:hover { transform: translateY(-2px); border-color: var(--border-2); }
        .kpi::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 3px;
            background: var(--accent);
        }
        .kpi.ok::before   { background: var(--green); }
        .kpi.warn::before { background: var(--amber); }
        .kpi.err::before  { background: var(--red); }

        .kpi-label {
            font-size: 10px;
            font-weight: 800;
            color: var(--text-3);
            text-transform: uppercase;
            letter-spacing: 1.1px;
            margin-bottom: 3px;
        }
        .kpi-value {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-0);
            line-height: 1;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.5px;
        }
        .kpi-value.ok   { color: var(--green); }
        .kpi-value.warn { color: var(--amber); }
        .kpi-value.err  { color: var(--red); }
        .kpi-sub {
            font-size: 10px;
            color: var(--text-3);
            font-weight: 600;
            margin-top: 2px;
        }

        /* ================= PANELS GRID ================= */
        .panels {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            overflow: hidden;
            min-height: 0;
        }
        .panel {
            background: var(--bg-1);
            border: 1px solid var(--border);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 0;
        }
        .panel-head {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(90deg, var(--bg-2), var(--bg-1));
            flex-shrink: 0;
        }
        .ph-icon {
            width: 26px; height: 26px;
            border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px;
            flex-shrink: 0;
        }
        .ph-icon.green  { background: rgba(0,214,143,0.15); color: var(--green); }
        .ph-icon.blue   { background: rgba(46,127,255,0.15); color: var(--accent); }
        .ph-icon.purple { background: rgba(168,85,247,0.15); color: var(--purple); }

        .ph-text { flex: 1; min-width: 0; }
        .ph-title {
            font-size: 12.5px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: -0.1px;
            white-space: nowrap;
        }
        .ph-sub {
            font-size: 10px;
            color: var(--text-3);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 1px;
        }
        .ph-badge {
            font-size: 10px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            background: var(--bg-3);
            color: var(--text-3);
            letter-spacing: 0.4px;
            white-space: nowrap;
        }

        /* ================= CARD GRID (IP cards) ================= */
        .card-grid {
            flex: 1;
            overflow: auto;
            padding: 10px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 8px;
            align-content: start;
            min-height: 0;
        }
        .card-grid::-webkit-scrollbar { width: 6px; }
        .card-grid::-webkit-scrollbar-track { background: transparent; }
        .card-grid::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 3px; }
        .card-grid::-webkit-scrollbar-thumb:hover { background: #3a4a5e; }

        /* IP CARD */
        .ip-card {
            background: var(--bg-2);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            transition: 0.15s;
            position: relative;
            overflow: hidden;
        }
        .ip-card:hover {
            border-color: var(--border-2);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.3);
        }
        .ip-card.healthy { border-left: 3px solid var(--green); }
        .ip-card.warning { border-left: 3px solid var(--amber); }
        .ip-card.critical { border-left: 3px solid var(--red); background: linear-gradient(135deg, var(--bg-2), rgba(255,77,79,0.05)); }

        .ip-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .ip-name {
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 12.5px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: 0.2px;
        }
        .ip-status {
            font-size: 9.5px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 5px;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }
        .ip-status.healthy { background: var(--green-bg); color: var(--green); }
        .ip-status.warning { background: var(--amber-bg); color: var(--amber); }
        .ip-status.critical { background: var(--red-bg); color: var(--red); }

        /* hits and success row */
        .ip-row-main {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .ip-metric {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .ip-metric-label {
            font-size: 9.5px;
            color: var(--text-3);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }
        .ip-metric-value {
            font-size: 15px;
            font-weight: 800;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
            line-height: 1;
        }
        .ip-metric-value.green { color: var(--green); }
        .ip-metric-value.amber { color: var(--amber); }
        .ip-metric-value.red   { color: var(--red); }

        /* error codes row */
        .ip-codes {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            padding-top: 6px;
            border-top: 1px dashed var(--border-2);
            min-height: 26px;
        }
        .ip-code {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            letter-spacing: 0.2px;
            white-space: nowrap;
        }
        .ip-code.td {
            background: rgba(255,176,32,0.15);
            color: var(--amber);
            border: 1px solid rgba(255,176,32,0.3);
        }
        .ip-code.bd {
            background: rgba(255,77,79,0.15);
            color: var(--red);
            border: 1px solid rgba(255,77,79,0.3);
        }
        .ip-code.ok {
            background: rgba(0,214,143,0.10);
            color: var(--green);
            border: 1px solid rgba(0,214,143,0.25);
        }

        /* ================= STATES ================= */
        .empty-state, .loader-state {
            grid-column: 1 / -1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            min-height: 200px;
            padding: 30px 20px;
            text-align: center;
            color: var(--text-3);
        }
        .empty-icon { font-size: 34px; opacity: 0.35; margin-bottom: 10px; }
        .empty-text { font-size: 12px; font-weight: 600; }

        .loader-spinner {
            width: 36px; height: 36px;
            border: 3px solid var(--bg-3);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
        }
        .loader-text {
            margin-top: 12px;
            font-size: 11.5px;
            color: var(--text-3);
            font-weight: 600;
            letter-spacing: 0.4px;
        }

        /* ================= TOAST ================= */
        .toast {
            position: fixed;
            bottom: 20px; right: 20px;
            padding: 11px 16px;
            background: var(--bg-2);
            border-left: 3px solid var(--green);
            border-radius: 8px;
            color: var(--text-0);
            font-size: 12.5px;
            font-weight: 700;
            box-shadow: 0 8px 28px rgba(0,0,0,0.8);
            z-index: 9999;
            animation: slideIn 0.25s ease;
        }
        .toast.err { border-left-color: var(--red); }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(24px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* ================= RESPONSIVE ================= */
        @media (max-width: 1500px) {
            .kpi-row { grid-template-columns: repeat(3, 1fr); }
        }
        @media (max-width: 1200px) {
            .panels { grid-template-columns: 1fr; }
            .main { grid-template-rows: auto 1fr; }
        }
    </style>
</head>
<body>

