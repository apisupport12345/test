<script>
    // ============================================================
    // VOICE ALERT SYSTEM
    // ============================================================
    let speechSynthesis = window.speechSynthesis;
    let isVoiceEnabled = true;
    let isMuted = false;
    let isPlaying = false;
    let voices = [];
    let userInteracted = false;
    let voiceInitialized = false;
    let voicePlayCount = 0;
    const MAX_VOICE_PLAYS = 3;

    const criticalServersByBroker = { <%= jsBrokerMap.toString() %> };
    const hasUserInteracted = localStorage.getItem('voiceEnabled') === 'true' || localStorage.getItem('chromeVoiceEnabled') === 'true';

    console.log('Critical servers by broker:', criticalServersByBroker);

    function cleanForPronunciation(text) {
        if (!text) return '';
        let cleaned = text.replace(/EXP/gi, 'E X P');
        cleaned = cleaned.replace(/NP_SPL/gi, 'N P S P L');
        cleaned = cleaned.replace(/_/g, ' ');
        cleaned = cleaned.replace(/\./g, ' dot ');
        return cleaned;
    }

    function buildSequentialMessage() {
        const brokerKeys = Object.keys(criticalServersByBroker);
        if (brokerKeys.length === 0) return '';
        let fullMessage = 'Alert! ';
        let messageParts = [];
        for (let i = 0; i < brokerKeys.length; i++) {
            let broker = brokerKeys[i];
            let servers = criticalServersByBroker[broker];
            let cleanBroker = cleanForPronunciation(broker);
            if (servers.length === 1) {
                messageParts.push(cleanBroker + ' server ' + cleanForPronunciation(servers[0]));
            } else {
                let serverList = servers.map(s => cleanForPronunciation(s)).join(', ');
                messageParts.push(cleanBroker + ' servers ' + serverList);
            }
        }
        if (messageParts.length === 1) return fullMessage + messageParts[0];
        else return fullMessage + messageParts.join(', then ');
    }

    function getTotalCriticalCount() {
        let count = 0;
        for (let broker in criticalServersByBroker) {
            count += criticalServersByBroker[broker].length;
        }
        return count;
    }

    function loadVoices() {
        try { voices = speechSynthesis.getVoices(); } catch(e) {}
    }
    if (speechSynthesis) {
        loadVoices();
        if (speechSynthesis.onvoiceschanged !== undefined) {
            speechSynthesis.onvoiceschanged = loadVoices;
        }
    }

    function getBestVoice() {
        if (voices.length === 0) return null;
        const preferred = ['Google UK English Female','Google US English','Microsoft David','Microsoft Zira','Samantha','Alex','Google UK English Male','en-US','en-GB','English'];
        for (let p of preferred) {
            let voice = voices.find(v => v.name.includes(p) || v.lang.includes(p));
            if (voice) return voice;
        }
        return voices.find(v => v.lang.startsWith('en'));
    }

    function updateVoiceUI() {
        const audioStatus = document.getElementById('audioStatus');
        const testBtn = document.getElementById('testVoiceBtn');
        const muteBtn = document.getElementById('muteVoiceBtn');
        const criticalCount = getTotalCriticalCount();
        if (isVoiceEnabled) {
            testBtn.style.display = 'inline-flex';
            muteBtn.style.display = 'inline-flex';
            if (isMuted) {
                audioStatus.innerHTML = 'Muted <i class="fas fa-volume-mute"></i>';
                audioStatus.style.color = 'var(--gray-500)';
                muteBtn.innerHTML = '<i class="fas fa-volume-up"></i> Unmute';
                muteBtn.style.background = 'var(--success)';
            } else {
                if (criticalCount > 0) {
                    audioStatus.innerHTML = 'Active - ' + criticalCount + ' critical server(s)';
                    audioStatus.style.color = 'var(--danger)';
                } else {
                    audioStatus.innerHTML = 'Active - No critical servers';
                    audioStatus.style.color = 'var(--success)';
                }
                muteBtn.innerHTML = '<i class="fas fa-volume-mute"></i> Mute';
                muteBtn.style.background = 'var(--gray-600)';
            }
        }
    }

    function speakMessage(message, callback) {
        if (!isVoiceEnabled || isMuted || !speechSynthesis || !message) {
            if (callback) callback();
            return false;
        }
        try { speechSynthesis.cancel(); } catch(e) {}
        try {
            const utterance = new SpeechSynthesisUtterance(message);
            utterance.rate = 0.85;
            utterance.pitch = 1.1;
            utterance.volume = 1;
            utterance.lang = 'en-US';
            const bestVoice = getBestVoice();
            if (bestVoice) utterance.voice = bestVoice;
            utterance.onstart = function() { console.log('Speech started'); };
            utterance.onerror = function() { if(callback) callback(); };
            utterance.onend = function() { if(callback) callback(); };
            setTimeout(() => {
                try { speechSynthesis.speak(utterance); } catch(e) { if(callback) callback(); }
            }, 50);
            return true;
        } catch(e) { if(callback) callback(); return false; }
    }

    function playVoiceAlert() {
        if (voicePlayCount >= MAX_VOICE_PLAYS) { console.log('Max voice plays reached.'); return; }
        const criticalCount = getTotalCriticalCount();
        if (criticalCount === 0) return;
        if (!isVoiceEnabled || isMuted) return;
        const message = buildSequentialMessage();
        console.log('Playing voice alert (play #' + (voicePlayCount + 1) + '):', message);
        isPlaying = true;
        voicePlayCount++;
        speakMessage(message, function() { isPlaying = false; updateVoiceUI(); });
        updateVoiceUI();
    }

    function toggleMute() {
        isMuted = !isMuted;
        saveVoicePreferences();
        if (isMuted) try { speechSynthesis.cancel(); } catch(e) {}
        isPlaying = false;
        updateVoiceUI();
    }

    function loadVoicePreferences() {
        try {
            const saved = localStorage.getItem('voiceEnabled');
            if (saved !== null) isVoiceEnabled = saved === 'true';
            const muted = localStorage.getItem('voiceMuted');
            if (muted !== null) isMuted = muted === 'true';
        } catch(e) {}
    }
    function saveVoicePreferences() {
        try {
            localStorage.setItem('voiceEnabled', isVoiceEnabled);
            localStorage.setItem('voiceMuted', isMuted);
        } catch(e) {}
    }
    function testVoice() {
        if (!userInteracted) { showOverlayAndInitialize(); return; }
        if (!isVoiceEnabled) { alert('Voice system is active. Click Unmute if muted.'); return; }
        if (isMuted) { alert('Please unmute first'); return; }
        speakMessage('Voice alert system is working correctly. This is a test message.', function() { alert('Voice test completed!'); });
    }
    function showOverlayAndInitialize() { document.getElementById('chromeVoiceOverlay').style.display = 'flex'; }
    function hideOverlayAndInitialize() {
        document.getElementById('chromeVoiceOverlay').style.display = 'none';
        initializeVoiceSystem();
    }
    function initializeVoiceSystem() {
        if (voiceInitialized) return;
        voiceInitialized = true;
        userInteracted = true;
        localStorage.setItem('voiceEnabled', 'true');
        localStorage.setItem('chromeVoiceEnabled', 'true');
        console.log('Voice system initialized');
        loadVoicePreferences();
        updateVoiceUI();
        try {
            const silent = new SpeechSynthesisUtterance('');
            silent.volume = 0;
            speechSynthesis.speak(silent);
        } catch(e) {}
        setTimeout(function() {
            if (getTotalCriticalCount() > 0 && !isMuted && voicePlayCount < MAX_VOICE_PLAYS) {
                playVoiceAlert();
            }
        }, 1500);
    }
    function playRefreshVoiceAnnouncement() {
        const criticalCount = getTotalCriticalCount();
        if (criticalCount > 0 && isVoiceEnabled && !isMuted && userInteracted && voicePlayCount < MAX_VOICE_PLAYS) {
            setTimeout(function() { playVoiceAlert(); }, 1500);
        }
    }

    function countdown(elementName, minutes, seconds) {
        var element, endTime, time;
        function twoDigits(n) { return (n <= 9 ? "0" + n : n); }
        function updateTimer() {
            var msLeft = endTime - (+new Date);
            if (msLeft < 1000) {
                element.innerHTML = "Refreshing...";
                setTimeout(function() { location.reload(true); }, 1000);
            } else {
                time = new Date(msLeft);
                var hours = time.getUTCHours();
                var mins = time.getUTCMinutes();
                element.innerHTML = (hours ? hours + ':' + twoDigits(mins) : mins) + ':' + twoDigits(time.getUTCSeconds());
                setTimeout(updateTimer, time.getUTCMilliseconds() + 500);
            }
        }
        element = document.getElementById(elementName);
        endTime = (+new Date) + 1000 * (60 * minutes + seconds) + 500;
        updateTimer();
    }

    function toggleTimeFilter() {
        var content = document.getElementById('timeFilterContent');
        var toggle = document.querySelector('.time-filter-toggle');
        content.classList.toggle('expanded');
        toggle.classList.toggle('expanded');
    }
    function resetTimeFilter() {
        document.getElementById('fromDateTime').value = '';
        document.getElementById('toDateTime').value = '';
        document.getElementById('timeFilterForm').submit();
    }
    function setQuickFilter(minutes) {
        var now = new Date();
        var start = new Date(now.getTime() - minutes * 60000);
        document.getElementById('fromDateTime').value = formatDateForInput(start);
        document.getElementById('toDateTime').value = formatDateForInput(now);
        document.querySelectorAll('.quick-filter-btn').forEach(b => b.classList.remove('active'));
        event.target.classList.add('active');
        document.getElementById('timeFilterForm').submit();
    }
    function formatDateForInput(date) {
        var y = date.getFullYear();
        var m = String(date.getMonth()+1).padStart(2,'0');
        var d = String(date.getDate()).padStart(2,'0');
        var h = String(date.getHours()).padStart(2,'0');
        var min = String(date.getMinutes()).padStart(2,'0');
        return y + '-' + m + '-' + d + 'T' + h + ':' + min;
    }
    function toggleBlinking() {
        var body = document.body;
        var btn = document.getElementById('blinkingToggle');
        if (body.classList.contains('no-blink')) {
            body.classList.remove('no-blink');
            btn.innerHTML = '<i class="fas fa-eye"></i> <span id="blinkingButtonText">Disable Blinking</span>';
            localStorage.setItem('blinkingEnabled', 'true');
        } else {
            body.classList.add('no-blink');
            btn.innerHTML = '<i class="fas fa-eye-slash"></i> <span id="blinkingButtonText">Enable Blinking</span>';
            localStorage.setItem('blinkingEnabled', 'false');
        }
    }
    function showIsolatedOnly() {
        var cards = document.querySelectorAll('.broker-card');
        var isolatedCount = 0;
        cards.forEach(function(card) {
            if (card.classList.contains('isolated')) { card.style.display = 'flex'; isolatedCount++; }
            else { card.style.display = 'none'; }
        });
        document.getElementById('showAllBtn').style.display = 'inline-flex';
        var container = document.getElementById('brokerCardsContainer');
        var existing = document.getElementById('noIsolatedMessage');
        if (isolatedCount === 0 && !existing) {
            var div = document.createElement('div');
            div.id = 'noIsolatedMessage';
            div.style.gridColumn = '1 / -1';
            div.style.textAlign = 'center';
            div.style.padding = '3rem';
            div.style.background = 'white';
            div.style.borderRadius = '0.75rem';
            div.style.boxShadow = 'var(--card-shadow)';
            div.innerHTML = '<i class="fas fa-shield-alt" style="font-size: 3rem; color: var(--gray-300); margin-bottom: 1rem;"></i><h3 style="color: var(--gray-600); margin-bottom: 0.5rem;">No Isolated Brokers Found</h3><button class="control-btn primary" onclick="showAllBrokers()" style="margin-top: 1rem;"><i class="fas fa-globe"></i> Show All Servers</button>';
            container.appendChild(div);
        } else if (existing && isolatedCount > 0) { existing.remove(); }
    }
    function showAllBrokers() {
        document.querySelectorAll('.broker-card').forEach(c => c.style.display = 'flex');
        document.getElementById('showAllBtn').style.display = 'none';
        var msg = document.getElementById('noIsolatedMessage');
        if (msg) msg.remove();
    }
    function openNewPage() {
        var a = '<%= request.getContextPath() + "/jsp/A_SYS_SERVERWISE_COUNT_LDAP.jsp" %>';
        window.open(a, '_blank');
    }
    function initializeTooltips() {
        document.querySelectorAll('.server-item').forEach(function(item) {
            var full = item.getAttribute('data-full-ip');
            if (full) item.setAttribute('title', 'IP Address: ' + full);
        });
    }
    function manualRefresh() { location.reload(true); }
    function handleResize() {
        var width = window.innerWidth;
        var container = document.getElementById('brokerCardsContainer');
        if (width <= 768) container.style.gridTemplateColumns = '1fr';
        else if (width <= 1200) container.style.gridTemplateColumns = 'repeat(auto-fill, minmax(400px, 1fr))';
        else container.style.gridTemplateColumns = 'repeat(auto-fill, minmax(450px, 1fr))';
    }

    document.addEventListener('DOMContentLoaded', function() {
        console.log('DOM loaded, initializing...');
        var overlay = document.getElementById('chromeVoiceOverlay');
        var enableBtn = document.getElementById('enableVoiceNowBtn');
        if (overlay) {
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay || e.target === enableBtn) {
                    hideOverlayAndInitialize();
                }
            });
        }
        if (enableBtn) {
            enableBtn.addEventListener('click', function() {
                hideOverlayAndInitialize();
            });
        }
        var blinkingPref = localStorage.getItem('blinkingEnabled');
        if (blinkingPref === 'false') {
            document.body.classList.add('no-blink');
            document.getElementById('blinkingToggle').innerHTML = '<i class="fas fa-eye-slash"></i> <span id="blinkingButtonText">Enable Blinking</span>';
        } else {
            document.body.classList.remove('no-blink');
            document.getElementById('blinkingToggle').innerHTML = '<i class="fas fa-eye"></i> <span id="blinkingButtonText">Disable Blinking</span>';
        }
        countdown('ten-countdown', 10, 0);
        var urlParams = new URLSearchParams(window.location.search);
        var fromDateTime = urlParams.get('fromDateTime');
        var toDateTime = urlParams.get('toDateTime');
        if (fromDateTime && toDateTime) {
            var fromDate = new Date(fromDateTime);
            var toDate = new Date(toDateTime);
            var diffMinutes = Math.round((toDate - fromDate) / (1000 * 60));
            document.querySelectorAll('.quick-filter-btn').forEach(function(btn) {
                btn.classList.remove('active');
                var minutes = parseInt(btn.getAttribute('onclick')?.match(/\d+/) || '60');
                if (Math.abs(diffMinutes - minutes) < 5) btn.classList.add('active');
            });
        }
        initializeTooltips();
        if (hasUserInteracted) {
            userInteracted = true;
            voiceInitialized = true;
            loadVoicePreferences();
            updateVoiceUI();
            setTimeout(playRefreshVoiceAnnouncement, 1500);
        } else {
            setTimeout(function() { if (!userInteracted) showOverlayAndInitialize(); }, 500);
        }
        window.addEventListener('resize', handleResize);
        handleResize();
    });

    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.key === 'r') { e.preventDefault(); manualRefresh(); }
        if (e.ctrlKey && e.key === 'b') { e.preventDefault(); toggleBlinking(); }
        if (e.ctrlKey && e.key === 'i') { e.preventDefault(); showIsolatedOnly(); }
        if (e.ctrlKey && e.key === 'a') { e.preventDefault(); showAllBrokers(); }
        if (e.ctrlKey && e.key === 'v') { e.preventDefault(); testVoice(); }
        if (e.ctrlKey && e.key === 'm') { e.preventDefault(); toggleMute(); }
    });

    window.addEventListener('beforeunload', function() {
        saveVoicePreferences();
        try { speechSynthesis.cancel(); } catch(e) {}
    });
</script>

</body>
</html>
