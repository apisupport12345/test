package com.cron;

import java.math.BigDecimal;
import java.sql.*;
import java.sql.Date;
import java.text.SimpleDateFormat;
import java.util.*;
import java.util.concurrent.*;

import com.jdbc.DBUtilityAuto;

public class HourlyQueryCronEISSBIDATA2 {

    private static final int QUERY_TIMEOUT_SECONDS = 1800; // increased to 30 minutes
    private static final int FETCH_SIZE = 1000;
    private static final int THREAD_POOL_SIZE = 4;
    private static final int MAX_RETRIES = 3;
    private static final long RETRY_DELAY_MS = 5000;

    private static final int QUERY_START = 0;
    private static final int QUERY_END   = 6;

    private static String flagStatus = "DR";

    static {
        try (Connection conn = DBUtilityAuto.getReportDBConnection();
             Statement smt = conn.createStatement();
             ResultSet rs = smt.executeQuery("SELECT FLAG FROM connection_master")) {
            if (rs.next()) {
                flagStatus = rs.getString("FLAG");
                if (flagStatus == null) flagStatus = "DR";
            }
            System.out.println("[" + new Date(0) + "] Flag status initialized: " + flagStatus);
        } catch (Exception e) {
            System.out.println("[" + new Date(0) + "] Flag not found! Using default DR. Error: " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        java.util.Date startTime, endTime;
        if (args.length >= 2) {
            try {
                SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy HH:mm:ss");
                startTime = sdf.parse(args[0]);
                endTime = sdf.parse(args[1]);
            } catch (Exception e) {
                System.err.println("Invalid date format. Use dd-MMM-yyyy HH:mm:ss");
                return;
            }
        } else {
            Calendar cal = Calendar.getInstance();
            cal.set(Calendar.MINUTE, 0);
            cal.set(Calendar.SECOND, 0);
            cal.set(Calendar.MILLISECOND, 0);
            endTime = cal.getTime();
            cal.add(Calendar.HOUR_OF_DAY, -1);
            startTime = cal.getTime();
        }

        System.out.println("[" + new Date(0) + "] Running cron (Part 2) for window: " + startTime + " to " + endTime);
        final String fromDate = formatDate(startTime);
        final String toDate = formatDate(endTime);
        final String partition = getPartition(startTime);

        ExecutorService executor = Executors.newFixedThreadPool(THREAD_POOL_SIZE);
        List<Future<?>> futures = new ArrayList<>();

        long batchStart = System.currentTimeMillis();

        for (int queryIndex = QUERY_START; queryIndex <= QUERY_END; queryIndex++) {
            final int qIdx = queryIndex;
            Future<?> future = executor.submit(() -> {
                String threadName = Thread.currentThread().getName();
                System.out.println("[" + threadName + "] Starting query " + qIdx);
                int attempt = 1;
                boolean success = false;
                while (!success && attempt <= MAX_RETRIES) {
                    long queryStart = System.currentTimeMillis();
                    try {
                        executeAndInsert(qIdx, fromDate, toDate, partition, startTime, endTime);
                        success = true;
                        long queryDuration = System.currentTimeMillis() - queryStart;
                        System.out.println("[" + threadName + "] Query " + qIdx + " completed successfully in " + queryDuration + " ms (attempt " + attempt + ")");
                    } catch (Exception e) {
                        long queryDuration = System.currentTimeMillis() - queryStart;
                        System.err.println("[" + threadName + "] Attempt " + attempt + " failed for query " + qIdx +
                                           " after " + queryDuration + " ms: " + e.getMessage());
                        if (attempt == MAX_RETRIES) {
                            e.printStackTrace();
                        } else {
                            try {
                                long delay = RETRY_DELAY_MS * attempt;
                                System.out.println("[" + threadName + "] Retrying query " + qIdx + " after " + delay + " ms");
                                Thread.sleep(delay);
                            } catch (InterruptedException ie) {
                                Thread.currentThread().interrupt();
                                break;
                            }
                        }
                        attempt++;
                    }
                }
                if (!success) {
                    System.err.println("[" + threadName + "] Query " + qIdx + " failed after " + MAX_RETRIES + " attempts.");
                }
            });
            futures.add(future);
        }

        executor.shutdown();
        try {
            if (!executor.awaitTermination(60, TimeUnit.MINUTES)) {
                executor.shutdownNow();
                System.err.println("[" + new Date(batchStart) + "] Some queries did not finish within timeout");
            }
        } catch (InterruptedException e) {
            executor.shutdownNow();
            Thread.currentThread().interrupt();
        }

        long totalTime = System.currentTimeMillis() - batchStart;
        System.out.println("[" + new Date(totalTime) + "] All Part 2 queries completed in " + totalTime + " ms");
    }

    private static String formatDate(java.util.Date date) {
        SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy HH:mm:ss");
        return sdf.format(date).toUpperCase();
    }

    private static String getPartition(java.util.Date fromDate) {
        Calendar cal = Calendar.getInstance();
        cal.setTime(fromDate);
        String[] months = {"JAN","FEB","MAR","APR","MAY","JUN",
                           "JUL","AUG","SEP","OCT","NOV","DEC"};
        String month = months[cal.get(Calendar.MONTH)];
        String year = String.valueOf(cal.get(Calendar.YEAR)).substring(2);
        return month + "_" + year;
    }

    private static void executeAndInsert(int queryIndex, String fromDate, String toDate,
                                         String partition, java.util.Date startTime, java.util.Date endTime) throws Exception {
        String threadName = Thread.currentThread().getName();
        long methodStart = System.currentTimeMillis();

        Connection readConn = null;
        Connection writeConn = null;
        PreparedStatement ps = null;
        ResultSet rs = null;
        PreparedStatement insertStmt = null;
        PreparedStatement deleteStmt = null;

        try {
            long connStart = System.currentTimeMillis();
            readConn = DBUtilityAuto.getIIBDBConnection();
            if (readConn == null || readConn.isClosed()) {
                throw new SQLException("Could not get IIB connection for query " + queryIndex);
            }
            readConn.setAutoCommit(false);
            readConn.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);
            long connDuration = System.currentTimeMillis() - connStart;
            System.out.println("[" + threadName + "] Query " + queryIndex + " read connection acquired in " + connDuration + " ms");

            connStart = System.currentTimeMillis();
            writeConn = DBUtilityAuto.getReportDBConnection();
            if (writeConn == null || writeConn.isClosed()) {
                throw new SQLException("Could not get report connection for query " + queryIndex);
            }
            writeConn.setAutoCommit(false);
            connDuration = System.currentTimeMillis() - connStart;
            System.out.println("[" + threadName + "] Query " + queryIndex + " report connection acquired in " + connDuration + " ms");

            String query = getQuery(queryIndex, partition);
            ps = readConn.prepareStatement(query, ResultSet.TYPE_FORWARD_ONLY, ResultSet.CONCUR_READ_ONLY);
            ps.setFetchSize(FETCH_SIZE);
            ps.setQueryTimeout(QUERY_TIMEOUT_SECONDS);
            setQueryParameters(ps, queryIndex, fromDate, toDate);

            long execStart = System.currentTimeMillis();
            rs = ps.executeQuery();
            long execDurationMs = System.currentTimeMillis() - execStart;
            double execDurationSec = execDurationMs / 1000.0;
            System.out.println("[" + threadName + "] Query " + queryIndex + " SELECT execution took " + execDurationMs + " ms (" + execDurationSec + " sec)");

            ResultSetMetaData meta = rs.getMetaData();
            int colCount = meta.getColumnCount();
            List<String> colNames = new ArrayList<>();
            for (int i = 1; i <= colCount; i++) {
                colNames.add(meta.getColumnName(i).toUpperCase());
            }

            List<Map<String, Object>> rows = new ArrayList<>();
            while (rs.next()) {
                Map<String, Object> row = new LinkedHashMap<>();
                for (int i = 1; i <= colCount; i++) {
                    row.put(colNames.get(i-1), rs.getObject(i));
                }
                rows.add(row);
            }
            System.out.println("[" + threadName + "] Query " + queryIndex + " fetched " + rows.size() + " rows");

            String tableName = getTableName(queryIndex);
            String deleteSQL = "DELETE FROM " + tableName + " WHERE START_TIME = ? AND END_TIME = ?";
            deleteStmt = writeConn.prepareStatement(deleteSQL);
            deleteStmt.setTimestamp(1, new Timestamp(startTime.getTime()));
            deleteStmt.setTimestamp(2, new Timestamp(endTime.getTime()));
            int deleted = deleteStmt.executeUpdate();
            System.out.println("[" + threadName + "] Deleted " + deleted + " existing rows from " + tableName + " for this time window");

            StringBuilder insertSQL = new StringBuilder("INSERT INTO " + tableName + " (");
            insertSQL.append("START_TIME, END_TIME, QUERY_DURATION_SEC");
            for (String col : colNames) {
                insertSQL.append(", ").append(col);
            }
            insertSQL.append(") VALUES (?, ?, ?");
            for (int i = 0; i < colCount; i++) {
                insertSQL.append(", ?");
            }
            insertSQL.append(")");

            insertStmt = writeConn.prepareStatement(insertSQL.toString());

            long insertStart = System.currentTimeMillis();
            int rowCount = 0;
            int batchSize = 0;
            final int BATCH_LIMIT = 1000;

            for (Map<String, Object> row : rows) {
                int paramIndex = 1;
                insertStmt.setTimestamp(paramIndex++, new Timestamp(startTime.getTime()));
                insertStmt.setTimestamp(paramIndex++, new Timestamp(endTime.getTime()));
                insertStmt.setDouble(paramIndex++, execDurationSec);

                for (String col : colNames) {
                    Object value = row.get(col);
                    if (value == null) {
                        insertStmt.setNull(paramIndex++, Types.NULL);
                    } else if (value instanceof BigDecimal) {
                        insertStmt.setBigDecimal(paramIndex++, (BigDecimal) value);
                    } else if (value instanceof String) {
                        insertStmt.setString(paramIndex++, (String) value);
                    } else if (value instanceof Timestamp) {
                        insertStmt.setTimestamp(paramIndex++, (Timestamp) value);
                    } else if (value instanceof java.sql.Date) {
                        insertStmt.setTimestamp(paramIndex++, new Timestamp(((java.sql.Date) value).getTime()));
                    } else if (value instanceof Integer) {
                        insertStmt.setInt(paramIndex++, (Integer) value);
                    } else if (value instanceof Long) {
                        insertStmt.setLong(paramIndex++, (Long) value);
                    } else {
                        insertStmt.setObject(paramIndex++, value);
                    }
                }
                insertStmt.addBatch();
                rowCount++;
                batchSize++;
                if (batchSize >= BATCH_LIMIT) {
                    insertStmt.executeBatch();
                    insertStmt.clearBatch();
                    batchSize = 0;
                }
            }

            if (batchSize > 0) {
                insertStmt.executeBatch();
                insertStmt.clearBatch();
            }

            long insertDuration = System.currentTimeMillis() - insertStart;
            writeConn.commit();

            System.out.println("[" + threadName + "] Query " + queryIndex +
                               " inserted " + rowCount + " rows into " + tableName +
                               " (insert took " + insertDuration + " ms)");

            long totalDuration = System.currentTimeMillis() - methodStart;
            System.out.println("[" + threadName + "] Query " + queryIndex + " total processing time: " + totalDuration + " ms");

        } catch (SQLException e) {
            if (writeConn != null) {
                try { writeConn.rollback(); } catch (SQLException ex) {}
            }
            throw e;
        } catch (Exception e) {
            if (writeConn != null) {
                try { writeConn.rollback(); } catch (SQLException ex) {}
            }
            throw e;
        } finally {
            try { if (rs != null) rs.close(); } catch (SQLException e) {}
            try { if (ps != null) ps.close(); } catch (SQLException e) {}
            try { if (insertStmt != null) insertStmt.close(); } catch (SQLException e) {}
            try { if (deleteStmt != null) deleteStmt.close(); } catch (SQLException e) {}
            if (readConn != null) {
                try { readConn.setAutoCommit(true); readConn.close(); } catch (SQLException e) {}
            }
            if (writeConn != null) {
                try { writeConn.setAutoCommit(true); writeConn.close(); } catch (SQLException e) {}
            }
        }
    }

    private static String getTableName(int queryIndex) {
        switch (queryIndex) {
            case 0: return "ADHARVAULT_HOURLY";
            case 1: return "PANVALIDATION_HOURLY";
            case 2: return "CKYC_HOURLY";
            case 3: return "AMLOCK_HOURLY";
            case 4: return "SBI_CAPS_HOURLY";
            case 5: return "IVR_HOURLY";
            case 6: return "DMZ_HOURLY";
            default: throw new IllegalArgumentException("Invalid query index for Part 2: " + queryIndex);
        }
    }

    private static String getQuery(int queryIndex, String partition) {
        String part = (partition == null || partition.isEmpty()) ? "" : " PARTITION(" + partition + ")";

        switch (queryIndex) {
            case 0:
                return "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_HITS, " +
                       "SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS, " +
                       "SUM(CASE WHEN ERROR_CODE IN ('SI002', 'SI014', 'SI001', 'SI051') THEN 1 ELSE 0 END) AS FAILURE, " +
                       "ROUND(AVG(EXTRACT(SECOND FROM (response_date_time - request_date_time))), 4) AS Avg_response_end_to_end " +
                       "FROM EISAPP.api_log" + part + " " +
                       "WHERE url IN ('http://eispri.sbi.co.in:3113/aadharVault/refKeyEnq/misc', " +
                       "'http://eispri.sbi.co.in:3113/aadharVault/storeData/misc', " +
                       "'http://eispri.sbi.co.in:3113/aadharVault/fetchAadhar/misc') " +
                       "AND request_date_time BETWEEN TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS')";
            case 1:
                return "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_HITS, " +
                       "SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS, " +
                       "SUM(CASE WHEN ERROR_CODE IN ('SI002', 'SI014', 'SI001', 'SI051') THEN 1 ELSE 0 END) AS TD, " +
                       "SUM(CASE WHEN ERROR_CODE NOT IN ('SI002', 'SI014', 'SI001', 'SI051') THEN 1 ELSE 0 END) AS BD " +
                       "FROM EISAPP.api_log" + part + " " +
                       "WHERE url = 'http://eispri.sbi.co.in:3013/PANMatchingDetails/misc' " +
                       "AND request_date_time BETWEEN TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS')";
            case 2:
                return "SELECT /*+ PARALLEL(4) */ " +
                       "ROUND(SUM(CASE WHEN ERROR_CODE IN ('SI001', 'SI002', 'SI007', 'SI014', 'SI017', 'SI569', 'SI570') THEN 1 ELSE 0 END) * 100 / NULLIF(COUNT(*), 0), 2) AS EIS_TD_PERCENT, " +
                       "ROUND(SUM(CASE WHEN ERROR_CODE IN ('CK002', 'CK014') THEN 1 ELSE 0 END) * 100 / NULLIF(COUNT(*), 0), 2) AS DEST_TD_PERCENT " +
                       "FROM EISAPP.api_log" + part + " " +
                       "WHERE source_id IN ('CK', 'LP', 'YB', 'YA', 'IN', 'FA') " +
                       "AND url IN ('http://eispri.sbi.co.in:3002/ckyc/Creation/customers', " +
                       "'http://eispri.sbi.co.in:3002/ckycPersonalDetails_th/update/customers', " +
                       "'http://eispri.sbi.co.in:3002/ckycPersonalDetails_th/enquiry/customers') " +
                       "AND request_date_time BETWEEN TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS')";
            case 3:
                return "SELECT /*+ PARALLEL(4) */ " +
                       "ROUND(SUM(CASE WHEN ERROR_CODE IN ('SI001', 'SI002', 'SI007', 'SI014', 'SI017', 'SI569', 'SI570') THEN 1 ELSE 0 END) * 100 / NULLIF(COUNT(*), 0), 2) AS EIS_TD_PERCENT, " +
                       "ROUND(SUM(CASE WHEN SUBSTR(ERROR_CODE, 3, 3) IN ('002', '014') THEN 1 ELSE 0 END) * 100 / NULLIF(COUNT(*), 0), 2) AS DEST_TD_PERCENT " +
                       "FROM EISAPP.api_log" + part + " " +
                       "WHERE URL IN ('http://eispri.sbi.co.in:3021/amlockName/CCSID/ScreeningDetails/customers', " +
                       "'http://eispri.sbi.co.in:3011/amlockName/acknowledgeDetails/misc') " +
                       "AND REQUEST_DATE_TIME BETWEEN TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS')";
            case 4:
                return "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_HITS, " +
                       "SUM(CASE WHEN RESPONSE_STATUS IN ('0', 'SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS, " +
                       "ROUND(SUM(CASE WHEN ERROR_CODE IN ('SI002', 'SI014', 'SI001', 'SI051', 'SI007', 'SI569', 'SI570') THEN 1 ELSE 0 END) * 100 / NULLIF(COUNT(*), 0), 2) AS TD_PERCENT " +
                       "FROM EISAPP.api_log" + part + " " +
                       "WHERE SUBSTR(URN, 4, 2) = 'SA' " +
                       "AND REQUEST_DATE_TIME BETWEEN TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS')";
            case 5:
                return "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_HITS, " +
                       "SUM(CASE WHEN RESPONSE_STATUS IN ('0', 'SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS, " +
                       "ROUND(SUM(CASE WHEN ERROR_CODE IN ('SI002', 'SI014', 'SI001', 'SI051', 'SI007', 'SI569', 'SI570') THEN 1 ELSE 0 END) * 100 / NULLIF(COUNT(*), 0), 2) AS TD_PERCENT " +
                       "FROM EISAPP.api_log" + part + " " +
                       "WHERE BROKER_NAME = 'IVR_EXP' " +
                       "AND REQUEST_DATE_TIME BETWEEN TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS')";
            case 6:
                // DYNAMIC DMZ â€“ exclude NULL IPs
                return "SELECT /*+ PARALLEL(4) */ dpg_ip AS IP, COUNT(*) AS COUNT " +
                       "FROM EISAPP.api_log" + part + " " +
                       "WHERE REQUEST_DATE_TIME BETWEEN TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS') " +
                       "AND TO_DATE(?, 'DD-MON-YYYY HH24:MI:SS') " +
                       "AND dpg_ip IS NOT NULL " +
                       "GROUP BY dpg_ip";
            default:
                throw new IllegalArgumentException("Unknown query index for Part 2: " + queryIndex);
        }
    }

    private static void setQueryParameters(PreparedStatement ps, int queryIndex, String fromDate, String toDate)
            throws SQLException {
        // All queries 0-6 require two date parameters
        ps.setString(1, fromDate);
        ps.setString(2, toDate);
    }
}
