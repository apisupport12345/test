WITH 
gen5_non_siapp3 AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS op
    FROM daily_dpg_url_data
    WHERE (UPPER(lb_url) LIKE 'GEN5/GATEWAY%'
        OR UPPER(lb_url) LIKE 'GEN5%GATEWAY%'
        OR UPPER(lb_url) LIKE '%GEN5/GETWAY%')
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_non_siapp3 AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS op,
        ROW_NUMBER() OVER (
            PARTITION BY ip, type, REGEXP_SUBSTR(lb_url, '[^/]+$')
            ORDER BY lb_url
        ) rn
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) NOT LIKE '%GEN5%'
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_non_siapp3_fb AS (
    SELECT 
        ip, type, lb_url AS gen6_lb_url,
        ROW_NUMBER() OVER (PARTITION BY ip, type ORDER BY lb_url) rn
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) NOT LIKE '%GEN5%'
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen5_siapp3 AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS op
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%SIAPP3%GEN5%'
),
gen6_siapp3 AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS op,
        ROW_NUMBER() OVER (
            PARTITION BY ip, type, REGEXP_SUBSTR(lb_url, '[^/]+$')
            ORDER BY lb_url
        ) rn
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%SIAPP3%'
      AND UPPER(lb_url) NOT LIKE '%GEN5/GATEWAY%'
),
gen6_siapp3_fb AS (
    SELECT 
        ip, type, lb_url AS gen6_lb_url,
        ROW_NUMBER() OVER (PARTITION BY ip, type ORDER BY lb_url) rn
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%SIAPP3%'
      AND UPPER(lb_url) NOT LIKE '%GEN5/GATEWAY%'
)
SELECT 
    g5.ip, g5.type, g5.gen5_lb_url,
    COALESCE(g6.gen6_lb_url, fb.gen6_lb_url) AS gen6_lb_url,
    g5.route_url, SYSDATE
FROM gen5_non_siapp3 g5
LEFT JOIN gen6_non_siapp3 g6
  ON g5.ip = g6.ip AND g5.type = g6.type AND g5.op = g6.op AND g6.rn = 1
LEFT JOIN gen6_non_siapp3_fb fb
  ON g5.ip = fb.ip AND g5.type = fb.type AND fb.rn = 1

UNION ALL

SELECT 
    g5.ip, g5.type, g5.gen5_lb_url,
    COALESCE(g6.gen6_lb_url, fb.gen6_lb_url) AS gen6_lb_url,
    g5.route_url, SYSDATE
FROM gen5_siapp3 g5
LEFT JOIN gen6_siapp3 g6
  ON g5.ip = g6.ip AND g5.type = g6.type AND g5.op = g6.op AND g6.rn = 1
LEFT JOIN gen6_siapp3_fb fb
  ON g5.ip = fb.ip AND g5.type = fb.type AND fb.rn = 1;
