<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="true"%>
<%@ page import="com.jdbc.IPOMonitorService" %>
<%@ page import="com.jdbc.IPOMonitorService.QueryResult" %>
<%@ page import="java.util.*" %>
<%
    String ajax = request.getParameter("ajax");
    if ("fetch".equals(ajax)) {
        Map<String, QueryResult> results = IPOMonitorService.runAll();
        StringBuilder sb = new StringBuilder("{");
        int i = 0;
        for (Map.Entry<String, QueryResult> e : results.entrySet()) {
            if (i++ > 0) sb.append(",");
            sb.append("\"").append(IPOMonitorService.esc(e.getKey())).append("\":");
            sb.append(IPOMonitorService.toJson(e.getValue()));
        }
        sb.append("}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IPO Monitoring Dashboard</title>
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-light: #818cf8;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --isolated: #8b5cf6;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --card-shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            color: var(--gray-800);
            line-height: 1.5;
            min-height: 100vh;
            font-size: 16px;
        }

        /* ================= HEADER ================= */
        .dashboard-header {
            background: white;
            border-bottom: 1px solid var(--gray-200);
            padding: 1.5rem 2rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .header-main {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .dashboard-title h1 {
            font-size: 1.85rem;
            font-weight: 700;
            color: var(--gray-900);
            margin-bottom: 0.35rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .dashboard-title h1 svg {
            width: 2rem; height: 2rem;
            color: var(--primary);
        }
        .dashboard-title p {
            color: var(--gray-600);
            font-size: 1rem;
        }
        .header-info {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .refresh-timer {
            background: var(--primary);
            color: white;
            padding: 0.7rem 1.2rem;
            border-radius: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            box-shadow: 0 2px 4px rgba(99, 102, 241, 0.3);
        }
        .refresh-timer .icon-spin {
            display: inline-block;
            animation: none;
        }
        .refresh-timer.refreshing .icon-spin {
            animation: spin 1s linear infinite;
        }
        .run-time-info {
            background: var(--gray-800);
            color: white;
            padding: 0.7rem 1.2rem;
            border-radius: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .btn-refresh-now {
            background: var(--success);
            color: white;
            border: none;
            padding: 0.7rem 1.2rem;
            border-radius: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s;
            box-shadow: 0 2px 4px rgba(16, 185, 129, 0.3);
            font-family: inherit;
        }
        .btn-refresh-now:hover {
            background: #059669;
            transform: translateY(-2px);
        }
        .btn-refresh-now:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* ================= STATS GRID ================= */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 1rem;
        }
        .stat-card {
            background: white;
            padding: 1rem 1.25rem;
            border-radius: 0.75rem;
            box-shadow: var(--card-shadow);
            text-align: center;
            transition: all 0.3s ease;
            border-top: 5px solid var(--primary);
            position: relative;
            overflow: hidden;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--card-shadow-hover);
        }
        .stat-card.critical { border-top-color: var(--danger); }
        .stat-card.warning { border-top-color: var(--warning); }
        .stat-card.healthy { border-top-color: var(--success); }
        .stat-card.isolated { border-top-color: var(--isolated); }
        .stat-card.info { border-top-color: var(--primary); }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--gray-900);
            line-height: 1;
            margin-bottom: 0.35rem;
            font-variant-numeric: tabular-nums;
        }
        .stat-value.critical { color: var(--danger); }
        .stat-value.warning { color: var(--warning); }
        .stat-value.healthy { color: var(--success); }
        .stat-value.isolated { color: var(--isolated); }

        .stat-label {
            font-size: 0.85rem;
            color: var(--gray-600);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* ================= LEGEND ================= */
        .color-legend {
            background: white;
            border-radius: 0.75rem;
            box-shadow: var(--card-shadow);
            padding: 1.25rem 2rem;
            margin: 1.5rem 2rem 0;
        }
        .legend-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--gray-900);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            justify-content: center;
        }
        .legend-title svg { color: var(--primary); }
        .legend-items {
            display: flex;
            gap: 1.25rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 0.75rem;
            background: var(--gray-50);
            min-width: 260px;
            flex: 1;
            transition: all 0.2s;
        }
        .legend-item:hover {
            background: var(--gray-100);
            transform: translateY(-2px);
        }
        .legend-dot {
            width: 18px; height: 18px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .legend-dot.critical { background: var(--danger); }
        .legend-dot.warning { background: var(--warning); }
        .legend-dot.healthy { background: var(--success); }
        .legend-dot.isolated { background: var(--isolated); }
        .legend-text {
            font-size: 0.95rem;
            color: var(--gray-700);
            font-weight: 500;
            line-height: 1.4;
        }
        .legend-text strong { color: var(--gray-900); }

        /* ================= MAIN CONTENT ================= */
        .main-content {
            padding: 1.5rem 2rem 2rem;
            display: grid;
            grid-template-columns: 380px 1fr;
            gap: 1.5rem;
            min-height: calc(100vh - 400px);
        }

        /* ================= PANELS ================= */
        .panel {
            background: white;
            border-radius: 0.75rem;
            box-shadow: var(--card-shadow);
            margin-bottom: 1.25rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .panel:hover {
            box-shadow: var(--card-shadow-hover);
        }
        .panel-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--gray-200);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
            background: var(--gray-50);
        }
        .panel-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--gray-900);
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .panel-title.critical { color: var(--danger); }
        .panel-title.isolated { color: var(--isolated); }
        .panel-title.success { color: var(--success); }

        .panel-badge {
            background: var(--gray-800);
            color: white;
            padding: 0.2rem 0.75rem;
            border-radius: 1rem;
            font-size: 0.85rem;
            font-weight: 700;
            min-width: 42px;
            text-align: center;
        }
        .panel-badge.critical { background: var(--danger); }
        .panel-badge.isolated { background: var(--isolated); }
        .panel-badge.success { background: var(--success); }

        .panel-body {
            padding: 1rem 1.25rem;
            max-height: 340px;
            overflow-y: auto;
        }
        .panel-body::-webkit-scrollbar { width: 6px; }
        .panel-body::-webkit-scrollbar-track { background: var(--gray-100); }
        .panel-body::-webkit-scrollbar-thumb { background: var(--gray-300); border-radius: 3px; }

        /* Impacted / Isolated items */
        .impact-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.7rem 0.9rem;
            background: var(--gray-50);
            border-radius: 0.6rem;
            margin-bottom: 0.6rem;
            border-left: 4px solid var(--danger);
            transition: all 0.2s;
            font-size: 0.9rem;
        }
        .impact-item:hover { background: var(--gray-100); }
        .impact-item.warning { border-left-color: var(--warning); }
        .impact-item.isolated { border-left-color: var(--isolated); }
        .impact-item:last-child { margin-bottom: 0; }

        .impact-broker {
            flex: 1;
            font-weight: 600;
            color: var(--gray-900);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .impact-ip {
            font-family: 'Courier New', monospace;
            color: var(--gray-600);
            font-size: 0.9rem;
            white-space: nowrap;
        }
        .impact-hits {
            background: var(--danger);
            color: white;
            padding: 0.15rem 0.65rem;
            border-radius: 0.5rem;
            font-weight: 700;
            font-size: 0.82rem;
            white-space: nowrap;
        }
        .impact-hits.warning { background: var(--warning); }
        .impact-hits.isolated { background: var(--isolated); }

        /* ================= BROKER CARDS ================= */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 1.25rem;
        }
        .broker-card {
            background: white;
            border-radius: 0.75rem;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: all 0.3s;
            position: relative;
            border-top: 5px solid var(--success);
        }
        .broker-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--card-shadow-hover);
        }
        .broker-card.critical { border-top-color: var(--danger); }
        .broker-card.warning { border-top-color: var(--warning); }
        .broker-card.isolated { border-top-color: var(--isolated); }

        .broker-head {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--gray-200);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
        }
        .broker-info {
            flex: 1;
            min-width: 0;
        }
        .broker-name {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--gray-900);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: 'JetBrains Mono', 'Courier New', monospace;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .broker-api {
            font-size: 0.78rem;
            color: var(--gray-500);
            font-weight: 500;
            margin-top: 0.15rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .broker-status-badge {
            padding: 0.3rem 0.75rem;
            border-radius: 2rem;
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            white-space: nowrap;
        }
        .broker-status-badge.healthy { background: rgba(16,185,129,0.15); color: var(--success); }
        .broker-status-badge.warning { background: rgba(245,158,11,0.15); color: var(--warning); }
        .broker-status-badge.critical { background: rgba(239,68,68,0.15); color: var(--danger); }
        .broker-status-badge.isolated { background: rgba(139,92,246,0.15); color: var(--isolated); }

        .broker-body {
            padding: 1rem 1.25rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* Metrics grid */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }
        .metric {
            background: var(--gray-50);
            padding: 0.7rem 0.85rem;
            border-radius: 0.6rem;
            text-align: center;
        }
        .metric-label {
            font-size: 0.72rem;
            color: var(--gray-500);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.2rem;
        }
        .metric-value {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--gray-900);
            font-variant-numeric: tabular-nums;
        }
        .metric-value.success { color: var(--success); }
        .metric-value.warning { color: var(--warning); }
        .metric-value.danger { color: var(--danger); }

        /* Error chips */
        .err-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            padding-top: 0.75rem;
            border-top: 1px dashed var(--gray-200);
            min-height: 32px;
        }
        .err-chip {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.2rem 0.55rem;
            border-radius: 0.4rem;
            white-space: nowrap;
        }
        .err-chip.td {
            background: rgba(245,158,11,0.12);
            color: var(--warning);
            border: 1px solid rgba(245,158,11,0.3);
        }
        .err-chip.bd {
            background: rgba(239,68,68,0.12);
            color: var(--danger);
            border: 1px solid rgba(239,68,68,0.3);
        }
        .err-chip.ok {
            background: rgba(16,185,129,0.1);
            color: var(--success);
            border: 1px solid rgba(16,185,129,0.25);
        }

        /* Empty states */
        .empty-state {
            text-align: center;
            padding: 2rem 1rem;
            color: var(--gray-500);
        }
        .empty-state .icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            opacity: 0.5;
        }
        .empty-state .title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--gray-600);
            margin-bottom: 0.25rem;
        }
        .empty-state .sub {
            font-size: 0.85rem;
            color: var(--gray-500);
        }

        /* Loader */
        .loader {
            text-align: center;
            padding: 3rem 1rem;
        }
        .loader-spinner {
            display: inline-block;
            width: 40px; height: 40px;
            border: 4px solid var(--gray-200);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
        }
        .loader-text {
            margin-top: 1rem;
            font-size: 0.9rem;
            color: var(--gray-500);
            font-weight: 600;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 1.5rem; right: 1.5rem;
            padding: 0.9rem 1.4rem;
            background: white;
            border-left: 4px solid var(--success);
            border-radius: 0.6rem;
            color: var(--gray-900);
            font-size: 0.95rem;
            font-weight: 600;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.15);
            z-index: 9999;
            animation: slideIn 0.25s ease;
        }
        .toast.err { border-left-color: var(--danger); }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* ================= RESPONSIVE ================= */
        @media (max-width: 1400px) {
            .stats-grid { grid-template-columns: repeat(3, 1fr); }
        }
        @media (max-width: 1100px) {
            .main-content { grid-template-columns: 1fr; }
            .cards-grid { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
        }
        @media (max-width: 768px) {
            .dashboard-header { padding: 1rem 1rem; }
            .header-main { flex-direction: column; align-items: flex-start; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .main-content { padding: 1rem; }
            .cards-grid { grid-template-columns: 1fr; }
            .color-legend { margin: 1rem; padding: 1rem; }
        }
    </style>
</head>
<body>

<!-- ================= HEADER ================= -->
<div class="dashboard-header">
    <div class="header-main">
        <div class="dashboard-title">
            <h1>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
                IPO Monitoring Dashboard
            </h1>
            <p>Live monitoring of IPO backend services · Auto-refresh every 5 minutes · Last 5-minute window</p>
        </div>
        <div class="header-info">
            <div class="refresh-timer" id="refreshTimer">
                <span class="icon-spin">&#8635;</span>
                Next refresh: <span id="countdown" style="font-variant-numeric: tabular-nums;">Initializing...</span>
            </div>
            <div class="run-time-info" id="lastRefreshInfo">
                Last refresh: <span id="lastRefreshTime">—</span>
            </div>
            <button class="btn-refresh-now" id="refreshBtn" onclick="refreshNow()">
                <span style="display:inline-block;" id="refreshBtnIcon">&#8635;</span> Refresh Now
            </button>
        </div>
    </div>

    <!-- STATS -->
    <div class="stats-grid">
        <div class="stat-card info">
            <div class="stat-value" id="statBackendHits">—</div>
            <div class="stat-label">Backend Hits</div>
        </div>
        <div class="stat-card info">
            <div class="stat-value" id="statBackendTD">—</div>
            <div class="stat-label">Backend TD%</div>
        </div>
        <div class="stat-card info">
            <div class="stat-value" id="statApiNHits">—</div>
            <div class="stat-label">NSE/INB Hits</div>
        </div>
        <div class="stat-card info">
            <div class="stat-value" id="statApiNTD">—</div>
            <div class="stat-label">NSE/INB TD%</div>
        </div>
        <div class="stat-card info">
            <div class="stat-value" id="statApiBHits">—</div>
            <div class="stat-label">BSE Hits</div>
        </div>
        <div class="stat-card info">
            <div class="stat-value" id="statApiBTD">—</div>
            <div class="stat-label">BSE TD%</div>
        </div>
    </div>
</div>

<!-- ================= LEGEND ================= -->
<div class="color-legend">
    <div class="legend-title">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:1.15rem;height:1.15rem;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
        </svg>
        Status Color Guide
    </div>
    <div class="legend-items">
        <div class="legend-item">
            <div class="legend-dot healthy"></div>
            <div class="legend-text"><strong>Healthy</strong> — Zero TD / BD errors</div>
        </div>
        <div class="legend-item">
            <div class="legend-dot warning"></div>
            <div class="legend-text"><strong>Warning</strong> — TD% &gt; 0 or BD present</div>
        </div>
        <div class="legend-item">
            <div class="legend-dot critical"></div>
            <div class="legend-text"><strong>Critical</strong> — TD% &gt; 5 or BD% &gt; 5</div>
        </div>
        <div class="legend-item">
            <div class="legend-dot isolated"></div>
            <div class="legend-text"><strong>Isolated</strong> — Server isolated</div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="main-content">

    <!-- LEFT PANEL: Summary Sections -->
    <div class="left-panel">

        <!-- Backend Summary -->
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">
                    <span style="color: var(--primary);">&#9881;</span> Backend Log
                </div>
                <span class="panel-badge" id="leftBackendBadge">—</span>
            </div>
            <div class="panel-body" id="leftBackendBody">
                <div class="loader"><div class="loader-spinner"></div><div class="loader-text">Loading...</div></div>
            </div>
        </div>

        <!-- NSE/INB Summary -->
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">
                    <span style="color: var(--primary);">&#128225;</span> API Log · NSE/INB
                </div>
                <span class="panel-badge" id="leftApiNBadge">—</span>
            </div>
            <div class="panel-body" id="leftApiNBody">
                <div class="loader"><div class="loader-spinner"></div><div class="loader-text">Loading...</div></div>
            </div>
        </div>

        <!-- BSE Summary -->
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">
                    <span style="color: var(--purple, #a855f7);">&#128226;</span> API Log · BSE
                </div>
                <span class="panel-badge" id="leftApiBBadge">—</span>
            </div>
            <div class="panel-body" id="leftApiBBody">
                <div class="loader"><div class="loader-spinner"></div><div class="loader-text">Loading...</div></div>
            </div>
        </div>

    </div>

    <!-- RIGHT PANEL: IP Cards -->
    <div class="right-panel">

        <!-- Panel: Backend IPs -->
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">
                    <span style="color: var(--primary);">&#9881;</span> Backend IPs — IPO Auth
                </div>
                <span class="panel-badge" id="backendBadge">—</span>
            </div>
            <div class="panel-body" style="max-height: none; overflow: visible;">
                <div class="cards-grid" id="backendCards">
                    <div class="loader" style="grid-column: 1/-1;"><div class="loader-spinner"></div><div class="loader-text">Loading backend IPs...</div></div>
                </div>
            </div>
        </div>

        <!-- Panel: NSE/INB IPs -->
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">
                    <span style="color: var(--primary);">&#128225;</span> NSE/INB IPs — Routing
                </div>
                <span class="panel-badge" id="apiNBadge">—</span>
            </div>
            <div class="panel-body" style="max-height: none; overflow: visible;">
                <div class="cards-grid" id="apiNCards">
                    <div class="loader" style="grid-column: 1/-1;"><div class="loader-spinner"></div><div class="loader-text">Loading NSE/INB IPs...</div></div>
                </div>
            </div>
        </div>

        <!-- Panel: BSE IPs -->
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">
                    <span style="color: var(--primary);">&#128226;</span> BSE IPs — IPO_ORDER
                </div>
                <span class="panel-badge" id="apiBBadge">—</span>
            </div>
            <div class="panel-body" style="max-height: none; overflow: visible;">
                <div class="cards-grid" id="apiBCards">
                    <div class="loader" style="grid-column: 1/-1;"><div class="loader-spinner"></div><div class="loader-text">Loading BSE IPs...</div></div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
/* ============================================================
 * IPO MONITORING DASHBOARD — v5.0 (Professional)
 * ============================================================ */

var REFRESH_INTERVAL_SEC = 300;   // 5 min
var secondsLeft = 0;
var countdownTimer = null;
var isRefreshing = false;

/* ============ COUNTDOWN ============ */
function startCountdown() {
    if (countdownTimer) clearInterval(countdownTimer);
    secondsLeft = REFRESH_INTERVAL_SEC;
    updateCountdownUI();
    countdownTimer = setInterval(function() {
        secondsLeft--;
        if (secondsLeft <= 0) { secondsLeft = REFRESH_INTERVAL_SEC; refreshNow(); }
        updateCountdownUI();
    }, 1000);
}

function stopCountdown() {
    if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
}

function updateCountdownUI() {
    var el = document.getElementById('countdown');
    if (!el) return;
    if (isRefreshing) {
        el.innerHTML = '<span style="color:#f59e0b;">Refreshing...</span>';
        return;
    }
    var m = Math.floor(secondsLeft / 60);
    var s = secondsLeft % 60;
    el.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
}

function updateLastRefreshTime() {
    var el = document.getElementById('lastRefreshTime');
    if (!el) return;
    var now = new Date();
    var hh = String(now.getHours()).padStart(2,'0');
    var mm = String(now.getMinutes()).padStart(2,'0');
    var ss = String(now.getSeconds()).padStart(2,'0');
    el.textContent = hh + ':' + mm + ':' + ss;
}

/* ============ REFRESH ============ */
function refreshNow() {
    if (isRefreshing) return;
    isRefreshing = true;
    stopCountdown();
    updateCountdownUI();

    var btn = document.getElementById('refreshBtn');
    var icon = document.getElementById('refreshBtnIcon');
    var timer = document.getElementById('refreshTimer');
    btn.disabled = true;
    icon.style.animation = 'spin 1s linear infinite';
    timer.classList.add('refreshing');

    // Show loaders
    showLoader('backendCards', 'Loading backend IPs...');
    showLoader('apiNCards', 'Loading NSE/INB IPs...');
    showLoader('apiBCards', 'Loading BSE IPs...');
    showLoader('leftBackendBody', 'Loading summary...');
    showLoader('leftApiNBody', 'Loading summary...');
    showLoader('leftApiBBody', 'Loading summary...');

    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'ipo-monitor.jsp?ajax=fetch&_=' + Date.now(), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        btn.disabled = false;
        icon.style.animation = '';
        timer.classList.remove('refreshing');
        isRefreshing = false;

        if (xhr.status !== 200) {
            toast('HTTP ' + xhr.status + ' — refresh failed', true);
            startCountdown();
            updateCountdownUI();
            return;
        }
        try {
            var data = JSON.parse(xhr.responseText);
            renderAll(data);
            updateLastRefreshTime();
            toast('Data refreshed');
        } catch(e) {
            toast('Parse error', true);
            console.error(e);
        }
        startCountdown();
        updateCountdownUI();
    };
    xhr.send();
}

function showLoader(id, text) {
    var el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = '<div class="loader" style="grid-column: 1/-1;"><div class="loader-spinner"></div><div class="loader-text">' + escapeHtml(text) + '</div></div>';
}

/* ============ RENDER ALL ============ */
function renderAll(data) {
    renderCardGrid(data.BACKEND_LOG, 'backendCards', 'backendBadge');
    renderCardGrid(data.API_NSE_INB, 'apiNCards', 'apiNBadge');
    renderCardGrid(data.API_BSE, 'apiBCards', 'apiBBadge');
    renderLeftSummary(data.BACKEND_LOG, 'leftBackendBody', 'leftBackendBadge', 'backend');
    renderLeftSummary(data.API_NSE_INB, 'leftApiNBody', 'leftApiNBadge', 'nse');
    renderLeftSummary(data.API_BSE, 'leftApiBBody', 'leftApiBBadge', 'bse');
    updateStats(data);
}

/* ============ IP CARD GRID ============ */
function renderCardGrid(qr, cardsId, badgeId) {
    var container = document.getElementById(cardsId);
    var badge = document.getElementById(badgeId);

    if (!qr || !qr.success) {
        container.innerHTML = '<div class="empty-state" style="grid-column:1/-1;"><div class="icon">&#9888;</div><div class="title">No Data</div><div class="sub">' + escapeHtml(qr ? qr.message : 'Failed to load') + '</div></div>';
        badge.textContent = 'ERR';
        return;
    }
    badge.textContent = qr.rows.length + ' IPs · ' + qr.executionTimeMs + ' ms';

    if (!qr.rows || qr.rows.length === 0) {
        container.innerHTML = '<div class="empty-state" style="grid-column:1/-1;"><div class="icon">&#128269;</div><div class="title">No Hits</div><div class="sub">No traffic in last 5 minutes</div></div>';
        return;
    }

    var cols = qr.columns;
    var ipCol    = findCol(cols, ['SYS_IP','EXP_IP','IP']);
    var apiCol   = findCol(cols, ['API_NAME']);
    var hitsCol  = findCol(cols, ['TOTAL_HITS','HITS']);
    var succCol  = findCol(cols, ['SUCCESS']);
    var tdCol    = findCol(cols, ['TD']);
    var tdpCol   = findCol(cols, ['TD_PERCENT']);
    var bdCol    = findCol(cols, ['BD']);
    var bdpCol   = findCol(cols, ['BD_PERCENT']);

    var errCols = [];
    cols.forEach(function(c) {
        if (c === ipCol || c === apiCol || c === hitsCol || c === succCol ||
            c === tdCol || c === tdpCol || c === bdCol || c === bdpCol) return;
        errCols.push(c);
    });

    var html = '';
    qr.rows.forEach(function(row) {
        var ip = row[ipCol] || '-';
        var apiName = row[apiCol] || '';
        var hits = parseInt(row[hitsCol] || 0);
        var success = parseInt(row[succCol] || 0);
        var td = parseInt(row[tdCol] || 0);
        var tdPct = parseFloat(row[tdpCol] || 0);
        var bd = parseInt(row[bdCol] || 0);
        var bdPct = parseFloat(row[bdpCol] || 0);

        var status = 'healthy';
        if (tdPct > 5 || bdPct > 5) status = 'critical';
        else if (tdPct > 0 || bdPct > 0 || td > 0 || bd > 0) status = 'warning';

        var errChips = [];
        errCols.forEach(function(c) {
            var v = parseInt(row[c] || 0);
            if (v > 0) {
                var isBD = (c === 'BD' || c === 'BD_NEW');
                var cls = isBD ? 'bd' : 'td';
                errChips.push('<span class="err-chip ' + cls + '">' + escapeHtml(c) + ' · ' + v + '</span>');
            }
        });

        var succPct = hits > 0 ? (success * 100 / hits) : 100;
        var succClass = succPct >= 99 ? 'success' : (succPct >= 95 ? 'warning' : 'danger');

        var shortApi = apiName.replace('thirdParty','').replace('_sys','').replace('_expDS','');

        html += '<div class="broker-card ' + status + '">';
        html +=   '<div class="broker-head">';
        html +=     '<div class="broker-info">';
        html +=       '<div class="broker-name"><span class="status-indicator ' + status + '" style="display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--' +
                        (status === 'healthy' ? 'success' : status === 'warning' ? 'warning' : 'danger') + ');"></span>' + escapeHtml(ip) + '</div>';
        if (shortApi) html += '<div class="broker-api">' + escapeHtml(shortApi) + '</div>';
        html +=     '</div>';
        html +=     '<span class="broker-status-badge ' + status + '">' + status + '</span>';
        html +=   '</div>';

        html +=   '<div class="broker-body">';
        html +=     '<div class="metrics-grid">';
        html +=       '<div class="metric"><div class="metric-label">Hits</div><div class="metric-value">' + hits + '</div></div>';
        html +=       '<div class="metric"><div class="metric-label">Success</div><div class="metric-value ' + succClass + '">' + success + '</div></div>';
        html +=       '<div class="metric"><div class="metric-label">TD%</div><div class="metric-value ' + (tdPct > 0 ? (tdPct > 5 ? 'danger' : 'warning') : 'success') + '">' + tdPct.toFixed(2) + '%</div></div>';
        html +=       '<div class="metric"><div class="metric-label">BD%</div><div class="metric-value ' + (bdPct > 0 ? (bdPct > 5 ? 'danger' : 'warning') : 'success') + '">' + bdPct.toFixed(2) + '%</div></div>';
        html +=     '</div>';
        html +=     '<div class="err-chips">';
        if (errChips.length > 0) html += errChips.join('');
        else html += '<span class="err-chip ok">&#10003; No errors</span>';
        html +=     '</div>';
        html +=   '</div>';
        html += '</div>';
    });
    container.innerHTML = html;
}

function findCol(cols, names) {
    for (var i = 0; i < names.length; i++) {
        var n = names[i].toUpperCase();
        for (var j = 0; j < cols.length; j++) {
            if (cols[j].toUpperCase() === n) return cols[j];
        }
    }
    return null;
}

/* ============ LEFT SUMMARY (Top IPs list) ============ */
function renderLeftSummary(qr, bodyId, badgeId, prefix) {
    var body = document.getElementById(bodyId);
    var badge = document.getElementById(badgeId);

    if (!qr || !qr.success) {
        body.innerHTML = '<div class="empty-state"><div class="icon">&#9888;</div><div class="title">No data</div></div>';
        badge.textContent = 'ERR';
        return;
    }

    var totalHits = 0, totalTD = 0, count = 0;
    qr.rows.forEach(function(r) {
        totalHits += parseInt(r.TOTAL_HITS || 0);
        totalTD += parseFloat(r.TD_PERCENT || 0);
        count++;
    });
    badge.textContent = qr.rows.length + ' IPs';

    var html = '';
    // Sort by hits desc, top 8
    var sorted = qr.rows.slice().sort(function(a, b) {
        return parseInt(b.TOTAL_HITS || 0) - parseInt(a.TOTAL_HITS || 0);
    }).slice(0, 8);

    sorted.forEach(function(r) {
        var ip = r.SYS_IP || r.EXP_IP || '-';
        var hits = parseInt(r.TOTAL_HITS || 0);
        var tdPct = parseFloat(r.TD_PERCENT || 0);
        var status = tdPct > 5 ? 'critical' : (tdPct > 0 ? 'warning' : '');

        html += '<div class="impact-item ' + status + '">';
        html +=   '<span class="impact-broker" style="font-family: monospace;">' + escapeHtml(ip) + '</span>';
        html +=   '<span class="impact-ip">' + hits + ' hits</span>';
        html +=   '<span class="impact-hits ' + status + '">' + tdPct.toFixed(1) + '%</span>';
        html += '</div>';
    });
    body.innerHTML = html;
}

/* ============ STATS ============ */
function updateStats(data) {
    var b = data.BACKEND_LOG, n = data.API_NSE_INB, x = data.API_BSE;

    var bHits = 0, bTD = 0, bCount = 0;
    if (b && b.success && b.rows) b.rows.forEach(function(r) { bHits += parseInt(r.TOTAL_HITS||0); bTD += parseFloat(r.TD_PERCENT||0); bCount++; });
    setStat('statBackendHits', bHits);
    setStat('statBackendTD', bCount > 0 ? (bTD/bCount).toFixed(2) + '%' : '—', bCount > 0 ? bTD/bCount : null);

    var nHits = 0, nTD = 0, nCount = 0;
    if (n && n.success && n.rows) n.rows.forEach(function(r) { nHits += parseInt(r.TOTAL_HITS||0); nTD += parseFloat(r.TD_PERCENT||0); nCount++; });
    setStat('statApiNHits', nHits);
    setStat('statApiNTD', nCount > 0 ? (nTD/nCount).toFixed(2) + '%' : '—', nCount > 0 ? nTD/nCount : null);

    var xHits = 0, xTD = 0, xCount = 0;
    if (x && x.success && x.rows) x.rows.forEach(function(r) { xHits += parseInt(r.TOTAL_HITS||0); xTD += parseFloat(r.TD_PERCENT||0); xCount++; });
    setStat('statApiBHits', xHits);
    setStat('statApiBTD', xCount > 0 ? (xTD/xCount).toFixed(2) + '%' : '—', xCount > 0 ? xTD/xCount : null);
}

function setStat(id, value, pct) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = value;
    el.classList.remove('critical', 'warning', 'healthy');
    if (pct !== null && pct !== undefined && !isNaN(pct)) {
        if (pct <= 1) el.classList.add('healthy');
        else if (pct <= 5) el.classList.add('warning');
        else el.classList.add('critical');
    } else {
        el.classList.add('healthy');
    }
}

/* ============ HELPERS ============ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function(){
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function(){ el.remove(); }, 320);
    }, 2200);
}

/* ============ INIT ============ */
window.addEventListener('load', function() {
    refreshNow();
});
</script>

