<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="true"%>
<%@ page import="com.jdbc.IPOMonitorService" %>
<%@ page import="com.jdbc.IPOMonitorService.QueryResult" %>
<%@ page import="java.util.*" %>
<%
    String ajax = request.getParameter("ajax");
    if ("fetch".equals(ajax)) {
        Map<String, QueryResult> results = IPOMonitorService.runAll();
        StringBuilder sb = new StringBuilder("{");
        int i = 0;
        for (Map.Entry<String, QueryResult> e : results.entrySet()) {
            if (i++ > 0) sb.append(",");
            sb.append("\"").append(IPOMonitorService.esc(e.getKey())).append("\":");
            sb.append(IPOMonitorService.toJson(e.getValue()));
        }
        sb.append("}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }
%>
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IPO Monitoring Dashboard</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        /* ==================== DARK THEME (default) ==================== */
        html[data-theme="dark"] {
            --bg-base: #070b14;
            --bg-grad-1: #0a0f1e;
            --bg-grad-2: #151228;
            --bg-grad-3: #0d1424;
            --glass: rgba(20, 28, 45, 0.55);
            --glass-2: rgba(255, 255, 255, 0.035);
            --glass-3: rgba(0, 0, 0, 0.18);
            --glass-border: rgba(120, 150, 210, 0.14);
            --glass-border-hi: rgba(120, 150, 210, 0.32);
            --text-0: #f5f7fb;
            --text-1: #c8d0e0;
            --text-2: #7e8899;
            --text-3: #5a6478;
            --accent: #4f8cff;
            --green: #22e6a4;
            --green-dim: rgba(34, 230, 164, 0.14);
            --amber: #ffb84d;
            --amber-dim: rgba(255, 184, 77, 0.14);
            --red: #ff5577;
            --red-dim: rgba(255, 85, 119, 0.14);
            --purple: #b47cff;
            --purple-dim: rgba(180, 124, 255, 0.14);
            --cyan: #4fd1ff;
            --bg-scroll: rgba(120, 150, 210, 0.22);
            --bg-scroll-hover: rgba(120, 150, 210, 0.4);
        }

        /* ==================== LIGHT THEME ==================== */
        html[data-theme="light"] {
            --bg-base: #eef2f8;
            --bg-grad-1: #e6ecf5;
            --bg-grad-2: #f3eef8;
            --bg-grad-3: #eaf0f8;
            --glass: rgba(255, 255, 255, 0.85);
            --glass-2: rgba(255, 255, 255, 0.7);
            --glass-3: rgba(0, 0, 0, 0.04);
            --glass-border: rgba(70, 100, 160, 0.15);
            --glass-border-hi: rgba(70, 100, 160, 0.35);
            --text-0: #0a1124;
            --text-1: #2e3a52;
            --text-2: #64738c;
            --text-3: #8895ab;
            --accent: #2f6ee0;
            --green: #0ea875;
            --green-dim: rgba(14, 168, 117, 0.12);
            --amber: #e08a12;
            --amber-dim: rgba(224, 138, 18, 0.12);
            --red: #e02550;
            --red-dim: rgba(224, 37, 80, 0.12);
            --purple: #8243e0;
            --purple-dim: rgba(130, 67, 224, 0.12);
            --cyan: #0e9ec8;
            --bg-scroll: rgba(70, 100, 160, 0.28);
            --bg-scroll-hover: rgba(70, 100, 160, 0.5);
        }

        html, body {
            height: 100vh;
            overflow: hidden;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--text-0);
            background: var(--bg-base);
            font-size: 13.5px;
            -webkit-font-smoothing: antialiased;
            transition: background 0.3s, color 0.3s;
        }

        /* Animated gradient background */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse at 0% 0%, rgba(79, 140, 255, 0.20), transparent 45%),
                radial-gradient(ellipse at 100% 0%, rgba(180, 124, 255, 0.16), transparent 45%),
                radial-gradient(ellipse at 50% 100%, rgba(34, 230, 164, 0.10), transparent 50%),
                linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-3) 50%, var(--bg-grad-2) 100%);
            z-index: -2;
            transition: background 0.3s;
        }
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1;
            pointer-events: none;
        }
        html[data-theme="light"] body::after {
            background-image:
                linear-gradient(rgba(0,0,0,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,0,0,0.02) 1px, transparent 1px);
        }

        .app {
            height: 100vh;
            display: grid;
            grid-template-rows: 68px 1fr;
            overflow: hidden;
        }

        /* ==================== HEADER ==================== */
        .header {
            display: flex;
            align-items: center;
            padding: 0 22px;
            gap: 16px;
            border-bottom: 1px solid var(--glass-border);
            background: var(--glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 100;
            flex-shrink: 0;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 13px;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.4px;
            color: var(--text-0);
        }
        .logo-mark {
            width: 38px; height: 38px;
            border-radius: 11px;
            background: linear-gradient(135deg, #4f8cff 0%, #b47cff 100%);
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            box-shadow:
                0 6px 20px rgba(79, 140, 255, 0.45),
                inset 0 1px 0 rgba(255,255,255,0.3);
        }
        .logo-pill {
            font-size: 10px;
            font-weight: 800;
            padding: 3px 9px;
            background: var(--green-dim);
            border: 1px solid rgba(34, 230, 164, 0.35);
            color: var(--green);
            border-radius: 6px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .pulse-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
            animation: pulse 1.5s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.35; transform: scale(0.85); }
        }

        .hdr-spacer { flex: 1; }

        .hdr-stat {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-1);
        }
        .hdr-stat .num { color: var(--text-0); font-weight: 800; font-size: 14px; }
        .hdr-stat .num.green  { color: var(--green); }
        .hdr-stat .num.amber  { color: var(--amber); }
        .hdr-stat .num.red    { color: var(--red); }
        .hdr-stat .dot { width: 7px; height: 7px; border-radius: 50%; }
        .hdr-stat .dot.g { background: var(--green); box-shadow: 0 0 6px var(--green); }
        .hdr-stat .dot.a { background: var(--amber); box-shadow: 0 0 6px var(--amber); }
        .hdr-stat .dot.r { background: var(--red); box-shadow: 0 0 6px var(--red); }

        .countdown-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 16px;
            background: linear-gradient(135deg, rgba(79, 140, 255, 0.15), rgba(180, 124, 255, 0.12));
            border: 1px solid rgba(79, 140, 255, 0.35);
            border-radius: 10px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
            box-shadow: 0 4px 14px rgba(79, 140, 255, 0.15);
        }
        .countdown-pill .cd-val { color: var(--accent); font-size: 14px; font-weight: 800; letter-spacing: 0.3px; }

        .theme-toggle {
            width: 52px; height: 28px;
            border-radius: 14px;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            position: relative;
            cursor: pointer;
            transition: 0.25s;
            flex-shrink: 0;
        }
        .theme-toggle:hover { border-color: var(--accent); }
        .theme-toggle .icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            font-size: 13px;
            transition: 0.25s;
            pointer-events: none;
        }
        .theme-toggle .icon.sun  { left: 6px;  opacity: 0; }
        .theme-toggle .icon.moon { right: 6px; opacity: 1; }
        html[data-theme="light"] .theme-toggle .icon.sun  { opacity: 1; }
        html[data-theme="light"] .theme-toggle .icon.moon { opacity: 0; }
        .theme-toggle .knob {
            position: absolute;
            top: 3px; left: 3px;
            width: 20px; height: 20px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f8cff, #3866dd);
            transition: 0.25s cubic-bezier(0.4,0,0.2,1);
            box-shadow: 0 2px 6px rgba(0,0,0,0.35);
        }
        html[data-theme="light"] .theme-toggle .knob {
            left: 27px;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
        }

        .btn-refresh {
            width: 40px; height: 40px;
            background: linear-gradient(135deg, #4f8cff, #3866dd);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: 0.22s;
            box-shadow: 0 6px 18px rgba(79, 140, 255, 0.4);
            flex-shrink: 0;
        }
        .btn-refresh:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(79, 140, 255, 0.6);
        }
        .btn-refresh:disabled { opacity: 0.7; cursor: not-allowed; }
        .btn-refresh.spinning { animation: spin 1s linear infinite; }

        @keyframes spin { to { transform: rotate(360deg); } }

        /* ==================== MAIN ==================== */
        .main {
            padding: 14px 18px;
            display: grid;
            grid-template-rows: 108px 1fr;
            gap: 14px;
            min-height: 0;
            overflow: hidden;
        }

        /* ==================== KPI ROW ==================== */
        .kpis {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            min-height: 0;
        }
        .kpi {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 12px 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            transition: 0.22s;
        }
        .kpi:hover {
            transform: translateY(-2px);
            border-color: var(--glass-border-hi);
            box-shadow: 0 12px 32px rgba(0,0,0,0.35);
        }
        .kpi::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--accent);
            box-shadow: 0 0 16px rgba(79, 140, 255, 0.5);
        }
        .kpi.green::before  { background: var(--green); box-shadow: 0 0 16px rgba(34, 230, 164, 0.6); }
        .kpi.amber::before  { background: var(--amber); box-shadow: 0 0 16px rgba(255, 184, 77, 0.6); }
        .kpi.red::before    { background: var(--red); box-shadow: 0 0 16px rgba(255, 85, 119, 0.6); }

        .kpi-label {
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: var(--text-3);
            margin-bottom: 5px;
        }
        .kpi-value {
            font-size: 28px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: -0.7px;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }
        .kpi-value.green { color: var(--green); }
        .kpi-value.amber { color: var(--amber); }
        .kpi-value.red   { color: var(--red); }
        .kpi-sub {
            font-size: 11px;
            color: var(--text-3);
            font-weight: 600;
            margin-top: 4px;
        }

        /* ==================== PANELS ==================== */
        .panels {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            min-height: 0;
            overflow: hidden;
        }
        .panel {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 0;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 4px 22px rgba(0,0,0,0.2);
        }
        .panel-head {
            padding: 12px 16px;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--glass-2);
            flex-shrink: 0;
        }
        .ph-icon {
            width: 30px; height: 30px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }
        .ph-icon.green  { background: var(--green-dim); color: var(--green); }
        .ph-icon.blue   { background: rgba(79, 140, 255, 0.15); color: var(--accent); }
        .ph-icon.purple { background: var(--purple-dim); color: var(--purple); }

        .ph-text { flex: 1; min-width: 0; }
        .ph-title {
            font-size: 14px;
            font-weight: 800;
            color: var(--text-0);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .ph-sub {
            font-size: 10px;
            color: var(--text-3);
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin-top: 1px;
        }
        .ph-badge {
            font-size: 10px;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 7px;
            background: var(--glass-2);
            color: var(--text-2);
            letter-spacing: 0.4px;
            white-space: nowrap;
            border: 1px solid var(--glass-border);
        }

        /* Panel body — SCROLLABLE */
        .panel-body {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 12px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 10px;
            align-content: start;
        }
        .panel-body::-webkit-scrollbar { width: 8px; }
        .panel-body::-webkit-scrollbar-track { background: transparent; }
        .panel-body::-webkit-scrollbar-thumb {
            background: var(--bg-scroll);
            border-radius: 4px;
        }
        .panel-body::-webkit-scrollbar-thumb:hover { background: var(--bg-scroll-hover); }

        /* ==================== IP CARD ==================== */
        .ip-card {
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: 0.22s;
            position: relative;
            overflow: hidden;
            min-height: 180px;
        }
        .ip-card:hover {
            background: var(--glass-3);
            border-color: var(--glass-border-hi);
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(0,0,0,0.35);
        }

        /* --- CRITICAL: TD error --> RED --- */
        .ip-card.critical-td {
            background: var(--red-dim);
            border: 2px solid rgba(255, 85, 119, 0.55);
            animation: tdPulse 2.6s ease-in-out infinite;
        }
        .ip-card.critical-td::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 5px;
            background: var(--red);
            box-shadow: 0 0 18px var(--red);
        }
        @keyframes tdPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 85, 119, 0.0); }
            50%      { box-shadow: 0 0 24px 2px rgba(255, 85, 119, 0.35); }
        }

        /* --- WARNING: BD error --> YELLOW --- */
        .ip-card.critical-bd {
            background: var(--amber-dim);
            border: 2px solid rgba(255, 184, 77, 0.55);
            animation: bdPulse 2.6s ease-in-out infinite;
        }
        .ip-card.critical-bd::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 5px;
            background: var(--amber);
            box-shadow: 0 0 18px var(--amber);
        }
        @keyframes bdPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 184, 77, 0.0); }
            50%      { box-shadow: 0 0 24px 2px rgba(255, 184, 77, 0.35); }
        }

        /* --- Healthy --- */
        .ip-card.healthy {
            border-color: var(--glass-border);
        }
        .ip-card.healthy::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 3px;
            background: var(--green);
        }

        /* Head */
        .ip-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .ip-addr {
            font-family: 'JetBrains Mono', 'SF Mono', 'Consolas', monospace;
            font-size: 14px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: 0.3px;
        }
        .ip-badge {
            font-size: 10px;
            font-weight: 900;
            padding: 4px 10px;
            border-radius: 7px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }
        .ip-badge.healthy    { background: var(--green-dim); color: var(--green); border: 1px solid rgba(34,230,164,0.4); }
        .ip-badge.critical-td{ background: var(--red-dim);   color: var(--red);   border: 1px solid rgba(255,85,119,0.45); }
        .ip-badge.critical-bd{ background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(255,184,77,0.45); }

        .ip-api {
            font-size: 11px;
            color: var(--text-2);
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: -4px;
        }

        /* Metrics */
        .ip-metrics {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .ip-metric {
            background: var(--glass-3);
            border-radius: 8px;
            padding: 8px 10px;
            border: 1px solid var(--glass-border);
        }
        .ip-metric-label {
            font-size: 10px;
            color: var(--text-3);
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }
        .ip-metric-value {
            font-size: 17px;
            font-weight: 800;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
            line-height: 1;
        }
        .ip-metric-value.green { color: var(--green); }
        .ip-metric-value.amber { color: var(--amber); }
        .ip-metric-value.red   { color: var(--red); }

        /* Success bar */
        .succ-bar {
            height: 6px;
            background: var(--glass-3);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 4px;
        }
        .succ-bar-inner {
            height: 100%;
            background: linear-gradient(90deg, var(--green), var(--cyan));
            border-radius: 3px;
            transition: width 0.4s ease;
            box-shadow: 0 0 10px rgba(34, 230, 164, 0.5);
        }
        .succ-bar-inner.warn { background: linear-gradient(90deg, var(--amber), #ff8a4d); box-shadow: 0 0 10px rgba(255,184,77,0.5); }
        .succ-bar-inner.bad  { background: linear-gradient(90deg, var(--red), #ff3d5f); box-shadow: 0 0 10px rgba(255,85,119,0.5); }

        /* Error chips */
        .err-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            padding-top: 8px;
            border-top: 1px dashed var(--glass-border);
            min-height: 28px;
        }
        .err-chip {
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 10.5px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 5px;
            letter-spacing: 0.3px;
            white-space: nowrap;
        }
        .err-chip.td {
            background: var(--red-dim);
            color: var(--red);
            border: 1px solid rgba(255, 85, 119, 0.45);
        }
        .err-chip.bd {
            background: var(--amber-dim);
            color: var(--amber);
            border: 1px solid rgba(255, 184, 77, 0.45);
        }
        .err-chip.ok {
            background: var(--green-dim);
            color: var(--green);
            border: 1px solid rgba(34, 230, 164, 0.3);
            font-family: inherit;
        }

        /* ==================== STATES ==================== */
        .state {
            grid-column: 1 / -1;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--text-2);
            min-height: 200px;
        }
        .state .ico { font-size: 40px; opacity: 0.35; margin-bottom: 12px; }
        .state .ttl { font-size: 14px; font-weight: 700; color: var(--text-1); margin-bottom: 4px; }
        .state .sub { font-size: 12px; color: var(--text-3); }

        .loader-spin {
            width: 44px; height: 44px;
            border: 4px solid rgba(79, 140, 255, 0.15);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin-bottom: 16px;
        }

        /* ==================== TOAST ==================== */
        .toast {
            position: fixed;
            bottom: 24px; right: 24px;
            padding: 12px 20px;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-left: 4px solid var(--green);
            border-radius: 10px;
            color: var(--text-0);
            font-size: 13px;
            font-weight: 700;
            backdrop-filter: blur(20px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.5);
            z-index: 9999;
            animation: slideIn 0.25s ease;
        }
        .toast.err { border-left-color: var(--red); }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* ==================== RESPONSIVE ==================== */
        @media (max-width: 1500px) {
            .kpis { grid-template-columns: repeat(3, 1fr); }
            .main { grid-template-rows: 200px 1fr; }
        }
        @media (max-width: 1100px) {
            .panels { grid-template-columns: 1fr; }
            .main { grid-template-rows: auto 1fr; overflow-y: auto; }
            .panel-body { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
        }
        @media (max-width: 700px) {
            .kpis { grid-template-columns: repeat(2, 1fr); }
            .main { padding: 10px; }
            .header { padding: 0 12px; }
        }
    </style>
</head>
<body>

<div class="app">

    <!-- ================= HEADER ================= -->
    <div class="header">
        <div class="logo">
            <div class="logo-mark">&#128200;</div>
            IPO Monitor
            <span class="logo-pill"><span class="pulse-dot"></span> LIVE</span>
        </div>

        <div class="hdr-spacer"></div>

        <div class="hdr-stat">
            <span class="dot g"></span> Healthy <span class="num green" id="hdrHealthy">0</span>
        </div>
        <div class="hdr-stat">
            <span class="dot a"></span> BD <span class="num amber" id="hdrWarn">0</span>
        </div>
        <div class="hdr-stat">
            <span class="dot r"></span> TD <span class="num red" id="hdrCrit">0</span>
        </div>

        <div class="countdown-pill">
            <span>&#9202;</span>
            <span>Next</span>
            <span class="cd-val" id="cdVal">--:--</span>
        </div>

        <div class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
            <span class="icon moon">&#9789;</span>
            <span class="icon sun">&#9728;</span>
            <div class="knob"></div>
        </div>

        <button class="btn-refresh" id="refreshBtn" onclick="refreshNow()" title="Refresh now">&#8635;</button>
    </div>

    <!-- ================= MAIN ================= -->
    <div class="main">

        <!-- KPI ROW -->
        <div class="kpis">
            <div class="kpi green" id="kpiApiNHits">
                <div class="kpi-label">NSE/INB Hits</div>
                <div class="kpi-value" id="kpiApiNHitsVal">—</div>
                <div class="kpi-sub" id="kpiApiNHitsSub">Routing services</div>
            </div>
            <div class="kpi green" id="kpiApiNTD">
                <div class="kpi-label">NSE/INB TD%</div>
                <div class="kpi-value" id="kpiApiNTDVal">—</div>
                <div class="kpi-sub" id="kpiApiNTDSub">Technical decline</div>
            </div>
            <div class="kpi green" id="kpiApiBHits">
                <div class="kpi-label">BSE Hits</div>
                <div class="kpi-value" id="kpiApiBHitsVal">—</div>
                <div class="kpi-sub" id="kpiApiBHitsSub">IPO_ORDER service</div>
            </div>
            <div class="kpi green" id="kpiApiBTD">
                <div class="kpi-label">BSE TD%</div>
                <div class="kpi-value" id="kpiApiBTDVal">—</div>
                <div class="kpi-sub" id="kpiApiBTDSub">Technical decline</div>
            </div>
            <div class="kpi green" id="kpiBackendHits">
                <div class="kpi-label">Backend Hits</div>
                <div class="kpi-value" id="kpiBackendHitsVal">—</div>
                <div class="kpi-sub" id="kpiBackendHitsSub">NSE · BSE · INB Auth</div>
            </div>
            <div class="kpi green" id="kpiBackendTD">
                <div class="kpi-label">Backend TD%</div>
                <div class="kpi-value" id="kpiBackendTDVal">—</div>
                <div class="kpi-sub" id="kpiBackendTDSub">Technical decline</div>
            </div>
        </div>

        <!-- PANELS (NSE/INB → BSE → BACKEND) -->
        <div class="panels">

            <!-- 1. NSE/INB -->
            <div class="panel">
                <div class="panel-head">
                    <div class="ph-icon blue">&#128225;</div>
                    <div class="ph-text">
                        <div class="ph-title">API LOG · NSE/INB</div>
                        <div class="ph-sub">Routing Services</div>
                    </div>
                    <div class="ph-badge" id="apiNBadge">—</div>
                </div>
                <div class="panel-body" id="apiNBody">
                    <div class="state">
                        <div class="loader-spin"></div>
                        <div class="ttl">Loading NSE/INB data...</div>
                    </div>
                </div>
            </div>

            <!-- 2. BSE -->
            <div class="panel">
                <div class="panel-head">
                    <div class="ph-icon purple">&#128226;</div>
                    <div class="ph-text">
                        <div class="ph-title">API LOG · BSE</div>
                        <div class="ph-sub">BSE IPO_ORDER</div>
                    </div>
                    <div class="ph-badge" id="apiBBadge">—</div>
                </div>
                <div class="panel-body" id="apiBBody">
                    <div class="state">
                        <div class="loader-spin"></div>
                        <div class="ttl">Loading BSE data...</div>
                    </div>
                </div>
            </div>

            <!-- 3. BACKEND (last) -->
            <div class="panel">
                <div class="panel-head">
                    <div class="ph-icon green">&#9881;</div>
                    <div class="ph-text">
                        <div class="ph-title">BACKEND LOG</div>
                        <div class="ph-sub">IPO Auth · NSE + BSE + INB</div>
                    </div>
                    <div class="ph-badge" id="backendBadge">—</div>
                </div>
                <div class="panel-body" id="backendBody">
                    <div class="state">
                        <div class="loader-spin"></div>
                        <div class="ttl">Loading backend data...</div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<script>
/* ============================================================
 * IPO MONITORING DASHBOARD — v7.0
 * Theme toggle, Scroll bars, TD red / BD yellow, Smart sorting
 * ============================================================ */

var REFRESH_INTERVAL_SEC = 300;
var secondsLeft = 0;
var countdownTimer = null;
var isRefreshing = false;

/* ============ THEME ============ */
(function initTheme() {
    try {
        var saved = localStorage.getItem('ipo_theme');
        if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
        }
    } catch(e) {}
})();

function toggleTheme() {
    var current = document.documentElement.getAttribute('data-theme') || 'dark';
    var next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('ipo_theme', next); } catch(e) {}
    toast('Switched to ' + next + ' mode');
}

/* ============ COUNTDOWN ============ */
function startCountdown() {
    if (countdownTimer) clearInterval(countdownTimer);
    secondsLeft = REFRESH_INTERVAL_SEC;
    renderCountdown();
    countdownTimer = setInterval(function() {
        secondsLeft--;
        if (secondsLeft <= 0) { secondsLeft = REFRESH_INTERVAL_SEC; refreshNow(); }
        renderCountdown();
    }, 1000);
}

function stopCountdown() {
    if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
}

function renderCountdown() {
    var el = document.getElementById('cdVal');
    if (!el) return;
    if (isRefreshing) {
        el.textContent = '...';
        el.style.color = 'var(--amber)';
        return;
    }
    el.style.color = '';
    var m = Math.floor(secondsLeft / 60);
    var s = secondsLeft % 60;
    el.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
}

/* ============ REFRESH ============ */
function refreshNow() {
    if (isRefreshing) return;
    isRefreshing = true;
    stopCountdown();
    renderCountdown();

    var btn = document.getElementById('refreshBtn');
    btn.classList.add('spinning');
    btn.disabled = true;

    showState('apiNBody', 'Loading NSE/INB data...');
    showState('apiBBody', 'Loading BSE data...');
    showState('backendBody', 'Loading backend data...');

    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'ipo-monitor.jsp?ajax=fetch&_=' + Date.now(), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        btn.classList.remove('spinning');
        btn.disabled = false;
        isRefreshing = false;

        if (xhr.status !== 200) {
            toast('HTTP ' + xhr.status + ' — refresh failed', true);
            startCountdown();
            renderCountdown();
            return;
        }
        try {
            var data = JSON.parse(xhr.responseText);
            renderAll(data);
            toast('Data refreshed');
        } catch(e) {
            toast('Parse error: ' + e.message, true);
            console.error(e);
        }
        startCountdown();
        renderCountdown();
    };
    xhr.send();
}

function showState(id, text) {
    var el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = '<div class="state">' +
                       '<div class="loader-spin"></div>' +
                       '<div class="ttl">' + escapeHtml(text) + '</div>' +
                   '</div>';
}

/* ============ RENDER ALL ============ */
function renderAll(data) {
    var s1 = renderPanel(data.API_NSE_INB, 'apiNBody', 'apiNBadge');
    var s2 = renderPanel(data.API_BSE, 'apiBBody', 'apiBBadge');
    var s3 = renderPanel(data.BACKEND_LOG, 'backendBody', 'backendBadge');
    updateKpis(data);
    document.getElementById('hdrHealthy').textContent = s1.healthy + s2.healthy + s3.healthy;
    document.getElementById('hdrWarn').textContent = s1.bd + s2.bd + s3.bd;
    document.getElementById('hdrCrit').textContent = s1.td + s2.td + s3.td;
}

/* ============ PANEL RENDER (with sorting) ============ */
function renderPanel(qr, bodyId, badgeId) {
    var body = document.getElementById(bodyId);
    var badge = document.getElementById(badgeId);
    var stats = { healthy: 0, td: 0, bd: 0 };

    if (!qr || !qr.success) {
        body.innerHTML = '<div class="state">' +
                            '<div class="ico">&#9888;</div>' +
                            '<div class="ttl">Could not load data</div>' +
                            '<div class="sub">' + escapeHtml(qr ? qr.message : 'Unknown error') + '</div>' +
                         '</div>';
        badge.textContent = 'ERROR';
        return stats;
    }

    badge.textContent = qr.rows.length + ' IPs · ' + qr.executionTimeMs + ' ms';

    if (!qr.rows || qr.rows.length === 0) {
        body.innerHTML = '<div class="state">' +
                            '<div class="ico">&#128269;</div>' +
                            '<div class="ttl">No traffic in window</div>' +
                            '<div class="sub">Widen the time window if needed</div>' +
                         '</div>';
        return stats;
    }

    var cols = qr.columns;
    var ipCol   = findCol(cols, ['SYS_IP', 'EXP_IP', 'IP']);
    var apiCol  = findCol(cols, ['API_NAME']);
    var hitsCol = findCol(cols, ['TOTAL_HITS', 'HITS']);
    var succCol = findCol(cols, ['SUCCESS']);
    var tdCol   = findCol(cols, ['TD']);
    var tdpCol  = findCol(cols, ['TD_PERCENT']);
    var bdCol   = findCol(cols, ['BD']);
    var bdpCol  = findCol(cols, ['BD_PERCENT']);

    var errCols = [];
    cols.forEach(function(c) {
        if (c === ipCol || c === apiCol || c === hitsCol || c === succCol ||
            c === tdCol || c === tdpCol || c === bdCol || c === bdpCol) return;
        errCols.push(c);
    });

    // === PRE-COMPUTE per row + sorting ===
    var rows = qr.rows.map(function(row) {
        var ip    = row[ipCol] || '-';
        var api   = row[apiCol] || '';
        var hits  = parseInt(row[hitsCol] || 0);
        var succ  = parseInt(row[succCol] || 0);
        var td    = parseInt(row[tdCol] || 0);
        var tdPct = parseFloat(row[tdpCol] || 0);
        var bd    = parseInt(row[bdCol] || 0);
        var bdPct = parseFloat(row[bdpCol] || 0);

        var category = 'healthy';
        if (td > 0 || tdPct > 0) category = 'critical-td';
        else if (bd > 0 || bdPct > 0) category = 'critical-bd';

        var errChips = [];
        errCols.forEach(function(c) {
            var v = parseInt(row[c] || 0);
            if (v > 0) {
                var isBD = (c === 'BD' || c === 'BD_NEW');
                errChips.push('<span class="err-chip ' + (isBD ? 'bd' : 'td') + '">' + escapeHtml(c) + ' · ' + v + '</span>');
            }
        });

        return {
            ip: ip, api: api, hits: hits, succ: succ,
            td: td, tdPct: tdPct, bd: bd, bdPct: bdPct,
            category: category, errChips: errChips
        };
    });

    // Sort priority: critical-td (0) > critical-bd (1) > healthy (2)
    // Within same category: higher hits first
    rows.sort(function(a, b) {
        var priority = { 'critical-td': 0, 'critical-bd': 1, 'healthy': 2 };
        var pa = priority[a.category], pb = priority[b.category];
        if (pa !== pb) return pa - pb;
        return b.hits - a.hits;
    });

    var html = '';
    rows.forEach(function(r) {
        if (r.category === 'critical-td') stats.td++;
        else if (r.category === 'critical-bd') stats.bd++;
        else stats.healthy++;

        var succPct = r.hits > 0 ? (r.succ * 100 / r.hits) : 100;
        var succCls = succPct >= 99 ? 'green' : succPct >= 95 ? 'amber' : 'red';
        var barCls  = succPct >= 99 ? '' : succPct >= 95 ? 'warn' : 'bad';

        var tdCls = r.tdPct <= 1 ? 'green' : r.tdPct <= 5 ? 'amber' : 'red';
        var bdCls = r.bdPct <= 1 ? 'green' : r.bdPct <= 5 ? 'amber' : 'red';

        // For TD card → red colors; for BD card → yellow colors
        var tdColorCls = r.category === 'critical-td' ? 'red' : (r.tdPct > 0 ? 'red' : 'green');
        var bdColorCls = r.category === 'critical-bd' ? 'amber' : (r.bdPct > 0 ? 'amber' : 'green');

        var badgeText = r.category === 'critical-td' ? 'TD' : r.category === 'critical-bd' ? 'BD' : 'OK';

        var shortApi = r.api.replace('thirdParty', '').replace('_sys', '').replace('_expDS', '').replace('GenericRouting', '');
        if (shortApi.length > 26) shortApi = shortApi.substring(0, 24) + '…';

        html += '<div class="ip-card ' + r.category + '">';

        html +=   '<div class="ip-head">';
        html +=     '<div class="ip-addr">' + escapeHtml(r.ip) + '</div>';
        html +=     '<div class="ip-badge ' + r.category + '">' + badgeText + '</div>';
        html +=   '</div>';

        if (shortApi) html += '<div class="ip-api">' + escapeHtml(shortApi) + '</div>';

        html +=   '<div class="ip-metrics">';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">Hits</div><div class="ip-metric-value">' + r.hits + '</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">Success</div><div class="ip-metric-value ' + succCls + '">' + r.succ + '</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">TD%</div><div class="ip-metric-value ' + tdColorCls + '">' + r.tdPct.toFixed(2) + '%</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">BD%</div><div class="ip-metric-value ' + bdColorCls + '">' + r.bdPct.toFixed(2) + '%</div></div>';
        html +=   '</div>';

        html +=   '<div class="succ-bar"><div class="succ-bar-inner ' + barCls + '" style="width:' + Math.min(100, Math.max(2, succPct)).toFixed(1) + '%"></div></div>';

        html +=   '<div class="err-chips">';
        if (r.errChips.length > 0) html += r.errChips.join('');
        else html += '<span class="err-chip ok">&#10003; No errors</span>';
        html +=   '</div>';

        html += '</div>';
    });

    body.innerHTML = html;
    return stats;
}

function findCol(cols, names) {
    for (var i = 0; i < names.length; i++) {
        var n = names[i].toUpperCase();
        for (var j = 0; j < cols.length; j++) {
            if (cols[j].toUpperCase() === n) return cols[j];
        }
    }
    return null;
}

/* ============ KPIS ============ */
function updateKpis(data) {
    var b = data.BACKEND_LOG, n = data.API_NSE_INB, x = data.API_BSE;

    function agg(qr) {
        var hits = 0, tdSum = 0, count = 0;
        if (qr && qr.success && qr.rows) {
            qr.rows.forEach(function(r) {
                hits += parseInt(r.TOTAL_HITS || 0);
                tdSum += parseFloat(r.TD_PERCENT || 0);
                count++;
            });
        }
        return { hits: hits, tdAvg: count > 0 ? (tdSum / count) : null, ips: count };
    }

    var bA = agg(b), nA = agg(n), xA = agg(x);

    setKpi('kpiApiNHits', 'kpiApiNHitsVal', 'kpiApiNHitsSub', nA.hits, nA.ips + ' IPs', null);
    setKpi('kpiApiNTD',   'kpiApiNTDVal',   'kpiApiNTDSub',   null, null, nA.tdAvg);
    setKpi('kpiApiBHits', 'kpiApiBHitsVal', 'kpiApiBHitsSub', xA.hits, xA.ips + ' IPs', null);
    setKpi('kpiApiBTD',   'kpiApiBTDVal',   'kpiApiBTDSub',   null, null, xA.tdAvg);
    setKpi('kpiBackendHits', 'kpiBackendHitsVal', 'kpiBackendHitsSub', bA.hits, bA.ips + ' IPs', null);
    setKpi('kpiBackendTD',   'kpiBackendTDVal',   'kpiBackendTDSub',   null, null, bA.tdAvg);
}

function setKpi(wrapperId, valId, subId, hits, hitsSub, tdPct) {
    var wrap = document.getElementById(wrapperId);
    var val  = document.getElementById(valId);
    var sub  = document.getElementById(subId);
    if (!wrap || !val) return;

    wrap.classList.remove('green', 'amber', 'red');
    val.classList.remove('green', 'amber', 'red');

    if (hits !== null && hits !== undefined) {
        val.textContent = hits.toLocaleString();
        val.classList.add('green');
        wrap.classList.add('green');
        if (sub && hitsSub) sub.textContent = hitsSub;
    } else if (tdPct !== null && tdPct !== undefined && !isNaN(tdPct)) {
        val.textContent = tdPct.toFixed(2) + '%';
        if (tdPct <= 1) { val.classList.add('green'); wrap.classList.add('green'); }
        else if (tdPct <= 5) { val.classList.add('amber'); wrap.classList.add('amber'); }
        else { val.classList.add('red'); wrap.classList.add('red'); }
        if (sub) sub.textContent = tdPct <= 1 ? 'Excellent' : tdPct <= 5 ? 'Moderate' : 'High decline';
    } else {
        val.textContent = '—';
        wrap.classList.add('green');
        val.classList.add('green');
    }
}

/* ============ HELPERS ============ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function() {
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function() { el.remove(); }, 320);
    }, 2200);
}

/* ============ INIT ============ */
window.addEventListener('load', function() {
    refreshNow();
});
</script>

</body>
</html>
