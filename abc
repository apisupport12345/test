        for (Map.Entry<String, List<String>> entry : criticalServersByBroker.entrySet()) {
            if (brokerIndex > 0) jsBrokerMap.append(",");
            String broker = entry.getKey().replace("'", "\\'").replace("\"", "&quot;");
            jsBrokerMap.append("\"").append(broker).append("\":[");
            List<String> ips = entry.getValue();
            for (int i = 0; i < ips.size(); i++) {
                if (i > 0) jsBrokerMap.append(",");
                String ip = ips.get(i).replace("'", "\\'").replace("\"", "&quot;");
                jsBrokerMap.append("\"").append(ip).append("\"");
            }
            jsBrokerMap.append("]");
            brokerIndex++;
        }
