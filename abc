        .tb-clear {
            background: #262a33;
            color: #e4e6eb;
            border-color: #3a3f4b;
        }
        .tb-clear:hover { background: #2f333d; }

        .tb-close {
            background: #262a33;
            color: #ef4444;
            border-color: #3a3f4b;
        }
        .tb-close:hover { background: #3a2020; color: #f87171; }

        .tb-export {
            background: #262a33;
            color: #4ade80;
            border-color: #3a3f4b;
        }
        .tb-export:hover { background: #1e3a2a; color: #6ee7b7; }
        .tb-export:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
        }

        .toolbar-spacer { flex: 1; }
        .status-chip {
            padding: 5px 12px;
            border-radius: 12px;
            font-size: 11.5px;
            font-weight: 700;
            background: #262a33;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }
        .status-chip.ok { background: #1e3a2a; color: #4ade80; }
        .status-chip.loading { background: #3a3020; color: #fbbf24; }
        .status-chip.err { background: #3a2020; color: #f87171; }

        /* Editor */
        .editor-wrap {
            padding: 12px 16px;
            background: #181a1f;
        }
        .editor-box {
            border: 1px solid #2f333d;
            border-radius: 8px;
            background: #14161a;
            overflow: hidden;
        }
        .editor-box:focus-within {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
        }
        textarea.sql {
            width: 100%;
            min-height: 220px;
            max-height: 460px;
            padding: 14px 18px;
            background: #14161a;
            color: #e4e6eb;
            border: none;
            outline: none;
            resize: vertical;
            font-family: 'JetBrains Mono', 'Consolas', 'Monaco', monospace;
            font-size: 14px;
            line-height: 1.65;
            caret-color: #3b82f6;
            tab-size: 4;
            display: block;
        }
        textarea.sql::placeholder { color: #4b5159; }

        /* Results */
        .results {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-top: 1px solid #2f333d;
            background: #14161a;
            min-height: 0;
        }
        .res-bar {
            padding: 8px 16px;
            background: #23262e;
            border-bottom: 1px solid #2f333d;
            display: flex;
            align-items: center;
            gap: 18px;
            font-size: 12.5px;
            flex-wrap: wrap;
        }
        .res-bar .label {
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #6b7280;
            font-weight: 700;
            margin-right: 4px;
        }
        .res-stat { color: #a8adb8; }
        .res-stat b { color: #e4e6eb; font-weight: 600; }
        .res-time.ok   { color: #4ade80; font-weight: 700; }
        .res-time.warn { color: #fbbf24; font-weight: 700; }
        .res-time.slow { color: #f87171; font-weight: 700; }

        .res-body {
            flex: 1;
            overflow: auto;
            position: relative;
        }
        .res-body::-webkit-scrollbar { width: 12px; height: 12px; }
        .res-body::-webkit-scrollbar-track { background: #14161a; }
        .res-body::-webkit-scrollbar-thumb {
            background: #3a3f4b;
            border-radius: 6px;
            border: 3px solid #14161a;
        }
        .res-body::-webkit-scrollbar-thumb:hover { background: #4a505c; }

        table.data {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            font-family: 'JetBrains Mono', 'Consolas', monospace;
        }
        table.data th {
            background: #1f2229;
            color: #93c5fd;
            padding: 10px 14px;
            text-align: left;
            position: sticky;
            top: 0;
            z-index: 2;
            font-weight: 700;
            font-size: 12.5px;
            white-space: nowrap;
            border-bottom: 2px solid #2f333d;
            border-right: 1px solid #262a33;
            letter-spacing: 0.3px;
        }
        table.data td {
            padding: 8px 14px;
            border-bottom: 1px solid #1f2229;
            border-right: 1px solid #1f2229;
            color: #d1d5db;
            max-width: 450px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        table.data tr:nth-child(even) td { background: #171a1f; }
        table.data tr:hover td { background: #1e293b; }
        table.data td.row-no {
            color: #6b7280;
            background: #14161a !important;
            width: 60px;
            text-align: right;
            font-size: 12px;
        }
        .null-cell { color: #4b5159; font-style: italic; }

        .alert {
            padding: 14px 20px;
            margin: 14px 20px;
            border-radius: 6px;
            font-size: 13.5px;
        }
        .alert-ok {
            background: #142a1e;
            border-left: 4px solid #16a34a;
            color: #86efac;
        }
        .alert-err {
            background: #2a1414;
            border-left: 4px solid #ef4444;
            color: #fca5a5;
            font-family: 'JetBrains Mono', monospace;
            white-space: pre-wrap;
            font-size: 12.5px;
        }

        .placeholder {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            height: 100%;
            color: #4b5159;
            gap: 12px;
            padding: 40px;
            text-align: center;
        }
        .placeholder .ph-icon { font-size: 42px; opacity: 0.5; }
        .placeholder .ph-title { font-size: 15px; color: #6b7280; }
        .placeholder .ph-sub { font-size: 13px; color: #4b5159; }

        /* Status bar */
        .status {
            grid-area: status;
            background: #23262e;
            color: #8b909a;
            display: flex;
            align-items: center;
            font-size: 12.5px;
            padding: 0 18px;
            gap: 22px;
            border-top: 1px solid #2f333d;
        }
        .status .st-item { display: flex; align-items: center; gap: 7px; }
        .status .st-item b { color: #e4e6eb; font-weight: 600; }
        .status .right { margin-left: auto; display: flex; gap: 22px; }
        .st-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: #4ade80;
        }

        /* Autocomplete */
        .ac-box {
            position: fixed;
            background: #23262e;
            border: 1px solid #3a3f4b;
            border-radius: 6px;
            box-shadow: 0 12px 36px rgba(0,0,0,0.7);
            max-height: 300px;
            overflow-y: auto;
            z-index: 9999;
            display: none;
            min-width: 320px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
        }
        .ac-box::-webkit-scrollbar { width: 8px; }
        .ac-box::-webkit-scrollbar-thumb { background: #3a3f4b; border-radius: 4px; }

        .ac-item {
            padding: 7px 14px;
            cursor: pointer;
            color: #d1d5db;
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: center;
            border-bottom: 1px solid #1f2229;
        }
        .ac-item:last-child { border-bottom: none; }
        .ac-item:hover, .ac-item.active {
            background: #1e3a5f;
            color: #fff;
        }
        .ac-tag {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 8px;
            font-weight: 700;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        .tag-KEYWORD { background: #3b2f4a; color: #c084fc; }
        .tag-SCHEMA  { background: #1e3a5f; color: #60a5fa; }
        .tag-TABLE   { background: #1e3a2a; color: #4ade80; }
        .tag-COLUMN  { background: #3a3020; color: #fbbf24; }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 44px; right: 24px;
            background: #23262e;
            border-left: 4px solid #16a34a;
            color: #e4e6eb;
            padding: 14px 20px;
            border-radius: 6px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
            font-size: 13.5px;
            z-index: 10001;
            animation: slideIn 0.22s ease;
            max-width: 380px;
            font-weight: 500;
        }
        .toast.err { border-left-color: #ef4444; }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }
    </style>
</head>
<body>

<div class="app">

    <!-- ========== HEADER ========== -->
    <div class="header">
        <div class="brand">
            <div class="brand-mark">Q</div>
            Query Runner
            <span class="brand-tag">v2.0</span>
        </div>
        <div class="header-spacer"></div>
        <div class="conn-status">
            <span class="conn-dot"></span>
            CONNECTED
        </div>
        <button class="btn-primary" onclick="newTab()">+ New Tab</button>
    </div>

    <!-- ========== SIDEBAR ========== -->
    <div class="sidebar">
        <div class="sidebar-title">Saved Queries</div>
        <div class="search-wrap">
            <input type="text" class="search-input" id="qSearch" placeholder="Search queries...">
        </div>
        <div class="tree" id="tree">

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> Gen 5 — Error Summary
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">
                        Broker-wise error count (last 5 min)
                        <script type="text/plain" class="q-sql">SELECT broker_eg, broker_name, ERROR_CODE, ERROR_DESCRIPTION, url, api_name,
COUNT(*) AS CNT FROM EISAPP.API_LOG WHERE Request_date_time>=SYSDATE - INTERVAL '05' MINUTE and
(substr(error_code,3,3) in ('001','002','007','051','014','111','570','569','052','005','077','003','017','015') and error_code<>'00014' OR error_code in ('401','500'))
and ERROR_DESCRIPTION is not null and error_description not like '%No active transaction found, please do check GCC machine and retry%'
GROUP BY broker_eg,broker_name, ERROR_CODE, error_description,url,api_name
ORDER BY CNT DESC;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> Daily Use (Last 10 min)
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">api_log — recent
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where
request_date_time >= sysdate - interval '10' minute
order by request_date_time desc;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">api_log — error summary
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.api_log where
request_date_time >= sysdate - interval '10' minute
GROUP by error_code, error_description;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log — recent
                        <script type="text/plain" class="q-sql">select * from eisapp.BACKEND_log where
request_date_time >= sysdate - interval '10' minute
order by request_date_time desc;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log — error summary
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.BACKEND_log where
request_date_time >= sysdate - interval '10' minute
GROUP by error_code, error_description;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> URN Search
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_details where URN in('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">orch_api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">orch_api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_details where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_details where URN in ('');</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> URL / Mappers
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">source_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.source_mapper;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">url_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.url_mapper;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">urn_details
                        <script type="text/plain" class="q-sql">select * from EISAPP.urn_details;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">cache_details
                        <script type="text/plain" class="q-sql">SELECT * FROM EISAPP.cache_details;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">Find API (NOMINEE)
                        <script type="text/plain" class="q-sql">select distinct api_name from eisapp.api_log where UPPER(api_name) like '%NOMINEE%';</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> API Log — TD/BD Summary
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">API-wise TD/BD (last 60 min)
                        <script type="text/plain" class="q-sql">select trim(API_NAME),
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) As "SI001",
SUM(CASE WHEN substr(error_code,3,3) ='002'then 1 else 0 end) As "002",
SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) As "SI007",
SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) As "SI051",
SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) AS "014",
SUM(CASE WHEN error_code ='SI569' then 1 else 0 end) As "SI569",
SUM(CASE WHEN error_code ='SI570' then 1 else 0 end) As "SI570",
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT
from eisapp.api_log where
request_date_time>=SYSDATE - INTERVAL '60' minute
GROUP BY trim(API_NAME)
ORDER BY TD_PERCENT DESC;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">Backend-wise TD/BD (last 60 min)
                        <script type="text/plain" class="q-sql">select TRIM(api_name),
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN error_code is null THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) As "SI001",
SUM(CASE WHEN substr(error_code,3,3) ='002' then 1 else 0 end) As "002",
SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) As "SI007",
SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) As "SI051",
SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) AS "014",
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT
from eisapp.BACKEND_LOG  WHERE
REQUEST_DATE_TIME>=SYSDATE - INTERVAL '60' minute
GROUP BY TRIM(api_name)
ORDER BY TD_PERCENT DESC;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> SI Monitoring (SBISI)
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">SI_TRANS_DB — error summary (last 10 min)
                        <script type="text/plain" class="q-sql">SELECT function_name,ERROR_CODE, ERROR_DESC, COUNT(*) AS CNT FROM SBISI.SI_TRANS_DB
WHERE SUBSTR(error_code,1,2) = 'SI'
and req_time>=SYSDATE - INTERVAL '10' MINUTE
GROUP BY ERROR_CODE,ERROR_DESC,function_name ORDER BY CNT DESC;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">EKYC_log — TD% (SI207, SI392)
                        <script type="text/plain" class="q-sql">select COUNT(1) as TOTAL_HITS,
SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN ERROR_CODE IS NOT NULL AND error_code NOT IN ('SI392','SI207') THEN 1 ELSE 0 END) "BD",
SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END) "SI392",
ROUND((SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI392%",
SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END) "SI207",
ROUND((SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END)/COUNT(1))*100,2) "TD%"
from SBISI.EKYC_log where resp_date_time >=sysdate - interval '15' minute;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">EKYC (SI392) — recent
                        <script type="text/plain" class="q-sql">select *  from SBISI.ekyc_log where
 error_code = 'SI392'
and req_date_time>=SYSDATE - INTERVAL '10' MINUTE  order by req_date_time desc;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> Performance / Latency
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">EXP IP response-time buckets (last 2 min)
                        <script type="text/plain" class="q-sql">SELECT exp_ip,COUNT(1),
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))between 0.1 AND 0.5 then 1 else 0 end ) as "between 100ms-500ms" ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC
FROM EISAPP.API_LOG WHERE broker_name = 'LOGGING_EXP' and
request_date_time>=SYSDATE-INTERVAL '02' MINUTE
group by exp_ip;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">SYS latency — backend vs orch (last 2 min)
                        <script type="text/plain" class="q-sql">SELECT b.sys_ip,COUNT(1),
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC
FROM  EISAPP.backend_log b , EISAPP.orch_api_log a WHERE a.urn=b.urn and b.sys_broker = 'LOGGING_SYS' and
b.creation_date_time>=SYSDATE-INTERVAL '02' MINUTE
group by b.sys_ip;</script>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ========== MAIN ========== -->
    <div class="main">
        <div class="tabbar" id="tabbar">
            <div class="tab-add" onclick="newTab()" title="New Tab (Ctrl+T)">+</div>
        </div>
        <div class="tab-content" id="tabContent"></div>
    </div>

    <!-- ========== STATUS BAR ========== -->
    <div class="status">
        <div class="st-item">
            <span class="st-dot"></span>
            <b id="stDb">IIB DB (EISAPP)</b>
        </div>
        <div class="st-item" id="stTab">Tab: —</div>
        <div class="right">
            <div class="st-item" id="stLast">Last exec: —</div>
            <div class="st-item" id="stCount">1 tab</div>
        </div>
    </div>

</div>

