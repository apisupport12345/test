package com.cron;

import java.math.BigDecimal;
import java.sql.*;
import java.sql.Date;
import java.text.SimpleDateFormat;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.Locale;
import java.util.concurrent.*;

import com.jdbc.DBUtilityAuto;

public class HourlyQueryCronEISSBIDATA2 {

    private static final int QUERY_TIMEOUT_SECONDS = 1800;
    private static final int FETCH_SIZE = 1000;
    private static final int THREAD_POOL_SIZE = 4;
    private static final int MAX_RETRIES = 3;
    private static final long RETRY_DELAY_MS = 5000;

    private static final int QUERY_START = 0;
    private static final int QUERY_END   = 6;

    private static final DateTimeFormatter LOG_TIME_FMT =
            DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss", Locale.ENGLISH);

    private static String nowLabel() {
        return "[" + LocalDateTime.now().format(LOG_TIME_FMT) + "]";
    }

    private static String sec(long ms) {
        return String.format(Locale.ENGLISH, "%.2f sec", ms / 1000.0);
    }

    private static String flagStatus = "DR";

    static {
        Connection conn = null;
        Statement smt = null;
        ResultSet rs = null;
        try {
            conn = DBUtilityAuto.getReportDBConnection();
            if (conn == null || conn.isClosed()) {
                throw new SQLException("Report DB connection unavailable");
            }
            smt = conn.createStatement();
            rs = smt.executeQuery("SELECT FLAG FROM connection_master");
            if (rs.next()) {
                String f = rs.getString("FLAG");
                if (f != null && !f.trim().isEmpty()) {
                    flagStatus = f.trim();
                }
            }
            System.out.println(nowLabel() + " Flag status initialized: " + flagStatus);
        } catch (Exception e) {
            System.out.println(nowLabel()
                    + " Flag not found! Using default DR. Error: " + e.getMessage());
        } finally {
            try { if (rs != null) rs.close(); } catch (SQLException e) {}
            try { if (smt != null) smt.close(); } catch (SQLException e) {}
            try { if (conn != null) conn.close(); } catch (SQLException e) {}
        }
    }

    public static void main(String[] args) {
        java.util.Date startTime, endTime;
        if (args.length >= 2) {
            try {
                SimpleDateFormat sdf =
                        new SimpleDateFormat("dd-MMM-yyyy HH:mm:ss", Locale.ENGLISH);
                sdf.setLenient(false);
                startTime = sdf.parse(args[0]);
                endTime = sdf.parse(args[1]);
                if (!startTime.before(endTime)) {
                    System.err.println("startTime must be before endTime");
                    return;
                }
            } catch (Exception e) {
                System.err.println("Invalid date format. Use dd-MMM-yyyy HH:mm:ss");
                return;
            }
        } else {
            Calendar cal = Calendar.getInstance();
            cal.set(Calendar.MINUTE, 0);
            cal.set(Calendar.SECOND, 0);
            cal.set(Calendar.MILLISECOND, 0);
            endTime = cal.getTime();
            cal.add(Calendar.HOUR_OF_DAY, -1);
            startTime = cal.getTime();
        }

        System.out.println(nowLabel()
                + " Running cron (Part 2, queries 0-6) for window: "
                + startTime + " to " + endTime);

        final String partition = getPartition(startTime);
        System.out.println(nowLabel() + " Using partition: " + partition);

        ExecutorService executor = Executors.newFixedThreadPool(THREAD_POOL_SIZE);
        List<Future<?>> futures = new ArrayList<>();

        long batchStart = System.currentTimeMillis();

        for (int queryIndex = QUERY_START; queryIndex <= QUERY_END; queryIndex++) {
            final int qIdx = queryIndex;
            Future<?> future = executor.submit(() -> {
                String threadName = Thread.currentThread().getName();
                System.out.println("[" + threadName + "] " + nowLabel()
                        + " Starting query " + qIdx);
                int attempt = 1;
                boolean success = false;
                while (!success && attempt <= MAX_RETRIES) {
                    long queryStart = System.currentTimeMillis();
                    try {
                        executeAndInsert(qIdx, partition, startTime, endTime);
                        success = true;
                        long queryDuration = System.currentTimeMillis() - queryStart;
                        System.out.println("[" + threadName + "] " + nowLabel()
                                + " Query " + qIdx + " completed successfully in "
                                + sec(queryDuration) + " (attempt " + attempt + ")");
                    } catch (Exception e) {
                        long queryDuration = System.currentTimeMillis() - queryStart;
                        System.err.println("[" + threadName + "] " + nowLabel()
                                + " Attempt " + attempt + " failed for query " + qIdx
                                + " after " + sec(queryDuration) + ": " + e.getMessage());

                        if (isNonRetryable(e)) {
                            System.err.println("[" + threadName + "] " + nowLabel()
                                    + " Query " + qIdx
                                    + " hit a non-retryable error; aborting retries.");
                            e.printStackTrace();
                            break;
                        }

                        if (attempt == MAX_RETRIES) {
                            e.printStackTrace();
                        } else {
                            try {
                                long delay = RETRY_DELAY_MS * attempt;
                                System.out.println("[" + threadName + "] " + nowLabel()
                                        + " Retrying query " + qIdx + " after " + sec(delay));
                                Thread.sleep(delay);
                            } catch (InterruptedException ie) {
                                Thread.currentThread().interrupt();
                                break;
                            }
                        }
                        attempt++;
                    }
                }
                if (!success) {
                    System.err.println("[" + threadName + "] " + nowLabel()
                            + " Query " + qIdx + " failed after "
                            + MAX_RETRIES + " attempts.");
                }
            });
            futures.add(future);
        }

        executor.shutdown();
        try {
            if (!executor.awaitTermination(60, TimeUnit.MINUTES)) {
                executor.shutdownNow();
                System.err.println(nowLabel()
                        + " Some queries did not finish within timeout");
            }
        } catch (InterruptedException e) {
            executor.shutdownNow();
            Thread.currentThread().interrupt();
        }

        long totalTime = System.currentTimeMillis() - batchStart;
        System.out.println(nowLabel() + " All Part 2 queries completed in " + sec(totalTime));
    }

    private static boolean isNonRetryable(Throwable t) {
        Throwable cause = t;
        while (cause != null) {
            if (cause instanceof SQLDataException) return true;
            String msg = cause.getMessage();
            if (msg != null) {
                String m = msg.toUpperCase(Locale.ENGLISH);
                if (m.contains("ORA-01861") || m.contains("ORA-01858")
                        || m.contains("ORA-01843") || m.contains("ORA-01722")
                        || m.contains("ORA-00904") || m.contains("ORA-00942")) {
                    return true;
                }
            }
            cause = cause.getCause();
        }
        return false;
    }

    private static String getPartition(java.util.Date fromDate) {
        Calendar cal = Calendar.getInstance();
        cal.setTime(fromDate);
        String[] months = {"JAN","FEB","MAR","APR","MAY","JUN",
                           "JUL","AUG","SEP","OCT","NOV","DEC"};
        String month = months[cal.get(Calendar.MONTH)];
        String year = String.valueOf(cal.get(Calendar.YEAR)).substring(2);
        return month + "_" + year;
    }

    private static void executeAndInsert(int queryIndex, String partition,
                                         java.util.Date startTime,
                                         java.util.Date endTime) throws Exception {
        String threadName = Thread.currentThread().getName();
        long methodStart = System.currentTimeMillis();

        Connection readConn = null;
        Connection writeConn = null;
        PreparedStatement ps = null;
        ResultSet rs = null;
        PreparedStatement insertStmt = null;
        PreparedStatement deleteStmt = null;

        try {
            long connStart = System.currentTimeMillis();
            readConn = DBUtilityAuto.getIIBDBConnection();
            if (readConn == null || readConn.isClosed()) {
                throw new SQLException("Could not get IIB connection for query " + queryIndex);
            }
            readConn.setAutoCommit(false);
            readConn.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);
            long connDuration = System.currentTimeMillis() - connStart;
            System.out.println("[" + threadName + "] " + nowLabel()
                    + " Query " + queryIndex + " read connection acquired in "
                    + sec(connDuration));

            connStart = System.currentTimeMillis();
            writeConn = DBUtilityAuto.getReportDBConnection();
            if (writeConn == null || writeConn.isClosed()) {
                throw new SQLException("Could not get report connection for query " + queryIndex);
            }
            writeConn.setAutoCommit(false);
            connDuration = System.currentTimeMillis() - connStart;
            System.out.println("[" + threadName + "] " + nowLabel()
                    + " Query " + queryIndex + " report connection acquired in "
                    + sec(connDuration));

            String query = getQuery(queryIndex, partition);
            ps = readConn.prepareStatement(query,
                    ResultSet.TYPE_FORWARD_ONLY, ResultSet.CONCUR_READ_ONLY);
            ps.setFetchSize(FETCH_SIZE);
            ps.setQueryTimeout(QUERY_TIMEOUT_SECONDS);
            setQueryParameters(ps, queryIndex, startTime, endTime);

            long execStart = System.currentTimeMillis();
            rs = ps.executeQuery();
            long execDurationMs = System.currentTimeMillis() - execStart;
            double execDurationSec = execDurationMs / 1000.0;
            System.out.println("[" + threadName + "] " + nowLabel()
                    + " Query " + queryIndex + " SELECT execution took "
                    + sec(execDurationMs));

            ResultSetMetaData meta = rs.getMetaData();
            int colCount = meta.getColumnCount();
            List<String> colNames = new ArrayList<>();
            for (int i = 1; i <= colCount; i++) {
                colNames.add(meta.getColumnName(i).toUpperCase(Locale.ENGLISH));
            }

            List<Map<String, Object>> rows = new ArrayList<>();
            while (rs.next()) {
                Map<String, Object> row = new LinkedHashMap<>();
                for (int i = 1; i <= colCount; i++) {
                    row.put(colNames.get(i - 1), rs.getObject(i));
                }
                rows.add(row);
            }
            System.out.println("[" + threadName + "] " + nowLabel()
                    + " Query " + queryIndex + " fetched " + rows.size() + " rows");

            String tableName = getTableName(queryIndex);
            String deleteSQL = "DELETE FROM " + tableName
                    + " WHERE START_TIME = ? AND END_TIME = ?";
            deleteStmt = writeConn.prepareStatement(deleteSQL);
            deleteStmt.setTimestamp(1, new Timestamp(startTime.getTime()));
            deleteStmt.setTimestamp(2, new Timestamp(endTime.getTime()));
            int deleted = deleteStmt.executeUpdate();
            System.out.println("[" + threadName + "] " + nowLabel()
                    + " Deleted " + deleted + " existing rows from " + tableName);

            StringBuilder insertSQL = new StringBuilder("INSERT INTO " + tableName + " (");
            insertSQL.append("START_TIME, END_TIME, QUERY_DURATION_SEC");
            for (String col : colNames) insertSQL.append(", ").append(col);
            insertSQL.append(") VALUES (?, ?, ?");
            for (int i = 0; i < colCount; i++) insertSQL.append(", ?");
            insertSQL.append(")");

            insertStmt = writeConn.prepareStatement(insertSQL.toString());

            long insertStart = System.currentTimeMillis();
            int rowCount = 0;
            int batchSize = 0;
            final int BATCH_LIMIT = 1000;

            for (Map<String, Object> row : rows) {
                int paramIndex = 1;
                insertStmt.setTimestamp(paramIndex++, new Timestamp(startTime.getTime()));
                insertStmt.setTimestamp(paramIndex++, new Timestamp(endTime.getTime()));
                insertStmt.setDouble(paramIndex++, execDurationSec);

                for (String col : colNames) {
                    Object value = row.get(col);
                    if (value == null) insertStmt.setNull(paramIndex++, Types.NULL);
                    else if (value instanceof BigDecimal) insertStmt.setBigDecimal(paramIndex++, (BigDecimal) value);
                    else if (value instanceof String) insertStmt.setString(paramIndex++, (String) value);
                    else if (value instanceof Timestamp) insertStmt.setTimestamp(paramIndex++, (Timestamp) value);
                    else if (value instanceof java.sql.Date) insertStmt.setTimestamp(paramIndex++, new Timestamp(((java.sql.Date) value).getTime()));
                    else if (value instanceof Integer) insertStmt.setInt(paramIndex++, (Integer) value);
                    else if (value instanceof Long) insertStmt.setLong(paramIndex++, (Long) value);
                    else if (value instanceof Double) insertStmt.setDouble(paramIndex++, (Double) value);
                    else if (value instanceof Float) insertStmt.setFloat(paramIndex++, (Float) value);
                    else if (value instanceof Boolean) insertStmt.setBoolean(paramIndex++, (Boolean) value);
                    else insertStmt.setObject(paramIndex++, value);
                }
                insertStmt.addBatch();
                rowCount++;
                batchSize++;
                if (batchSize >= BATCH_LIMIT) {
                    insertStmt.executeBatch();
                    insertStmt.clearBatch();
                    batchSize = 0;
                }
            }
            if (batchSize > 0) {
                insertStmt.executeBatch();
                insertStmt.clearBatch();
            }

            long insertDuration = System.currentTimeMillis() - insertStart;
            writeConn.commit();

            System.out.println("[" + threadName + "] " + nowLabel()
                    + " Query " + queryIndex + " inserted " + rowCount
                    + " rows into " + tableName
                    + " (insert took " + sec(insertDuration) + ")");

            long totalDuration = System.currentTimeMillis() - methodStart;
            System.out.println("[" + threadName + "] " + nowLabel()
                    + " Query " + queryIndex + " total processing time: "
                    + sec(totalDuration));

        } catch (SQLException e) {
            if (writeConn != null) { try { writeConn.rollback(); } catch (SQLException ex) {} }
            throw e;
        } catch (Exception e) {
            if (writeConn != null) { try { writeConn.rollback(); } catch (SQLException ex) {} }
            throw e;
        } finally {
            try { if (rs != null) rs.close(); } catch (SQLException e) {}
            try { if (ps != null) ps.close(); } catch (SQLException e) {}
            try { if (insertStmt != null) insertStmt.close(); } catch (SQLException e) {}
            try { if (deleteStmt != null) deleteStmt.close(); } catch (SQLException e) {}
            if (readConn != null) { try { readConn.setAutoCommit(true); readConn.close(); } catch (SQLException e) {} }
            if (writeConn != null) { try { writeConn.setAutoCommit(true); writeConn.close(); } catch (SQLException e) {} }
        }
    }

