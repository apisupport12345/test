package com.cron;

import java.math.BigDecimal;
import java.sql.*;
import java.sql.Date;
import java.text.SimpleDateFormat;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.Locale;
import java.util.concurrent.*;

import com.jdbc.DBUtilityAuto;

public class HourlyQueryCronStatMgmtPart1 {

    private static final int QUERY_TIMEOUT_SECONDS = 1800;
    private static final int FETCH_SIZE = 1000;
    private static final int THREAD_POOL_SIZE = 2;
    private static final int MAX_RETRIES = 3;
    private static final long RETRY_DELAY_MS = 5000;

    // Part 1 handles queries 0 to 3
    private static final int QUERY_START = 0;
    private static final int QUERY_END   = 3;

    // Thread-safe formatter with explicit English locale so month abbreviations
    // are always JAN, FEB, ..., SEP (required by Oracle TO_DATE format mask).
    private static final DateTimeFormatter LOG_TIME_FMT =
            DateTimeFormatter.ofPattern("EEE MMM dd HH:mm:ss zzz yyyy", Locale.ENGLISH);

    public static void main(String[] args) {
        java.util.Date startTime, endTime;
        if (args.length >= 2) {
            try {
                SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy HH:mm:ss", Locale.ENGLISH);
                startTime = sdf.parse(args[0]);
                endTime = sdf.parse(args[1]);
            } catch (Exception e) {
                System.err.println("Invalid date format. Use dd-MMM-yyyy HH:mm:ss");
                return;
            }
        } else {
            Calendar cal = Calendar.getInstance();
            cal.set(Calendar.MINUTE, 0);
            cal.set(Calendar.SECOND, 0);
            cal.set(Calendar.MILLISECOND, 0);
            endTime = cal.getTime();
            cal.add(Calendar.HOUR_OF_DAY, -1);
            startTime = cal.getTime();
        }

        // Use real wall-clock time in log labels instead of epoch (1970-01-01).
        String runLabel = "[" + LocalDateTime.now().format(LOG_TIME_FMT) + "]";
        System.out.println(runLabel + " Running Part 1 (queries 0-3) for window: "
                + startTime + " to " + endTime);

        final String fromDate = formatDate(startTime);
        final String toDate = formatDate(endTime);
        final String partition = getPartition(startTime);

        ExecutorService executor = Executors.newFixedThreadPool(THREAD_POOL_SIZE);
        List<Future<?>> futures = new ArrayList<>();

        long batchStart = System.currentTimeMillis();

        for (int queryIndex = QUERY_START; queryIndex <= QUERY_END; queryIndex++) {
            final int qIdx = queryIndex;
            Future<?> future = executor.submit(() -> {
                String threadName = Thread.currentThread().getName();
                System.out.println("[" + threadName + "] Starting query " + qIdx);
                int attempt = 1;
                boolean success = false;
                while (!success && attempt <= MAX_RETRIES) {
                    long queryStart = System.currentTimeMillis();
                    try {
                        executeAndInsert(qIdx, fromDate, toDate, partition, startTime, endTime);
                        success = true;
                        long queryDuration = System.currentTimeMillis() - queryStart;
                        System.out.println("[" + threadName + "] Query " + qIdx
                                + " completed successfully in " + queryDuration
                                + " ms (attempt " + attempt + ")");
                    } catch (Exception e) {
                        long queryDuration = System.currentTimeMillis() - queryStart;
                        System.err.println("[" + threadName + "] Attempt " + attempt
                                + " failed for query " + qIdx
                                + " after " + queryDuration + " ms: " + e.getMessage());

                        if (isNonRetryable(e)) {
                            System.err.println("[" + threadName + "] Query " + qIdx
                                    + " failed with non-retryable error; aborting retries.");
                            e.printStackTrace();
                            break;
                        }

                        if (attempt == MAX_RETRIES) {
                            e.printStackTrace();
                        } else {
                            try {
                                long delay = RETRY_DELAY_MS * attempt;
                                System.out.println("[" + threadName + "] Retrying query "
                                        + qIdx + " after " + delay + " ms");
                                Thread.sleep(delay);
                            } catch (InterruptedException ie) {
                                Thread.currentThread().interrupt();
                                break;
                            }
                        }
                        attempt++;
                    }
                }
                if (!success) {
                    System.err.println("[" + threadName + "] Query " + qIdx
                            + " failed after " + MAX_RETRIES + " attempts.");
                }
            });
            futures.add(future);
        }

        executor.shutdown();
        try {
            if (!executor.awaitTermination(60, TimeUnit.MINUTES)) {
                executor.shutdownNow();
                System.err.println("[" + LocalDateTime.now().format(LOG_TIME_FMT)
                        + "] Some Part 1 queries did not finish within timeout");
            }
        } catch (InterruptedException e) {
            executor.shutdownNow();
            Thread.currentThread().interrupt();
        }

        long totalTime = System.currentTimeMillis() - batchStart;
        System.out.println("[" + LocalDateTime.now().format(LOG_TIME_FMT)
                + "] All Part 1 queries completed in " + totalTime + " ms");
    }

    /**
     * Deterministic errors (bad data / bad format) will never succeed on retry.
     * Skip the retry loop for these to avoid pointless backoff.
     */
    private static boolean isNonRetryable(Throwable t) {
        Throwable cause = t;
        while (cause != null) {
            if (cause instanceof SQLDataException) {
                return true;
            }
            String msg = cause.getMessage();
            if (msg != null) {
                String m = msg.toUpperCase(Locale.ENGLISH);
                if (m.contains("ORA-01861")   // literal does not match format string
                        || m.contains("ORA-01858")  // non-numeric where numeric expected
                        || m.contains("ORA-01843")  // not a valid month
                        || m.contains("ORA-01722")) { // invalid number
                    return true;
                }
            }
            cause = cause.getCause();
        }
        return false;
    }

    private static String formatDate(java.util.Date date) {
        // Force English locale so MMM always yields JAN..DEC, matching the
        // 'DD-MON-YYYY HH24:MI:SS' format mask used inside the SQL.
        SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy HH:mm:ss", Locale.ENGLISH);
        return sdf.format(date).toUpperCase(Locale.ENGLISH);
    }

    private static String getPartition(java.util.Date fromDate) {
        Calendar cal = Calendar.getInstance();
        cal.setTime(fromDate);
        String[] months = {"JAN","FEB","MAR","APR","MAY","JUN",
                           "JUL","AUG","SEP","OCT","NOV","DEC"};
        String month = months[cal.get(Calendar.MONTH)];
        String year = String.valueOf(cal.get(Calendar.YEAR)).substring(2);
        return month + "_" + year;
    }

    private static void executeAndInsert(int queryIndex, String fromDate, String toDate,
                                         String partition, java.util.Date startTime,
                                         java.util.Date endTime) throws Exception {
        String threadName = Thread.currentThread().getName();
        long methodStart = System.currentTimeMillis();

        Connection readConn = null;
        Connection writeConn = null;
        PreparedStatement ps = null;
        ResultSet rs = null;
        PreparedStatement insertStmt = null;
        PreparedStatement deleteStmt = null;

        try {
            // 1. Get READ connection
            long connStart = System.currentTimeMillis();
            // All Part 1 queries (0-3) use IIB
            readConn = DBUtilityAuto.getIIBDBConnection();
            if (readConn == null || readConn.isClosed()) {
                throw new SQLException("Could not get IIB connection for query " + queryIndex);
            }
            readConn.setAutoCommit(false);
            readConn.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);
            long connDuration = System.currentTimeMillis() - connStart;
            System.out.println("[" + threadName + "] Query " + queryIndex
                    + " read connection acquired in " + connDuration + " ms");

            // 2. Get WRITE connection (Report DB)
            connStart = System.currentTimeMillis();
            writeConn = DBUtilityAuto.getReportDBConnection();
            if (writeConn == null || writeConn.isClosed()) {
                throw new SQLException("Could not get report connection for query " + queryIndex);
            }
            writeConn.setAutoCommit(false);
            connDuration = System.currentTimeMillis() - connStart;
            System.out.println("[" + threadName + "] Query " + queryIndex
                    + " report connection acquired in " + connDuration + " ms");

            // 3. Prepare and execute SELECT
            String query = getQuery(queryIndex, partition);
            ps = readConn.prepareStatement(query, ResultSet.TYPE_FORWARD_ONLY,
                    ResultSet.CONCUR_READ_ONLY);
            ps.setFetchSize(FETCH_SIZE);
            ps.setQueryTimeout(QUERY_TIMEOUT_SECONDS);
            // Bind timestamps directly — no reliance on TO_DATE string parsing.
            setParameters(ps, queryIndex, startTime, endTime);

            long execStart = System.currentTimeMillis();
            rs = ps.executeQuery();
            long execDurationMs = System.currentTimeMillis() - execStart;
            double execDurationSec = execDurationMs / 1000.0;
            System.out.println("[" + threadName + "] Query " + queryIndex
                    + " SELECT execution took " + execDurationMs + " ms ("
                    + execDurationSec + " sec)");

            // 4. Fetch all rows into a list
            ResultSetMetaData meta = rs.getMetaData();
            int colCount = meta.getColumnCount();
            List<String> colNames = new ArrayList<>();
            for (int i = 1; i <= colCount; i++) {
                colNames.add(meta.getColumnName(i).toUpperCase(Locale.ENGLISH));
            }

            List<Map<String, Object>> rows = new ArrayList<>();
            while (rs.next()) {
                Map<String, Object> row = new LinkedHashMap<>();
                for (int i = 1; i <= colCount; i++) {
                    row.put(colNames.get(i - 1), rs.getObject(i));
                }
                rows.add(row);
            }
            System.out.println("[" + threadName + "] Query " + queryIndex
                    + " fetched " + rows.size() + " rows");

            // 5. DELETE existing rows for this time window
            String tableName = getTableName(queryIndex);
            String deleteSQL = "DELETE FROM " + tableName
                    + " WHERE START_TIME = ? AND END_TIME = ?";
            deleteStmt = writeConn.prepareStatement(deleteSQL);
            deleteStmt.setTimestamp(1, new Timestamp(startTime.getTime()));
            deleteStmt.setTimestamp(2, new Timestamp(endTime.getTime()));
            int deleted = deleteStmt.executeUpdate();
            System.out.println("[" + threadName + "] Deleted " + deleted
                    + " existing rows from " + tableName + " for this time window");

            // 6. Build INSERT statement with QUERY_DURATION_SEC
            StringBuilder insertSQL = new StringBuilder("INSERT INTO " + tableName + " (");
            insertSQL.append("START_TIME, END_TIME, QUERY_DURATION_SEC");
            for (String col : colNames) {
                insertSQL.append(", ").append(col);
            }
            insertSQL.append(") VALUES (?, ?, ?");
            for (int i = 0; i < colCount; i++) {
                insertSQL.append(", ?");
            }
            insertSQL.append(")");

            insertStmt = writeConn.prepareStatement(insertSQL.toString());

            // 7. Insert all rows (batch)
            long insertStart = System.currentTimeMillis();
            int rowCount = 0;
            int batchSize = 0;
            final int BATCH_LIMIT = 1000;

            for (Map<String, Object> row : rows) {
                int paramIndex = 1;
                insertStmt.setTimestamp(paramIndex++, new Timestamp(startTime.getTime()));
                insertStmt.setTimestamp(paramIndex++, new Timestamp(endTime.getTime()));
                insertStmt.setDouble(paramIndex++, execDurationSec);

                for (String col : colNames) {
                    Object value = row.get(col);
                    if (value == null) {
                        insertStmt.setNull(paramIndex++, Types.NULL);
                    } else if (value instanceof BigDecimal) {
                        insertStmt.setBigDecimal(paramIndex++, (BigDecimal) value);
                    } else if (value instanceof String) {
                        insertStmt.setString(paramIndex++, (String) value);
                    } else if (value instanceof Timestamp) {
                        insertStmt.setTimestamp(paramIndex++, (Timestamp) value);
                    } else if (value instanceof java.sql.Date) {
                        insertStmt.setTimestamp(paramIndex++,
                                new Timestamp(((java.sql.Date) value).getTime()));
                    } else if (value instanceof Integer) {
                        insertStmt.setInt(paramIndex++, (Integer) value);
                    } else if (value instanceof Long) {
                        insertStmt.setLong(paramIndex++, (Long) value);
                    } else if (value instanceof Double) {
                        insertStmt.setDouble(paramIndex++, (Double) value);
                    } else if (value instanceof Float) {
                        insertStmt.setFloat(paramIndex++, (Float) value);
                    } else if (value instanceof Boolean) {
                        insertStmt.setBoolean(paramIndex++, (Boolean) value);
                    } else {
                        insertStmt.setObject(paramIndex++, value);
                    }
                }
                insertStmt.addBatch();
                rowCount++;
                batchSize++;
                if (batchSize >= BATCH_LIMIT) {
                    insertStmt.executeBatch();
                    insertStmt.clearBatch();
                    batchSize = 0;
                }
            }

            if (batchSize > 0) {
                insertStmt.executeBatch();
                insertStmt.clearBatch();
            }

            long insertDuration = System.currentTimeMillis() - insertStart;
            writeConn.commit();

            System.out.println("[" + threadName + "] Query " + queryIndex
                    + " inserted " + rowCount + " rows into " + tableName
                    + " (insert took " + insertDuration + " ms)");

            long totalDuration = System.currentTimeMillis() - methodStart;
            System.out.println("[" + threadName + "] Query " + queryIndex
                    + " total processing time: " + totalDuration + " ms");

        } catch (SQLException e) {
            if (writeConn != null) {
                try { writeConn.rollback(); } catch (SQLException ex) { /* ignore */ }
            }
            throw e;
        } catch (Exception e) {
            if (writeConn != null) {
                try { writeConn.rollback(); } catch (SQLException ex) { /* ignore */ }
            }
            throw e;
        } finally {
            try { if (rs != null) rs.close(); } catch (SQLException e) { /* ignore */ }
            try { if (ps != null) ps.close(); } catch (SQLException e) { /* ignore */ }
            try { if (insertStmt != null) insertStmt.close(); } catch (SQLException e) { /* ignore */ }
            try { if (deleteStmt != null) deleteStmt.close(); } catch (SQLException e) { /* ignore */ }
            if (readConn != null) {
                try { readConn.setAutoCommit(true); readConn.close(); } catch (SQLException e) { /* ignore */ }
            }
            if (writeConn != null) {
                try { writeConn.setAutoCommit(true); writeConn.close(); } catch (SQLException e) { /* ignore */ }
            }
        }
    }

    // ========== QUERY DEFINITIONS (Part 1: queries 0-3) ==========
    // Bind placeholders are used directly for the date/timestamp columns.
    // JDBC setTimestamp() binds them as real TIMESTAMP values, so no TO_DATE
    // format-string dependency remains.
    private static String getQuery(int queryIndex, String partition) {
        String[] queries = {
            // Query 0
            "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_COUNT, " +
            "COUNT(CASE WHEN ERROR_CODE IN ('SI002','SI014','SI001','SI051','SI007','SI569','SI570') THEN 1 END) AS TD_COUNT, " +
            "ROUND((COUNT(CASE WHEN ERROR_CODE IN ('SI002','SI014','SI001','SI051','SI007','SI569','SI570') THEN 1 END) * 100.0) / " +
            "NULLIF(COUNT(*), 0), 2) AS TD_PERCENT " +
            "FROM EISAPP.api_log PARTITION(" + partition + ") " +
            "WHERE request_date_time BETWEEN ? AND ?",

            // Query 1
            "SELECT /*+ PARALLEL(4) */ txn_endpoint, COUNT(*) AS TOTAL_COUNT, " +
            "COUNT(CASE WHEN (ERROR_CODE IS NULL OR NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') " +
            "OR error_code IN ('00014','70007','00017','CK001')) THEN 1 END) AS SUCCESS_COUNT, " +
            "ROUND((COUNT(CASE WHEN (ERROR_CODE IS NULL OR NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') " +
            "OR error_code IN ('00014','70007','00017','CK001')) THEN 1 END) * 100.0) / NULLIF(COUNT(*), 0), 2) AS SUCCESS_PERCENT, " +
            "COUNT(CASE WHEN SUBSTR(error_code,3,3) IN ('001','002','007','051','014','111') AND error_code <> '00014' THEN 1 END) AS TD_COUNT, " +
            "ROUND((COUNT(CASE WHEN SUBSTR(error_code,3,3) IN ('001','002','007','051','014','111') AND error_code <> '00014' THEN 1 END) * 100.0) / " +
            "NULLIF(COUNT(*), 0), 2) AS TD_PERCENT " +
            "FROM eisapp.BACKEND_LOG PARTITION(" + partition + ") " +
            "WHERE (txn_endpoint IN ('DCMS','Vault','NSDL','HRMS') AND request_date_time BETWEEN ? AND ?) " +
            "OR (txn_endpoint = 'ATM' AND creation_date_time BETWEEN ? AND ?) " +
            "GROUP BY txn_endpoint ORDER BY txn_endpoint",

            // Query 2
            "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_COUNT, " +
            "COUNT(CASE WHEN ERROR_CODE IS NULL OR NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') " +
            "OR error_code IN ('00014','70007','00017','CK001') THEN 1 END) AS SUCCESS_COUNT, " +
            "ROUND((COUNT(CASE WHEN ERROR_CODE IS NULL OR NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') " +
            "OR error_code IN ('00014','70007','00017','CK001')) THEN 1 END) * 100.0) / NULLIF(COUNT(*), 0), 2) AS SUCCESS_PERCENTAGE " +
            "FROM eisapp.BACKEND_LOG PARTITION(" + partition + ") " +
            "WHERE txn_endpoint='CKYC' AND request_date_time BETWEEN ? AND ?",

            // Query 3
            "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_COUNT, " +
            "COUNT(CASE WHEN error_code IS NULL AND response_status = '0' THEN 1 END) AS SUCCESS_COUNT, " +
            "COUNT(CASE WHEN (NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') " +
            "OR error_code IN ('00014','70007')) AND RESPONSE_STATUS NOT IN ('0','SUCCESS') THEN 1 END) AS OTHER_COUNT, " +
            "ROUND((COUNT(CASE WHEN error_code IS NULL AND response_status = '0' THEN 1 END) + " +
            "COUNT(CASE WHEN (NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') " +
            "OR error_code IN ('00014','70007')) AND RESPONSE_STATUS NOT IN ('0','SUCCESS') THEN 1 END)) * 100.0 / " +
            "NULLIF(COUNT(*), 0), 2) AS PAN_SUCCESS " +
            "FROM EISAPP.api_log PARTITION(" + partition + ") " +
            "WHERE url IN ('http://eispri.sbi.co.in:3002/dedupOn_bth/PANMobile/customers', " +
            "'http://eispri.sbi.co.in:3002/dedupOn/PANMobile/customers', " +
            "'http://eispri.sbi.co.in:3016/misc/PAN/Enquiry/details/misc', " +
            "'http://eispri.sbi.co.in:3013/misc/PAN/Details/misc', " +
            "'http://eispri.sbi.co.in:3013/misc/PAN_bth/Details/misc', " +
            "'http://eispri.sbi.co.in:3002/dedupOn_th/PANMobile/customers', " +
            "'http://eispri.sbi.co.in:3002/dedupOn_bth/PANMobileCheck/customers', " +
            "'http://eispri.sbi.co.in:3013/misc/PAN_th/Details/misc') " +
            "AND request_date_time BETWEEN ? AND ?"
        };
        return queries[queryIndex];
    }

    private static void setParameters(PreparedStatement ps, int queryIndex,
                                      java.util.Date startTime, java.util.Date endTime)
            throws SQLException {
        Timestamp fromTs = new Timestamp(startTime.getTime());
        Timestamp toTs   = new Timestamp(endTime.getTime());
        switch (queryIndex) {
            case 0: case 2: case 3:
                ps.setTimestamp(1, fromTs);
                ps.setTimestamp(2, toTs);
                break;
            case 1:
                ps.setTimestamp(1, fromTs);
                ps.setTimestamp(2, toTs);
                ps.setTimestamp(3, fromTs);
                ps.setTimestamp(4, toTs);
                break;
        }
    }

    private static String getTableName(int queryIndex) {
        switch (queryIndex) {
            case 0: return "EIS_TD_PERCENTAGE_HOURLY";
            case 1: return "MAJOR_DOWNSTREAM_HOURLY";
            case 2: return "CKYC_STATUS_HOURLY";
            case 3: return "PAN_STATUS_HOURLY";
            default: throw new IllegalArgumentException("Invalid query index for Part 1: " + queryIndex);
        }
    }
}
