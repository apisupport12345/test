<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="true"%>
<%@ page import="com.jdbc.IPOMonitorService" %>
<%@ page import="com.jdbc.IPOMonitorService.QueryResult" %>
<%@ page import="java.util.*" %>
<%
    String ajax = request.getParameter("ajax");
    if ("fetch".equals(ajax)) {
        Map<String, QueryResult> results = IPOMonitorService.runAll();
        StringBuilder sb = new StringBuilder("{");
        int i = 0;
        for (Map.Entry<String, QueryResult> e : results.entrySet()) {
            if (i++ > 0) sb.append(",");
            sb.append("\"").append(IPOMonitorService.esc(e.getKey())).append("\":");
            sb.append(IPOMonitorService.toJson(e.getValue()));
        }
        sb.append("}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IPO Monitoring Dashboard</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg-base: #070b14;
            --bg-grad-1: #0a0f1e;
            --bg-grad-2: #151228;
            --bg-grad-3: #0d1424;
            --glass: rgba(20, 28, 45, 0.55);
            --glass-strong: rgba(25, 34, 55, 0.75);
            --glass-border: rgba(120, 150, 210, 0.14);
            --glass-border-hi: rgba(120, 150, 210, 0.28);
            --text-0: #f5f7fb;
            --text-1: #c8d0e0;
            --text-2: #7e8899;
            --text-3: #5a6478;
            --accent: #4f8cff;
            --accent-glow: rgba(79, 140, 255, 0.5);
            --green: #22e6a4;
            --green-dim: rgba(34, 230, 164, 0.14);
            --amber: #ffb84d;
            --amber-dim: rgba(255, 184, 77, 0.14);
            --red: #ff5577;
            --red-dim: rgba(255, 85, 119, 0.14);
            --purple: #b47cff;
            --purple-dim: rgba(180, 124, 255, 0.14);
            --cyan: #4fd1ff;
        }

        html, body {
            height: 100vh;
            overflow: hidden;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--text-0);
            background: var(--bg-base);
            font-size: 13.5px;
            -webkit-font-smoothing: antialiased;
        }

        /* Animated gradient background */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse at 0% 0%, rgba(79, 140, 255, 0.20), transparent 45%),
                radial-gradient(ellipse at 100% 0%, rgba(180, 124, 255, 0.16), transparent 45%),
                radial-gradient(ellipse at 50% 100%, rgba(34, 230, 164, 0.10), transparent 50%),
                linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-3) 50%, var(--bg-grad-2) 100%);
            z-index: -2;
        }
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1;
            pointer-events: none;
        }

        .app {
            height: 100vh;
            display: grid;
            grid-template-rows: 68px 1fr;
            overflow: hidden;
        }

        /* ============ HEADER ============ */
        .header {
            display: flex;
            align-items: center;
            padding: 0 26px;
            gap: 22px;
            border-bottom: 1px solid var(--glass-border);
            background: rgba(10, 15, 26, 0.55);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 100;
            flex-shrink: 0;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 13px;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.4px;
            color: #fff;
        }
        .logo-mark {
            width: 38px; height: 38px;
            border-radius: 11px;
            background: linear-gradient(135deg, #4f8cff 0%, #b47cff 100%);
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            box-shadow:
                0 6px 20px rgba(79, 140, 255, 0.45),
                inset 0 1px 0 rgba(255,255,255,0.3);
            position: relative;
        }
        .logo-mark::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 11px;
            padding: 1px;
            background: linear-gradient(135deg, rgba(255,255,255,0.4), transparent);
            -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor;
                    mask-composite: exclude;
            pointer-events: none;
        }
        .logo-pill {
            font-size: 10px;
            font-weight: 800;
            padding: 3px 9px;
            background: rgba(34, 230, 164, 0.13);
            border: 1px solid rgba(34, 230, 164, 0.35);
            color: var(--green);
            border-radius: 6px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .pulse-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
            animation: pulse 1.5s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.35; transform: scale(0.85); }
        }

        .hdr-spacer { flex: 1; }

        /* Activity ticker */
        .ticker {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            color: var(--text-2);
            padding: 6px 14px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--glass-border);
            border-radius: 999px;
            max-width: 380px;
            overflow: hidden;
        }
        .ticker-icon {
            color: var(--cyan);
            font-size: 13px;
            animation: spin 6s linear infinite;
            display: inline-block;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .ticker-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 600;
            color: var(--text-1);
        }

        .hdr-stat {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-1);
            backdrop-filter: blur(10px);
        }
        .hdr-stat .num { color: var(--text-0); font-weight: 800; font-size: 14px; }
        .hdr-stat .num.green  { color: var(--green); }
        .hdr-stat .num.amber  { color: var(--amber); }
        .hdr-stat .num.red    { color: var(--red); }
        .hdr-stat .dot { width: 7px; height: 7px; border-radius: 50%; }
        .hdr-stat .dot.g { background: var(--green); box-shadow: 0 0 6px var(--green); }
        .hdr-stat .dot.a { background: var(--amber); box-shadow: 0 0 6px var(--amber); }
        .hdr-stat .dot.r { background: var(--red); box-shadow: 0 0 6px var(--red); }

        .countdown-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 16px;
            background: linear-gradient(135deg, rgba(79, 140, 255, 0.15), rgba(180, 124, 255, 0.12));
            border: 1px solid rgba(79, 140, 255, 0.35);
            border-radius: 10px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
            box-shadow: 0 4px 14px rgba(79, 140, 255, 0.15);
        }
        .countdown-pill .cd-val { color: var(--accent); font-size: 14px; font-weight: 800; letter-spacing: 0.3px; }

        .btn-refresh {
            width: 40px; height: 40px;
            background: linear-gradient(135deg, #4f8cff, #3866dd);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: 0.22s;
            box-shadow: 0 6px 18px rgba(79, 140, 255, 0.4);
            position: relative;
        }
        .btn-refresh:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(79, 140, 255, 0.6);
        }
        .btn-refresh:disabled { opacity: 0.7; cursor: not-allowed; }
        .btn-refresh.spinning { animation: spin 1s linear infinite; }

        /* ============ MAIN ============ */
        .main {
            padding: 16px 22px;
            display: grid;
            grid-template-rows: 100px 1fr;
            gap: 14px;
            min-height: 0;
            overflow: hidden;
        }

        /* ============ KPI ROW ============ */
        .kpis {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            min-height: 0;
        }
        .kpi {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 12px 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            transition: 0.22s;
        }
        .kpi:hover {
            transform: translateY(-2px);
            border-color: var(--glass-border-hi);
            box-shadow: 0 12px 32px rgba(0,0,0,0.35);
        }
        .kpi::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--accent);
            box-shadow: 0 0 16px var(--accent-glow);
        }
        .kpi.green::before  { background: var(--green); box-shadow: 0 0 16px rgba(34, 230, 164, 0.6); }
        .kpi.amber::before  { background: var(--amber); box-shadow: 0 0 16px rgba(255, 184, 77, 0.6); }
        .kpi.red::before    { background: var(--red); box-shadow: 0 0 16px rgba(255, 85, 119, 0.6); }

        .kpi-label {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: var(--text-3);
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .kpi-label .mini { font-size: 11px; opacity: 0.8; }
        .kpi-value {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: -0.7px;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }
        .kpi-value.green { color: var(--green); }
        .kpi-value.amber { color: var(--amber); }
        .kpi-value.red   { color: var(--red); }
        .kpi-sub {
            font-size: 10.5px;
            color: var(--text-3);
            font-weight: 600;
            margin-top: 4px;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .kpi-sub .trend-up   { color: var(--green); }
        .kpi-sub .trend-down { color: var(--red); }

        /* ============ PANELS ============ */
        .panels {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            min-height: 0;
            overflow: hidden;
        }
        .panel {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 0;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 4px 22px rgba(0,0,0,0.2);
        }

        .panel-head {
            padding: 12px 16px;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.025);
            flex-shrink: 0;
        }
        .ph-icon {
            width: 30px; height: 30px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }
        .ph-icon.green  { background: var(--green-dim); color: var(--green); }
        .ph-icon.blue   { background: rgba(79, 140, 255, 0.15); color: var(--accent); }
        .ph-icon.purple { background: var(--purple-dim); color: var(--purple); }

        .ph-text { flex: 1; min-width: 0; }
        .ph-title {
            font-size: 13.5px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: -0.1px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .ph-sub {
            font-size: 10px;
            color: var(--text-3);
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin-top: 1px;
        }
        .ph-badge {
            font-size: 10px;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 7px;
            background: rgba(255,255,255,0.05);
            color: var(--text-2);
            letter-spacing: 0.4px;
            white-space: nowrap;
            border: 1px solid var(--glass-border);
        }

        /* Scrollable cards */
        .panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
            gap: 10px;
            align-content: start;
            min-height: 0;
        }
        .panel-body::-webkit-scrollbar { width: 7px; }
        .panel-body::-webkit-scrollbar-track { background: transparent; }
        .panel-body::-webkit-scrollbar-thumb {
            background: rgba(120, 150, 210, 0.22);
            border-radius: 4px;
        }
        .panel-body::-webkit-scrollbar-thumb:hover { background: rgba(120, 150, 210, 0.4); }

        /* ============ IP CARD ============ */
        .ip-card {
            background: rgba(255,255,255,0.035);
            border: 1px solid rgba(120, 150, 210, 0.14);
            border-radius: 12px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: 0.22s;
            position: relative;
            overflow: hidden;
        }
        .ip-card:hover {
            background: rgba(255,255,255,0.06);
            border-color: rgba(120, 150, 210, 0.32);
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(0,0,0,0.35);
        }
        .ip-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 3px;
            background: var(--green);
            box-shadow: 0 0 14px rgba(34, 230, 164, 0.5);
        }
        .ip-card.warning::before  { background: var(--amber); box-shadow: 0 0 14px rgba(255, 184, 77, 0.6); }
        .ip-card.critical::before { background: var(--red); box-shadow: 0 0 14px rgba(255, 85, 119, 0.6); }
        .ip-card.critical {
            background: rgba(255, 85, 119, 0.045);
            animation: cardPulse 3s ease-in-out infinite;
        }
        @keyframes cardPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 85, 119, 0); }
            50%      { box-shadow: 0 0 20px 0 rgba(255, 85, 119, 0.18); }
        }

        /* Head row */
        .ip-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .ip-addr {
            font-family: 'JetBrains Mono', 'SF Mono', 'Consolas', monospace;
            font-size: 12.5px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: 0.2px;
        }
        .ip-badge {
            font-size: 9px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .ip-badge.healthy  { background: var(--green-dim); color: var(--green); border: 1px solid rgba(34,230,164,0.3); }
        .ip-badge.warning  { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(255,184,77,0.3); }
        .ip-badge.critical { background: var(--red-dim); color: var(--red); border: 1px solid rgba(255,85,119,0.3); }

        .ip-api {
            font-size: 10px;
            color: var(--text-3);
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: -4px;
        }

        /* Metric grid with values */
        .ip-metrics {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .ip-metric {
            background: rgba(0,0,0,0.18);
            border-radius: 8px;
            padding: 7px 10px;
            border: 1px solid rgba(255,255,255,0.03);
        }
        .ip-metric-label {
            font-size: 9px;
            color: var(--text-3);
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 3px;
        }
        .ip-metric-value {
            font-size: 15px;
            font-weight: 800;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
            line-height: 1;
        }
        .ip-metric-value.green { color: var(--green); }
        .ip-metric-value.amber { color: var(--amber); }
        .ip-metric-value.red   { color: var(--red); }

        /* Success bar */
        .succ-bar {
            height: 5px;
            background: rgba(255,255,255,0.06);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 6px;
        }
        .succ-bar-inner {
            height: 100%;
            background: linear-gradient(90deg, #22e6a4, #4fd1ff);
            border-radius: 3px;
            transition: width 0.4s ease;
            box-shadow: 0 0 8px rgba(34, 230, 164, 0.5);
        }
        .succ-bar-inner.warn { background: linear-gradient(90deg, #ffb84d, #ff8a4d); box-shadow: 0 0 8px rgba(255,184,77,0.5); }
        .succ-bar-inner.bad  { background: linear-gradient(90deg, #ff5577, #ff3d5f); box-shadow: 0 0 8px rgba(255,85,119,0.5); }

        /* Error chips */
        .err-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            padding-top: 8px;
            border-top: 1px dashed rgba(120, 150, 210, 0.12);
            min-height: 26px;
        }
        .err-chip {
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 9.5px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 5px;
            letter-spacing: 0.2px;
            white-space: nowrap;
        }
        .err-chip.td {
            background: rgba(255, 184, 77, 0.14);
            color: var(--amber);
            border: 1px solid rgba(255, 184, 77, 0.32);
        }
        .err-chip.bd {
            background: rgba(255, 85, 119, 0.14);
            color: var(--red);
            border: 1px solid rgba(255, 85, 119, 0.32);
        }
        .err-chip.ok {
            background: rgba(34, 230, 164, 0.10);
            color: var(--green);
            border: 1px solid rgba(34, 230, 164, 0.25);
            font-family: inherit;
        }

        /* ============ STATES ============ */
        .state {
            grid-column: 1 / -1;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--text-2);
            min-height: 200px;
        }
        .state .ico { font-size: 40px; opacity: 0.35; margin-bottom: 12px; }
        .state .ttl { font-size: 14px; font-weight: 700; color: var(--text-1); margin-bottom: 4px; }
        .state .sub { font-size: 12px; color: var(--text-3); }

        .loader-spin {
            width: 44px; height: 44px;
            border: 4px solid rgba(79, 140, 255, 0.15);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin-bottom: 16px;
        }

        /* ============ TOAST ============ */
        .toast {
            position: fixed;
            bottom: 24px; right: 24px;
            padding: 12px 20px;
            background: rgba(20, 28, 45, 0.95);
            border: 1px solid rgba(34, 230, 164, 0.35);
            border-left: 4px solid var(--green);
            border-radius: 10px;
            color: var(--text-0);
            font-size: 13px;
            font-weight: 700;
            backdrop-filter: blur(20px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.7);
            z-index: 9999;
            animation: slideIn 0.25s ease;
        }
        .toast.err { border-color: rgba(255, 85, 119, 0.5); border-left-color: var(--red); }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 1500px) {
            .kpis { grid-template-columns: repeat(3, 1fr); }
            .main { grid-template-rows: 200px 1fr; }
        }
        @media (max-width: 1100px) {
            .panels { grid-template-columns: 1fr; }
            .main { grid-template-rows: auto 1fr; overflow-y: auto; }
            .panel-body { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
        }
        @media (max-width: 700px) {
            .kpis { grid-template-columns: repeat(2, 1fr); }
            .main { padding: 10px; }
            .header { padding: 0 14px; }
            .ticker { display: none; }
        }
    </style>
</head>
<body>

<div class="app">

    <!-- ================= HEADER ================= -->
    <div class="header">
        <div class="logo">
            <div class="logo-mark">&#128200;</div>
            IPO Monitor
            <span class="logo-pill"><span class="pulse-dot"></span> LIVE</span>
        </div>

        <div class="hdr-spacer"></div>

        <!-- Activity ticker -->
        <div class="ticker">
            <span class="ticker-icon">&#9881;</span>
            <span class="ticker-text" id="tickerText">Initializing monitors...</span>
        </div>

        <!-- Mini stats -->
        <div class="hdr-stat">
            <span class="dot g"></span> Healthy <span class="num green" id="hdrHealthy">0</span>
        </div>
        <div class="hdr-stat">
            <span class="dot a"></span> Warn <span class="num amber" id="hdrWarn">0</span>
        </div>
        <div class="hdr-stat">
            <span class="dot r"></span> Crit <span class="num red" id="hdrCrit">0</span>
        </div>

        <!-- Countdown -->
        <div class="countdown-pill">
            <span>&#9202;</span>
            <span>Next</span>
            <span class="cd-val" id="cdVal">--:--</span>
        </div>

        <button class="btn-refresh" id="refreshBtn" onclick="refreshNow()" title="Refresh now">&#8635;</button>
    </div>

    <!-- ================= MAIN ================= -->
    <div class="main">

        <!-- KPI ROW -->
        <div class="kpis">
            <div class="kpi green" id="kpiBackendHits">
                <div class="kpi-label"><span class="mini">&#9881;</span> Backend Hits</div>
                <div class="kpi-value" id="kpiBackendHitsVal">—</div>
                <div class="kpi-sub" id="kpiBackendHitsSub">NSE · BSE · INB Auth</div>
            </div>
            <div class="kpi green" id="kpiBackendTD">
                <div class="kpi-label"><span class="mini">&#9888;</span> Backend TD%</div>
                <div class="kpi-value" id="kpiBackendTDVal">—</div>
                <div class="kpi-sub" id="kpiBackendTDSub">Avg technical decline</div>
            </div>
            <div class="kpi green" id="kpiApiNHits">
                <div class="kpi-label"><span class="mini">&#128225;</span> NSE/INB Hits</div>
                <div class="kpi-value" id="kpiApiNHitsVal">—</div>
                <div class="kpi-sub" id="kpiApiNHitsSub">Routing services</div>
            </div>
            <div class="kpi green" id="kpiApiNTD">
                <div class="kpi-label"><span class="mini">&#9888;</span> NSE/INB TD%</div>
                <div class="kpi-value" id="kpiApiNTDVal">—</div>
                <div class="kpi-sub" id="kpiApiNTDSub">Avg technical decline</div>
            </div>
            <div class="kpi green" id="kpiApiBHits">
                <div class="kpi-label"><span class="mini">&#128226;</span> BSE Hits</div>
                <div class="kpi-value" id="kpiApiBHitsVal">—</div>
                <div class="kpi-sub" id="kpiApiBHitsSub">IPO_ORDER service</div>
            </div>
            <div class="kpi green" id="kpiApiBTD">
                <div class="kpi-label"><span class="mini">&#9888;</span> BSE TD%</div>
                <div class="kpi-value" id="kpiApiBTDVal">—</div>
                <div class="kpi-sub" id="kpiApiBTDSub">Avg technical decline</div>
            </div>
        </div>

        <!-- PANELS -->
        <div class="panels">

            <div class="panel">
                <div class="panel-head">
                    <div class="ph-icon green">&#9881;</div>
                    <div class="ph-text">
                        <div class="ph-title">BACKEND LOG</div>
                        <div class="ph-sub">IPO Auth · NSE + BSE + INB</div>
                    </div>
                    <div class="ph-badge" id="backendBadge">—</div>
                </div>
                <div class="panel-body" id="backendBody">
                    <div class="state">
                        <div class="loader-spin"></div>
                        <div class="ttl">Loading backend data...</div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-head">
                    <div class="ph-icon blue">&#128225;</div>
                    <div class="ph-text">
                        <div class="ph-title">API LOG · NSE/INB</div>
                        <div class="ph-sub">Routing Services</div>
                    </div>
                    <div class="ph-badge" id="apiNBadge">—</div>
                </div>
                <div class="panel-body" id="apiNBody">
                    <div class="state">
                        <div class="loader-spin"></div>
                        <div class="ttl">Loading NSE/INB data...</div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-head">
                    <div class="ph-icon purple">&#128226;</div>
                    <div class="ph-text">
                        <div class="ph-title">API LOG · BSE</div>
                        <div class="ph-sub">BSE IPO_ORDER</div>
                    </div>
                    <div class="ph-badge" id="apiBBadge">—</div>
                </div>
                <div class="panel-body" id="apiBBody">
                    <div class="state">
                        <div class="loader-spin"></div>
                        <div class="ttl">Loading BSE data...</div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<script>
/* ============================================================
 * IPO MONITORING DASHBOARD — v6.0 (Attractive + Informative)
 * ============================================================ */

var REFRESH_INTERVAL_SEC = 300;
var secondsLeft = 0;
var countdownTimer = null;
var isRefreshing = false;
var lastStats = { healthy: 0, warn: 0, crit: 0 };

/* ============ TICKER ============ */
function updateTicker(msg) {
    var el = document.getElementById('tickerText');
    if (el) el.textContent = msg;
}

/* ============ COUNTDOWN ============ */
function startCountdown() {
    if (countdownTimer) clearInterval(countdownTimer);
    secondsLeft = REFRESH_INTERVAL_SEC;
    renderCountdown();
    countdownTimer = setInterval(function() {
        secondsLeft--;
        if (secondsLeft <= 0) {
            secondsLeft = REFRESH_INTERVAL_SEC;
            refreshNow();
        }
        renderCountdown();
    }, 1000);
}

function stopCountdown() {
    if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
}

function renderCountdown() {
    var el = document.getElementById('cdVal');
    if (!el) return;
    if (isRefreshing) {
        el.textContent = 'loading...';
        el.style.color = '#ffb84d';
        return;
    }
    el.style.color = '';
    var m = Math.floor(secondsLeft / 60);
    var s = secondsLeft % 60;
    el.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
}

/* ============ REFRESH ============ */
function refreshNow() {
    if (isRefreshing) return;
    isRefreshing = true;
    stopCountdown();
    renderCountdown();

    var btn = document.getElementById('refreshBtn');
    btn.classList.add('spinning');
    btn.disabled = true;

    updateTicker('Fetching latest IPO activity...');

    showState('backendBody', 'Loading backend data...');
    showState('apiNBody', 'Loading NSE/INB data...');
    showState('apiBBody', 'Loading BSE data...');

    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'ipo-monitor.jsp?ajax=fetch&_=' + Date.now(), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        btn.classList.remove('spinning');
        btn.disabled = false;
        isRefreshing = false;

        if (xhr.status !== 200) {
            updateTicker('Refresh failed — HTTP ' + xhr.status);
            toast('HTTP ' + xhr.status + ' — refresh failed', true);
            startCountdown();
            renderCountdown();
            return;
        }
        try {
            var data = JSON.parse(xhr.responseText);
            renderAll(data);
            var now = new Date();
            updateTicker('Updated at ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds()));
            toast('Data refreshed');
        } catch(e) {
            updateTicker('Parse error');
            toast('Parse error: ' + e.message, true);
            console.error(e);
        }
        startCountdown();
        renderCountdown();
    };
    xhr.send();
}

function pad(n) { return n < 10 ? '0' + n : '' + n; }

function showState(id, text) {
    var el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = '<div class="state">' +
                       '<div class="loader-spin"></div>' +
                       '<div class="ttl">' + escapeHtml(text) + '</div>' +
                   '</div>';
}

/* ============ RENDER ALL ============ */
function renderAll(data) {
    var s1 = renderPanel(data.BACKEND_LOG, 'backendBody', 'backendBadge');
    var s2 = renderPanel(data.API_NSE_INB, 'apiNBody', 'apiNBadge');
    var s3 = renderPanel(data.API_BSE, 'apiBBody', 'apiBBadge');
    updateKpis(data);
    var totals = {
        healthy: s1.healthy + s2.healthy + s3.healthy,
        warn:    s1.warning + s2.warning + s3.warning,
        crit:    s1.critical + s2.critical + s3.critical
    };
    document.getElementById('hdrHealthy').textContent = totals.healthy;
    document.getElementById('hdrWarn').textContent = totals.warn;
    document.getElementById('hdrCrit').textContent = totals.crit;
    lastStats = totals;
}

/* ============ PANEL RENDER ============ */
function renderPanel(qr, bodyId, badgeId) {
    var body = document.getElementById(bodyId);
    var badge = document.getElementById(badgeId);
    var stats = { healthy: 0, warning: 0, critical: 0 };

    if (!qr || !qr.success) {
        body.innerHTML = '<div class="state">' +
                            '<div class="ico">&#9888;</div>' +
                            '<div class="ttl">Could not load data</div>' +
                            '<div class="sub">' + escapeHtml(qr ? qr.message : 'Unknown error') + '</div>' +
                         '</div>';
        badge.textContent = 'ERROR';
        return stats;
    }

    badge.textContent = qr.rows.length + ' IPs · ' + qr.executionTimeMs + ' ms';

    if (!qr.rows || qr.rows.length === 0) {
        body.innerHTML = '<div class="state">' +
                            '<div class="ico">&#128269;</div>' +
                            '<div class="ttl">No traffic in window</div>' +
                            '<div class="sub">Widen the time window if needed</div>' +
                         '</div>';
        return stats;
    }

    var cols = qr.columns;
    var ipCol   = findCol(cols, ['SYS_IP', 'EXP_IP', 'IP']);
    var apiCol  = findCol(cols, ['API_NAME']);
    var hitsCol = findCol(cols, ['TOTAL_HITS', 'HITS']);
    var succCol = findCol(cols, ['SUCCESS']);
    var tdCol   = findCol(cols, ['TD']);
    var tdpCol  = findCol(cols, ['TD_PERCENT']);
    var bdCol   = findCol(cols, ['BD']);
    var bdpCol  = findCol(cols, ['BD_PERCENT']);

    var errCols = [];
    cols.forEach(function(c) {
        if (c === ipCol || c === apiCol || c === hitsCol || c === succCol ||
            c === tdCol || c === tdpCol || c === bdCol || c === bdpCol) return;
        errCols.push(c);
    });

    var html = '';
    qr.rows.forEach(function(row) {
        var ip     = row[ipCol] || '-';
        var api    = row[apiCol] || '';
        var hits   = parseInt(row[hitsCol] || 0);
        var succ   = parseInt(row[succCol] || 0);
        var td     = parseInt(row[tdCol] || 0);
        var tdPct  = parseFloat(row[tdpCol] || 0);
        var bd     = parseInt(row[bdCol] || 0);
        var bdPct  = parseFloat(row[bdpCol] || 0);

        var status = 'healthy';
        if (tdPct > 5 || bdPct > 5) status = 'critical';
        else if (tdPct > 0 || bdPct > 0 || td > 0 || bd > 0) status = 'warning';
        stats[status]++;

        var succPct = hits > 0 ? (succ * 100 / hits) : 100;
        var succCls = succPct >= 99 ? 'green' : succPct >= 95 ? 'amber' : 'red';
        var barCls  = succPct >= 99 ? '' : succPct >= 95 ? 'warn' : 'bad';

        var tdCls = tdPct <= 1 ? 'green' : tdPct <= 5 ? 'amber' : 'red';
        var bdCls = bdPct <= 1 ? 'green' : bdPct <= 5 ? 'amber' : 'red';

        var errChips = [];
        errCols.forEach(function(c) {
            var v = parseInt(row[c] || 0);
            if (v > 0) {
                var isBD = (c === 'BD' || c === 'BD_NEW');
                errChips.push('<span class="err-chip ' + (isBD ? 'bd' : 'td') + '">' + escapeHtml(c) + ' · ' + v + '</span>');
            }
        });

        var shortApi = api.replace('thirdParty', '').replace('_sys', '').replace('_expDS', '').replace('GenericRouting', '');
        if (shortApi.length > 26) shortApi = shortApi.substring(0, 24) + '…';

        html += '<div class="ip-card ' + status + '">';

        html +=   '<div class="ip-head">';
        html +=     '<div class="ip-addr">' + escapeHtml(ip) + '</div>';
        html +=     '<div class="ip-badge ' + status + '">' + status + '</div>';
        html +=   '</div>';

        if (shortApi) html += '<div class="ip-api">' + escapeHtml(shortApi) + '</div>';

        html +=   '<div class="ip-metrics">';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">Hits</div><div class="ip-metric-value">' + hits + '</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">Success</div><div class="ip-metric-value ' + succCls + '">' + succ + '</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">TD%</div><div class="ip-metric-value ' + tdCls + '">' + tdPct.toFixed(2) + '%</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">BD%</div><div class="ip-metric-value ' + bdCls + '">' + bdPct.toFixed(2) + '%</div></div>';
        html +=   '</div>';

        // Success bar
        html +=   '<div class="succ-bar" title="Success: ' + succPct.toFixed(1) + '%"><div class="succ-bar-inner ' + barCls + '" style="width:' + Math.min(100, Math.max(2, succPct)).toFixed(1) + '%"></div></div>';

        // Error chips
        html +=   '<div class="err-chips">';
        if (errChips.length > 0) html += errChips.join('');
        else html += '<span class="err-chip ok">&#10003; No errors</span>';
        html +=   '</div>';

        html += '</div>';
    });

    body.innerHTML = html;
    return stats;
}

function findCol(cols, names) {
    for (var i = 0; i < names.length; i++) {
        var n = names[i].toUpperCase();
        for (var j = 0; j < cols.length; j++) {
            if (cols[j].toUpperCase() === n) return cols[j];
        }
    }
    return null;
}

/* ============ KPIS ============ */
function updateKpis(data) {
    var b = data.BACKEND_LOG, n = data.API_NSE_INB, x = data.API_BSE;

    var agg = function(qr) {
        var hits = 0, tdSum = 0, count = 0, ips = 0;
        if (qr && qr.success && qr.rows) {
            qr.rows.forEach(function(r) {
                hits += parseInt(r.TOTAL_HITS || 0);
                tdSum += parseFloat(r.TD_PERCENT || 0);
                count++;
                ips++;
            });
        }
        return {
            hits: hits,
            tdAvg: count > 0 ? (tdSum / count) : null,
            ips: ips
        };
    };

    var bAgg = agg(b), nAgg = agg(n), xAgg = agg(x);

    setKpi('kpiBackendHits', 'kpiBackendHitsVal', 'kpiBackendHitsSub', bAgg.hits, bAgg.ips + ' IPs', null);
    setKpi('kpiBackendTD',   'kpiBackendTDVal',   'kpiBackendTDSub',   null, null, bAgg.tdAvg);

    setKpi('kpiApiNHits', 'kpiApiNHitsVal', 'kpiApiNHitsSub', nAgg.hits, nAgg.ips + ' IPs', null);
    setKpi('kpiApiNTD',   'kpiApiNTDVal',   'kpiApiNTDSub',   null, null, nAgg.tdAvg);

    setKpi('kpiApiBHits', 'kpiApiBHitsVal', 'kpiApiBHitsSub', xAgg.hits, xAgg.ips + ' IPs', null);
    setKpi('kpiApiBTD',   'kpiApiBTDVal',   'kpiApiBTDSub',   null, null, xAgg.tdAvg);
}

function setKpi(wrapperId, valId, subId, hits, hitsSub, tdPct) {
    var wrap = document.getElementById(wrapperId);
    var val  = document.getElementById(valId);
    var sub  = document.getElementById(subId);
    if (!wrap || !val) return;

    wrap.classList.remove('green', 'amber', 'red');
    val.classList.remove('green', 'amber', 'red');

    if (hits !== null && hits !== undefined) {
        val.textContent = hits.toLocaleString();
        val.classList.add('green');
        wrap.classList.add('green');
        if (sub && hitsSub) sub.textContent = hitsSub;
    } else if (tdPct !== null && tdPct !== undefined && !isNaN(tdPct)) {
        val.textContent = tdPct.toFixed(2) + '%';
        if (tdPct <= 1) { val.classList.add('green'); wrap.classList.add('green'); }
        else if (tdPct <= 5) { val.classList.add('amber'); wrap.classList.add('amber'); }
        else { val.classList.add('red'); wrap.classList.add('red'); }
        if (sub) {
            if (tdPct <= 1) sub.textContent = 'Excellent';
            else if (tdPct <= 5) sub.textContent = 'Moderate decline';
            else sub.textContent = 'High decline';
        }
    } else {
        val.textContent = '—';
        wrap.classList.add('green');
        val.classList.add('green');
    }
}

/* ============ HELPERS ============ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function() {
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function() { el.remove(); }, 320);
    }, 2200);
}

/* ============ INIT ============ */
window.addEventListener('load', function() {
    refreshNow();
});
</script>

</body>
</html>
