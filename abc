/* ============ SWITCH / CLOSE ============ */
function switchTab(id) {
    activeTabId = id;
    document.querySelectorAll('.tab').forEach(function(el) {
        el.classList.toggle('active', el.dataset.tabId === id);
    });
    document.querySelectorAll('.pane').forEach(function(el) {
        el.classList.toggle('active', el.dataset.tabId === id);
    });
    var t = getTab(id);
    if (t && t.editorEl) try { t.editorEl.focus(); } catch(e) {}
    updateStatus();
    saveTabs();
}

function getTab(id) {
    for (var i = 0; i < tabs.length; i++) if (tabs[i].id === id) return tabs[i];
    return null;
}

function closeTab(id) {
    var idx = -1;
    for (var i = 0; i < tabs.length; i++) if (tabs[i].id === id) { idx = i; break; }
    if (idx === -1) return;
    var t = tabs[idx];

    if (t.running) {
        if (!confirm('Query is still running in "' + t.title + '". Close anyway?')) return;
    } else if (!t.isPinned && t.sql && t.sql.trim()) {
        if (!confirm('Close "' + t.title + '"? Unsaved query will be lost.')) return;
    }

    delete usedNumbers[t.num];
    if (t.el) t.el.remove();
    if (t.paneEl) t.paneEl.remove();
    tabs.splice(idx, 1);

    if (tabs.length === 0) newTab();
    else if (activeTabId === id) switchTab(tabs[Math.max(0, idx - 1)].id);
    updateCount();
    saveTabs();
}

/* ============ EDITOR EVENTS ============ */
function bindEditorEvents(t) {
    var ta = t.editorEl;
    var dbSel = t.paneEl.querySelector('.db-sel');
    var resSearch = t.paneEl.querySelector('[data-role="resSearch"]');

    ta.addEventListener('input', function() {
        t.sql = ta.value;
        clearTimeout(ta._tmr);
        ta._tmr = setTimeout(function() {
            saveTabs();
            autoSuggest(t);
        }, 130);
    });

    dbSel.addEventListener('change', function() {
        t.db = dbSel.value;
        t.el.querySelector('.tab-dot').className = 'tab-dot ' + DB_META[t.db].dot;
        if (SUGGEST.dbFetched && SUGGEST.dbFetched !== t.db) {
            SUGGEST.loaded = false; SUGGEST.dbFetched = null;
        }
        updateStatus();
        toast("DB switched to " + DB_META[t.db].label);
        saveTabs();
    });

    if (resSearch) {
        resSearch.addEventListener('input', debounce(function() {
            t.filterText = resSearch.value;
            renderFilteredResult(t);
        }, 200));
    }

    ta.addEventListener('keydown', function(e) {
        var boxOpen = document.getElementById('acBox').style.display === 'block';

        // Ctrl+Space — multiple detection methods
        if (e.ctrlKey && (e.key === ' ' || e.code === 'Space' || e.keyCode === 32)) {
            e.preventDefault();
            e.stopPropagation();
            doSuggest(t.id);
            return false;
        }
        // F1 — backup
        if (e.key === 'F1') {
            e.preventDefault();
            doSuggest(t.id);
            return false;
        }
        if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); runQuery(t.id); return; }
        if (e.ctrlKey && (e.key === 't' || e.key === 'T')) { e.preventDefault(); newTab(); return; }
        if (e.ctrlKey && (e.key === 'w' || e.key === 'W')) { e.preventDefault(); closeTab(t.id); return; }
        if (e.ctrlKey && e.shiftKey && (e.key === 'f' || e.key === 'F')) { e.preventDefault(); formatSQL(t.id); return; }

        if (boxOpen && t.currentItems.length > 0) {
            if (e.key === 'ArrowDown') { e.preventDefault(); t.activeIdx = (t.activeIdx + 1) % t.currentItems.length; updateActive(t); return; }
            if (e.key === 'ArrowUp')   { e.preventDefault(); t.activeIdx = (t.activeIdx - 1 + t.currentItems.length) % t.currentItems.length; updateActive(t); return; }
            if (e.key === 'Enter' || e.key === 'Tab') {
                if (t.activeIdx >= 0) { e.preventDefault(); pickSuggestion(t, t.activeIdx); return; }
            }
            if (e.key === 'Escape') { e.preventDefault(); hideSuggest(t); return; }
        }
    });
}

function debounce(fn, ms) {
    var tm;
    return function() {
        var ctx = this, args = arguments;
        clearTimeout(tm);
        tm = setTimeout(function(){ fn.apply(ctx, args); }, ms);
    };
}

/* ============ SQL FORMATTER ============ */
function formatSQL(tabId) {
    var t = getTab(tabId); if (!t || t.isPinned) return;
    var raw = t.editorEl.value;
    if (!raw || !raw.trim()) { toast("Nothing to format.", true); return; }

    var sql = raw.replace(/\r\n/g, '\n').replace(/\s+/g, ' ').trim();
    var tokens = [];
    sql = sql.replace(/'[^']*'/g, function(m){ tokens.push(m); return '\u0001' + (tokens.length-1) + '\u0001'; });
    sql = sql.replace(/"[^"]*"/g, function(m){ tokens.push(m); return '\u0001' + (tokens.length-1) + '\u0001'; });
    sql = sql.replace(/--[^\n]*/g, function(m){ tokens.push(m); return '\u0001' + (tokens.length-1) + '\u0001'; });
    sql = sql.replace(/\/\*[\s\S]*?\*\//g, function(m){ tokens.push(m); return '\u0001' + (tokens.length-1) + '\u0001'; });

    var upper = sql.toUpperCase();
    var majorRegex = /\b(SELECT|FROM|WHERE|GROUP BY|ORDER BY|HAVING|UNION ALL|UNION|INSERT INTO|VALUES|UPDATE|SET|DELETE FROM|INNER JOIN|LEFT OUTER JOIN|RIGHT OUTER JOIN|LEFT JOIN|RIGHT JOIN|FULL JOIN|CROSS JOIN|JOIN|ON|AND|OR|WITH)\b/g;
    var matches = [];
    var m;
    while ((m = majorRegex.exec(upper)) !== null) {
        matches.push({ start: m.index, end: m.index + m[0].length, kw: m[0] });
    }

    var out = '';
    var prev = 0;
    var indent = 0;

    for (var k = 0; k < matches.length; k++) {
        var mk = matches[k];
        var beforeText = sql.substring(prev, mk.start).trim();
        if (beforeText) {
            if (out && !out.endsWith('\n') && !out.endsWith(' ')) out += ' ';
            out += beforeText;
        }
        var kw = mk.kw;
        if (kw === 'AND' || kw === 'OR' || kw === 'ON') {
            out += '\n' + '  '.repeat(indent + 1) + kw + ' ';
        } else {
            if (out) out += '\n';
            if (kw === 'UNION' || kw === 'UNION ALL') {
                out += kw + '\n'; indent = 0;
            } else if (kw === 'FROM' || kw === 'WHERE' || kw === 'GROUP BY' || kw === 'ORDER BY' || kw === 'HAVING') {
                out += kw + ' '; indent = 0;
            } else if (kw === 'SELECT') {
                out += kw + ' '; indent = 0;
            } else if (kw.indexOf('JOIN') !== -1) {
                out += '  ' + kw + ' '; indent = 1;
            } else {
                out += kw + ' ';
            }
        }
        prev = mk.end;
    }
    var afterText = sql.substring(prev).trim();
    if (afterText) {
        if (out && !out.endsWith('\n') && !out.endsWith(' ')) out += ' ';
        out += afterText;
    }

    out = out.replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
    out = out.replace(/\u0001(\d+)\u0001/g, function(_, n){ return tokens[parseInt(n, 10)]; });

    t.editorEl.value = out;
    t.sql = out;
    saveTabs();
    toast("Query formatted");
}

/* ============ SUGGESTIONS ============ */
function autoSuggest(t) {
    if (t.isPinned) return;
    var ctx = getCtx(t);
    if ((ctx.word && ctx.word.length >= 1) || ctx.dotBefore) {
        showSuggestInstant(t, false);
    } else {
        hideSuggest(t);
    }
}

function doSuggest(id) {
    var t = getTab(id); if (!t || t.isPinned) return;
    ensureSuggestLoaded(t);
    showSuggestInstant(t, true);
}

function showSuggestInstant(t, forceAll) {
    var ctx = getCtx(t);
    var items;

    var schemas, tables, keywords;
    if (SUGGEST.loaded && SUGGEST.dbFetched === t.db) {
        schemas  = SUGGEST.schemas;
        tables   = SUGGEST.tables;
        keywords = SUGGEST.keywords.length ? SUGGEST.keywords : BOOTSTRAP_KEYWORDS;
    } else {
        var fb = FALLBACK[t.db] || { schemas: [], tables: [] };
        schemas  = fb.schemas.map(function(s){ return { label: s, insert: s + ".", type: "SCHEMA" }; });
        tables   = fb.tables.map(function(tb){ return { label: tb, insert: tb, type: "TABLE" }; });
        keywords = BOOTSTRAP_KEYWORDS;
        ensureSuggestLoaded(t);
    }

    if (ctx.dotBefore) {
        var prefUp = ctx.prefix.toUpperCase();
        var isSchema = schemas.some(function(s){ return s.label.toUpperCase() === prefUp; });
        if (isSchema) {
            items = tables.filter(function(tb){
                return tb.label.toUpperCase().startsWith(prefUp + ".");
            }).map(function(tb){
                var shortName = tb.label.substring(tb.label.indexOf('.') + 1);
                return { label: shortName, insert: shortName, type: "TABLE" };
            });
            if (ctx.word) {
                var w = ctx.word.toLowerCase();
                items = items.filter(function(x){ return x.label.toLowerCase().indexOf(w) !== -1; });
            }
            renderSuggest(t, items);
        } else {
            fetchCols(t, ctx.prefix, function(cols){
                var w = (ctx.word || '').toLowerCase();
                var filtered = w ? cols.filter(function(c){ return c.label.toLowerCase().indexOf(w) !== -1; }) : cols;
                renderSuggest(t, filtered);
            });
        }
        return;
    }

    items = keywords.concat(schemas).concat(tables);
    var w = (ctx.word || '').toLowerCase();
    if (!forceAll && w) {
        var starts = [], contains = [];
        items.forEach(function(it){
            var l = it.label.toLowerCase();
            if (l.startsWith(w)) starts.push(it);
            else if (l.indexOf(w) !== -1) contains.push(it);
        });
        items = starts.concat(contains);
    }
    renderSuggest(t, items);
}

function ensureSuggestLoaded(t) {
    if (SUGGEST.loaded && SUGGEST.dbFetched === t.db) return;
    if (SUGGEST.loading) return;

    SUGGEST.loading = true;
    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'query.jsp?ajax=suggest&db=' + encodeURIComponent(t.db), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        SUGGEST.loading = false;
        if (xhr.status === 200) {
            try {
                var d = JSON.parse(xhr.responseText);
                var fb = FALLBACK[t.db] || { schemas: [], tables: [] };
                var fbSchemas = fb.schemas.map(function(s){ return { label: s, insert: s + ".", type: "SCHEMA" }; });
                var fbTables  = fb.tables.map(function(tb){ return { label: tb, insert: tb, type: "TABLE" }; });

                var seenS = {}; var mergedS = [];
                (d.schemas || []).concat(fbSchemas).forEach(function(s){
                    if (!seenS[s.label.toUpperCase()]) { seenS[s.label.toUpperCase()] = true; mergedS.push(s); }
                });
                var seenT = {}; var mergedT = [];
                (d.tables || []).concat(fbTables).forEach(function(tb){
                    var key = tb.label.toUpperCase();
                    if (!seenT[key]) { seenT[key] = true; mergedT.push(tb); }
                });

                SUGGEST.schemas  = mergedS;
                SUGGEST.tables   = mergedT;
                SUGGEST.keywords = (d.keywords && d.keywords.length) ? d.keywords : BOOTSTRAP_KEYWORDS;
                SUGGEST.loaded = true;
                SUGGEST.dbFetched = t.db;
            } catch(e) { console.error("Suggest parse error:", e); }
        }
    };
    xhr.send();
}

function renderSuggest(t, items) {
    var box = document.getElementById('acBox');
    if (!items || items.length === 0) { hideSuggest(t); return; }
    items = items.slice(0, 30);
    t.currentItems = items;
    t.activeIdx = 0;
    var html = '';
    items.forEach(function(it, i) {
        var cls = 'ac-item' + (i === 0 ? ' active' : '');
        var tag = it.type.split(':')[0];
        var tagTxt = tag === 'COLUMN' ? 'COL' : tag;
        html += '<div class="' + cls + '" onmousedown="event.preventDefault();" onclick="pickById(\'' + t.id + '\',' + i + ')">' +
                    '<span>' + escapeHtml(it.label) + '</span>' +
                    '<span class="ac-tag tag-' + tag + '">' + tagTxt + '</span>' +
                '</div>';
    });
    box.innerHTML = html;
    box.style.display = 'block';

    var p = caretXY(t.editorEl);
    var h = Math.min(320, items.length * 36 + 8);
    var top = p.top;
    if (top + h > window.innerHeight - 50) top = p.top - h - p.lineHeight - 6;
    box.style.left = Math.max(6, Math.min(p.left, window.innerWidth - 380)) + 'px';
    box.style.top  = top + 'px';
}

function hideSuggest(t) {
    document.getElementById('acBox').style.display = 'none';
    if (t) { t.currentItems = []; t.activeIdx = -1; }
}

function updateActive(t) {
    document.querySelectorAll('#acBox .ac-item').forEach(function(el, i){
        if (i === t.activeIdx) { el.classList.add('active'); el.scrollIntoView({block:'nearest'}); }
        else el.classList.remove('active');
    });
}

function pickById(tabId, idx) {
    var t = getTab(tabId); if (!t || t.isPinned) return;
    pickSuggestion(t, idx);
}

function pickSuggestion(t, idx) {
    if (idx < 0 || idx >= t.currentItems.length) return;
    var it = t.currentItems[idx];
    var ctx = getCtx(t);
    var val = t.editorEl.value;
    var before = val.substring(0, ctx.start);
    var after = val.substring(ctx.end);
    t.editorEl.value = before + it.insert + after;
    var np = before.length + it.insert.length;
    t.editorEl.selectionStart = t.editorEl.selectionEnd = np;
    t.sql = t.editorEl.value;
    hideSuggest(t);
    t.editorEl.focus();
}

/* ============================================================
 * fetchCols — with fallback columns
 * ============================================================ */
function fetchCols(t, schema, table, cb) {
    var key = (schema || '').toUpperCase() + '.' + table.toUpperCase();

    // 1. Check cache
    if (SUGGEST.columnCache[key]) { cb(SUGGEST.columnCache[key]); return; }

    // 2. Check fallback columns (instant)
    var fb = FALLBACK[t.db] || { columns: {} };
    var fbCols = fb.columns || {};
    var fallbackList = null;

    if (fbCols[key]) fallbackList = fbCols[key];
    else {
        var shortKey = table.toUpperCase();
        var prefSch = (schema || '').toUpperCase();
        for (var k in fbCols) {
            var ku = k.toUpperCase();
            if (ku === key || ku === (prefSch + '.' + shortKey) || ku.endsWith('.' + shortKey)) {
                fallbackList = fbCols[k];
                break;
            }
        }
    }

    if (fallbackList) {
        var quick = fallbackList.map(function(c){ return { label: c, insert: c, type: "COLUMN" }; });
        cb(quick);
        // Also try DB in background to enrich cache
        tryFetchColsFromDB(t, schema, table, key, null);
        return;
    }

    // 3. No fallback — fetch from DB
    tryFetchColsFromDB(t, schema, table, key, cb);
}

function tryFetchColsFromDB(t, schema, table, key, cb) {
    var url = 'query.jsp?ajax=cols&db=' + encodeURIComponent(t.db) +
              '&schema=' + encodeURIComponent(schema || '') +
              '&table=' + encodeURIComponent(table);
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState === 4 && xhr.status === 200) {
            try {
                var d = JSON.parse(xhr.responseText);
                SUGGEST.columnCache[key] = d;
                if (cb) cb(d);
            } catch(e){ if (cb) cb([]); }
        }
    };
    xhr.send();
}

function getCtx(t) {
    var ta = t.editorEl;
    var pos = ta.selectionStart;
    var val = ta.value;
    var s = pos;
    while (s > 0 && /[A-Za-z0-9_$#]/.test(val.charAt(s - 1))) s--;
    var e = pos;
    while (e < val.length && /[A-Za-z0-9_$#]/.test(val.charAt(e))) e++;
    var word = val.substring(s, pos);
    var prefix = "";
    var dotBefore = false;
    if (s > 0 && val.charAt(s - 1) === '.') {
        dotBefore = true;
        var p = s - 2;
        while (p >= 0 && /[A-Za-z0-9_$#]/.test(val.charAt(p))) p--;
        prefix = val.substring(p + 1, s - 1);
    }
    return { word: word, start: s, end: e, dotBefore: dotBefore, prefix: prefix };
}

function caretXY(ta) {
    var d = document.createElement('div');
    var st = window.getComputedStyle(ta);
    var ps = ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing',
              'paddingTop','paddingLeft','paddingRight','paddingBottom',
              'borderTopWidth','borderLeftWidth','whiteSpace','wordWrap','wordBreak'];
    ps.forEach(function(p){ d.style[p] = st[p]; });
    d.style.position = 'fixed';
    d.style.visibility = 'hidden';
    d.style.whiteSpace = 'pre-wrap';
    d.style.wordWrap = 'break-word';
    d.style.width = (ta.clientWidth - parseInt(st.paddingLeft) - parseInt(st.paddingRight)) + 'px';
    d.style.top = '-9999px';
    d.textContent = ta.value.substring(0, ta.selectionStart);
    var span = document.createElement('span');
    span.textContent = ta.value.substring(ta.selectionStart) || '.';
    d.appendChild(span);
    document.body.appendChild(d);
    var sr = span.getBoundingClientRect();
    var lineH = parseInt(st.lineHeight) || 24;
    var pos = { left: sr.left, top: sr.bottom + 2, lineHeight: lineH };
    document.body.removeChild(d);
    return pos;
}

/* ============ RUN QUERY ============ */
function runQuery(tabId) {
    var t = getTab(tabId); if (!t) return;
    if (t.isPinned) { toast("Pinned tab is read-only.", true); return; }
    var sql = t.editorEl.value.trim();
    if (!sql) { toast("Query is empty.", true); return; }
    if (t.running) { toast("Query already running in this tab.", true); return; }

    t.sql = t.editorEl.value;
    saveTabs();
    t.running = true;
    refreshTabHeader(t);
    setChip(t, "loading", "running");
    hideSuggest(t);

    var resBar = t.paneEl.querySelector('[data-role="resBar"]');
    resBar.style.display = 'none';
    resBar.querySelector('[data-role="qType"]').textContent = '\u2014';
    resBar.querySelector('[data-role="qRows"]').textContent = '\u2014';
    var tEl0 = resBar.querySelector('[data-role="qTime"]');
    tEl0.textContent = '\u2014';
    tEl0.className = '';
    resBar.querySelector('[data-role="qDb"]').textContent = '\u2014';

    t.filterText = "";
    t.sortCol = null;
    t.sortDir = null;
    var searchInp = t.paneEl.querySelector('[data-role="resSearch"]');
    if (searchInp) searchInp.value = '';
    t.rawRows = null;
    t.rawCols = null;
    t.lastResult = null;
    var expBtn = t.paneEl.querySelector('.tb-export');
    if (expBtn) expBtn.disabled = true;
    var pinBtn = t.paneEl.querySelector('[data-role="pinBtn"]');
    if (pinBtn) pinBtn.disabled = true;

    var resBody = t.paneEl.querySelector('[data-role="resBody"]');
    resBody.innerHTML = '' +
        '<div class="loader-overlay">' +
            '<div class="loader-big"></div>' +
            '<div class="loader-text">Executing query...</div>' +
            '<div class="loader-sub">Target: ' + DB_META[t.db].label + '</div>' +
        '</div>';

    var xhr = new XMLHttpRequest();
    xhr.open('POST', 'query.jsp?ajax=run', true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
    var payload = 'sql=' + encodeURIComponent(sql) + '&dbType=' + encodeURIComponent(t.db);

    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        t.running = false;
        refreshTabHeader(t);

        if (xhr.status !== 200) {
            resBody.innerHTML = '<div class="alert alert-err">HTTP ' + xhr.status + ' — execution failed.</div>';
            setChip(t, "err", "error");
            updateStatus();
            toast("HTTP " + xhr.status, true);
            return;
        }
        try {
            var res = JSON.parse(xhr.responseText);
            t.lastExecMs = res.executionTimeMs;
            t.lastResult = res;

            resBar.style.display = 'flex';
            resBar.querySelector('[data-role="qType"]').textContent = res.queryType || '\u2014';
            resBar.querySelector('[data-role="qRows"]').textContent = (res.rows ? res.rows.length : 0);
            resBar.querySelector('[data-role="qDb"]').textContent = DB_META[t.db].label;

            var tEl = resBar.querySelector('[data-role="qTime"]');
            tEl.textContent = res.executionTimeMs + ' ms';
            tEl.className = 'res-time ' + (res.executionTimeMs < 500 ? 'ok' : res.executionTimeMs < 3000 ? 'warn' : 'slow');

            if (res.success && res.columns && res.columns.length > 0) {
                t.rawCols = res.columns.slice();
                t.rawRows = res.rows ? res.rows.slice() : [];
            } else {
                t.rawCols = null;
                t.rawRows = null;
            }

            renderFilteredResult(t);

            setChip(t, res.success ? "ok" : "err", res.success ? "success" : "error");
            if (expBtn) expBtn.disabled = !(res.success && t.rawRows && t.rawRows.length > 0);
            if (pinBtn) pinBtn.disabled = !(res.success && t.rawRows && t.rawRows.length > 0);

            updateStatus();
            toast(res.success ? "Query ran in " + res.executionTimeMs + " ms" : "Query failed", !res.success);
        } catch(e) {
            resBody.innerHTML = '<div class="alert alert-err">Parse error: ' + escapeHtml(e.message) + '</div>';
            setChip(t, "err", "parse error");
            updateStatus();
        }
    };
    xhr.send(payload);
}

/* ============ FILTER + SORT + RENDER ============ */
function renderFilteredResult(t) {
    var resBody = t.paneEl.querySelector('[data-role="resBody"]');
    var res = t.lastResult;

    if (!res) {
        resBody.innerHTML = '<div class="placeholder"><div class="ph-icon">&#9654;</div><div class="ph-title">Ready</div></div>';
        return;
    }
    if (!res.success) {
        resBody.innerHTML = '<div class="alert alert-err">' + escapeHtml(res.message) + '</div>';
        return;
    }
    if (!t.rawCols || !t.rawRows || t.rawRows.length === 0) {
        var msg = res.updateCount >= 0 ? ('Rows affected: ' + res.updateCount) : 'Query executed. 0 rows returned.';
        resBody.innerHTML = '<div class="alert alert-ok">' + escapeHtml(res.message) + '</div>' +
                            '<div class="placeholder"><div class="ph-title">0 rows</div><div class="ph-sub">' + escapeHtml(msg) + '</div></div>';
        return;
    }

    var filter = (t.filterText || '').toLowerCase().trim();
    var rows = t.rawRows;
    if (filter) {
        rows = rows.filter(function(row){
            for (var i = 0; i < t.rawCols.length; i++) {
                var v = row[t.rawCols[i]];
                if (v != null && String(v).toLowerCase().indexOf(filter) !== -1) return true;
            }
            return false;
        });
    }
    if (t.sortCol) {
        var col = t.sortCol;
        var dir = t.sortDir === 'desc' ? -1 : 1;
        rows = rows.slice().sort(function(a, b){
            var va = a[col], vb = b[col];
            if (va == null && vb == null) return 0;
            if (va == null) return 1;
            if (vb == null) return -1;
            var na = parseFloat(va), nb = parseFloat(vb);
            if (!isNaN(na) && !isNaN(nb) && String(va).trim() === String(na) && String(vb).trim() === String(nb)) {
                return (na - nb) * dir;
            }
            return String(va).localeCompare(String(vb)) * dir;
        });
    }

    var frag = document.createDocumentFragment();

    var alertDiv = document.createElement('div');
    alertDiv.className = 'alert alert-ok';
    alertDiv.innerHTML = escapeHtml(res.message) +
        (filter ? ' <b>(' + rows.length + ' of ' + t.rawRows.length + ' shown)</b>' : '');
    frag.appendChild(alertDiv);

    if (rows.length > ROW_LIMIT_RENDER) {
        var warn = document.createElement('div');
        warn.className = 'alert alert-ok';
        warn.style.margin = '0 24px 12px 24px';
        warn.style.fontSize = '13.5px';
        warn.innerHTML = 'Showing first <b>' + ROW_LIMIT_RENDER + '</b> rows of <b>' + rows.length + '</b>. Use search to narrow.';
        frag.appendChild(warn);
    }

    var wrap = document.createElement('div');
    wrap.className = 'table-scroll';

    var table = document.createElement('table');
    table.className = 'data';

    var thead = document.createElement('thead');
    var trh = document.createElement('tr');
    var thIdx = document.createElement('th');
    thIdx.className = 'th-idx';
    thIdx.textContent = '#';
    trh.appendChild(thIdx);

    t.rawCols.forEach(function(c){
        var th = document.createElement('th');
        var sortCls = '';
        var sortIcon = '\u21C5';
        if (t.sortCol === c) {
            if (t.sortDir === 'asc') { sortCls = 'sorted-asc'; sortIcon = '\u25B2'; }
            else { sortCls = 'sorted-desc'; sortIcon = '\u25BC'; }
        }
        th.className = sortCls;
        th.appendChild(document.createTextNode(c));
        var icon = document.createElement('span');
        icon.className = 'sort-icon';
        icon.textContent = sortIcon;
        th.appendChild(icon);
        th.onclick = function(){ sortByColumn(t.id, c); };
        trh.appendChild(th);
    });
    thead.appendChild(trh);
    table.appendChild(thead);

    var tbody = document.createElement('tbody');
    var limit = Math.min(rows.length, ROW_LIMIT_RENDER);
    for (var i = 0; i < limit; i++) {
        var row = rows[i];
        var tr = document.createElement('tr');
        var tdIdx = document.createElement('td');
        tdIdx.className = 'row-no';
        tdIdx.textContent = (i+1);
        tr.appendChild(tdIdx);

        for (var j = 0; j < t.rawCols.length; j++) {
            var c = t.rawCols[j];
            var v = row[c];
            var td = document.createElement('td');
            if (v === null || v === undefined) {
                var spanN = document.createElement('span');
                spanN.className = 'null-cell';
                spanN.textContent = 'NULL';
                td.appendChild(spanN);
            } else {
                var s = String(v);
                td.title = s;
                if (filter) {
                    td.innerHTML = highlightMatch(s, filter);
                } else {
                    td.textContent = s;
                }
            }
            tr.appendChild(td);
        }
        tbody.appendChild(tr);
    }
    table.appendChild(tbody);
    wrap.appendChild(table);
    frag.appendChild(wrap);

    resBody.innerHTML = '';
    resBody.appendChild(frag);
}

function renderPinnedResult(t) {
    var resBar = t.paneEl.querySelector('[data-role="resBar"]');
    var resBody = t.paneEl.querySelector('[data-role="resBody"]');
    if (!resBar || !resBody) return;

    var res = t.lastResult;
    if (!res) {
        resBody.innerHTML = '<div class="placeholder"><div class="ph-title">No data</div></div>';
        return;
    }

    resBar.querySelector('[data-role="qType"]').textContent = res.queryType || '\u2014';
    resBar.querySelector('[data-role="qRows"]').textContent = (res.rows ? res.rows.length : 0);
    var tEl = resBar.querySelector('[data-role="qTime"]');
    tEl.textContent = res.executionTimeMs + ' ms';
    tEl.className = 'res-time ' + (res.executionTimeMs < 500 ? 'ok' : res.executionTimeMs < 3000 ? 'warn' : 'slow');
    resBar.querySelector('[data-role="qDb"]').textContent = DB_META[t.db].label;

    var frag = document.createDocumentFragment();
    var alertDiv = document.createElement('div');
    alertDiv.className = 'alert alert-ok';
    alertDiv.textContent = res.message;
    frag.appendChild(alertDiv);

    if (t.rawCols && t.rawRows && t.rawRows.length > 0) {
        if (t.rawRows.length > ROW_LIMIT_RENDER) {
            var warn = document.createElement('div');
            warn.className = 'alert alert-ok';
            warn.style.margin = '0 24px 12px 24px';
            warn.style.fontSize = '13.5px';
            warn.innerHTML = 'Showing first <b>' + ROW_LIMIT_RENDER + '</b> rows of <b>' + t.rawRows.length + '</b>.';
            frag.appendChild(warn);
        }

        var wrap = document.createElement('div');
        wrap.className = 'table-scroll';

        var table = document.createElement('table');
        table.className = 'data';
        var thead = document.createElement('thead');
        var trh = document.createElement('tr');
        var thIdx = document.createElement('th');
        thIdx.className = 'th-idx';
        thIdx.textContent = '#';
        trh.appendChild(thIdx);
        t.rawCols.forEach(function(c){
            var th = document.createElement('th');
            th.textContent = c;
            trh.appendChild(th);
        });
        thead.appendChild(trh); table.appendChild(thead);

        var tbody = document.createElement('tbody');
        var limit = Math.min(t.rawRows.length, ROW_LIMIT_RENDER);
        for (var i = 0; i < limit; i++) {
            var row = t.rawRows[i];
            var tr = document.createElement('tr');
            var tdIdx = document.createElement('td');
            tdIdx.className = 'row-no';
            tdIdx.textContent = (i+1);
            tr.appendChild(tdIdx);
            for (var j = 0; j < t.rawCols.length; j++) {
                var c = t.rawCols[j];
                var v = row[c];
                var td = document.createElement('td');
                if (v === null || v === undefined) {
                    var spanN = document.createElement('span');
                    spanN.className = 'null-cell';
                    spanN.textContent = 'NULL';
                    td.appendChild(spanN);
                } else {
                    var s = String(v);
                    td.title = s;
                    td.textContent = s;
                }
                tr.appendChild(td);
            }
            tbody.appendChild(tr);
        }
        table.appendChild(tbody);
        wrap.appendChild(table);
        frag.appendChild(wrap);
    }

    resBody.innerHTML = '';
    resBody.appendChild(frag);
}

function sortByColumn(tabId, col) {
    var t = getTab(tabId); if (!t || t.isPinned) return;
    if (t.sortCol === col) {
        if (t.sortDir === 'asc') t.sortDir = 'desc';
        else if (t.sortDir === 'desc') { t.sortCol = null; t.sortDir = null; }
        else t.sortDir = 'asc';
    } else {
        t.sortCol = col;
        t.sortDir = 'asc';
    }
    renderFilteredResult(t);
}

function highlightMatch(text, filter) {
    var esc = escapeHtml(text);
    if (!filter) return esc;
    try {
        var re = new RegExp('(' + filter.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
        return esc.replace(re, '<span class="hl-match">$1</span>');
    } catch(e) { return esc; }
}

/* ============ PIN → NEW TAB ============ */
function pinCurrentResult(tabId) {
    var t = getTab(tabId); if (!t) return;
    if (t.isPinned) { toast("Already pinned.", true); return; }
    if (!t.lastResult || !t.lastResult.success || !t.rawCols || !t.rawRows || t.rawRows.length === 0) {
        toast("Nothing to pin — run a successful query first.", true);
        return;
    }
    newPinnedTab(t);
    toast("Result pinned into new tab");
}

/* ============ EXPORT EXCEL ============ */
function exportResult(tabId) {
    var t = getTab(tabId); if (!t) return;
    if (!t.rawCols || !t.rawRows || t.rawRows.length === 0) {
        toast("Nothing to export.", true);
        return;
    }
    var BOM = '\uFEFF';
    var lines = [];
    lines.push(t.rawCols.map(csvCell).join(','));
    t.rawRows.forEach(function(row){
        lines.push(t.rawCols.map(function(c){ return csvCell(row[c]); }).join(','));
    });
    var csv = BOM + lines.join('\r\n');
    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var stamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
    var fname = 'query_' + t.num + '_' + t.db + '_' + stamp + '.csv';
    var a = document.createElement('a');
    a.href = url; a.download = fname;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast("Exported " + t.rawRows.length + " rows");
}

function csvCell(v) {
    if (v === null || v === undefined) return '';
    var s = String(v);
    if (/[",\n\r]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
    return s;
}

/* ============ HELPERS ============ */
function setChip(t, type, text) {
    var el = t.paneEl.querySelector('[data-role="chip"]');
    if (!el) return;
    el.textContent = text || "idle";
    el.className = 'chip';
    if (type === 'ok') el.classList.add('ok');
    if (type === 'loading') el.classList.add('loading');
    if (type === 'err') el.classList.add('err');
}

function updateStatus() {
    var t = getTab(activeTabId);
    if (t) {
        document.getElementById('stDb').textContent = DB_META[t.db].label;
        document.getElementById('stTab').innerHTML = 'Tab: <b>' + escapeHtml(t.title) + '</b>' +
            (t.isPinned ? ' <span style="color:#a78bfa;">&#128204;</span>' : '') +
            (t.running ? ' <span style="color:#60a5fa;">&#9679; running</span>' : '');
        document.getElementById('stLast').innerHTML = 'Last exec: <b>' + (t.lastExecMs != null ? t.lastExecMs + ' ms' : '\u2014') + '</b>';
    }
    document.getElementById('stCount').textContent = tabs.length + (tabs.length === 1 ? ' tab' : ' tabs');
    document.getElementById('qCount').textContent = document.querySelectorAll('.qitem').length;
}

function updateCount() { updateStatus(); }

function clearEditor(id) {
    var t = getTab(id); if (!t || t.isPinned) return;
    t.editorEl.value = '';
    t.sql = '';
    t.editorEl.focus();
    hideSuggest(t);
    saveTabs();
}

/* ============ SIDEBAR ============ */
function toggleGroup(el) {
    var body = el.nextElementSibling;
    var open = body.classList.toggle('open');
    el.classList.toggle('open', open);
}

function loadQuery(el) {
    var sqlEl = el.querySelector('.q-sql');
    if (!sqlEl) return;
    var text = (sqlEl.textContent || sqlEl.innerText).replace(/^\s*\n+/, '').replace(/\s+$/, '');
    var t = getTab(activeTabId);
    if (!t) return;
    if (t.isPinned) {
        t = newTab();
    }
    t.editorEl.value = text;
    t.sql = text;
    t.editorEl.focus();
    t.editorEl.selectionStart = t.editorEl.selectionEnd = text.length;
    document.querySelectorAll('.qitem').forEach(function(i){ i.classList.remove('active'); });
    el.classList.add('active');
    saveTabs();
    toast("Loaded into " + t.title);
}

document.getElementById('qSearch').addEventListener('input', debounce(function(e) {
    var q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.tgroup').forEach(function(g){
        var items = g.querySelectorAll('.qitem');
        var any = false;
        items.forEach(function(it){
            var txt = it.textContent.toLowerCase();
            if (!q || txt.indexOf(q) !== -1) { it.style.display = ''; any = true; }
            else it.style.display = 'none';
        });
        g.style.display = (any || !q) ? '' : 'none';
        if (q && any) {
            g.querySelector('.tgroup-body').classList.add('open');
            g.querySelector('.tgroup-head').classList.add('open');
        }
    });
}, 150));

/* ============ UTILS ============ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function(){
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function(){ el.remove(); }, 320);
    }, 2400);
}

/* ============ PERSIST ============ */
function saveTabs() {
    try {
        localStorage.setItem('eis_qc_v6', JSON.stringify({
            tabs: tabs.map(function(t){
                return { num: t.num, db: t.db, sql: t.sql, title: t.title, isPinned: t.isPinned, pinnedSql: t.pinnedSql };
            }),
            active: activeTabId,
            usedNumbers: usedNumbers
        }));
    } catch(e){}
}

function restoreTabs() {
    try {
        var raw = localStorage.getItem('eis_qc_v6');
        if (!raw) return false;
        var d = JSON.parse(raw);
        if (!d || !d.tabs || !d.tabs.length) return false;
        usedNumbers = d.usedNumbers || {};
        d.tabs.forEach(function(td){
            var t = new Tab(td.num || nextFreeNum(), td.db || DEFAULT_DB);
            t.sql = td.sql || '';
            t.title = td.title || ("Query " + t.num);
            t.isPinned = !!td.isPinned;
            t.pinnedSql = td.pinnedSql || '';
            tabs.push(t);
            renderTab(t);
            if (t.editorEl) t.editorEl.value = t.sql;
        });
        switchTab(d.active || tabs[0].id);
        return true;
    } catch(e){ return false; }
}

/* ============================================================
 * GLOBAL Ctrl+Space (backup — works if editor is focused)
 * ============================================================ */
document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && (e.key === ' ' || e.code === 'Space' || e.keyCode === 32)) {
        var t = getTab(activeTabId);
        if (!t || t.isPinned) return;
        var active = document.activeElement;
        if (active && active.classList && active.classList.contains('sql')) {
            e.preventDefault();
            e.stopPropagation();
            doSuggest(t.id);
        }
    }
}, true);

/* ============ INIT ============ */
window.addEventListener('load', function() {
    if (!restoreTabs()) newTab();
    var firstBody = document.querySelector('.tgroup-body');
    var firstHead = document.querySelector('.tgroup-head');
    if (firstBody && firstHead) {
        firstBody.classList.add('open');
        firstHead.classList.add('open');
    }
    setTimeout(function() {
        var t = getTab(activeTabId);
        if (t && !t.isPinned) ensureSuggestLoaded(t);
    }, 400);
    updateCount();
});

document.addEventListener('mousedown', function(e) {
    if (!e.target.closest('#acBox')) {
        var t = getTab(activeTabId);
        if (t) hideSuggest(t);
    }
});
</script>
