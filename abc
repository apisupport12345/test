            flex: 1;
            justify-content: center;
            min-width: 0;
            flex-wrap: wrap;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            white-space: nowrap;
            transition: all 0.2s ease;
        }
        .pill i { font-size: 0.75rem; }
        .pill.timer { background: rgba(99, 102, 241, 0.12); color: var(--primary); border-color: rgba(99, 102, 241, 0.3); }
        .pill.timer.warning-state { background: rgba(245, 158, 11, 0.15); color: var(--warning); border-color: rgba(245, 158, 11, 0.4); animation: pulseWarn 1s ease-in-out infinite; }
        @keyframes pulseWarn { 0%,100% { transform: scale(1); } 50% { transform: scale(1.04); } }
        .pill.window { background: var(--bg-elevated); color: var(--text-primary); }
        .pill.pr { background: rgba(16, 185, 129, 0.12); color: var(--success); border-color: rgba(16, 185, 129, 0.3); }
        .pill.dr { background: rgba(139, 92, 246, 0.12); color: var(--isolated); border-color: rgba(139, 92, 246, 0.3); }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            flex-shrink: 0;
        }
        .icon-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.85rem;
        }
        .icon-btn:hover {
            background: var(--bg-hover);
            color: var(--primary);
            border-color: var(--primary);
            transform: translateY(-1px);
        }
        .icon-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* ============================================================
           STATS BAR — COMPACT single-line
           ============================================================ */
        .stats-bar {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 0.65rem 1.25rem;
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 0.5rem;
            transition: background 0.3s ease, border-color 0.3s ease;
        }
        .stat-mini {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.4rem 0.65rem;
            border-radius: 0.55rem;
            background: var(--bg-elevated);
            border-left: 3px solid var(--primary);
            min-width: 0;
            transition: all 0.2s ease;
        }
        .stat-mini:hover { background: var(--bg-hover); transform: translateY(-1px); }
        .stat-mini.critical { border-left-color: var(--danger); }
        .stat-mini.warning { border-left-color: var(--warning); }
        .stat-mini.healthy { border-left-color: var(--success); }
        .stat-mini.isolated { border-left-color: var(--isolated); }
        .stat-mini.info { border-left-color: var(--info); }
        .stat-mini-icon {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            color: white;
            flex-shrink: 0;
            background: var(--primary);
        }
        .stat-mini.info .stat-mini-icon { background: var(--info); }
        .stat-mini.critical .stat-mini-icon { background: var(--danger); }
        .stat-mini.warning .stat-mini-icon { background: var(--warning); }
        .stat-mini.healthy .stat-mini-icon { background: var(--success); }
        .stat-mini.isolated .stat-mini-icon { background: var(--isolated); }
        .stat-mini-text { display: flex; flex-direction: column; min-width: 0; }
        .stat-mini-value {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1;
        }
        .stat-mini-label {
            font-size: 0.65rem;
            color: var(--text-muted);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ============================================================
           BANNERS
           ============================================================ */
        .banner {
            padding: 0.5rem 1.25rem;
            text-align: center;
            font-weight: 600;
            font-size: 0.82rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        .fallback-banner { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; }
        .slot-info-banner { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; }

        /* ============================================================
           MAIN LAYOUT
           ============================================================ */
        .main-content {
            display: grid;
            grid-template-columns: 360px minmax(0, 1fr);
            gap: 1rem;
            padding: 1rem 1.25rem;
            align-items: start;
            width: 100%;
        }
        .left-panel { display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }
        .right-panel { display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }

        /* ============================================================
           CARD
           ============================================================ */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 0.7rem;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

        /* ============================================================
           TIME FILTER
           ============================================================ */
        .time-filter-header {
            padding: 0.75rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            background: var(--bg-elevated);
            transition: background 0.2s ease;
        }
        .time-filter-header:hover { background: var(--bg-hover); }
        .time-filter-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .time-filter-toggle { color: var(--text-muted); transition: transform 0.3s ease; font-size: 0.8rem; }
        .time-filter-toggle.expanded { transform: rotate(180deg); }
        .time-filter-content { display: none; padding: 1rem; border-top: 1px solid var(--border); }
        .time-filter-content.expanded { display: block; }
        .time-filter-form { display: flex; flex-direction: column; gap: 0.75rem; }
        .time-filter-group { display: flex; flex-direction: column; gap: 0.35rem; }
        .time-filter-label { font-size: 0.78rem; font-weight: 700; color: var(--text-secondary); }
        .time-filter-input {
            padding: 0.55rem 0.7rem;
            border: 1px solid var(--border-strong);
            border-radius: 0.5rem;
            font-size: 0.85rem;
            background: var(--bg-card);
            color: var(--text-primary);
            font-family: inherit;
            width: 100%;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .time-filter-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }
        .time-filter-actions { display: flex; gap: 0.5rem; }
        .time-filter-actions .btn { flex: 1; justify-content: center; }
        .quick-filter-buttons { display: flex; gap: 0.4rem; margin-top: 0.75rem; flex-wrap: wrap; }
        .quick-filter-btn {
            background: var(--bg-elevated);
            color: var(--text-secondary);
            border: 1px solid var(--border-strong);
            padding: 0.4rem 0.7rem;
            border-radius: 0.5rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.78rem;
            font-family: inherit;
            flex: 1;
            min-width: 0;
        }
        .quick-filter-btn:hover { background: var(--bg-hover); border-color: var(--primary); color: var(--primary); }
        .quick-filter-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

        /* ============================================================
           BUTTONS
           ============================================================ */
        .btn {
            background: var(--bg-elevated);
            color: var(--text-secondary);
            border: 1px solid var(--border-strong);
            padding: 0.5rem 0.9rem;
            border-radius: 0.5rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.82rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: inherit;
            white-space: nowrap;
        }
        .btn:hover { background: var(--bg-hover); border-color: var(--primary); color: var(--primary); transform: translateY(-1px); }
        .btn.primary { background: var(--primary); color: white; border-color: var(--primary); }
        .btn.primary:hover { background: var(--primary-dark); color: white; }
        .btn.isolated { background: var(--isolated); color: white; border-color: var(--isolated); }
        .btn.isolated:hover { color: white; }
        .btn.success { background: var(--success); color: white; border-color: var(--success); }
        .btn.success:hover { color: white; }

        .controls-row {
            display: flex;
            gap: 0.45rem;
            flex-wrap: wrap;
        }
        .controls-row .btn { flex: 1; justify-content: center; }

        /* ============================================================
           IMPACTED SECTIONS
           ============================================================ */
        .impacted-section {
            border-left: 4px solid var(--danger);
        }
        .impacted-section.isolated { border-left-color: var(--isolated); }
        .impacted-header {
            padding: 0.7rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.5rem;
            border-bottom: 1px solid var(--border);
        }
        .impacted-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--danger);
            display: flex;
            align-items: center;
            gap: 0.45rem;
        }
        .impacted-title.isolated { color: var(--isolated); }
        .impacted-count {
            background: var(--danger);
            color: white;
            padding: 0.15rem 0.6rem;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 700;
        }
        .impacted-count.isolated { background: var(--isolated); }
        .impacted-content { padding: 0.75rem 1rem; max-height: 240px; overflow-y: auto; }
        .impacted-list { display: flex; flex-direction: column; gap: 0.45rem; }
        .impacted-server-item {
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            padding: 0.55rem 0.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            font-size: 0.83rem;
            position: relative;
            overflow: hidden;
        }
        .impacted-server-item::before { content: ''; position: absolute; left: 0; top: 0; height: 100%; width: 3px; background: var(--danger); }
        .impacted-server-item.warning::before { background: var(--warning); }
        .impacted-server-item.isolated::before { background: var(--isolated); }
        .impacted-server-item:hover { background: var(--bg-hover); }
        .impacted-broker { font-weight: 700; color: var(--text-primary); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .impacted-ip { color: var(--text-muted); font-family: 'Courier New', monospace; flex-shrink: 0; font-weight: 600; font-size: 0.8rem; }
        .impacted-hits {
            color: white;
            padding: 0.15rem 0.55rem;
            border-radius: 0.35rem;
            font-weight: 700;
            font-size: 0.72rem;
            min-width: 50px;
            text-align: center;
        }
        .impacted-hits.critical { background: var(--danger); }
        .impacted-hits.warning { background: var(--warning); }
        .impacted-hits.isolated { background: var(--isolated); }

        /* ============================================================
           BROKER CARDS
           ============================================================ */
        .broker-cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 0.85rem;
            width: 100%;
        }
        .broker-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 0.7rem;
            box-shadow: var(--card-shadow);
            transition: all 0.25s ease;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            min-width: 0;
        }
        .broker-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; }
        .broker-card.critical::before { background: var(--danger); }
        .broker-card.warning::before { background: var(--warning); }
        .broker-card.healthy::before { background: var(--success); }
        .broker-card.isolated::before { background: var(--isolated); }
        .broker-card:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }

        .broker-header {
            padding: 0.75rem 0.95rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.6rem;
        }
        .broker-info { flex: 1; min-width: 0; }
        .broker-name {
            font-size: 1rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 0.2rem;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            word-break: break-word;
            line-height: 1.2;
        }
        .broker-port { color: var(--text-muted); font-size: 0.78rem; font-weight: 600; }
        .broker-port i { margin-right: 0.25rem; color: var(--text-faint); }
        .broker-status { display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem; flex-shrink: 0; }
        .status-badge {
            padding: 0.22rem 0.6rem;
            border-radius: 999px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            white-space: nowrap;
            color: white;
        }
        .status-badge.healthy { background: var(--success); }
        .status-badge.warning { background: var(--warning); }
        .status-badge.critical { background: var(--danger); }
        .status-badge.isolated { background: var(--isolated); }
        .total-hits { color: var(--text-primary); font-size: 1rem; font-weight: 800; white-space: nowrap; line-height: 1; }
        .total-hits-label { font-size: 0.6rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }

        .broker-body { padding: 0.75rem 0.95rem; flex: 1; display: flex; flex-direction: column; gap: 0.75rem; }
        .server-stats {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 0.35rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--border);
        }
        .server-stat {
            text-align: center;
            padding: 0.4rem 0.2rem;
            border-radius: 0.45rem;
            background: var(--bg-elevated);
            min-width: 0;
            transition: background 0.2s ease;
        }
        .server-stat:hover { background: var(--bg-hover); }
        .server-stat-value { font-size: 1rem; font-weight: 800; color: var(--text-primary); line-height: 1; margin-bottom: 0.2rem; }
        .server-stat-label { font-size: 0.6rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; }

        .server-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 0.4rem;
        }
        .server-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.45rem 0.6rem;
            background: var(--bg-elevated);
            border-radius: 0.45rem;
            transition: background 0.2s;
            font-size: 0.78rem;
            border-left: 3px solid var(--border-strong);
            position: relative;
            min-width: 0;
        }
        .server-item:hover { background: var(--bg-hover); }
        .server-ip {
            font-weight: 700;
            color: var(--text-secondary);
            font-family: 'Courier New', monospace;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.78rem;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .server-hits {
            font-weight: 800;
            padding: 0.2rem 0.45rem;
            border-radius: 0.35rem;
            background: var(--bg-card);
            border: 1px solid var(--border);
            min-width: 2.75rem;
            text-align: center;
            font-size: 0.72rem;
            flex-shrink: 0;
            color: var(--text-secondary);
        }
        .server-hits.healthy { color: var(--success); border-color: var(--success); background: rgba(16, 185, 129, 0.1); }
        .server-hits.warning { color: var(--warning); border-color: var(--warning); background: rgba(245, 158, 11, 0.1); }
        .server-hits.critical, .server-hits.zero { color: var(--danger); border-color: var(--danger); background: rgba(239, 68, 68, 0.1); }
        .server-hits.isolated { color: var(--isolated); border-color: var(--isolated); background: rgba(139, 92, 246, 0.1); }

        .broker-footer {
            padding: 0.5rem 0.95rem;
            background: var(--bg-footer);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.72rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* ============================================================
           STATUS INDICATORS
           ============================================================ */
        .status-indicator { display: inline-block; width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
        .status-indicator.healthy { background: var(--success); }
        .status-indicator.warning { background: var(--warning); }
        .status-indicator.critical { background: var(--danger); }
        .status-indicator.isolated { background: var(--isolated); }

        /* ============================================================
           TOOLTIP
           ============================================================ */
        [data-full-ip] { position: relative; cursor: help; }
        [data-full-ip]:hover::after {
            content: attr(data-full-ip);
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            padding: 0.35rem 0.7rem;
            background: var(--text-primary);
            color: var(--bg-card);
            border-radius: 0.35rem;
            font-size: 0.72rem;
            white-space: nowrap;
            z-index: 1000;
            pointer-events: none;
            margin-bottom: 0.35rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.15);
        }

        /* ============================================================
           NO DATA STATES
           ============================================================ */
        .no-impacted { text-align: center; color: var(--text-muted); padding: 1.25rem 0.75rem; font-size: 0.85rem; }
        .no-impacted i { font-size: 1.5rem; margin-bottom: 0.4rem; display: block; }
        .no-impacted p { margin-bottom: 0.15rem; font-weight: 600; }
        .no-impacted small { color: var(--text-faint); font-size: 0.72rem; }

        /* ============================================================
           ANIMATIONS
           ============================================================ */
        @keyframes softBlinkCritical { 0%, 90% { opacity: 1; } 92% { opacity: 0.85; } 94% { opacity: 1; } 96% { opacity: 0.85; } 98% { opacity: 1; } }
        @keyframes softBlinkWarning { 0%, 92% { opacity: 1; } 94% { opacity: 0.9; } 96% { opacity: 1; } 98% { opacity: 0.9; } }
        @keyframes softBlinkIsolated { 0%, 88% { opacity: 1; } 91% { opacity: 0.8; } 94% { opacity: 1; } 97% { opacity: 0.8; } }

        .broker-card.critical { border-left: 3px solid var(--danger); animation: softBlinkCritical 5s ease-in-out infinite; }
        .broker-card.warning { border-left: 3px solid var(--warning); animation: softBlinkWarning 7s ease-in-out infinite; }
        .broker-card.isolated { border-left: 3px solid var(--isolated); animation: softBlinkIsolated 3s ease-in-out infinite; }
        .status-badge.critical { animation: softBlinkCritical 5s ease-in-out infinite; }
        .status-badge.warning { animation: softBlinkWarning 7s ease-in-out infinite; }
        .status-badge.isolated { animation: softBlinkIsolated 3s ease-in-out infinite; }
        .impacted-count { animation: softBlinkCritical 5s ease-in-out infinite; }
        .impacted-count.isolated { animation: softBlinkIsolated 3s ease-in-out infinite; }
        .status-indicator.critical { animation: softBlinkCritical 5s ease-in-out infinite; }
        .status-indicator.warning { animation: softBlinkWarning 7s ease-in-out infinite; }
        .status-indicator.isolated { animation: softBlinkIsolated 3s ease-in-out infinite; }

        .no-blink .broker-card.critical, .no-blink .broker-card.warning, .no-blink .broker-card.isolated,
        .no-blink .status-badge.critical, .no-blink .status-badge.warning, .no-blink .status-badge.isolated,
        .no-blink .impacted-count, .no-blink .impacted-count.isolated,
        .no-blink .status-indicator.critical, .no-blink .status-indicator.warning, .no-blink .status-indicator.isolated { animation: none !important; opacity: 1 !important; }

        /* ============================================================
           FOCUS
           ============================================================ */
        .btn:focus, .quick-filter-btn:focus, .time-filter-input:focus, .icon-btn:focus { outline: 2px solid rgba(99, 102, 241, 0.4); outline-offset: 1px; }

        /* ============================================================
           OVERLAY
           ============================================================ */
        #chromeVoiceOverlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.95);
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .overlay-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 2rem;
            border-radius: 1rem;
            text-align: center;
            max-width: 420px;
            margin: 1rem;
            color: white;
        }
        .overlay-box i { font-size: 3rem; margin-bottom: 0.75rem; }
        .overlay-box h3 { margin-bottom: 0.5rem; font-size: 1.25rem; }
        .overlay-box p { margin-bottom: 1rem; line-height: 1.4; font-size: 0.9rem; opacity: 0.95; }
        .overlay-box button {
            background: white;
            color: #667eea;
            border: none;
            padding: 0.65rem 1.5rem;
            border-radius: 0.6rem;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
        }

        /* ============================================================
           SCROLLBAR
           ============================================================ */
        .impacted-content::-webkit-scrollbar { width: 6px; }
        .impacted-content::-webkit-scrollbar-track { background: var(--scrollbar-track); border-radius: 3px; }
        .impacted-content::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 3px; }
        .impacted-content::-webkit-scrollbar-thumb:hover { background: var(--text-faint); }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 1200px) {
            .stats-bar { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .main-content { grid-template-columns: 320px minmax(0, 1fr); }
            .broker-cards-container { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
        }

