WITH gen5_base AS (
    SELECT 
        ip, 
        type, 
        route_url, 
        lb_url AS gen5_lb_url,
        -- Path nikaalo gen5 prefix hata ke
        UPPER(REGEXP_REPLACE(lb_url, '^.*?/gen5/(gateway/|getway/)?', '', 1, 0, 'i')) AS gen5_path,
        UPPER(REGEXP_SUBSTR(lb_url, '[^/]+$')) AS gen5_op
    FROM daily_dpg_url_data
    WHERE (UPPER(lb_url) LIKE 'GEN5/GATEWAY%'
        OR UPPER(lb_url) LIKE 'GEN5%GATEWAY%'
        OR UPPER(lb_url) LIKE '%GEN5/GETWAY%'
        OR UPPER(lb_url) LIKE '%SIAPP3%GEN5%')
),
gen6_base AS (
    SELECT 
        ip, 
        type, 
        route_url, 
        lb_url AS gen6_lb_url,
        -- Path nikaalo gen6 prefix hata ke
        UPPER(REGEXP_REPLACE(lb_url, '^.*?/gen6/(gateway/|getway/)?', '', 1, 0, 'i')) AS gen6_path,
        UPPER(REGEXP_SUBSTR(lb_url, '[^/]+$')) AS gen6_op
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) NOT LIKE '%GEN5%'
      AND UPPER(lb_url) NOT LIKE '%GEN5/GATEWAY%'
)
SELECT 
    g5.ip,
    g5.type,
    g5.gen5_lb_url,
    g6.gen6_lb_url,
    g5.route_url,
    SYSDATE
FROM gen5_base g5
LEFT JOIN gen6_base g6
  ON g5.route_url = g6.route_url
 AND (g5.ip = g6.ip OR g6.ip IS NULL)
 AND (g5.type = g6.type OR g6.type IS NULL)
 AND (
      -- Path match (gen5 path = gen6 path)
      g5.gen5_path = g6.gen6_path
      OR
      -- Ya last segment match
      g5.gen5_op = g6.gen6_op
 );
