select trim(api_name),TRIM(sys_ip),
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN error_code is null or error_code = 'CK001' THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) As "SI001",
SUM(CASE WHEN error_code ='SI002' then 1 else 0 end) As "SI002",
SUM(CASE WHEN substr(error_code,3,3) ='002' AND error_code <>'SI002' then 1 else 0 end) As "DYNAMIC 002",
SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) As "SI007",
SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) As "SI051",
SUM(CASE WHEN error_code ='SI052' then 1 else 0 end) As "SI052",
SUM(CASE WHEN substr(error_code,3,3) ='052' AND error_code <>'SI052' then 1 else 0 end) As "DYNAMIC 052",
SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) AS "014",
SUM(CASE WHEN error_code ='SI569' then 1 else 0 end) As "SI569",
SUM(CASE WHEN error_code ='SI570' then 1 else 0 end) As "SI570",
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') or error_code in('SI001','SI007','SI017','SI569','SI570','SI052','SI077','SI051','SI111')) and error_code<>'00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI052','SI077','SI569','SI570')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT,
SUM(CASE  WHEN ((nvl( substr(error_code,3,3),'A') not in  ('002','014') and  error_code not in('SI001','SI007','SI017','SI569','SI570','SI052','SI077','SI051','SI111')) AND error_code <> 'CK001'  OR error_code IN ('00014','70007') ) THEN 1 ELSE 0 END) AS BD,
ROUND((SUM(CASE WHEN (nvl( substr(error_code,3,3),'A') NOT in ('001','002','007','052','051','014') OR error_code IN ('00014','70007') ) AND error_code <> 'CK001' and error_code IS NOT NULL THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS BD_PERCENT
from eisapp.BACKEND_LOG where
api_name in ('thirdPartyINBIpo_sys','thirdPartyNSEAuth_sys','thirdPartyBSEAuth_sys') and 
--creation_date_time >= sysdate - interval '05' minute
creation_date_time between to_date('16-SEP-2026 00:00:00','DD-MON-YYYY HH24:MI:SS') and to_date('16-SEP-2026 14:00:00','DD-MON-YYYY HH24:MI:SS')
GROUP BY trim(api_name),TRIM(sys_ip)
ORDER BY 1,2;

