            <div class="info-section-title red">
                TD <span class="count-pill" id="tdListCount">0</span>
            </div>
            <div class="short-list" id="tdList"></div>

            <div class="info-section-title amber">
                BD <span class="count-pill" id="bdListCount">0</span>
            </div>
            <div class="short-list" id="bdList"></div>

