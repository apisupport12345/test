<script>
/* ============================================================
 * IPO MONITORING DASHBOARD — v4.0 (IP Card Based)
 * ============================================================ */

var REFRESH_INTERVAL_SEC = 300;
var secondsLeft = 0;
var countdownTimer = null;
var isRefreshing = false;

/* ============ COUNTDOWN ============ */
function startCountdown() {
    if (countdownTimer) clearInterval(countdownTimer);
    secondsLeft = REFRESH_INTERVAL_SEC;
    updateCountdownUI();
    countdownTimer = setInterval(function() {
        secondsLeft--;
        if (secondsLeft <= 0) { secondsLeft = REFRESH_INTERVAL_SEC; refreshNow(); }
        updateCountdownUI();
    }, 1000);
}

function stopCountdown() {
    if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
}

function updateCountdownUI() {
    var el = document.getElementById('countdown');
    if (!el) return;
    if (isRefreshing) { el.innerHTML = '<span style="color:#ffb020;">&#8635; Refreshing...</span>'; return; }
    var m = Math.floor(secondsLeft / 60);
    var s = secondsLeft % 60;
    el.innerHTML = 'Next in <b>' + (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s + '</b>';
}

/* ============ REFRESH ============ */
function refreshNow() {
    if (isRefreshing) return;
    isRefreshing = true;
    stopCountdown();
    updateCountdownUI();

    var btn = document.getElementById('refreshBtn');
    btn.classList.add('spinning');
    btn.disabled = true;

    showLoader('backendBody', 'Loading backend...');
    showLoader('apiNBody', 'Loading NSE/INB...');
    showLoader('apiBBody', 'Loading BSE...');

    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'ipo-monitor.jsp?ajax=fetch&_=' + Date.now(), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        btn.classList.remove('spinning');
        btn.disabled = false;
        isRefreshing = false;

        if (xhr.status !== 200) {
            toast('HTTP ' + xhr.status + ' — failed', true);
            startCountdown();
            updateCountdownUI();
            return;
        }
        try {
            var data = JSON.parse(xhr.responseText);
            renderAll(data);
            toast('Refreshed');
        } catch(e) {
            toast('Parse error', true);
            console.error(e);
        }
        startCountdown();
        updateCountdownUI();
    };
    xhr.send();
}

function showLoader(panelId, text) {
    var el = document.getElementById(panelId);
    if (!el) return;
    el.innerHTML = '<div class="loader-state">' +
                       '<div class="loader-spinner"></div>' +
                       '<div class="loader-text">' + escapeHtml(text) + '</div>' +
                   '</div>';
}

/* ============ RENDER ALL ============ */
function renderAll(data) {
    var s1 = renderCardGrid(data.BACKEND_LOG, 'backendBody', 'backendBadge');
    var s2 = renderCardGrid(data.API_NSE_INB, 'apiNBody', 'apiNBadge');
    var s3 = renderCardGrid(data.API_BSE, 'apiBBody', 'apiBBadge');
    updateKpis(data);
    updateHeaderStats(s1, s2, s3);
}

/* ============ RENDER CARD GRID ============ */
function renderCardGrid(qr, bodyId, badgeId) {
    var body = document.getElementById(bodyId);
    var badge = document.getElementById(badgeId);
    var stats = { healthy: 0, warning: 0, critical: 0 };

    if (!qr || !qr.success) {
        body.innerHTML = '<div class="empty-state"><div class="empty-icon">&#9888;</div><div class="empty-text">' +
                         escapeHtml(qr ? qr.message : 'No data') + '</div></div>';
        badge.textContent = 'ERR';
        return stats;
    }

    badge.textContent = qr.rows.length + ' IPs · ' + qr.executionTimeMs + ' ms';

    if (!qr.rows || qr.rows.length === 0) {
        body.innerHTML = '<div class="empty-state"><div class="empty-icon">&#128269;</div><div class="empty-text">No hits in last 5 min</div></div>';
        return stats;
    }

    // Detect column names flexibly
    var cols = qr.columns;
    var ipCol     = findCol(cols, ['SYS_IP', 'EXP_IP', 'IP']);
    var apiCol    = findCol(cols, ['API_NAME']);
    var hitsCol   = findCol(cols, ['TOTAL_HITS', 'HITS']);
    var succCol   = findCol(cols, ['SUCCESS']);
    var tdCol     = findCol(cols, ['TD']);
    var tdpCol    = findCol(cols, ['TD_PERCENT']);
    var bdCol     = findCol(cols, ['BD']);
    var bdpCol    = findCol(cols, ['BD_PERCENT']);

    // Collect all error code columns (SI001, SI002, DYNAMIC_002, etc.)
    var errorCols = [];
    cols.forEach(function(c) {
        if (c === ipCol || c === apiCol || c === hitsCol || c === succCol ||
            c === tdCol || c === tdpCol || c === bdCol || c === bdpCol) return;
        errorCols.push(c);
    });

    var html = '';
    qr.rows.forEach(function(row) {
        var ip = row[ipCol] || '-';
        var apiName = row[apiCol] || '';
        var hits = parseInt(row[hitsCol] || 0);
        var success = parseInt(row[succCol] || 0);
        var td = parseInt(row[tdCol] || 0);
        var tdPct = parseFloat(row[tdpCol] || 0);
        var bd = parseInt(row[bdCol] || 0);
        var bdPct = parseFloat(row[bdpCol] || 0);

        // Determine health status
        var status = 'healthy';
        if (tdPct > 5 || bdPct > 5) status = 'critical';
        else if (tdPct > 1 || bdPct > 1 || td > 0 || bd > 0) status = 'warning';

        stats[status]++;

        // Collect non-zero error codes
        var errorChips = [];
        errorCols.forEach(function(c) {
            var v = parseInt(row[c] || 0);
            if (v > 0) {
                var isBD = (c === 'BD' || c === 'BD_NEW');
                var chipClass = isBD ? 'bd' : 'td';
                errorChips.push('<span class="ip-code ' + chipClass + '">' + escapeHtml(c) + ' · ' + v + '</span>');
            }
        });

        // Determine success color
        var succPct = hits > 0 ? (success * 100 / hits) : 100;
        var succClass = succPct >= 99 ? 'green' : (succPct >= 95 ? 'amber' : 'red');
        var tdClass = tdPct <= 1 ? '' : (tdPct <= 5 ? 'amber' : 'red');

        // Short API name for card title
        var shortApi = apiName.replace('thirdParty', '').replace('_sys', '').replace('_expDS', '');
        if (shortApi.length > 20) shortApi = shortApi.substring(0, 18) + '…';

        html += '<div class="ip-card ' + status + '">';

        // Head — IP + status badge
        html += '<div class="ip-card-head">';
        html += '<div class="ip-name">' + escapeHtml(ip) + '</div>';
        html += '<div class="ip-status ' + status + '">' + status + '</div>';
        html += '</div>';

        // API name subtitle (small)
        if (shortApi) {
            html += '<div style="font-size:10px;color:var(--text-3);font-weight:600;margin-top:-4px;">' +
                    escapeHtml(shortApi) + '</div>';
        }

        // Main metrics — Hits & Success
        html += '<div class="ip-row-main">';
        html += '<div class="ip-metric">';
        html +=   '<div class="ip-metric-label">Hits</div>';
        html +=   '<div class="ip-metric-value">' + hits + '</div>';
        html += '</div>';
        html += '<div class="ip-metric">';
        html +=   '<div class="ip-metric-label">Success</div>';
        html +=   '<div class="ip-metric-value ' + succClass + '">' + success + '</div>';
        html += '</div>';
        html += '</div>';

        // TD / BD row (only if any)
        if (td > 0 || bd > 0 || tdPct > 0 || bdPct > 0) {
            html += '<div class="ip-row-main">';
            html += '<div class="ip-metric">';
            html +=   '<div class="ip-metric-label">TD%</div>';
            html +=   '<div class="ip-metric-value ' + tdClass + '">' + tdPct.toFixed(2) + '%</div>';
            html += '</div>';
            html += '<div class="ip-metric">';
            html +=   '<div class="ip-metric-label">BD%</div>';
            html +=   '<div class="ip-metric-value ' + (bdPct > 1 ? 'red' : '') + '">' + bdPct.toFixed(2) + '%</div>';
            html += '</div>';
            html += '</div>';
        }

        // Error code chips
        html += '<div class="ip-codes">';
        if (errorChips.length > 0) {
            html += errorChips.join('');
        } else {
            html += '<span class="ip-code ok">&#10003; No errors</span>';
        }
        html += '</div>';

        html += '</div>';
    });

    body.innerHTML = html;
    return stats;
}

function findCol(cols, names) {
    for (var i = 0; i < names.length; i++) {
        var n = names[i].toUpperCase();
        for (var j = 0; j < cols.length; j++) {
            if (cols[j].toUpperCase() === n) return cols[j];
        }
    }
    return null;
}

/* ============ HEADER STATS ============ */
function updateHeaderStats(s1, s2, s3) {
    var healthy = s1.healthy + s2.healthy + s3.healthy;
    var warn = s1.warning + s2.warning + s3.warning;
    var crit = s1.critical + s2.critical + s3.critical;
    document.getElementById('hdrHealthy').textContent = healthy;
    document.getElementById('hdrWarn').textContent = warn;
    document.getElementById('hdrCritical').textContent = crit;
}

/* ============ KPI CARDS ============ */
function updateKpis(data) {
    var b = data.BACKEND_LOG;
    var n = data.API_NSE_INB;
    var x = data.API_BSE;

    var bHits = 0, bTD = 0, bCount = 0;
    if (b && b.success && b.rows) {
        b.rows.forEach(function(r) {
            bHits += parseInt(r.TOTAL_HITS || 0);
            bTD += parseFloat(r.TD_PERCENT || 0);
            bCount++;
        });
    }
    setKpi('kpiBackendHits', bHits, null);
    setKpi('kpiBackendTD', bCount > 0 ? (bTD/bCount).toFixed(2) + '%' : '—', bCount > 0 ? bTD/bCount : null);

    var nHits = 0, nTD = 0, nCount = 0;
    if (n && n.success && n.rows) {
        n.rows.forEach(function(r) {
            nHits += parseInt(r.TOTAL_HITS || 0);
            nTD += parseFloat(r.TD_PERCENT || 0);
            nCount++;
        });
    }
    setKpi('kpiApiNHits', nHits, null);
    setKpi('kpiApiNTD', nCount > 0 ? (nTD/nCount).toFixed(2) + '%' : '—', nCount > 0 ? nTD/nCount : null);

    var xHits = 0, xTD = 0, xCount = 0;
    if (x && x.success && x.rows) {
        x.rows.forEach(function(r) {
            xHits += parseInt(r.TOTAL_HITS || 0);
            xTD += parseFloat(r.TD_PERCENT || 0);
            xCount++;
        });
    }
    setKpi('kpiApiBHits', xHits, null);
    setKpi('kpiApiBTD', xCount > 0 ? (xTD/xCount).toFixed(2) + '%' : '—', xCount > 0 ? xTD/xCount : null);
}

function setKpi(id, value, pct) {
    var el = document.getElementById(id);
    if (!el) return;
    var valEl = el.querySelector('.kpi-value');
    valEl.textContent = value;
    el.classList.remove('ok', 'warn', 'err');
    valEl.classList.remove('ok', 'warn', 'err');

    if (pct !== null && pct !== undefined && !isNaN(pct)) {
        if (pct <= 1) { el.classList.add('ok'); valEl.classList.add('ok'); }
        else if (pct <= 5) { el.classList.add('warn'); valEl.classList.add('warn'); }
        else { el.classList.add('err'); valEl.classList.add('err'); }
    } else {
        el.classList.add('ok');
        valEl.classList.add('ok');
    }
}

/* ============ HELPERS ============ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function(){
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(24px)';
        setTimeout(function(){ el.remove(); }, 320);
    }, 2000);
}

/* ============ INIT ============ */
window.addEventListener('load', function() {
    refreshNow();
});
