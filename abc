BACKEND LOG

-- ============================================================
-- BACKEND LOG — IPO Auth (NSE Auth + BSE Auth + INB IPO)
-- Change WINDOW_MINUTES as needed: 5 / 15 / 60
-- ============================================================
WITH IP_LIST AS (
  SELECT '10.188.24.167' IP FROM DUAL UNION ALL
  SELECT '10.188.24.168' FROM DUAL UNION ALL
  SELECT '10.188.24.169' FROM DUAL UNION ALL
  SELECT '10.188.24.170' FROM DUAL UNION ALL
  SELECT '10.188.24.171' FROM DUAL UNION ALL
  SELECT '10.188.24.172' FROM DUAL UNION ALL
  SELECT '10.188.25.167' FROM DUAL UNION ALL
  SELECT '10.188.25.168' FROM DUAL UNION ALL
  SELECT '10.188.25.169' FROM DUAL UNION ALL
  SELECT '10.188.25.170' FROM DUAL UNION ALL
  SELECT '10.188.25.171' FROM DUAL UNION ALL
  SELECT '10.188.25.172' FROM DUAL
),
API_LIST AS (
  SELECT 'thirdPartyINBIpo_sys' API_NAME FROM DUAL UNION ALL
  SELECT 'thirdPartyNSEAuth_sys' FROM DUAL UNION ALL
  SELECT 'thirdPartyBSEAuth_sys' FROM DUAL
),
COMBOS AS (
  SELECT i.IP, a.API_NAME FROM IP_LIST i CROSS JOIN API_LIST a
),
AGG AS (
  SELECT TRIM(sys_ip) SYS_IP, TRIM(api_name) API_NAME,
    COUNT(1) TOTAL_HITS,
    SUM(CASE WHEN error_code is null or error_code = 'CK001' THEN 1 ELSE 0 END) SUCCESS,
    SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) SI001,
    SUM(CASE WHEN error_code ='SI002' then 1 else 0 end) SI002,
    SUM(CASE WHEN substr(error_code,3,3) ='002' AND error_code <>'SI002' then 1 else 0 end) DYNAMIC_002,
    SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) SI007,
    SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) SI051,
    SUM(CASE WHEN error_code ='SI052' then 1 else 0 end) SI052,
    SUM(CASE WHEN substr(error_code,3,3) ='052' AND error_code <>'SI052' then 1 else 0 end) DYNAMIC_052,
    SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) DYNAMIC_014,
    SUM(CASE WHEN error_code ='SI569' then 1 else 0 end) SI569,
    SUM(CASE WHEN error_code ='SI570' then 1 else 0 end) SI570,
    SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') or error_code in('SI001','SI007','SI017','SI569','SI570','SI052','SI077','SI051','SI111')) and error_code<>'00014' THEN 1 ELSE 0 END) TD,
    ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI052','SI077','SI569','SI570')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) TD_PERCENT,
    SUM(CASE WHEN ((nvl( substr(error_code,3,3),'A') not in ('002','014') and error_code not in('SI001','SI007','SI017','SI569','SI570','SI052','SI077','SI051','SI111')) AND error_code <> 'CK001' OR error_code IN ('00014','70007')) THEN 1 ELSE 0 END) BD,
    ROUND((SUM(CASE WHEN (nvl( substr(error_code,3,3),'A') NOT in ('001','002','007','052','051','014') OR error_code IN ('00014','70007')) AND error_code <> 'CK001' and error_code IS NOT NULL THEN 1 ELSE 0 END)*100)/COUNT(1),2) BD_PERCENT
  FROM eisapp.BACKEND_LOG
  WHERE api_name in ('thirdPartyINBIpo_sys','thirdPartyNSEAuth_sys','thirdPartyBSEAuth_sys')
    AND creation_date_time >= sysdate - interval '15' minute
  GROUP BY TRIM(sys_ip), TRIM(api_name)
)
SELECT
  c.API_NAME,
  c.IP SYS_IP,
  NVL(a.TOTAL_HITS,0) TOTAL_HITS,
  NVL(a.SUCCESS,0) SUCCESS,
  NVL(a.SI001,0) SI001,
  NVL(a.SI002,0) SI002,
  NVL(a.DYNAMIC_002,0) DYNAMIC_002,
  NVL(a.SI007,0) SI007,
  NVL(a.SI051,0) SI051,
  NVL(a.SI052,0) SI052,
  NVL(a.DYNAMIC_052,0) DYNAMIC_052,
  NVL(a.DYNAMIC_014,0) DYNAMIC_014,
  NVL(a.SI569,0) SI569,
  NVL(a.SI570,0) SI570,
  NVL(a.TD,0) TD,
  NVL(a.TD_PERCENT,0) TD_PERCENT,
  NVL(a.BD,0) BD,
  NVL(a.BD_PERCENT,0) BD_PERCENT
FROM COMBOS c LEFT JOIN AGG a ON c.IP = a.SYS_IP AND c.API_NAME = a.API_NAME
ORDER BY c.API_NAME, c.IP;

