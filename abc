import java.io.*;
import java.nio.file.*;
import java.util.*;
import java.util.jar.*;
import java.util.zip.*;

public class DependencyChecker {

    // 👇 TUMSARA HARDCODED PATH
    private static final String PROJECT_PATH = "F:\\Updated Tomcat";

    private static final String JAVAX_SERVLET = "javax/servlet/";
    private static final String JAKARTA_SERVLET = "jakarta/servlet/";
    private static final String JAVAX_PERSISTENCE = "javax/persistence/";
    private static final String JAKARTA_PERSISTENCE = "jakarta/persistence/";
    private static final String JAVAX_WS = "javax/ws/";
    private static final String JAKARTA_WS = "jakarta/ws/";

    public static void main(String[] args) throws Exception {
        Path projectRoot = Paths.get(PROJECT_PATH);

        if (!Files.exists(projectRoot)) {
            System.out.println("❌ Path nahi mila: " + projectRoot);
            System.out.println("   Check karo ki F:\\Updated Tomcat exist karta hai ya nahi.");
            return;
        }

        System.out.println("=================================================");
        System.out.println("🔍 Dependency Checker - Project: " + projectRoot);
        System.out.println("=================================================\n");

        // 1. Saari JAR files dhoondo
        List<Path> jars = new ArrayList<>();
        Files.walk(projectRoot)
                .filter(p -> p.toString().endsWith(".jar"))
                .forEach(jars::add);

        System.out.println("📦 Total JAR files mili: " + jars.size() + "\n");

        if (jars.isEmpty()) {
            System.out.println("⚠️  Koi JAR file nahi mili is path mein.");
            System.out.println("   Confirm karo ki tum project ka root ya WEB-INF/lib de rahe ho.");
            return;
        }

        // 2. Har JAR ko scan karo
        List<String> javaxJars = new ArrayList<>();
        List<String> jakartaJars = new ArrayList<>();
        List<String> mixedJars = new ArrayList<>();

        for (Path jar : jars) {
            JarScanResult result = scanJar(jar);
            if (result.hasJavax && result.hasJakarta) {
                mixedJars.add(jar + "  [javax: " + result.javaxClasses + ", jakarta: " + result.jakartaClasses + "]");
            } else if (result.hasJavax) {
                javaxJars.add(jar + "  [javax classes: " + result.javaxClasses + "]");
            } else if (result.hasJakarta) {
                jakartaJars.add(jar + "  [jakarta classes: " + result.jakartaClasses + "]");
            }
        }

        // 3. Report print karo
        System.out.println("=================================================");
        System.out.println("⚠️  PURANI javax.* DEPENDENCIES (Yeh problem hain!)");
        System.out.println("=================================================");
        if (javaxJars.isEmpty()) {
            System.out.println("✅ Koi purani javax dependency nahi mili. Badhiya!");
        } else {
            javaxJars.forEach(j -> System.out.println("  ❌ " + j));
        }

        System.out.println("\n=================================================");
        System.out.println("✅ NAYI jakarta.* DEPENDENCIES (Yeh sahi hain)");
        System.out.println("=================================================");
        if (jakartaJars.isEmpty()) {
            System.out.println("⚠️  Koi jakarta dependency nahi mili. Migration adhura hai!");
        } else {
            jakartaJars.forEach(j -> System.out.println("  ✅ " + j));
        }

        System.out.println("\n=================================================");
        System.out.println("🔀 MIXED JARS (Dono javax aur jakarta - sabse khatarnak!)");
        System.out.println("=================================================");
        if (mixedJars.isEmpty()) {
            System.out.println("✅ Koi mixed JAR nahi mili.");
        } else {
            mixedJars.forEach(j -> System.out.println("  ⚠️  " + j));
        }

        // 4. Summary
        System.out.println("\n=================================================");
        System.out.println("📊 SUMMARY");
        System.out.println("=================================================");
        System.out.println("  Purani javax JARs   : " + javaxJars.size());
        System.out.println("  Nayi jakarta JARs   : " + jakartaJars.size());
        System.out.println("  Mixed JARs          : " + mixedJars.size());
        System.out.println("  Total JARs scanned  : " + jars.size());

        if (!javaxJars.isEmpty() || !mixedJars.isEmpty()) {
            System.out.println("\n🚨 ACTION REQUIRED: Upar wali javax/mixed JARs ko update karo!");
            System.out.println("   Inhe jakarta-compatible version se replace karo.");
        } else {
            System.out.println("\n🎉 Sab clean hai! Production pe deploy kar sakte ho.");
        }
    }

    private static JarScanResult scanJar(Path jarPath) {
        JarScanResult result = new JarScanResult();
        try (JarFile jarFile = new JarFile(jarPath.toFile())) {
            Enumeration<JarEntry> entries = jarFile.entries();
            while (entries.hasMoreElements()) {
                JarEntry entry = entries.nextElement();
                String name = entry.getName();
                if (!name.endsWith(".class")) continue;

                if (name.startsWith(JAVAX_SERVLET) ||
                    name.startsWith(JAVAX_PERSISTENCE) ||
                    name.startsWith(JAVAX_WS)) {
                    result.hasJavax = true;
                    result.javaxClasses++;
                }

                if (name.startsWith(JAKARTA_SERVLET) ||
                    name.startsWith(JAKARTA_PERSISTENCE) ||
                    name.startsWith(JAKARTA_WS)) {
                    result.hasJakarta = true;
                    result.jakartaClasses++;
                }
            }
        } catch (Exception e) {
            System.out.println("⚠️  JAR read nahi ho payi: " + jarPath + " -> " + e.getMessage());
        }
        return result;
    }

    static class JarScanResult {
        boolean hasJavax = false;
        boolean hasJakarta = false;
        int javaxClasses = 0;
        int jakartaClasses = 0;
    }
}
