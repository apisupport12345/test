<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="true"%>
<%@ page import="com.jdbc.IPOMonitorService" %>
<%@ page import="com.jdbc.IPOMonitorService.QueryResult" %>
<%@ page import="java.util.*" %>
<%
    String ajax = request.getParameter("ajax");
    if ("fetch".equals(ajax)) {
        Map<String, QueryResult> results = IPOMonitorService.runAll();
        StringBuilder sb = new StringBuilder("{");
        int i = 0;
        for (Map.Entry<String, QueryResult> e : results.entrySet()) {
            if (i++ > 0) sb.append(",");
            sb.append("\"").append(IPOMonitorService.esc(e.getKey())).append("\":");
            sb.append(IPOMonitorService.toJson(e.getValue()));
        }
        sb.append("}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }
%>
<!DOCTYPE html>
<html>
<head>
    <title>IPO Monitoring Dashboard</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root {
            --bg-0: #070a0f;
            --bg-1: #0d1219;
            --bg-2: #131a24;
            --bg-3: #1a2230;
            --border: #1f2a3a;
            --border-2: #2a3849;
            --text-0: #ffffff;
            --text-1: #dfe5ee;
            --text-2: #9aa5b5;
            --text-3: #5e6b7e;
            --accent: #2e7fff;
            --green: #00d68f;
            --amber: #ffb020;
            --red: #ff4d4f;
            --purple: #a855f7;
            --cyan: #22d3ee;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100vh;
            overflow: hidden;
            font-family: 'Inter', 'Segoe UI', -apple-system, Roboto, sans-serif;
            background: var(--bg-0);
            color: var(--text-1);
            font-size: 14px;
            -webkit-font-smoothing: antialiased;
        }

        /* ================= APP GRID ================= */
        .app {
            display: grid;
            grid-template-rows: 64px 1fr;
            height: 100vh;
            width: 100vw;
        }

        /* ================= HEADER ================= */
        .header {
            background: linear-gradient(90deg, #0a0f18 0%, #101827 100%);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 20px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.6);
            z-index: 100;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 19px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.3px;
        }
        .logo-mark {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, #2e7fff, #1a5ecc);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            box-shadow: 0 4px 16px rgba(46,127,255,0.5);
        }
        .logo-sub {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-3);
            padding: 3px 10px;
            background: rgba(255,255,255,0.04);
            border-radius: 8px;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-left: 4px;
        }

        .header-spacer { flex: 1; }

        .live-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            background: rgba(0,214,143,0.08);
            border: 1px solid rgba(0,214,143,0.3);
            border-radius: 8px;
            font-size: 12px;
            font-weight: 800;
            color: var(--green);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .live-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 10px var(--green);
            animation: pulse 1.4s infinite;
        }
        @keyframes pulse {
            0%,100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }

        .countdown {
            font-size: 12.5px;
            color: var(--text-2);
            font-weight: 600;
            padding: 8px 16px;
            background: var(--bg-1);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-variant-numeric: tabular-nums;
            min-width: 150px;
            text-align: center;
            letter-spacing: 0.3px;
        }
        .countdown b { color: var(--accent); font-weight: 800; }

        .btn-icon {
            width: 38px; height: 38px;
            background: var(--bg-2);
            border: 1px solid var(--border);
            border-radius: 9px;
            color: var(--text-1);
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
            transition: 0.2s;
        }
        .btn-icon:hover { background: var(--bg-3); border-color: var(--accent); color: var(--accent); }
        .btn-icon:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-icon.spinning { animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        .btn-primary {
            padding: 9px 18px;
            background: linear-gradient(135deg, #2e7fff, #1a5ecc);
            color: #fff;
            border: none;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: flex; align-items: center; gap: 7px;
            transition: 0.2s;
            box-shadow: 0 4px 12px rgba(46,127,255,0.35);
            font-family: inherit;
            letter-spacing: 0.3px;
        }
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(46,127,255,0.55);
        }
        .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

        /* ================= MAIN LAYOUT ================= */
        .main {
            padding: 16px 20px;
            display: grid;
            grid-template-rows: 108px 1fr;
            gap: 14px;
            overflow: hidden;
            min-height: 0;
        }

        /* ================= KPI ROW ================= */
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            min-height: 0;
        }
        .kpi {
            background: linear-gradient(135deg, var(--bg-1) 0%, var(--bg-2) 100%);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 18px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            transition: 0.2s;
        }
        .kpi::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 3px;
            background: var(--accent);
        }
        .kpi.ok::before   { background: var(--green); }
        .kpi.warn::before { background: var(--amber); }
        .kpi.err::before  { background: var(--red); }

        .kpi-label {
            font-size: 10.5px;
            font-weight: 800;
            color: var(--text-3);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }
        .kpi-value {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-0);
            line-height: 1;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.5px;
        }
        .kpi-value.ok   { color: var(--green); }
        .kpi-value.warn { color: var(--amber); }
        .kpi-value.err  { color: var(--red); }
        .kpi-sub {
            font-size: 10.5px;
            color: var(--text-3);
            font-weight: 500;
            margin-top: 3px;
        }

        /* ================= PANELS ROW ================= */
        .panels {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            overflow: hidden;
            min-height: 0;
        }
        .panel {
            background: var(--bg-1);
            border: 1px solid var(--border);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 0;
        }
        .panel-head {
            background: linear-gradient(90deg, var(--bg-2) 0%, var(--bg-1) 100%);
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }
        .panel-head-icon {
            width: 30px; height: 30px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }
        .icon-green  { background: rgba(0,214,143,0.15); color: var(--green); }
        .icon-blue   { background: rgba(46,127,255,0.15); color: var(--accent); }
        .icon-purple { background: rgba(168,85,247,0.15); color: var(--purple); }

        .panel-head-text { flex: 1; min-width: 0; }
        .panel-title {
            font-size: 13.5px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: -0.1px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .panel-sub {
            font-size: 10.5px;
            color: var(--text-3);
            font-weight: 600;
            margin-top: 1px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .panel-badge {
            font-size: 10.5px;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 6px;
            background: var(--bg-3);
            color: var(--text-3);
            letter-spacing: 0.4px;
            white-space: nowrap;
        }

        .panel-body {
            flex: 1;
            overflow: auto;
            position: relative;
            min-height: 0;
        }
        .panel-body::-webkit-scrollbar { width: 8px; height: 8px; }
        .panel-body::-webkit-scrollbar-track { background: var(--bg-1); }
        .panel-body::-webkit-scrollbar-thumb {
            background: var(--border-2);
            border-radius: 4px;
        }
        .panel-body::-webkit-scrollbar-thumb:hover { background: #3a4a5e; }

        /* ================= TABLE ================= */
        table.dt {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 12px;
            font-family: 'JetBrains Mono', 'SF Mono', 'Consolas', monospace;
        }
        table.dt thead th {
            background: var(--bg-2);
            color: var(--cyan);
            padding: 9px 10px;
            text-align: right;
            position: sticky;
            top: 0;
            z-index: 10;
            font-weight: 800;
            font-size: 10.5px;
            white-space: nowrap;
            border-bottom: 2px solid var(--border-2);
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }
        table.dt thead th:first-child,
        table.dt thead th:nth-child(2) { text-align: left; }

        table.dt tbody td {
            padding: 8px 10px;
            border-bottom: 1px solid var(--border);
            color: var(--text-2);
            white-space: nowrap;
            text-align: right;
            font-variant-numeric: tabular-nums;
            font-size: 12px;
        }
        table.dt tbody td:first-child,
        table.dt tbody td:nth-child(2) {
            text-align: left;
            color: var(--text-1);
            font-weight: 700;
            max-width: 140px;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        table.dt tbody tr:nth-child(even) td { background: rgba(255,255,255,0.012); }
        table.dt tbody tr:hover td { background: rgba(46,127,255,0.07); }

        td.zero   { color: var(--text-3); opacity: 0.35; }
        td.hi     { color: var(--text-0); font-weight: 700; }
        td.success{ color: var(--green); font-weight: 700; }
        td.td-cnt { color: var(--amber); font-weight: 700; }
        td.bd-cnt { color: var(--red); font-weight: 700; }
        td.pct-ok { color: var(--green); font-weight: 700; }
        td.pct-mid{ color: var(--amber); font-weight: 700; }
        td.pct-bad{ color: var(--red); font-weight: 700; background: rgba(255,77,79,0.08); }

        /* ================= STATES ================= */
        .empty-state, .loader-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 30px 20px;
            text-align: center;
            color: var(--text-3);
        }
        .empty-icon { font-size: 36px; opacity: 0.35; margin-bottom: 10px; }
        .empty-text { font-size: 12.5px; font-weight: 600; }

        .loader-spinner {
            width: 40px; height: 40px;
            border: 3px solid var(--bg-3);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
        }
        .loader-text {
            margin-top: 14px;
            font-size: 12px;
            color: var(--text-3);
            font-weight: 600;
            letter-spacing: 0.4px;
        }

        /* ================= TOAST ================= */
        .toast {
            position: fixed;
            bottom: 22px; right: 22px;
            padding: 12px 18px;
            background: var(--bg-2);
            border-left: 3px solid var(--green);
            border-radius: 8px;
            color: var(--text-0);
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 8px 28px rgba(0,0,0,0.7);
            z-index: 9999;
            animation: slideIn 0.25s ease;
        }
        .toast.err { border-left-color: var(--red); }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(24px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* ================= RESPONSIVE ================= */
        @media (max-width: 1400px) {
            .kpi-row { grid-template-columns: repeat(3, 1fr); }
        }
        @media (max-width: 1100px) {
            .panels { grid-template-columns: 1fr; }
            .main { grid-template-rows: auto 1fr; }
        }
    </style>
</head>
