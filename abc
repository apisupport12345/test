// ============ AUTO-CLOSEABLE WRAPPER CLASS ============
class AutoCloseableConnection implements AutoCloseable {
    private Connection connection;
    private boolean autoClose = true;

    public AutoCloseableConnection(Connection connection) {
        this.connection = connection;
    }

    public Connection getConnection() {
        return connection;
    }

    public void setAutoClose(boolean autoClose) {
        this.autoClose = autoClose;
    }

    @Override
    public void close() throws Exception {
        if (autoClose && connection != null) {
            try {
                if (!connection.isClosed()) {
                    connection.close();
                    System.out.println("Connection auto-closed successfully");
                }
            } catch (SQLException e) {
                System.err.println("Error auto-closing connection: " + e.getMessage());
            }
        }
    }
}
