WITH gen5_base AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen5_op,
        TRIM(CASE 
            WHEN INSTR(lb_url, '/gateway/') > 0 
                THEN SUBSTR(lb_url, INSTR(lb_url, '/gateway/') + 9)
            WHEN INSTR(lb_url, '/getway/') > 0 
                THEN SUBSTR(lb_url, INSTR(lb_url, '/getway/') + 8)
            ELSE NULL
        END) AS gen5_path_op
    FROM daily_dpg_url_data
    WHERE (UPPER(lb_url) LIKE 'GEN5/GATEWAY%'
        OR UPPER(lb_url) LIKE 'GEN5%GATEWAY%'
        OR UPPER(lb_url) LIKE '%GEN5/GETWAY%')
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_base AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen6_op,
        TRIM(CASE 
            WHEN INSTR(lb_url, '/gateway/') > 0 
                THEN SUBSTR(lb_url, INSTR(lb_url, '/gateway/') + 9)
            WHEN INSTR(lb_url, '/getway/') > 0 
                THEN SUBSTR(lb_url, INSTR(lb_url, '/getway/') + 8)
            ELSE NULL
        END) AS gen6_path_op
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) NOT LIKE '%GEN5%'
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_best AS (
    SELECT 
        g5.ip, g5.type, g5.route_url, g5.gen5_lb_url, g5.gen5_op, g5.gen5_path_op,
        g6.gen6_lb_url,
        ROW_NUMBER() OVER (
            PARTITION BY g5.ip, g5.type, g5.route_url, g5.gen5_lb_url
            ORDER BY g6.gen6_lb_url
        ) AS rn
    FROM gen5_base g5
    LEFT JOIN gen6_base g6
      ON g5.ip = g6.ip
     AND g5.type = g6.type
     AND g5.route_url = g6.route_url
     AND g5.gen5_op = g6.gen6_op
     AND (
         g5.gen5_op NOT IN ('UpdateTransaction', 'GetDetails')
         OR g5.gen5_path_op = g6.gen6_path_op
     )
),
gen6_siapp3 AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen6_op,
        ROW_NUMBER() OVER (PARTITION BY ip, type, route_url ORDER BY lb_url) AS rn
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%SIAPP3%'
      AND UPPER(lb_url) LIKE '%GEN6%'
),
gen5_siapp3 AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen5_op,
        ROW_NUMBER() OVER (PARTITION BY ip, type, route_url ORDER BY lb_url) AS rn
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%SIAPP3%'
      AND UPPER(lb_url) LIKE '%GEN5%'
)
SELECT 
    g5.ip, g5.type, g5.gen5_lb_url,
    g6.gen6_lb_url,
    g5.route_url, SYSDATE
FROM gen5_base g5
LEFT JOIN gen6_best g6
  ON g5.ip = g6.ip AND g5.type = g6.type AND g5.route_url = g6.route_url
 AND g5.gen5_lb_url = g6.gen5_lb_url AND g6.rn = 1

UNION ALL

SELECT 
    g5.ip, g5.type, g5.gen5_lb_url,
    g6.gen6_lb_url,
    g5.route_url, SYSDATE
FROM gen5_siapp3 g5
LEFT JOIN gen6_siapp3 g6
  ON g5.ip = g6.ip AND g5.type = g6.type AND g5.route_url = g6.route_url
 AND g5.gen5_op = g6.gen6_op AND g6.rn = 1
WHERE g5.rn = 1

UNION ALL

SELECT NULL, NULL, NULL, g6.gen6_lb_url, g6.route_url, SYSDATE
FROM gen6_siapp3 g6
WHERE NOT EXISTS (
    SELECT 1 FROM gen5_siapp3 g5
    WHERE g5.ip = g6.ip AND g5.type = g6.type AND g5.route_url = g6.route_url
      AND g5.gen5_op = g6.gen6_op
)
AND g6.rn = 1

UNION ALL

SELECT NULL, NULL, NULL, g6.gen6_lb_url, g6.route_url, SYSDATE
FROM gen6_base g6
WHERE NOT EXISTS (
    SELECT 1 FROM gen5_base g5
    WHERE g5.ip = g6.ip AND g5.type = g6.type AND g5.route_url = g6.route_url
      AND g5.gen5_op = g6.gen6_op
);
