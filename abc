<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="true"%>
<%@ page import="com.jdbc.QueryRunner" %>
<%@ page import="com.jdbc.QueryRunner.QueryResult" %>
<%@ page import="com.jdbc.QueryRunner.Suggestion" %>
<%@ page import="java.util.*" %>
<%
    String ajax = request.getParameter("ajax");

    if ("run".equals(ajax)) {
        String runSql = request.getParameter("sql");
        String runDb  = request.getParameter("dbType");
        if (runDb == null) runDb = "IIB";
        QueryResult qr = QueryRunner.execute(runSql, runDb);
        StringBuilder sb = new StringBuilder("{");
        sb.append("\"success\":").append(qr.success).append(",");
        sb.append("\"message\":\"").append(QueryRunner.esc(qr.message)).append("\",");
        sb.append("\"queryType\":\"").append(qr.queryType == null ? "" : QueryRunner.esc(qr.queryType)).append("\",");
        sb.append("\"executionTimeMs\":").append(qr.executionTimeMs).append(",");
        sb.append("\"updateCount\":").append(qr.updateCount).append(",");
        sb.append("\"columns\":[");
        for (int i = 0; i < qr.columns.size(); i++) {
            if (i > 0) sb.append(",");
            sb.append("\"").append(QueryRunner.esc(qr.columns.get(i))).append("\"");
        }
        sb.append("],\"rows\":[");
        for (int r = 0; r < qr.rows.size(); r++) {
            if (r > 0) sb.append(",");
            sb.append("{");
            Map<String, Object> row = qr.rows.get(r);
            int c = 0;
            for (String col : qr.columns) {
                if (c++ > 0) sb.append(",");
                Object v = row.get(col);
                sb.append("\"").append(QueryRunner.esc(col)).append("\":");
                if (v == null) sb.append("null");
                else sb.append("\"").append(QueryRunner.esc(v.toString())).append("\"");
            }
            sb.append("}");
        }
        sb.append("]}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }

    if ("suggest".equals(ajax)) {
        String ajaxDb = request.getParameter("db");
        if (ajaxDb == null) ajaxDb = "IIB";
        List<Suggestion> schemas = new ArrayList<>();
        List<Suggestion> tables  = new ArrayList<>();
        String err = null;
        try { schemas = QueryRunner.getSchemaSuggestions(ajaxDb); }
        catch (Throwable t) { err = "schemas: " + t.getMessage(); }
        try { tables = QueryRunner.getTableSuggestions(ajaxDb); }
        catch (Throwable t) { err = (err == null ? "" : err + "; ") + "tables: " + t.getMessage(); }
        List<Suggestion> keywords = QueryRunner.getKeywordSuggestions();
        StringBuilder sb = new StringBuilder("{");
        if (err != null) sb.append("\"error\":\"").append(QueryRunner.esc(err)).append("\",");
        sb.append("\"schemas\":[");
        for (int i = 0; i < schemas.size(); i++) {
            Suggestion s = schemas.get(i);
            if (i > 0) sb.append(",");
            sb.append("{\"label\":\"").append(QueryRunner.esc(s.label))
              .append("\",\"insert\":\"").append(QueryRunner.esc(s.insert))
              .append("\",\"type\":\"SCHEMA\"}");
        }
        sb.append("],\"tables\":[");
        for (int i = 0; i < tables.size(); i++) {
            Suggestion s = tables.get(i);
            if (i > 0) sb.append(",");
            sb.append("{\"label\":\"").append(QueryRunner.esc(s.label))
              .append("\",\"insert\":\"").append(QueryRunner.esc(s.insert))
              .append("\",\"type\":\"TABLE\"}");
        }
        sb.append("],\"keywords\":[");
        for (int i = 0; i < keywords.size(); i++) {
            Suggestion s = keywords.get(i);
            if (i > 0) sb.append(",");
            sb.append("{\"label\":\"").append(QueryRunner.esc(s.label))
              .append("\",\"insert\":\"").append(QueryRunner.esc(s.insert))
              .append("\",\"type\":\"KEYWORD\"}");
        }
        sb.append("]}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }

    if ("cols".equals(ajax)) {
        String ajaxDb     = request.getParameter("db");
        String ajaxSchema = request.getParameter("schema");
        String ajaxTable  = request.getParameter("table");
        if (ajaxDb == null) ajaxDb = "IIB";
        if (ajaxTable == null) ajaxTable = "";
        List<Suggestion> cols = QueryRunner.getColumnSuggestions(ajaxDb, ajaxSchema, ajaxTable);
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < cols.size(); i++) {
            Suggestion s = cols.get(i);
            if (i > 0) sb.append(",");
            sb.append("{\"label\":\"").append(QueryRunner.esc(s.label))
              .append("\",\"insert\":\"").append(QueryRunner.esc(s.insert))
              .append("\",\"type\":\"").append(QueryRunner.esc(s.type)).append("\"}");
        }
        sb.append("]");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }

    String dbType = request.getParameter("dbType");
    if (dbType == null || dbType.trim().isEmpty()) dbType = "IIB";
    String dashboardUrl = request.getContextPath() + "/jsp/Centralized query storage User.jsp";
%>
<!DOCTYPE html>
<html>
<head>
    <title>EIS Query Console</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root {
            --bg-0: #0f1115;
            --bg-1: #14171d;
            --bg-2: #1a1e26;
            --bg-3: #0a0c10;
            --bg-hover: #1a1e26;
            --bg-hover-2: #242932;
            --border-1: #242932;
            --border-2: #2a3038;
            --border-3: #2f3742;
            --text-0: #ffffff;
            --text-1: #e2e4e9;
            --text-2: #c7cad1;
            --text-3: #a8adb8;
            --text-4: #8b909a;
            --text-5: #6b7280;
            --text-6: #4b5563;
            --accent: #3b82f6;
            --accent-hover: #60a5fa;
            --accent-dim: rgba(59,130,246,0.12);
            --green: #16a34a;
            --green-light: #4ade80;
            --green-dim: rgba(74,222,128,0.12);
            --amber: #fbbf24;
            --red: #ef4444;
            --red-light: #f87171;
            --red-dim: rgba(248,113,113,0.12);
            --purple: #8b5cf6;
            --purple-light: #a78bfa;
            --table-th-bg: #14171d;
            --table-th-color: #93c5fd;
            --table-td-border: #14171d;
            --table-row-even: #0d1014;
            --table-row-hover: #1a2332;
            --shadow-lg: 0 16px 44px rgba(0,0,0,0.75);
            --shadow-md: 0 6px 18px rgba(0,0,0,0.4);
        }

        [data-theme="light"] {
            --bg-0: #f5f7fa;
            --bg-1: #ffffff;
            --bg-2: #f0f3f8;
            --bg-3: #fafbfd;
            --bg-hover: #e8eef8;
            --bg-hover-2: #dce6f5;
            --border-1: #d5dbe6;
            --border-2: #c8d0dd;
            --border-3: #b8c2d4;
            --text-0: #0a0c10;
            --text-1: #1a1e26;
            --text-2: #2d333d;
            --text-3: #4b5563;
            --text-4: #6b7280;
            --text-5: #8891a3;
            --text-6: #a8b0c0;
            --accent: #2563eb;
            --accent-hover: #1d4ed8;
            --accent-dim: rgba(37,99,235,0.1);
            --green: #16a34a;
            --green-light: #15803d;
            --green-dim: rgba(22,163,74,0.12);
            --amber: #d97706;
            --red: #dc2626;
            --red-light: #b91c1c;
            --red-dim: rgba(220,38,38,0.1);
            --purple: #7c3aed;
            --purple-light: #8b5cf6;
            --table-th-bg: #eff3f9;
            --table-th-color: #1e40af;
            --table-td-border: #e5eaf1;
            --table-row-even: #f8fafd;
            --table-row-hover: #e8eef8;
            --shadow-lg: 0 16px 44px rgba(0,0,0,0.15);
            --shadow-md: 0 6px 18px rgba(0,0,0,0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%; width: 100%;
            font-family: 'Inter', 'Segoe UI', -apple-system, Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--bg-0);
            color: var(--text-1);
            font-size: 16.5px;
            overflow: hidden;
            transition: background 0.25s, color 0.25s;
        }

        .app {
            display: grid;
            grid-template-rows: 60px 1fr 32px;
            grid-template-columns: 340px 1fr;
            grid-template-areas: "header header" "sidebar main" "status status";
            height: 100vh;
        }

        /* ========== HEADER ========== */
        .header {
            grid-area: header;
            background: linear-gradient(90deg, var(--bg-1) 0%, var(--bg-2) 100%);
            border-bottom: 1px solid var(--border-1);
            display: flex; align-items: center;
            padding: 0 26px;
            gap: 14px;
            box-shadow: var(--shadow-md);
            z-index: 40;
        }
        .brand {
            display: flex; align-items: center; gap: 12px;
            font-weight: 800; font-size: 19px;
            color: var(--text-0);
        }
        .brand-mark {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 13px; font-weight: 900;
            box-shadow: 0 4px 12px rgba(59,130,246,0.35);
        }
        .brand-sub {
            font-size: 12.5px; font-weight: 500;
            color: var(--text-5);
            margin-left: 4px;
            padding: 4px 12px;
            background: var(--bg-2);
            border-radius: 11px;
        }
        .header-spacer { flex: 1; }
        .conn-pill {
            display: flex; align-items: center; gap: 9px;
            padding: 8px 18px;
            background: var(--green-dim);
            border: 1px solid rgba(74,222,128,0.25);
            border-radius: 9px;
            font-size: 13.5px;
            font-weight: 700;
            color: var(--green-light);
        }
        .conn-dot {
            width: 9px; height: 9px; border-radius: 50%;
            background: var(--green-light);
            box-shadow: 0 0 10px rgba(74,222,128,0.7);
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.35;} }

        .theme-toggle {
            width: 56px; height: 30px;
            border-radius: 15px;
            background: var(--bg-2);
            border: 1px solid var(--border-2);
            position: relative;
            cursor: pointer;
            transition: 0.25s;
        }
        .theme-toggle:hover { border-color: var(--accent); }
        .theme-toggle .tt-icon {
            position: absolute;
            top: 50%; transform: translateY(-50%);
            transition: 0.25s;
            font-size: 14px;
        }
        .theme-toggle .tt-sun { left: 7px; opacity: 0; }
        .theme-toggle .tt-moon { right: 7px; opacity: 1; }
        [data-theme="light"] .theme-toggle .tt-sun { opacity: 1; }
        [data-theme="light"] .theme-toggle .tt-moon { opacity: 0; }
        .theme-toggle .tt-knob {
            position: absolute;
            top: 3px; left: 3px;
            width: 22px; height: 22px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            transition: 0.25s cubic-bezier(0.4,0,0.2,1);
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }
        [data-theme="light"] .theme-toggle .tt-knob {
            left: 29px;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
        }

        .btn-dashboard {
            padding: 10px 22px;
            background: linear-gradient(135deg, var(--purple), #6d28d9);
            color: #fff !important;
            border: none;
            border-radius: 9px;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex; align-items: center; gap: 8px;
            transition: 0.18s;
            box-shadow: 0 4px 12px rgba(139,92,246,0.3);
            text-decoration: none;
            font-family: inherit;
        }
        .btn-dashboard:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(139,92,246,0.5);
        }

        .btn-new {
            padding: 10px 22px;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: #fff;
            border: none;
            border-radius: 9px;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex; align-items: center; gap: 7px;
            transition: 0.18s;
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
            font-family: inherit;
        }
        .btn-new:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(59,130,246,0.45);
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            grid-area: sidebar;
            background: var(--bg-1);
            border-right: 1px solid var(--border-1);
            display: flex; flex-direction: column;
            overflow: hidden;
        }
        .sidebar-head {
            padding: 18px 22px 14px;
            font-size: 12.5px;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            color: var(--text-5);
            font-weight: 800;
            border-bottom: 1px solid var(--border-1);
            display: flex; align-items: center; justify-content: space-between;
        }
        .sidebar-count {
            font-size: 12px;
            color: var(--text-6);
            background: var(--bg-2);
            padding: 3px 10px;
            border-radius: 11px;
            font-weight: 700;
        }
        .search-wrap { padding: 14px 18px; border-bottom: 1px solid var(--border-1); }
        .search-input {
            width: 100%;
            padding: 10px 15px;
            background: var(--bg-2);
            border: 1px solid var(--border-2);
            border-radius: 9px;
            color: var(--text-1);
            font-size: 15px;
            outline: none;
            font-family: inherit;
            transition: 0.15s;
        }
        .search-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-dim);
        }

        .tree { flex: 1; overflow-y: auto; padding: 8px 0; }
        .tree::-webkit-scrollbar { width: 10px; }
        .tree::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 5px; }

        .tgroup { border-bottom: 1px solid var(--bg-2); }
        .tgroup-head {
            padding: 12px 20px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 700;
            color: var(--text-2);
            display: flex; align-items: center; gap: 10px;
            user-select: none;
            transition: background 0.12s;
        }
        .tgroup-head:hover { background: var(--bg-hover); }
        .tg-arrow {
            font-size: 11px; color: var(--text-5);
            transition: transform 0.18s;
            width: 11px; display: inline-block;
        }
        .tgroup-head.open .tg-arrow { transform: rotate(90deg); }
        .tgroup-body { display: none; padding: 4px 0 12px; }
        .tgroup-body.open { display: block; }

        .qitem {
            padding: 10px 20px 10px 40px;
            cursor: pointer;
            font-size: 14.5px;
            color: var(--text-3);
            line-height: 1.5;
            transition: 0.1s;
            border-left: 3px solid transparent;
        }
        .qitem:hover {
            background: var(--bg-hover);
            color: var(--text-1);
            border-left-color: var(--accent);
        }
        .qitem.active {
            background: var(--accent-dim);
            color: var(--text-0);
            border-left-color: var(--accent);
        }

        /* ========== MAIN ========== */
        .main {
            grid-area: main;
            display: flex; flex-direction: column;
            overflow: hidden;
            background: var(--bg-0);
            min-width: 0;
        }

        .tabbar {
            background: var(--bg-1);
            display: flex;
            border-bottom: 1px solid var(--border-1);
            overflow-x: auto;
            min-height: 48px;
            flex-shrink: 0;
        }
        .tabbar::-webkit-scrollbar { height: 4px; }
        .tabbar::-webkit-scrollbar-thumb { background: var(--border-2); }

        .tab {
            display: flex; align-items: center; gap: 10px;
            padding: 0 16px 0 20px;
            background: var(--bg-1);
            border-right: 1px solid var(--border-1);
            cursor: pointer;
            font-size: 15px;
            color: var(--text-5);
            white-space: nowrap;
            min-width: 170px;
            max-width: 300px;
            position: relative;
            user-select: none;
            transition: 0.14s;
        }
        .tab:hover { background: var(--bg-hover); color: var(--text-2); }
        .tab.active {
            background: var(--bg-0);
            color: var(--text-1);
            font-weight: 600;
        }
        .tab.active::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: var(--accent);
        }
        .tab.pinned-tab.active::before { background: var(--purple); }
        .tab-dot {
            width: 10px; height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .tab-dot.db-IIB    { background: #4ade80; }
        .tab-dot.db-SI     { background: #fbbf24; }
        .tab-dot.db-REPORT { background: #c084fc; }
        .tab-dot.pinned-dot { background: var(--purple); }

        .tab.running .tab-dot {
            animation: tabpulse 1s infinite;
            box-shadow: 0 0 10px currentColor;
        }
        @keyframes tabpulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }
        .tab-running-badge {
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: var(--accent-hover);
            background: var(--accent-dim);
            padding: 2px 8px;
            border-radius: 9px;
            border: 1px solid rgba(59,130,246,0.3);
            margin-left: auto;
        }
        .tab-pinned-badge {
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: var(--purple-light);
            background: rgba(139,92,246,0.15);
            padding: 2px 8px;
            border-radius: 9px;
            border: 1px solid rgba(139,92,246,0.3);
            margin-left: auto;
        }

        .tab-name { flex: 1; overflow: hidden; text-overflow: ellipsis; }
        .tab-close {
            width: 22px; height: 22px;
            border-radius: 4px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            color: var(--text-6);
            line-height: 1;
            transition: 0.1s;
        }
        .tab-close:hover { background: var(--border-2); color: var(--text-0); }

        .tab-add {
            display: flex; align-items: center; justify-content: center;
            padding: 0 20px;
            cursor: pointer;
            color: var(--text-5);
            font-size: 20px;
        }
        .tab-add:hover { background: var(--bg-hover); color: var(--text-1); }

        .tab-content {
            flex: 1;
            display: flex; flex-direction: column;
            overflow: hidden;
            position: relative;
            min-height: 0;
        }
        .pane {
            display: none;
            flex: 1;
            flex-direction: column;
            overflow: hidden;
            min-height: 0;
        }
        .pane.active { display: flex; }

        /* ========== TOOLBAR ========== */
        .toolbar {
            background: var(--bg-1);
            border-bottom: 1px solid var(--border-1);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            flex-shrink: 0;
        }
        .toolbar select {
            padding: 10px 16px;
            background: var(--bg-2);
            color: var(--text-1);
            border: 1px solid var(--border-2);
            border-radius: 9px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            outline: none;
            font-family: inherit;
        }
        .toolbar select:focus { border-color: var(--accent); }

        .tb {
            padding: 10px 20px;
            border-radius: 9px;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex; align-items: center; gap: 7px;
            transition: 0.15s;
            border: 1px solid transparent;
            font-family: inherit;
        }
        .tb:hover { transform: translateY(-1px); }
        .tb:active { transform: translateY(0); }

        .tb-run { background: var(--green); color: #fff; box-shadow: 0 3px 10px rgba(22,163,74,0.25); }
        .tb-run:hover { background: #15803d; }

        .tb-suggest {
            background: var(--bg-2); color: var(--accent-hover); border-color: var(--border-2);
        }
        .tb-suggest:hover { background: var(--bg-hover-2); color: var(--accent); border-color: var(--accent); }

        .tb-format {
            background: var(--bg-2); color: var(--purple); border-color: var(--border-2);
        }
        .tb-format:hover { background: rgba(139,92,246,0.15); border-color: var(--purple); }

        .tb-pin {
            background: var(--bg-2); color: var(--purple-light); border-color: var(--border-2);
        }
        .tb-pin:hover:not(:disabled) { background: rgba(139,92,246,0.15); border-color: var(--purple); }
        .tb-pin:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }

        .tb-export {
            background: var(--bg-2); color: var(--green-light); border-color: var(--border-2);
        }
        .tb-export:hover:not(:disabled) { background: var(--green-dim); color: var(--green); border-color: var(--green); }
        .tb-export:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }

        .tb-clear {
            background: var(--bg-2); color: var(--text-2); border-color: var(--border-2);
        }
        .tb-clear:hover { background: var(--bg-hover-2); }

        .tb-close {
            background: var(--bg-2); color: var(--red-light); border-color: var(--border-2);
        }
        .tb-close:hover { background: var(--red-dim); color: var(--red); border-color: var(--red); }

        .toolbar-spacer { flex: 1; }
        .chip {
            padding: 7px 16px;
            border-radius: 15px;
            font-size: 12.5px;
            font-weight: 800;
            background: var(--bg-2);
            color: var(--text-5);
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }
        .chip.ok { background: var(--green-dim); color: var(--green-light); }
        .chip.loading { background: rgba(251,191,36,0.12); color: var(--amber); }
        .chip.err { background: var(--red-dim); color: var(--red-light); }

        /* ========== EDITOR ========== */
        .editor-wrap { padding: 16px 20px; background: var(--bg-0); flex-shrink: 0; }
        .editor-box {
            border: 1px solid var(--border-1);
            border-radius: 11px;
            background: var(--bg-3);
            overflow: hidden;
            transition: 0.15s;
        }
        .editor-box:focus-within {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-dim);
        }
        textarea.sql {
            width: 100%;
            min-height: 200px;
            max-height: 400px;
            padding: 18px 22px;
            background: var(--bg-3);
            color: var(--text-1);
            border: none;
            outline: none;
            resize: vertical;
            font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', 'Monaco', monospace;
            font-size: 15.5px;
            line-height: 1.75;
            caret-color: var(--accent);
            tab-size: 4;
            display: block;
        }
        textarea.sql::placeholder { color: var(--text-6); }

        /* ========== RESULTS ========== */
        .results {
            flex: 1;
            display: flex; flex-direction: column;
            overflow: hidden;
            border-top: 1px solid var(--border-1);
            background: var(--bg-3);
            min-height: 0;
        }
        .res-bar {
            padding: 12px 20px;
            background: var(--bg-1);
            border-bottom: 1px solid var(--border-1);
            display: flex;
            align-items: center;
            gap: 22px;
            font-size: 14.5px;
            flex-wrap: wrap;
            flex-shrink: 0;
        }
        .res-bar .label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-5);
            font-weight: 800;
            margin-right: 6px;
        }
        .res-stat { color: var(--text-3); display: flex; align-items: center; }
        .res-stat b { color: var(--text-1); font-weight: 700; margin-left: 4px; }
        .res-time.ok   { color: var(--green-light); }
        .res-time.warn { color: var(--amber); }
        .res-time.slow { color: var(--red-light); }
        .res-bar-spacer { flex: 1; }

        .res-search-wrap { position: relative; display: flex; align-items: center; }
        .res-search-icon {
            position: absolute; left: 11px;
            color: var(--text-6); font-size: 15px;
            pointer-events: none;
        }
        .res-search {
            padding: 8px 14px 8px 36px;
            background: var(--bg-2);
            border: 1px solid var(--border-2);
            border-radius: 9px;
            color: var(--text-1);
            font-size: 14.5px;
            width: 240px;
            outline: none;
            font-family: inherit;
            transition: 0.15s;
        }
        .res-search:focus {
            border-color: var(--accent);
            width: 300px;
            box-shadow: 0 0 0 3px var(--accent-dim);
        }

        .res-body {
            flex: 1;
            overflow: auto;
            position: relative;
            min-height: 0;
            min-width: 0;
        }
        .res-body::-webkit-scrollbar { width: 14px; height: 14px; }
        .res-body::-webkit-scrollbar-track { background: var(--bg-3); }
        .res-body::-webkit-scrollbar-thumb {
            background: var(--border-2);
            border-radius: 7px;
            border: 3px solid var(--bg-3);
        }
        .res-body::-webkit-scrollbar-thumb:hover { background: var(--border-3); }
        .res-body::-webkit-scrollbar-corner { background: var(--bg-3); }

        .table-scroll {
            display: inline-block;
            min-width: 100%;
            vertical-align: top;
        }
        table.data {
            border-collapse: separate;
            border-spacing: 0;
            font-size: 14px;
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            width: max-content;
            min-width: 100%;
        }
        table.data th {
            background: var(--table-th-bg);
            color: var(--table-th-color);
            padding: 12px 16px;
            text-align: left;
            position: sticky;
            top: 0;
            z-index: 5;
            font-weight: 800;
            font-size: 13.5px;
            white-space: nowrap;
            border-bottom: 2px solid var(--border-1);
            border-right: 1px solid var(--border-1);
            cursor: pointer;
            user-select: none;
            min-width: 140px;
            max-width: 440px;
        }
        table.data th:hover { background: var(--bg-hover-2); }
        table.data th .sort-icon {
            display: inline-block;
            margin-left: 6px;
            font-size: 11px;
            color: var(--text-6);
        }
        table.data th.sorted-asc .sort-icon { color: var(--green-light); }
        table.data th.sorted-desc .sort-icon { color: var(--red-light); }

        table.data th.th-idx {
            width: 66px;
            min-width: 66px;
            max-width: 66px;
            text-align: right;
            position: sticky;
            left: 0;
            z-index: 6;
            background: var(--table-th-bg);
            border-right: 1px solid var(--border-2);
        }

        table.data td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--table-td-border);
            border-right: 1px solid var(--table-td-border);
            color: var(--text-2);
            white-space: nowrap;
            min-width: 140px;
            max-width: 440px;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        table.data tr:nth-child(even) td { background: var(--table-row-even); }
        table.data tr:hover td { background: var(--table-row-hover); }

        table.data td.row-no {
            color: var(--text-5);
            background: var(--bg-3);
            width: 66px;
            min-width: 66px;
            max-width: 66px;
            text-align: right;
            font-size: 13px;
            position: sticky;
            left: 0;
            z-index: 4;
            border-right: 1px solid var(--border-2);
        }
        table.data tr:nth-child(even) td.row-no { background: var(--bg-3); }
        table.data tr:hover td.row-no { background: var(--bg-hover-2); }

        .null-cell { color: var(--text-6); font-style: italic; }
        .hl-match { background: rgba(251,191,36,0.35); color: var(--text-0); padding: 1px 3px; border-radius: 3px; }

        .alert {
            padding: 16px 24px;
            margin: 18px 24px;
            border-radius: 9px;
            font-size: 14.5px;
        }
        .alert-ok {
            background: var(--green-dim);
            border-left: 4px solid var(--green);
            color: var(--green-light);
        }
        .alert-err {
            background: var(--red-dim);
            border-left: 4px solid var(--red);
            color: var(--red-light);
            font-family: 'JetBrains Mono', monospace;
            white-space: pre-wrap;
            font-size: 13.5px;
        }

        /* ========== LOADER ========== */
        .loader-overlay {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            height: 100%;
            gap: 22px;
            padding: 40px;
        }
        .loader-big {
            width: 64px; height: 64px;
            border: 5px solid var(--bg-2);
            border-top-color: var(--accent);
            border-right-color: var(--accent-hover);
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loader-text {
            font-size: 17px;
            font-weight: 600;
            color: var(--text-2);
        }
        .loader-sub { font-size: 14px; color: var(--text-5); margin-top: -14px; }

        .placeholder {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            height: 100%;
            color: var(--text-6);
            gap: 16px;
            padding: 40px;
            text-align: center;
        }
        .placeholder .ph-icon { font-size: 54px; opacity: 0.35; }
        .placeholder .ph-title { font-size: 19px; color: var(--text-5); font-weight: 600; }
        .placeholder .ph-sub { font-size: 15px; color: var(--text-6); }

        /* ========== PINNED TAB ========== */
        .pinned-banner {
            padding: 12px 20px;
            background: linear-gradient(90deg, rgba(139,92,246,0.15), transparent);
            border-bottom: 1px solid var(--border-1);
            display: flex;
            align-items: center;
            gap: 14px;
            flex-shrink: 0;
        }
        .pinned-banner .pb-title {
            font-size: 15px;
            font-weight: 800;
            color: var(--purple);
            display: flex; align-items: center; gap: 8px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }
        .pinned-banner .pb-hint {
            font-size: 14px;
            color: var(--text-4);
            font-style: italic;
        }
        .pinned-banner .pb-spacer { flex: 1; }
        .pinned-banner .pb-unpin {
            padding: 7px 16px;
            background: var(--bg-2);
            border: 1px solid var(--border-2);
            border-radius: 7px;
            color: var(--red-light);
            font-size: 13.5px;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            transition: 0.15s;
        }
        .pinned-banner .pb-unpin:hover { background: var(--red-dim); color: var(--red); border-color: var(--red); }

        .pinned-editor-box {
            padding: 16px 20px;
            background: var(--bg-0);
            flex-shrink: 0;
        }
        .pinned-readonly {
            border: 1px solid var(--border-1);
            border-radius: 11px;
            background: var(--bg-3);
            padding: 14px 18px;
            color: var(--text-3);
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 14px;
            line-height: 1.65;
            max-height: 160px;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-word;
        }

        /* ========== STATUS BAR ========== */
        .status {
            grid-area: status;
            background: var(--bg-1);
            color: var(--text-4);
            display: flex;
            align-items: center;
            font-size: 13.5px;
            padding: 0 24px;
            gap: 26px;
            border-top: 1px solid var(--border-1);
        }
        .status .st-item { display: flex; align-items: center; gap: 8px; }
        .status .st-item b { color: var(--text-1); font-weight: 700; }
        .status .right { margin-left: auto; display: flex; gap: 26px; }
        .st-dot {
            width: 10px; height: 10px; border-radius: 50%;
            background: var(--green-light);
        }

        /* ========== AUTOCOMPLETE ========== */
        .ac-box {
            position: fixed;
            background: var(--bg-2);
            border: 1px solid var(--border-3);
            border-radius: 9px;
            box-shadow: var(--shadow-lg);
            max-height: 320px;
            overflow-y: auto;
            z-index: 9999;
            display: none;
            min-width: 360px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 14px;
        }
        .ac-box::-webkit-scrollbar { width: 9px; }
        .ac-box::-webkit-scrollbar-thumb { background: var(--border-3); border-radius: 4px; }

        .ac-item {
            padding: 10px 16px;
            cursor: pointer;
            color: var(--text-3);
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: center;
            border-bottom: 1px solid var(--border-1);
        }
        .ac-item:last-child { border-bottom: none; }
        .ac-item:hover, .ac-item.active {
            background: var(--accent-dim);
            color: var(--text-0);
        }
        .ac-item.active { background: var(--accent); color: #fff; }
        .ac-tag {
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 9px;
            font-weight: 800;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        .tag-KEYWORD { background: rgba(192,132,252,0.15); color: #c084fc; }
        .tag-SCHEMA  { background: rgba(96,165,250,0.15); color: #60a5fa; }
        .tag-TABLE   { background: rgba(74,222,128,0.15); color: #4ade80; }
        .tag-COLUMN  { background: rgba(251,191,36,0.15); color: #fbbf24; }

        .toast {
            position: fixed;
            bottom: 50px; right: 26px;
            background: var(--bg-2);
            border-left: 4px solid var(--green);
            color: var(--text-1);
            padding: 16px 24px;
            border-radius: 9px;
            box-shadow: var(--shadow-lg);
            font-size: 14.5px;
            z-index: 10001;
            animation: slideIn 0.22s ease;
            max-width: 420px;
            font-weight: 600;
        }
        .toast.err { border-left-color: var(--red); }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }
    </style>
</head>
<body data-theme="dark">

<div class="app">

    <div class="header">
        <div class="brand">
            <div class="brand-mark">EIS</div>
            Query Console
            <span class="brand-sub">Production</span>
        </div>
        <div class="header-spacer"></div>
        <div class="conn-pill">
            <span class="conn-dot"></span> CONNECTED
        </div>
        <div class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
            <span class="tt-icon tt-sun">&#9728;</span>
            <span class="tt-icon tt-moon">&#9789;</span>
            <div class="tt-knob"></div>
        </div>
        <a class="btn-dashboard" href="<%= dashboardUrl %>" target="_blank" rel="noopener noreferrer">
            Dashboard
        </a>
        <button class="btn-new" onclick="newTab()">+ New Query Tab</button>
    </div>

    <div class="sidebar">
        <div class="sidebar-head">
            SAVED QUERIES
            <span class="sidebar-count" id="qCount">0</span>
        </div>
        <div class="search-wrap">
            <input type="text" class="search-input" id="qSearch" placeholder="Search queries...">
        </div>
        <div class="tree" id="tree">

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)"><span class="tg-arrow">&#9654;</span> Gen 5 — Error Summary</div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">Broker-wise error count (last 5 min)
                        <script type="text/plain" class="q-sql">SELECT broker_eg, broker_name, ERROR_CODE, ERROR_DESCRIPTION, url, api_name, COUNT(*) AS CNT FROM EISAPP.API_LOG WHERE Request_date_time>=SYSDATE - INTERVAL '05' MINUTE and (substr(error_code,3,3) in ('001','002','007','051','014','111','570','569','052','005','077','003','017','015') and error_code<>'00014' OR error_code in ('401','500')) and ERROR_DESCRIPTION is not null and error_description not like '%No active transaction found, please do check GCC machine and retry%' GROUP BY broker_eg,broker_name, ERROR_CODE, error_description,url,api_name ORDER BY CNT DESC;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)"><span class="tg-arrow">&#9654;</span> Daily Use (Last 10 min)</div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">api_log — recent
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where request_date_time >= sysdate - interval '10' minute order by request_date_time desc;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">api_log — error summary
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.api_log where request_date_time >= sysdate - interval '10' minute GROUP by error_code, error_description;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log — recent
                        <script type="text/plain" class="q-sql">select * from eisapp.BACKEND_log where request_date_time >= sysdate - interval '10' minute order by request_date_time desc;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log — error summary
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.BACKEND_log where request_date_time >= sysdate - interval '10' minute GROUP by error_code, error_description;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)"><span class="tg-arrow">&#9654;</span> URN Search</div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_details where URN in('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">orch_api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">orch_api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_details where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_details where URN in ('');</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)"><span class="tg-arrow">&#9654;</span> URL / Mappers</div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">source_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.source_mapper;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">url_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.url_mapper;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">urn_details
                        <script type="text/plain" class="q-sql">select * from EISAPP.urn_details;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">cache_details
                        <script type="text/plain" class="q-sql">SELECT * FROM EISAPP.cache_details;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">Find API (NOMINEE)
                        <script type="text/plain" class="q-sql">select distinct api_name from eisapp.api_log where UPPER(api_name) like '%NOMINEE%';</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)"><span class="tg-arrow">&#9654;</span> SI Monitoring (SBISI)</div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">SI_TRANS_DB — error summary
                        <script type="text/plain" class="q-sql">SELECT function_name,ERROR_CODE, ERROR_DESC, COUNT(*) AS CNT FROM SBISI.SI_TRANS_DB WHERE SUBSTR(error_code,1,2) = 'SI' and req_time>=SYSDATE - INTERVAL '10' MINUTE GROUP BY ERROR_CODE,ERROR_DESC,function_name ORDER BY CNT DESC;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">EKYC_log — TD% (SI207, SI392)
                        <script type="text/plain" class="q-sql">select COUNT(1) as TOTAL_HITS, SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS, SUM(CASE WHEN ERROR_CODE IS NOT NULL AND error_code NOT IN ('SI392','SI207') THEN 1 ELSE 0 END) "BD", SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END) "SI392", ROUND((SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI392%", SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END) "SI207", ROUND((SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END)/COUNT(1))*100,2) "TD%" from SBISI.EKYC_log where resp_date_time >=sysdate - interval '15' minute;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">EKYC (SI392) — recent
                        <script type="text/plain" class="q-sql">select * from SBISI.ekyc_log where error_code = 'SI392' and req_date_time>=SYSDATE - INTERVAL '10' MINUTE order by req_date_time desc;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)"><span class="tg-arrow">&#9654;</span> Performance / Latency</div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">EXP IP response-time buckets
                        <script type="text/plain" class="q-sql">SELECT exp_ip,COUNT(1), SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS, sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC, sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC FROM EISAPP.API_LOG WHERE broker_name = 'LOGGING_EXP' and request_date_time>=SYSDATE-INTERVAL '02' MINUTE group by exp_ip;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">SYS latency — backend vs orch
                        <script type="text/plain" class="q-sql">SELECT b.sys_ip,COUNT(1), sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC, sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC FROM EISAPP.backend_log b , EISAPP.orch_api_log a WHERE a.urn=b.urn and b.sys_broker = 'LOGGING_SYS' and b.creation_date_time>=SYSDATE-INTERVAL '02' MINUTE group by b.sys_ip;</script>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="main">
        <div class="tabbar" id="tabbar">
            <div class="tab-add" onclick="newTab()" title="New Tab (Ctrl+T)">+</div>
        </div>
        <div class="tab-content" id="tabContent"></div>
    </div>

    <div class="status">
        <div class="st-item">
            <span class="st-dot"></span>
            <b id="stDb">IIB DB (EISAPP)</b>
        </div>
        <div class="st-item" id="stTab">Tab: —</div>
        <div class="right">
            <div class="st-item" id="stLast">Last exec: —</div>
            <div class="st-item" id="stCount">1 tab</div>
        </div>
    </div>

</div>

<div id="acBox" class="ac-box"></div>

<script>
/* ============================================================
 * EIS QUERY CONSOLE — v6.0
 * ============================================================ */

var DB_META = {
    "IIB":    { label: "IIB DB (EISAPP)", dot: "db-IIB" },
    "SI":     { label: "SI DB (SBISI)",   dot: "db-SI" },
    "REPORT": { label: "Report DB",       dot: "db-REPORT" }
};
var DEFAULT_DB = "<%= dbType %>";

/* ============================================================
 * FALLBACK — All your IIB/SI queries' tables + columns
 * ============================================================ */
var FALLBACK = {
    "IIB": {
        schemas: ["EISAPP"],
        tables: [
