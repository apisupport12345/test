package com.jdbc;

import java.sql.Connection;
import java.sql.DatabaseMetaData;
import java.sql.ResultSet;
import java.sql.ResultSetMetaData;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

public class QueryRunner {

    public static class QueryResult {
        public boolean success;
        public String message;
        public List<String> columns = new ArrayList<>();
        public List<Map<String, Object>> rows = new ArrayList<>();
        public int updateCount = -1;
        public long executionTimeMs;
        public String queryType;
    }

    public static class Suggestion {
        public String label;
        public String insert;
        public String type;
        public Suggestion(String label, String insert, String type) {
            this.label = label;
            this.insert = insert;
            this.type = type;
        }
    }

    private static final String[] KEYWORDS = {
        "SELECT", "FROM", "WHERE", "AND", "OR", "NOT", "NULL", "IS", "IN",
        "LIKE", "BETWEEN", "ORDER BY", "GROUP BY", "HAVING", "JOIN", "INNER JOIN",
        "LEFT JOIN", "RIGHT JOIN", "FULL JOIN", "ON", "AS", "DISTINCT", "COUNT",
        "SUM", "AVG", "MIN", "MAX", "INSERT INTO", "VALUES", "UPDATE", "SET",
        "DELETE FROM", "CREATE TABLE", "DROP TABLE", "ALTER TABLE", "TRUNCATE",
        "UNION", "UNION ALL", "EXISTS", "CASE", "WHEN", "THEN", "ELSE", "END",
        "ROWNUM", "SYSDATE", "DUAL", "FETCH FIRST", "OFFSET", "LIMIT",
        "ASC", "DESC", "COMMIT", "ROLLBACK", "WITH", "PARTITION"
    };

    public static String getDefaultSchema(String dbType) {
        if ("IIB".equalsIgnoreCase(dbType)) return "EISAPP";
        if ("SI".equalsIgnoreCase(dbType))  return "SBISI";
        return null;
    }

    private static Connection getConn(String dbType) throws Exception {
        if ("IIB".equalsIgnoreCase(dbType)) {
            return DBUtilityAuto.getIIBDBConnection();
        } else if ("SI".equalsIgnoreCase(dbType)) {
            return DBUtilityAuto.getSIDBConnection();
        } else {
            return DBUtilityAuto.getReportDBConnection();
        }
    }

    public static List<Suggestion> getSchemaSuggestions(String dbType) {
        List<Suggestion> list = new ArrayList<>();
        Set<String> seen = new LinkedHashSet<>();
        Connection conn = null;
        ResultSet rs = null;
        try {
            conn = getConn(dbType);
            if (conn == null) return list;
            DatabaseMetaData md = conn.getMetaData();

            String defSch = getDefaultSchema(dbType);
            if (defSch != null && seen.add(defSch.toUpperCase())) {
                list.add(new Suggestion(defSch, defSch + ".", "SCHEMA"));
            }
            String userSch = md.getUserName();
            if (userSch != null && seen.add(userSch.toUpperCase())) {
                list.add(new Suggestion(userSch, userSch + ".", "SCHEMA"));
            }
            rs = md.getSchemas();
            int count = 0;
            while (rs.next() && count < 50) {
                String s = rs.getString("TABLE_SCHEM");
                if (s == null) continue;
                String upper = s.toUpperCase();
                if (upper.startsWith("SYS") || upper.startsWith("XDB")
                    || upper.equals("MDSYS") || upper.equals("CTXSYS")
                    || upper.equals("DBSNMP") || upper.equals("OUTLN")
                    || upper.equals("APPQOSSYS") || upper.equals("ANONYMOUS")
                    || upper.equals("OLAPSYS") || upper.equals("ORDDATA")
                    || upper.equals("ORDSYS") || upper.equals("WMSYS")
                    || upper.equals("LBACSYS") || upper.equals("AUDSYS")
                    || upper.equals("GSMADMIN_INTERNAL") || upper.equals("OJVMSYS")) continue;
                if (seen.add(upper)) {
                    list.add(new Suggestion(s, s + ".", "SCHEMA"));
                    count++;
                }
            }
        } catch (Exception e) {
            System.err.println("Schema suggestion error: " + e.getMessage());
        } finally {
            if (rs != null) try { rs.close(); } catch (Exception ignored) {}
            if (conn != null) try { conn.close(); } catch (Exception ignored) {}
        }
        return list;
    }

    public static List<Suggestion> getTableSuggestions(String dbType) {
        List<Suggestion> list = new ArrayList<>();
        Set<String> seen = new LinkedHashSet<>();
        Connection conn = null;
        ResultSet rs = null;
        try {
            conn = getConn(dbType);
            if (conn == null) return list;
            DatabaseMetaData md = conn.getMetaData();

            String defSch = getDefaultSchema(dbType);
            if (defSch != null) {
                rs = md.getTables(null, defSch, "%", new String[]{"TABLE", "VIEW"});
                while (rs.next()) {
                    String tbl = rs.getString("TABLE_NAME");
                    String key = defSch.toUpperCase() + "." + tbl.toUpperCase();
                    if (seen.add(key)) {
                        list.add(new Suggestion(defSch + "." + tbl, defSch + "." + tbl, "TABLE"));
                    }
                }
                try { rs.close(); } catch (Exception ignored) {}
            }
            String userSch = md.getUserName();
            if (userSch != null) {
                rs = md.getTables(null, userSch, "%", new String[]{"TABLE", "VIEW"});
                while (rs.next()) {
                    String tbl = rs.getString("TABLE_NAME");
                    String key = userSch.toUpperCase() + "." + tbl.toUpperCase();
                    if (seen.add(key)) {
                        list.add(new Suggestion(tbl, tbl, "TABLE"));
                    }
                }
            }
        } catch (Exception e) {
            System.err.println("Table suggestion error: " + e.getMessage());
        } finally {
            if (rs != null) try { rs.close(); } catch (Exception ignored) {}
            if (conn != null) try { conn.close(); } catch (Exception ignored) {}
        }
        return list;
    }

    public static List<Suggestion> getColumnSuggestions(String dbType, String schema, String tableName) {
        List<Suggestion> list = new ArrayList<>();
        Connection conn = null;
        ResultSet rs = null;
        try {
            conn = getConn(dbType);
            if (conn == null) return list;
            DatabaseMetaData md = conn.getMetaData();
            String sch = (schema != null && !schema.isEmpty()) ? schema : md.getUserName();
            rs = md.getColumns(null, sch.toUpperCase(), tableName.toUpperCase(), "%");
            while (rs.next()) {
                String col = rs.getString("COLUMN_NAME");
                String type = rs.getString("TYPE_NAME");
                list.add(new Suggestion(col, col, "COLUMN:" + type));
            }
        } catch (Exception e) {
            System.err.println("Column suggestion error: " + e.getMessage());
        } finally {
            if (rs != null) try { rs.close(); } catch (Exception ignored) {}
            if (conn != null) try { conn.close(); } catch (Exception ignored) {}
        }
        return list;
    }

    public static List<Suggestion> getKeywordSuggestions() {
        List<Suggestion> list = new ArrayList<>();
        for (String k : KEYWORDS) list.add(new Suggestion(k, k, "KEYWORD"));
        return list;
    }

    public static QueryResult execute(String sql, String dbType) {
        QueryResult result = new QueryResult();
        long start = System.currentTimeMillis();

        if (sql == null || sql.trim().isEmpty()) {
            result.success = false;
            result.message = "Query is empty.";
            return result;
        }

        Connection conn = null;
        Statement stmt = null;
        ResultSet rs = null;

        try {
            conn = getConn(dbType);
            if (conn == null) {
                result.success = false;
                result.message = "Could not obtain DB connection. Check DB availability.";
                return result;
            }
            stmt = conn.createStatement();
            String trimmed = sql.trim();
            while (trimmed.endsWith(";")) trimmed = trimmed.substring(0, trimmed.length() - 1).trim();
            String upper = trimmed.toUpperCase();

            boolean isSelect = upper.startsWith("SELECT")
                    || upper.startsWith("WITH")
                    || upper.startsWith("SHOW")
                    || upper.startsWith("DESC");

            if (isSelect) {
                result.queryType = "SELECT";
                rs = stmt.executeQuery(trimmed);
                ResultSetMetaData md = rs.getMetaData();
                int colCount = md.getColumnCount();
                for (int i = 1; i <= colCount; i++) result.columns.add(md.getColumnLabel(i));
                int rowLimit = 5000;
                while (rs.next() && result.rows.size() < rowLimit) {
                    Map<String, Object> row = new LinkedHashMap<>();
                    for (int i = 1; i <= colCount; i++) row.put(md.getColumnLabel(i), rs.getObject(i));
                    result.rows.add(row);
                }
                result.success = true;
                result.message = "Query executed. " + result.rows.size() + " rows returned.";
            } else {
                result.queryType = upper.split("\\s+")[0];
                boolean hasResultSet = stmt.execute(trimmed);
                if (hasResultSet) {
                    rs = stmt.getResultSet();
                    ResultSetMetaData md = rs.getMetaData();
                    int colCount = md.getColumnCount();
                    for (int i = 1; i <= colCount; i++) result.columns.add(md.getColumnLabel(i));
                    while (rs.next() && result.rows.size() < 5000) {
                        Map<String, Object> row = new LinkedHashMap<>();
                        for (int i = 1; i <= colCount; i++) row.put(md.getColumnLabel(i), rs.getObject(i));
                        result.rows.add(row);
                    }
                } else {
                    result.updateCount = stmt.getUpdateCount();
                }
                result.success = true;
                result.message = "Query executed. Rows affected: " + result.updateCount;
            }
        } catch (Exception e) {
            result.success = false;
            result.message = "Error: " + e.getMessage();
        } finally {
            if (rs != null) try { rs.close(); } catch (Exception ignored) {}
            if (stmt != null) try { stmt.close(); } catch (Exception ignored) {}
            if (conn != null) try { conn.close(); } catch (Exception ignored) {}
            result.executionTimeMs = System.currentTimeMillis() - start;
        }
        return result;
    }

    public static String esc(String s) {
        if (s == null) return "";
        return s.replace("\\", "\\\\").replace("\"", "\\\"")
                .replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t");
    }
}


