package com.jdbc;

import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.ResultSetMetaData;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class QueryRunner {

    public static class QueryResult {
        public boolean success;
        public String message;
        public List<String> columns = new ArrayList<>();
        public List<Map<String, Object>> rows = new ArrayList<>();
        public int updateCount = -1;
        public long executionTimeMs;
        public String queryType;
    }

    public static QueryResult execute(String sql, String dbType) {
        QueryResult result = new QueryResult();
        long start = System.currentTimeMillis();

        if (sql == null || sql.trim().isEmpty()) {
            result.success = false;
            result.message = "Query empty hai. Kuch likho!";
            return result;
        }

        Connection conn = null;
        Statement stmt = null;
        ResultSet rs = null;

        try {
            if ("IIB".equalsIgnoreCase(dbType)) {
                conn = DBUtilityAuto.getIIBDBConnection();
            } else if ("SI".equalsIgnoreCase(dbType)) {
                conn = DBUtilityAuto.getSIDBConnection();
            } else {
                conn = DBUtilityAuto.getReportDBConnection();
            }

            if (conn == null) {
                result.success = false;
                result.message = "Connection nahi mila! DB down ho sakta hai.";
                return result;
            }

            stmt = conn.createStatement();
            String trimmed = sql.trim();
            String upper = trimmed.toUpperCase();

            boolean isSelect = upper.startsWith("SELECT")
                    || upper.startsWith("WITH")
                    || upper.startsWith("SHOW")
                    || upper.startsWith("DESC");

            if (isSelect) {
                result.queryType = "SELECT";
                rs = stmt.executeQuery(trimmed);

                ResultSetMetaData md = rs.getMetaData();
                int colCount = md.getColumnCount();
                for (int i = 1; i <= colCount; i++) {
                    result.columns.add(md.getColumnLabel(i));
                }

                int rowLimit = 5000;
                while (rs.next() && result.rows.size() < rowLimit) {
                    Map<String, Object> row = new LinkedHashMap<>();
                    for (int i = 1; i <= colCount; i++) {
                        row.put(md.getColumnLabel(i), rs.getObject(i));
                    }
                    result.rows.add(row);
                }
                result.success = true;
                result.message = "Query chal gayi. " + result.rows.size() + " rows mile.";
            } else {
                result.queryType = upper.split("\\s+")[0];
                boolean hasResultSet = stmt.execute(trimmed);

                if (hasResultSet) {
                    rs = stmt.getResultSet();
                    ResultSetMetaData md = rs.getMetaData();
                    int colCount = md.getColumnCount();
                    for (int i = 1; i <= colCount; i++) {
                        result.columns.add(md.getColumnLabel(i));
                    }
                    while (rs.next() && result.rows.size() < 5000) {
                        Map<String, Object> row = new LinkedHashMap<>();
                        for (int i = 1; i <= colCount; i++) {
                            row.put(md.getColumnLabel(i), rs.getObject(i));
                        }
                        result.rows.add(row);
                    }
                } else {
                    result.updateCount = stmt.getUpdateCount();
                }
                result.success = true;
                result.message = "Query execute ho gayi. Rows affected: " + result.updateCount;
            }

        } catch (Exception e) {
            result.success = false;
            result.message = "Error: " + e.getMessage();
        } finally {
            if (rs != null) try { rs.close(); } catch (Exception ignored) {}
            if (stmt != null) try { stmt.close(); } catch (Exception ignored) {}
            if (conn != null) try { conn.close(); } catch (Exception ignored) {}
            result.executionTimeMs = System.currentTimeMillis() - start;
        }

        return result;
    }
}


