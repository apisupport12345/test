WITH base AS (
  SELECT ip, type, route_url, lb_url
  FROM daily_dpg_url_data
  WHERE UPPER(lb_url) NOT LIKE '%SIAPP3%'  -- exclude SIAPP3 for now, handle separately
),
gen5 AS (
  SELECT ip, type, route_url, lb_url AS gen5_lb_url
  FROM base
  WHERE UPPER(lb_url) LIKE '%GEN5%'
     OR UPPER(lb_url) LIKE '%GETWAY%'   -- handle misspelling
),
gen6 AS (
  SELECT ip, type, route_url, lb_url AS gen6_lb_url
  FROM base
  WHERE UPPER(lb_url) NOT LIKE '%GEN5%'
    AND UPPER(lb_url) NOT LIKE '%GETWAY%'
),
-- For SIAPP3 rows (both gen5 and gen6 may have SIAPP3 prefix)
siapp3 AS (
  SELECT ip, type, route_url, lb_url
  FROM daily_dpg_url_data
  WHERE UPPER(lb_url) LIKE '%SIAPP3%'
),
gen5_siapp3 AS (
  SELECT ip, type, route_url, lb_url AS gen5_lb_url
  FROM siapp3
  WHERE UPPER(lb_url) LIKE '%GEN5%' OR UPPER(lb_url) LIKE '%GETWAY%'
),
gen6_siapp3 AS (
  SELECT ip, type, route_url, lb_url AS gen6_lb_url
  FROM siapp3
  WHERE UPPER(lb_url) NOT LIKE '%GEN5%' AND UPPER(lb_url) NOT LIKE '%GETWAY%'
)
-- Final: cartesian product for non-SIAPP3
SELECT g5.ip, g5.type, g5.gen5_lb_url, g6.gen6_lb_url, g5.route_url, SYSDATE
FROM gen5 g5
JOIN gen6 g6
  ON g5.ip = g6.ip AND g5.type = g6.type AND g5.route_url = g6.route_url

UNION ALL

-- Final: cartesian product for SIAPP3
SELECT g5.ip, g5.type, g5.gen5_lb_url, g6.gen6_lb_url, g5.route_url, SYSDATE
FROM gen5_siapp3 g5
JOIN gen6_siapp3 g6
  ON g5.ip = g6.ip AND g5.type = g6.type AND g5.route_url = g6.route_url;
