<script>
/* ============================================================
 * QUERY RUNNER — v2.0
 * ============================================================ */

var DB_META = {
    "IIB":    { label: "IIB DB (EISAPP)", dot: "db-IIB" },
    "SI":     { label: "SI DB (SBISI)",   dot: "db-SI" },
    "REPORT": { label: "Report DB",       dot: "db-REPORT" }
};
var DEFAULT_DB = "<%= dbType %>";

var SUGGEST = {
    loaded: false, loading: false,
    schemas: [], tables: [], keywords: [],
    columnCache: {}, dbFetched: null
};

var tabs = [];
var activeTabId = null;
var usedNumbers = {};   // track used numbers for reuse

/* ============ TAB ============ */
function Tab(num, db) {
    this.num = num;
    this.id = 'tab_' + num + '_' + Date.now();
    this.db = db || DEFAULT_DB;
    this.title = "Query " + num;
    this.sql = "";
    this.editorEl = null;
    this.el = null;
    this.paneEl = null;
    this.currentItems = [];
    this.activeIdx = -1;
    this.lastExecMs = null;
    this.lastResult = null;  // store result for export
}

/* ============ FIND FREE NUMBER (reuse on close) ============ */
function nextFreeNum() {
    var n = 1;
    while (usedNumbers[n]) n++;
    usedNumbers[n] = true;
    return n;
}

/* ============ NEW TAB ============ */
function newTab() {
    var num = nextFreeNum();
    var t = new Tab(num, DEFAULT_DB);
    tabs.push(t);
    renderTab(t);
    switchTab(t.id);
    saveTabs();
    return t;
}

function renderTab(t) {
    // Tab button
    var el = document.createElement('div');
    el.className = 'tab';
    el.dataset.tabId = t.id;
    el.innerHTML =
        '<span class="tab-dot ' + DB_META[t.db].dot + '"></span>' +
        '<span class="tab-name">' + t.title + '</span>' +
        '<span class="tab-close" title="Close (Ctrl+W)">×</span>';

    el.addEventListener('click', function(e) {
        if (e.target.classList.contains('tab-close')) {
            e.stopPropagation();
            closeTab(t.id);
            return;
        }
        switchTab(t.id);
    });

    var tabAdd = document.querySelector('.tab-add');
    document.getElementById('tabbar').insertBefore(el, tabAdd);
    t.el = el;

    // Pane
    var pane = document.createElement('div');
    pane.className = 'pane';
    pane.dataset.tabId = t.id;
    pane.innerHTML = buildPaneHTML(t);
    document.getElementById('tabContent').appendChild(pane);
    t.paneEl = pane;
    t.editorEl = pane.querySelector('.sql');

    bindEditorEvents(t);
    updateCount();
}

function buildPaneHTML(t) {
    return '' +
    '<div class="toolbar">' +
        '<select class="db-sel">' +
            '<option value="IIB"'    + (t.db === "IIB"    ? " selected" : "") + '>IIB DB (eisapp)</option>' +
            '<option value="SI"'     + (t.db === "SI"     ? " selected" : "") + '>SI DB (sbisi)</option>' +
            '<option value="REPORT"' + (t.db === "REPORT" ? " selected" : "") + '>Report DB</option>' +
        '</select>' +
        '<button class="tb tb-run"     onclick="runQuery(\'' + t.id + '\')">▶ Run</button>' +
        '<button class="tb tb-suggest" onclick="doSuggest(\'' + t.id + '\')">💡 Suggest</button>' +
        '<button class="tb tb-export"  onclick="exportResult(\'' + t.id + '\')" disabled>↓ Export</button>' +
        '<button class="tb tb-clear"   onclick="clearEditor(\'' + t.id + '\')">Clear</button>' +
        '<button class="tb tb-close"   onclick="closeTab(\'' + t.id + '\')">Close</button>' +
        '<div class="toolbar-spacer"></div>' +
        '<span class="status-chip" data-role="chip">idle</span>' +
    '</div>' +
    '<div class="editor-wrap">' +
        '<div class="editor-box">' +
            '<textarea class="sql" spellcheck="false" autocomplete="off" ' +
                'placeholder="-- Select a saved query from the sidebar, or write your SQL here&#10;-- Ctrl+Space: suggestions   |   Ctrl+Enter: run   |   Ctrl+T: new tab">' + escapeHtml(t.sql) + '</textarea>' +
        '</div>' +
    '</div>' +
    '<div class="results">' +
        '<div class="res-bar" style="display:none;" data-role="resBar">' +
            '<span class="res-stat"><span class="label">Type</span><b data-role="qType">—</b></span>' +
            '<span class="res-stat"><span class="label">Rows</span><b data-role="qRows">—</b></span>' +
            '<span class="res-stat"><span class="label">Time</span><b data-role="qTime">—</b></span>' +
            '<span class="res-stat"><span class="label">DB</span><b data-role="qDb">—</b></span>' +
        '</div>' +
        '<div class="res-body" data-role="resBody">' +
            '<div class="placeholder">' +
                '<div class="ph-icon">▶</div>' +
