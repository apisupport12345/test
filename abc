    // Default rolling window (used when no custom range is supplied)
    public static final int WINDOW_MINUTES = 5;

    // Debug flag - set false in production to reduce log noise
    public static final boolean DEBUG_SQL = true;
    public static final boolean DEBUG_PARTITIONS = true;

    public static class QueryResult {
