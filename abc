    // ============================================================
    // RUN ALL 3 IN PARALLEL
    // ============================================================
    public static Map<String, QueryResult> runAll() {
        return runAll(false, null, null);
    }

    public static Map<String, QueryResult> runAll(boolean useCustom, String startTime, String endTime) {
        System.out.println("############################################################");
        System.out.println("[IPO-RUN] START runAll() mode=" + (useCustom ? "MANUAL" : "AUTO")
                + " start=" + startTime + " end=" + endTime);
        System.out.println("[IPO-RUN] Current partition = [" + getCurrentPartitionName() + "]");
        System.out.println("############################################################");

        Map<String, QueryResult> results = new LinkedHashMap<>();
        ExecutorService pool = Executors.newFixedThreadPool(3);
        try {
            Future<QueryResult> f1 = pool.submit(new QueryTask("BACKEND_LOG",
                    getBackendQuery(useCustom, startTime, endTime)));
            Future<QueryResult> f2 = pool.submit(new QueryTask("API_NSE_INB",
                    getApiNseInbQuery(useCustom, startTime, endTime)));
            Future<QueryResult> f3 = pool.submit(new QueryTask("API_BSE",
                    getApiBseQuery(useCustom, startTime, endTime)));

            results.put("BACKEND_LOG", safeGet(f1));
            results.put("API_NSE_INB", safeGet(f2));
            results.put("API_BSE", safeGet(f3));
        } catch (Exception e) {
            System.out.println("[IPO-RUN] Pool error: " + e);
            e.printStackTrace();
            QueryResult err = new QueryResult();
            err.success = false;
            err.message = "Pool error: " + e.getMessage();
            results.put("ERROR", err);
        } finally {
            pool.shutdown();
            try { pool.awaitTermination(3, TimeUnit.SECONDS); } catch (InterruptedException ignored) {}
        }
        System.out.println("[IPO-RUN] END runAll() - done");
        return results;
    }

    private static QueryResult safeGet(Future<QueryResult> f) {
        try { return f.get(30, TimeUnit.MINUTES); }
        catch (Exception e) {
            QueryResult r = new QueryResult();
            r.success = false;
            r.message = "Timeout/Error: " + e.getMessage();
            return r;
        }
    }

    private static class QueryTask implements Callable<QueryResult> {
        private final String name;
        private final String sql;
        QueryTask(String name, String sql) { this.name = name; this.sql = sql; }

        @Override
        public QueryResult call() {
            QueryResult r = new QueryResult();
            r.queryName = name;
            long t0 = System.currentTimeMillis();
            Connection conn = null;
            Statement stmt = null;
            ResultSet rs = null;

            // Print the SQL that will be executed
            logSql(name, sql);

            try {
                conn = DBUtilityAuto.getIIBDBConnection();
                if (conn == null) {
                    r.success = false;
                    r.message = "Could not obtain IIB connection.";
                    System.out.println("[IPO-ERR][" + name + "] null connection");
                    return r;
                }

                // Print connection details
                logConnection(name, conn);

                // Print visible partitions
                logVisiblePartitions(name, conn);

                stmt = conn.createStatement();
                stmt.setFetchSize(500);
                long q0 = System.currentTimeMillis();
                rs = stmt.executeQuery(sql);
                long q1 = System.currentTimeMillis();
                System.out.println("[IPO-TIME][" + name + "] query execution took "
                        + (q1 - q0) + " ms");

                ResultSetMetaData md = rs.getMetaData();
                int colCount = md.getColumnCount();
                for (int i = 1; i <= colCount; i++) r.columns.add(md.getColumnLabel(i));

                while (rs.next()) {
                    Map<String, Object> row = new LinkedHashMap<>();
                    for (int i = 1; i <= colCount; i++) {
                        row.put(md.getColumnLabel(i), rs.getObject(i));
                    }
                    r.rows.add(row);
                }
                r.success = true;
                r.message = r.rows.size() + " rows";
                System.out.println("[IPO-OK][" + name + "] fetched " + r.rows.size() + " rows");
            } catch (Exception e) {
                r.success = false;
                r.message = "Error: " + e.getMessage();
                System.out.println("[IPO-ERR][" + name + "] " + e.getClass().getName()
                        + ": " + e.getMessage());
                e.printStackTrace();
            } finally {
                if (rs != null) try { rs.close(); } catch (Exception ignored) {}
                if (stmt != null) try { stmt.close(); } catch (Exception ignored) {}
                if (conn != null) try { conn.close(); } catch (Exception ignored) {}
                r.executionTimeMs = System.currentTimeMillis() - t0;
                System.out.println("[IPO-TIME][" + name + "] total = "
                        + r.executionTimeMs + " ms, success=" + r.success);
            }
            return r;
        }
    }

    public static String esc(String s) {
        if (s == null) return "";
        return s.replace("\\", "\\\\").replace("\"", "\\\"")
                .replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t");
    }

    public static String toJson(QueryResult qr) {
        StringBuilder sb = new StringBuilder("{");
        sb.append("\"name\":\"").append(esc(qr.queryName)).append("\",");
        sb.append("\"success\":").append(qr.success).append(",");
        sb.append("\"message\":\"").append(esc(qr.message)).append("\",");
        sb.append("\"executionTimeMs\":").append(qr.executionTimeMs).append(",");
        sb.append("\"columns\":[");
        for (int i = 0; i < qr.columns.size(); i++) {
            if (i > 0) sb.append(",");
            sb.append("\"").append(esc(qr.columns.get(i))).append("\"");
        }
        sb.append("],\"rows\":[");
        for (int r = 0; r < qr.rows.size(); r++) {
            if (r > 0) sb.append(",");
            sb.append("{");
            Map<String, Object> row = qr.rows.get(r);
            int c = 0;
            for (String col : qr.columns) {
                if (c++ > 0) sb.append(",");
                Object v = row.get(col);
                sb.append("\"").append(esc(col)).append("\":");
                if (v == null) sb.append("null");
                else sb.append("\"").append(esc(v.toString())).append("\"");
            }
            sb.append("}");
        }
        sb.append("]}");
        return sb.toString();
    }
