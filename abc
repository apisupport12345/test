/* ============ SWITCH / CLOSE ============ */
function switchTab(id) {
    activeTabId = id;
    document.querySelectorAll('.tab').forEach(function(el) {
        el.classList.toggle('active', el.dataset.tabId === id);
    });
    document.querySelectorAll('.pane').forEach(function(el) {
        el.classList.toggle('active', el.dataset.tabId === id);
    });
    var t = getTab(id);
    if (t && t.editorEl) try { t.editorEl.focus(); } catch(e) {}
    updateStatus();
    saveTabs();
}

function getTab(id) {
    for (var i = 0; i < tabs.length; i++) if (tabs[i].id === id) return tabs[i];
    return null;
}

function closeTab(id) {
    var idx = -1;
    for (var i = 0; i < tabs.length; i++) if (tabs[i].id === id) { idx = i; break; }
    if (idx === -1) return;
    var t = tabs[idx];

    if (t.sql && t.sql.trim()) {
        if (!confirm('Close "' + t.title + '"? Unsaved query will be lost.')) return;
    }

    // free the number for reuse
    delete usedNumbers[t.num];

    if (t.el) t.el.remove();
    if (t.paneEl) t.paneEl.remove();
    tabs.splice(idx, 1);

    if (tabs.length === 0) {
        newTab();
    } else if (activeTabId === id) {
        switchTab(tabs[Math.max(0, idx - 1)].id);
    }
    updateCount();
    saveTabs();
}

/* ============ EDITOR EVENTS ============ */
function bindEditorEvents(t) {
    var ta = t.editorEl;
    var dbSel = t.paneEl.querySelector('.db-sel');

    ta.addEventListener('input', function() {
        t.sql = ta.value;
        clearTimeout(ta._tmr);
        ta._tmr = setTimeout(function() {
            saveTabs();
            autoSuggest(t);
        }, 130);
    });

    dbSel.addEventListener('change', function() {
        t.db = dbSel.value;
        t.el.querySelector('.tab-dot').className = 'tab-dot ' + DB_META[t.db].dot;
        if (SUGGEST.dbFetched && SUGGEST.dbFetched !== t.db) {
            SUGGEST.loaded = false; SUGGEST.dbFetched = null;
        }
        updateStatus();
        toast("DB switched to " + DB_META[t.db].label);
        saveTabs();
    });

    ta.addEventListener('keydown', function(e) {
        var boxOpen = document.getElementById('acBox').style.display === 'block';

        if (e.ctrlKey && e.key === ' ') { e.preventDefault(); doSuggest(t.id); return; }
        if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); runQuery(t.id); return; }
        if (e.ctrlKey && (e.key === 't' || e.key === 'T')) { e.preventDefault(); newTab(); return; }
        if (e.ctrlKey && (e.key === 'w' || e.key === 'W')) { e.preventDefault(); closeTab(t.id); return; }

        if (boxOpen && t.currentItems.length > 0) {
            if (e.key === 'ArrowDown') { e.preventDefault(); t.activeIdx = (t.activeIdx + 1) % t.currentItems.length; updateActive(t); return; }
            if (e.key === 'ArrowUp')   { e.preventDefault(); t.activeIdx = (t.activeIdx - 1 + t.currentItems.length) % t.currentItems.length; updateActive(t); return; }
            if (e.key === 'Enter' || e.key === 'Tab') {
                if (t.activeIdx >= 0) { e.preventDefault(); pickSuggestion(t, t.activeIdx); return; }
            }
            if (e.key === 'Escape') { e.preventDefault(); hideSuggest(t); return; }
        }
    });
}

/* ============ AUTO SUGGEST ON TYPING ============ */
function autoSuggest(t) {
    var ctx = getCtx(t);
    if ((ctx.word && ctx.word.length >= 1) || ctx.dotBefore) {
        ensureSuggest(t, function(){ showSuggest(t, false); });
    } else {
        hideSuggest(t);
    }
}

/* ============ BUTTON: SUGGEST ============ */
function doSuggest(id) {
    var t = getTab(id); if (!t) return;
    ensureSuggest(t, function(){ showSuggest(t, true); });
}

/* ============ ENSURE SUGGESTIONS LOADED ============ */
function ensureSuggest(t, cb) {
    if (SUGGEST.loaded && SUGGEST.dbFetched === t.db) { cb(); return; }
    if (SUGGEST.loading) {
        var w = setInterval(function(){
            if (!SUGGEST.loading) {
                clearInterval(w);
                if (SUGGEST.dbFetched === t.db) cb();
                else ensureSuggest(t, cb);
            }
        }, 80);
        return;
    }
    SUGGEST.loading = true;
    setChip(t, "loading", "loading...");

    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'query.jsp?ajax=suggest&db=' + encodeURIComponent(t.db), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        if (xhr.status === 200) {
            try {
                var d = JSON.parse(xhr.responseText);
                SUGGEST.schemas = d.schemas || [];
                SUGGEST.tables  = d.tables  || [];
                SUGGEST.keywords = d.keywords || [];
                SUGGEST.loaded = true;
                SUGGEST.dbFetched = t.db;
                setChip(t, "ok", "ready");
                setTimeout(function(){ setChip(t, null, "idle"); }, 2000);
                if (d.error) console.warn("Suggest warn: " + d.error);
            } catch(e) {
                console.error("Suggest parse error", e);
                setChip(t, "err", "suggest failed");
            }
        } else {
            setChip(t, "err", "suggest failed " + xhr.status);
        }
        SUGGEST.loading = false;
        cb();
    };
    xhr.send();
}

/* ============ CONTEXT ============ */
function getCtx(t) {
    var ta = t.editorEl;
    var pos = ta.selectionStart;
    var val = ta.value;
    var s = pos;
    while (s > 0 && /[A-Za-z0-9_$#]/.test(val.charAt(s - 1))) s--;
    var e = pos;
    while (e < val.length && /[A-Za-z0-9_$#]/.test(val.charAt(e))) e++;
    var word = val.substring(s, pos);
    var prefix = "";
    var dotBefore = false;
    if (s > 0 && val.charAt(s - 1) === '.') {
        dotBefore = true;
        var p = s - 2;
        while (p >= 0 && /[A-Za-z0-9_$#]/.test(val.charAt(p))) p--;
        prefix = val.substring(p + 1, s - 1);
    }
    return { word: word, start: s, end: e, dotBefore: dotBefore, prefix: prefix };
}

/* ============ CARET POSITION ============ */
function caretXY(ta) {
    var d = document.createElement('div');
    var st = window.getComputedStyle(ta);
    var ps = ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing',
              'paddingTop','paddingLeft','paddingRight','paddingBottom',
              'borderTopWidth','borderLeftWidth','whiteSpace','wordWrap','wordBreak'];
    ps.forEach(function(p){ d.style[p] = st[p]; });
    d.style.position = 'fixed';
    d.style.visibility = 'hidden';
    d.style.whiteSpace = 'pre-wrap';
    d.style.wordWrap = 'break-word';
    d.style.width = (ta.clientWidth - parseInt(st.paddingLeft) - parseInt(st.paddingRight)) + 'px';
    d.style.top = '-9999px';
    d.textContent = ta.value.substring(0, ta.selectionStart);
    var span = document.createElement('span');
    span.textContent = ta.value.substring(ta.selectionStart) || '.';
    d.appendChild(span);
    document.body.appendChild(d);
    var sr = span.getBoundingClientRect();
    var lineH = parseInt(st.lineHeight) || 22;
    var pos = { left: sr.left, top: sr.bottom + 2, lineHeight: lineH };
    document.body.removeChild(d);
    return pos;
}

/* ============ SHOW SUGGEST ============ */
function showSuggest(t, forceAll) {
    var ctx = getCtx(t);
    var items;

    if (ctx.dotBefore) {
        var prefUp = ctx.prefix.toUpperCase();
        var isSchema = SUGGEST.schemas.some(function(s){ return s.label.toUpperCase() === prefUp; });
        if (isSchema) {
            items = SUGGEST.tables.filter(function(tb){
                return tb.label.toUpperCase().startsWith(prefUp + ".");
            }).map(function(tb){
                var shortName = tb.label.substring(tb.label.indexOf('.') + 1);
                return { label: shortName, insert: shortName, type: "TABLE" };
            });
            if (ctx.word) {
                var w = ctx.word.toLowerCase();
                items = items.filter(function(x){ return x.label.toLowerCase().indexOf(w) !== -1; });
            }
            renderSuggest(t, items);
        } else {
            fetchCols(t, ctx.prefix, function(cols){
                var w = (ctx.word || '').toLowerCase();
                var filtered = w ? cols.filter(function(c){ return c.label.toLowerCase().indexOf(w) !== -1; }) : cols;
                renderSuggest(t, filtered);
            });
        }
        return;
    }

    items = SUGGEST.keywords.concat(SUGGEST.schemas).concat(SUGGEST.tables);
    var w = (ctx.word || '').toLowerCase();
    if (!forceAll && w) {
        var starts = [], contains = [];
        items.forEach(function(it){
            var l = it.label.toLowerCase();
            if (l.startsWith(w)) starts.push(it);
            else if (l.indexOf(w) !== -1) contains.push(it);
        });
        items = starts.concat(contains);
    }
    renderSuggest(t, items);
}

function renderSuggest(t, items) {
    var box = document.getElementById('acBox');
    if (!items || items.length === 0) { hideSuggest(t); return; }
    items = items.slice(0, 50);
    t.currentItems = items;
    t.activeIdx = 0;
    var html = '';
    items.forEach(function(it, i) {
        var cls = 'ac-item' + (i === 0 ? ' active' : '');
        var tag = it.type.split(':')[0];
        var tagTxt = tag === 'COLUMN' ? 'COL' : tag;
        html += '<div class="' + cls + '" data-i="' + i + '" onmousedown="event.preventDefault();" onclick="pickById(\'' + t.id + '\',' + i + ')">' +
                    '<span>' + escapeHtml(it.label) + '</span>' +
                    '<span class="ac-tag tag-' + tag + '">' + tagTxt + '</span>' +
                '</div>';
    });
    box.innerHTML = html;
    box.style.display = 'block';

    var p = caretXY(t.editorEl);
    var h = Math.min(300, items.length * 30 + 8);
    var top = p.top;
    if (top + h > window.innerHeight - 50) top = p.top - h - p.lineHeight - 6;
    box.style.left = Math.max(6, Math.min(p.left, window.innerWidth - 340)) + 'px';
    box.style.top  = top + 'px';
}

function hideSuggest(t) {
    document.getElementById('acBox').style.display = 'none';
    if (t) { t.currentItems = []; t.activeIdx = -1; }
}

function updateActive(t) {
    document.querySelectorAll('#acBox .ac-item').forEach(function(el, i){
        if (i === t.activeIdx) { el.classList.add('active'); el.scrollIntoView({block:'nearest'}); }
        else el.classList.remove('active');
    });
}

function pickById(tabId, idx) {
    var t = getTab(tabId); if (!t) return;
    pickSuggestion(t, idx);
}

function pickSuggestion(t, idx) {
    if (idx < 0 || idx >= t.currentItems.length) return;
    var it = t.currentItems[idx];
    var ctx = getCtx(t);
    var val = t.editorEl.value;
    var before = val.substring(0, ctx.start);
    var after = val.substring(ctx.end);
    t.editorEl.value = before + it.insert + after;
    var np = before.length + it.insert.length;
    t.editorEl.selectionStart = t.editorEl.selectionEnd = np;
    t.sql = t.editorEl.value;
    hideSuggest(t);
    t.editorEl.focus();
}

function fetchCols(t, schema, table, cb) {
    var key = (schema || '').toUpperCase() + '.' + table.toUpperCase();
    if (SUGGEST.columnCache[key]) { cb(SUGGEST.columnCache[key]); return; }
    var url = 'query.jsp?ajax=cols&db=' + encodeURIComponent(t.db) +
              '&schema=' + encodeURIComponent(schema || '') +
              '&table=' + encodeURIComponent(table);
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState === 4 && xhr.status === 200) {
            try {
                var d = JSON.parse(xhr.responseText);
                SUGGEST.columnCache[key] = d;
                cb(d);
            } catch(e){ cb([]); }
        }
    };
    xhr.send();
}

/* ============ RUN QUERY ============ */
function runQuery(tabId) {
    var t = getTab(tabId); if (!t) return;
    var sql = t.editorEl.value.trim();
    if (!sql) { toast("Query is empty.", true); return; }

    t.sql = t.editorEl.value;
    saveTabs();
    setChip(t, "loading", "running...");
    hideSuggest(t);

    var resBody = t.paneEl.querySelector('[data-role="resBody"]');
    var resBar = t.paneEl.querySelector('[data-role="resBar"]');
    resBody.innerHTML = '<div class="placeholder"><div class="ph-icon" style="animation: spin 1s linear infinite; display:inline-block;">◌</div><div class="ph-title">Executing...</div><div class="ph-sub">Running on ' + DB_META[t.db].label + '</div></div>';

    var xhr = new XMLHttpRequest();
    xhr.open('POST', 'query.jsp?ajax=run', true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
    var payload = 'sql=' + encodeURIComponent(sql) + '&dbType=' + encodeURIComponent(t.db);

    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        if (xhr.status !== 200) {
            resBody.innerHTML = '<div class="alert alert-err">HTTP ' + xhr.status + ' — execution failed.</div>';
            setChip(t, "err", "error");
            return;
        }
        try {
            var res = JSON.parse(xhr.responseText);
            t.lastExecMs = res.executionTimeMs;
            t.lastResult = res;

            resBar.style.display = 'flex';
            resBar.querySelector('[data-role="qType"]').textContent = res.queryType || '—';
            resBar.querySelector('[data-role="qRows"]').textContent = (res.rows ? res.rows.length : 0);
            resBar.querySelector('[data-role="qDb"]').textContent = DB_META[t.db].label;

            var tEl = resBar.querySelector('[data-role="qTime"]');
            tEl.textContent = res.executionTimeMs + ' ms';
            tEl.className = 'res-time ' + (res.executionTimeMs < 500 ? 'ok' : res.executionTimeMs < 3000 ? 'warn' : 'slow');

            resBody.innerHTML = renderResult(res);
            setChip(t, res.success ? "ok" : "err", res.success ? "success" : "error");

            var expBtn = t.paneEl.querySelector('.tb-export');
            if (expBtn) expBtn.disabled = !(res.success && res.rows && res.rows.length > 0);

            updateStatus();
            toast(res.success ? "Query ran in " + res.executionTimeMs + " ms" : "Query failed", !res.success);
        } catch(e) {
            resBody.innerHTML = '<div class="alert alert-err">Parse error: ' + escapeHtml(e.message) + '</div>';
            setChip(t, "err", "parse error");
        }
    };
    xhr.send(payload);
}

function renderResult(res) {
    if (!res.success) return '<div class="alert alert-err">' + escapeHtml(res.message) + '</div>';
    var html = '<div class="alert alert-ok">' + escapeHtml(res.message) + '</div>';
    if (res.columns && res.columns.length > 0 && res.rows && res.rows.length > 0) {
        html += '<table class="data"><thead><tr><th>#</th>';
        res.columns.forEach(function(c){ html += '<th>' + escapeHtml(c) + '</th>'; });
        html += '</tr></thead><tbody>';
        res.rows.forEach(function(row, i) {
            html += '<tr><td class="row-no">' + (i+1) + '</td>';
            res.columns.forEach(function(c){
                var v = row[c];
                if (v === null || v === undefined) html += '<td><span class="null-cell">NULL</span></td>';
                else html += '<td title="' + escapeHtml(String(v)) + '">' + escapeHtml(String(v)) + '</td>';
            });
            html += '</tr>';
        });
        html += '</tbody></table>';
    } else if (res.updateCount >= 0) {
        html += '<div class="alert alert-ok">Rows affected: ' + res.updateCount + '</div>';
    } else {
        html += '<div class="placeholder"><div class="ph-title">0 rows</div><div class="ph-sub">Query executed successfully.</div></div>';
    }
    return html;
}

/* ============ EXPORT TO EXCEL (CSV that Excel opens natively) ============ */
function exportResult(tabId) {
    var t = getTab(tabId); if (!t) return;
    var res = t.lastResult;
    if (!res || !res.success || !res.rows || res.rows.length === 0) {
        toast("Nothing to export.", true);
        return;
    }

    // Build CSV with UTF-8 BOM so Excel reads it correctly
    var BOM = '\uFEFF';
    var sep = ',';
    var lines = [];

    // Header
    lines.push(res.columns.map(csvCell).join(sep));
    // Rows
    res.rows.forEach(function(row) {
        lines.push(res.columns.map(function(c){ return csvCell(row[c]); }).join(sep));
    });

    var csv = BOM + lines.join('\r\n');
    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);

    var stamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
    var fname = 'query_' + t.num + '_' + t.db + '_' + stamp + '.csv';

    var a = document.createElement('a');
    a.href = url;
    a.download = fname;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast("Exported " + res.rows.length + " rows → " + fname);
}

function csvCell(v) {
    if (v === null || v === undefined) return '';
    var s = String(v);
    if (/[",\n\r]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
    return s;
}

/* ============ HELPERS ============ */
function setChip(t, type, text) {
    var el = t.paneEl.querySelector('[data-role="chip"]');
    if (!el) return;
    el.textContent = text || "idle";
    el.className = 'status-chip';
    if (type === 'ok') el.classList.add('ok');
    if (type === 'loading') el.classList.add('loading');
    if (type === 'err') el.classList.add('err');
}

function updateStatus() {
    var t = getTab(activeTabId);
    if (t) {
        document.getElementById('stDb').textContent = DB_META[t.db].label;
        document.getElementById('stTab').innerHTML = 'Tab: <b>' + escapeHtml(t.title) + '</b>';
        document.getElementById('stLast').innerHTML = 'Last exec: <b>' + (t.lastExecMs != null ? t.lastExecMs + ' ms' : '—') + '</b>';
    }
    document.getElementById('stCount').textContent = tabs.length + (tabs.length === 1 ? ' tab' : ' tabs');
}

function updateCount() { updateStatus(); }

function clearEditor(id) {
    var t = getTab(id); if (!t) return;
    t.editorEl.value = '';
    t.sql = '';
    t.editorEl.focus();
    hideSuggest(t);
    saveTabs();
}

/* ============ SIDEBAR ============ */
function toggleGroup(el) {
    var body = el.nextElementSibling;
    var open = body.classList.toggle('open');
    el.classList.toggle('open', open);
}

function loadQuery(el) {
    var sqlEl = el.querySelector('.q-sql');
    if (!sqlEl) return;
    var text = (sqlEl.textContent || sqlEl.innerText).replace(/^\s*\n+/, '').replace(/\s+$/, '');
    var t = getTab(activeTabId);
    if (!t) return;
    t.editorEl.value = text;
    t.sql = text;
    t.editorEl.focus();
    t.editorEl.selectionStart = t.editorEl.selectionEnd = text.length;
    document.querySelectorAll('.qitem').forEach(function(i){ i.classList.remove('active'); });
    el.classList.add('active');
    saveTabs();
    toast("Loaded into " + t.title);
}

document.getElementById('qSearch').addEventListener('input', function(e) {
    var q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.tgroup').forEach(function(g){
        var items = g.querySelectorAll('.qitem');
        var any = false;
        items.forEach(function(it){
            var txt = it.textContent.toLowerCase();
            if (!q || txt.indexOf(q) !== -1) { it.style.display = ''; any = true; }
            else it.style.display = 'none';
        });
        g.style.display = (any || !q) ? '' : 'none';
        if (q && any) {
            g.querySelector('.tgroup-body').classList.add('open');
            g.querySelector('.tgroup-head').classList.add('open');
        }
    });
});

/* ============ UTILS ============ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function(){
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function(){ el.remove(); }, 320);
    }, 2400);
}

/* ============ PERSIST TABS ============ */
function saveTabs() {
    try {
        localStorage.setItem('qr_v2', JSON.stringify({
            tabs: tabs.map(function(t){ return { num: t.num, db: t.db, sql: t.sql }; }),
            active: activeTabId,
            usedNumbers: usedNumbers
        }));
    } catch(e){}
}

function restoreTabs() {
    try {
        var raw = localStorage.getItem('qr_v2');
        if (!raw) return false;
        var d = JSON.parse(raw);
        if (!d || !d.tabs || !d.tabs.length) return false;
        usedNumbers = d.usedNumbers || {};
        d.tabs.forEach(function(td){
            var t = new Tab(td.num || nextFreeNum(), td.db || DEFAULT_DB);
            t.sql = td.sql || '';
            tabs.push(t);
            renderTab(t);
            t.editorEl.value = t.sql;
        });
        switchTab(d.active || tabs[0].id);
        return true;
    } catch(e){ return false; }
}

/* ============ INIT ============ */
window.addEventListener('load', function() {
    if (!restoreTabs()) newTab();
    var firstBody = document.querySelector('.tgroup-body');
    var firstHead = document.querySelector('.tgroup-head');
    if (firstBody && firstHead) {
        firstBody.classList.add('open');
        firstHead.classList.add('open');
    }
    updateCount();
});

/* ============ OUTSIDE CLICK ============ */
document.addEventListener('mousedown', function(e) {
    if (!e.target.closest('#acBox')) {
        var t = getTab(activeTabId);
        if (t) hideSuggest(t);
    }
});
</script>
