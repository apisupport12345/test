SELECT lb_url,
       REGEXP_REPLACE(lb_url, '^.*/(gateway|getway)/', '', 1, 1, 'i') AS path_op
FROM daily_dpg_url_data
WHERE lb_url LIKE '%gen5/gateway/EKYC%'
   OR lb_url LIKE '%gen6/gateway/EKYC%'
   OR lb_url LIKE '%gen5/getway/payment%'
   OR lb_url LIKE '%gen6/gateway/misc%'
FETCH FIRST 10 ROWS ONLY;
