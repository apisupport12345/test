<script>
/* ============================================================
 * IPO MONITORING DASHBOARD
 * Auto-refresh every 5 minutes
 * ============================================================ */

var REFRESH_INTERVAL_SEC = 300;   // 5 minutes
var secondsLeft = REFRESH_INTERVAL_SEC;
var countdownTimer = null;
var isRefreshing = false;

/* ============ START COUNTDOWN ============ */
function startCountdown() {
    secondsLeft = REFRESH_INTERVAL_SEC;
    updateCountdownUI();
    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = setInterval(function() {
        secondsLeft--;
        if (secondsLeft <= 0) {
            secondsLeft = REFRESH_INTERVAL_SEC;
            refreshNow();
        }
        updateCountdownUI();
    }, 1000);
}

function updateCountdownUI() {
    var m = Math.floor(secondsLeft / 60);
    var s = secondsLeft % 60;
    var mm = (m < 10 ? '0' : '') + m;
    var ss = (s < 10 ? '0' : '') + s;
    var el = document.getElementById('countdown');
    if (el) el.innerHTML = 'Next refresh in <b>' + mm + ':' + ss + '</b>';
}

/* ============ MANUAL REFRESH ============ */
function refreshNow() {
    if (isRefreshing) return;
    isRefreshing = true;

    var btn = document.getElementById('refreshBtn');
    btn.classList.add('spinning');
    btn.disabled = true;

    // Reset countdown after manual click
    secondsLeft = REFRESH_INTERVAL_SEC;

    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'ipo-monitor.jsp?ajax=fetch&_=' + Date.now(), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        btn.classList.remove('spinning');
        btn.disabled = false;
        isRefreshing = false;

        if (xhr.status !== 200) {
            toast('HTTP ' + xhr.status + ' — refresh failed', true);
            return;
        }
        try {
            var data = JSON.parse(xhr.responseText);
            renderAll(data);
            toast('Data refreshed');
        } catch(e) {
            console.error('Parse error:', e);
            toast('Parse error: ' + e.message, true);
        }
    };
    xhr.send();
}

/* ============ RENDER ALL ============ */
function renderAll(data) {
    renderBackend(data.BACKEND_LOG);
    renderApiN(data.API_NSE_INB);
    renderApiB(data.API_BSE);
    updateCards(data);
}

/* ============ BACKEND PANEL ============ */
function renderBackend(qr) {
    var body = document.getElementById('backendBody');
    document.getElementById('backendRows').textContent = qr && qr.rows ? qr.rows.length : '0';
    document.getElementById('backendTime').textContent = qr ? (qr.executionTimeMs + ' ms') : '—';

    if (!qr) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#9888;</div>No data</div>';
        return;
    }
    if (!qr.success) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#10060;</div>' + escapeHtml(qr.message) + '</div>';
        return;
    }
    if (!qr.rows || qr.rows.length === 0) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#128269;</div>No hits in last 5 minutes</div>';
        return;
    }
    body.innerHTML = buildTable(qr, 'backendTable');
}

/* ============ API NSE/INB PANEL ============ */
function renderApiN(qr) {
    var body = document.getElementById('apiNBody');
    document.getElementById('apiNRows').textContent = qr && qr.rows ? qr.rows.length : '0';
    document.getElementById('apiNTime').textContent = qr ? (qr.executionTimeMs + ' ms') : '—';

    if (!qr) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#9888;</div>No data</div>';
        return;
    }
    if (!qr.success) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#10060;</div>' + escapeHtml(qr.message) + '</div>';
        return;
    }
    if (!qr.rows || qr.rows.length === 0) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#128269;</div>No hits in last 5 minutes</div>';
        return;
    }
    body.innerHTML = buildTable(qr, 'apiNTable');
}

/* ============ API BSE PANEL ============ */
function renderApiB(qr) {
    var body = document.getElementById('apiBBody');
    document.getElementById('apiBRows').textContent = qr && qr.rows ? qr.rows.length : '0';
    document.getElementById('apiBTime').textContent = qr ? (qr.executionTimeMs + ' ms') : '—';

    if (!qr) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#9888;</div>No data</div>';
        return;
    }
    if (!qr.success) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#10060;</div>' + escapeHtml(qr.message) + '</div>';
        return;
    }
    if (!qr.rows || qr.rows.length === 0) {
        body.innerHTML = '<div class="empty"><div class="empty-icon">&#128269;</div>No hits in last 5 minutes</div>';
        return;
    }
    body.innerHTML = buildTable(qr, 'apiBTable');
}

/* ============ BUILD TABLE ============ */
function buildTable(qr, tableId) {
    var html = '<table class="dt" id="' + tableId + '"><thead><tr>';
    qr.columns.forEach(function(c, i) {
        html += '<th>' + escapeHtml(c) + '</th>';
    });
    html += '</tr></thead><tbody>';

    qr.rows.forEach(function(row) {
        html += '<tr>';
        qr.columns.forEach(function(c, ci) {
            var v = row[c];
            var cls = '';
            if (v === null || v === undefined || v === '' || v === '0') {
                cls = 'zero';
            } else if (typeof v === 'string' && v.match(/^\d+(\.\d+)?$/)) {
                var n = parseFloat(v);
                if (n === 0) cls = 'zero';
                else cls = 'num-hi';
            }
            // Highlight TD_PERCENT / BD_PERCENT columns
            if (c === 'TD_PERCENT' || c === 'BD_PERCENT') {
                var pct = parseFloat(v);
                if (!isNaN(pct)) {
                    if (pct <= 1) cls = 'pct-ok';
                    else if (pct <= 5) cls = 'pct-mid';
                    else cls = 'pct-bad';
                }
            }
            // Highlight TD / BD counts
            if (c === 'TD' || c === 'BD') {
                var num = parseInt(v);
                if (num > 0) cls = (c === 'TD') ? 'num-warn' : 'num-err';
            }
            // Highlight SUCCESS
            if (c === 'SUCCESS') {
                cls = 'num-ok';
            }
            // TOTAL_HITS
            if (c === 'TOTAL_HITS') {
                cls = 'num-hi';
            }

            html += '<td class="' + cls + '" title="' + escapeHtml(String(v || '')) + '">' +
                    escapeHtml(v === null || v === undefined ? '' : String(v)) +
                    '</td>';
        });
        html += '</tr>';
    });
    html += '</tbody></table>';
    return html;
}

/* ============ SUMMARY CARDS ============ */
function updateCards(data) {
    var b = data.BACKEND_LOG;
    var n = data.API_NSE_INB;
    var x = data.API_BSE;

    var backendHits = 0, backendTD = 0, backendCount = 0;
    if (b && b.success && b.rows) {
        b.rows.forEach(function(r) {
            backendHits += parseInt(r.TOTAL_HITS || 0);
            backendTD += parseFloat(r.TD_PERCENT || 0);
            backendCount++;
        });
    }
    setCard('cardBackendHits', backendHits);
    setCard('cardBackendTD', backendCount > 0 ? (backendTD / backendCount).toFixed(2) + '%' : '—', backendTD / backendCount);

    var nHits = 0, nTD = 0, nCount = 0;
    if (n && n.success && n.rows) {
        n.rows.forEach(function(r) {
            nHits += parseInt(r.TOTAL_HITS || 0);
            nTD += parseFloat(r.TD_PERCENT || 0);
            nCount++;
        });
    }
    setCard('cardApiNHits', nHits);
    setCard('cardApiNTD', nCount > 0 ? (nTD / nCount).toFixed(2) + '%' : '—', nTD / nCount);

    var xHits = 0, xTD = 0, xCount = 0;
    if (x && x.success && x.rows) {
        x.rows.forEach(function(r) {
            xHits += parseInt(r.TOTAL_HITS || 0);
            xTD += parseFloat(r.TD_PERCENT || 0);
            xCount++;
        });
    }
    setCard('cardApiBHits', xHits);
    setCard('cardApiBTD', xCount > 0 ? (xTD / xCount).toFixed(2) + '%' : '—', xTD / xCount);
}

function setCard(id, value, pct) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = value;
    el.classList.remove('ok', 'warn', 'err');
    if (pct !== undefined && pct !== null && !isNaN(pct)) {
        if (pct <= 1) el.classList.add('ok');
        else if (pct <= 5) el.classList.add('warn');
        else el.classList.add('err');
    } else {
        el.classList.add('ok');
    }
}

/* ============ TABLE FILTER ============ */
function filterTable(tableId, query) {
    var tbl = document.getElementById(tableId);
    if (!tbl) return;
    var q = (query || '').toLowerCase().trim();
    var rows = tbl.querySelectorAll('tbody tr');
    rows.forEach(function(tr) {
        if (!q) { tr.style.display = ''; return; }
        var text = tr.textContent.toLowerCase();
        tr.style.display = text.indexOf(q) !== -1 ? '' : 'none';
    });
}

/* ============ HELPERS ============ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function(){
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function(){ el.remove(); }, 320);
    }, 2200);
}

/* ============ INIT ============ */
window.addEventListener('load', function() {
    refreshNow();          // Initial load
    startCountdown();      // Start 5-min countdown
});
