<body>
<div class="container">

    <h1>🔎 Query Runner</h1>
    <p class="subtitle">Database select karo, SQL likho, aur Run dabao — result neeche aayega.</p>

    <form method="post" action="query.jsp" id="qForm">
        <div class="form-row">
            <div>
                <label for="dbType">Database</label>
                <select name="dbType" id="dbType" required>
                    <option value="REPORT" <%= "REPORT".equals(dbType) ? "selected" : "" %>>Report DB</option>
                    <option value="IIB"    <%= "IIB".equals(dbType)    ? "selected" : "" %>>IIB DB</option>
                    <option value="SI"     <%= "SI".equals(dbType)     ? "selected" : "" %>>SI DB</option>
                </select>
            </div>
            <div>
                <label for="sql">SQL Query</label>
                <textarea name="sql" id="sql" placeholder="SELECT * FROM connection_master;" required><%= sql != null ? sql : "" %></textarea>
            </div>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn-run">▶ Run Query</button>
            <button type="button" class="btn-clear" onclick="document.getElementById('sql').value=''; document.getElementById('sql').focus();">🗑 Clear</button>
        </div>

        <div class="hint">
            <b>Tip:</b> Bade tables par <code>WHERE rownum &lt;= 100</code> lagao. &nbsp;|&nbsp; <b>Ctrl+Enter</b> se bhi run ho jayega.
        </div>
    </form>

    <%-- ================= RESULT SECTION (SAME PAGE) ================= --%>
    <% if (qr != null) { %>
        <div class="result-section">
            <div class="meta-bar">
                <span>🗄 DB: <%= dbType %></span>
                <% if (qr.queryType != null) { %>
                    <span>📝 Type: <%= qr.queryType %></span>
                <% } %>
                <span>⏱ Time: <%= qr.executionTimeMs %> ms</span>
                <span>📦 Rows: <%= qr.rows.size() %></span>
                <% if (qr.updateCount >= 0) { %>
                    <span>✏️ Affected: <%= qr.updateCount %></span>
                <% } %>
            </div>

            <% if (qr.success) { %>
                <div class="alert alert-success">✅ <%= qr.message %></div>
            <% } else { %>
                <div class="alert alert-error">❌ <%= qr.message %></div>
            <% } %>

            <% if (qr.success && !qr.columns.isEmpty()) { %>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <% for (String col : qr.columns) { %>
                                    <th><%= col %></th>
                                <% } %>
                            </tr>
                        </thead>
                        <tbody>
                            <%
                                int i = 1;
                                for (Map<String, Object> row : qr.rows) {
                            %>
                                <tr>
                                    <td class="idx"><%= i++ %></td>
                                    <% for (String col : qr.columns) {
                                           Object val = row.get(col);
                                    %>
                                        <td title="<%= val == null ? "NULL" : val.toString().replace("\"","&quot;") %>">
                                            <%= val == null ? "<span class='null-val'>NULL</span>" : val.toString() %>
                                        </td>
                                    <% } %>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } else if (qr.success && qr.columns.isEmpty()) { %>
                <div class="empty">✅ Query execute ho gayi — koi row return nahi hui.</div>
            <% } %>

            <div class="sql-preview"><b>Executed SQL:</b>
<%= sql %></div>
        </div>
    <% } %>

</div>

<script>
    // Ctrl+Enter = Run
    document.getElementById('sql').addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('qForm').submit();
        }
    });
    // Auto focus on query box
    window.addEventListener('load', function() {
        var t = document.getElementById('sql');
        t.focus();
        t.selectionStart = t.selectionEnd = t.value.length;
    });
</script>
</body>
</html>
