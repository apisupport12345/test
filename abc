function toggleTheme() {
    var cur = document.body.getAttribute('data-theme') || 'dark';
    var next = cur === 'dark' ? 'light' : 'dark';
    document.body.setAttribute('data-theme', next);
    try { localStorage.setItem('eis_theme', next); } catch(e){}
    toast("Switched to " + next + " mode");
}
(function initTheme(){
    try {
        var saved = localStorage.getItem('eis_theme');
        if (saved === 'light' || saved === 'dark') {
            document.body.setAttribute('data-theme', saved);
        }
    } catch(e){}
})();

/* ============================================================
 * TAB
 * ============================================================ */
function Tab(num, db) {
    this.num = num;
    this.id = 'tab_' + num + '_' + Math.random().toString(36).substr(2, 9);
    this.db = db || DEFAULT_DB;
    this.title = "Query " + num;
    this.sql = "";
    this.editorEl = null;
    this.el = null;
    this.paneEl = null;
    this.currentItems = [];
    this.activeIdx = -1;
    this.lastExecMs = null;
    this.lastResult = null;
    this.running = false;
    this.rawRows = null;
    this.rawCols = null;
    this.filterText = "";
    this.sortCol = null;
    this.sortDir = null;
    this.isPinned = false;
    this.pinnedSql = "";
}

function nextFreeNum() {
    var n = 1;
    while (usedNumbers[n]) n++;
    usedNumbers[n] = true;
    return n;
}

function newTab() {
    var num = nextFreeNum();
    var t = new Tab(num, DEFAULT_DB);
    tabs.push(t);
    renderTab(t);
    switchTab(t.id);
    saveTabs();
    return t;
}

function newPinnedTab(sourceTab) {
    var num = nextFreeNum();
    var t = new Tab(num, sourceTab.db);
    t.title = sourceTab.title + " (Pinned)";
    t.isPinned = true;
    t.pinnedSql = sourceTab.sql;
    t.rawCols = sourceTab.rawCols.slice();
    t.rawRows = sourceTab.rawRows.slice();
    t.lastResult = sourceTab.lastResult;
    t.lastExecMs = sourceTab.lastExecMs;
    tabs.push(t);
    renderTab(t);
    switchTab(t.id);
    saveTabs();
    return t;
}

function renderTab(t) {
    var el = document.createElement('div');
    el.className = 'tab' + (t.isPinned ? ' pinned-tab' : '');
    el.dataset.tabId = t.id;
    el.innerHTML = buildTabHTML(t);

    el.addEventListener('click', function(e) {
        if (e.target.classList.contains('tab-close')) {
            e.stopPropagation();
            closeTab(t.id);
            return;
        }
        switchTab(t.id);
    });

    var tabAdd = document.querySelector('.tab-add');
    document.getElementById('tabbar').insertBefore(el, tabAdd);
    t.el = el;

    var pane = document.createElement('div');
    pane.className = 'pane';
    pane.dataset.tabId = t.id;
    pane.innerHTML = t.isPinned ? buildPinnedPaneHTML(t) : buildPaneHTML(t);
    document.getElementById('tabContent').appendChild(pane);
    t.paneEl = pane;
    t.editorEl = pane.querySelector('.sql');

    if (t.isPinned) {
        renderPinnedResult(t);
    } else {
        bindEditorEvents(t);
    }
    updateCount();
}

function buildTabHTML(t) {
    var badge = '';
    if (t.running) badge = '<span class="tab-running-badge">RUNNING</span>';
    else if (t.isPinned) badge = '<span class="tab-pinned-badge">&#128204; PINNED</span>';
    var dotClass = t.isPinned ? 'pinned-dot' : DB_META[t.db].dot;
    return '<span class="tab-dot ' + dotClass + '"></span>' +
           '<span class="tab-name">' + escapeHtml(t.title) + '</span>' +
           badge +
           '<span class="tab-close" title="Close">&#215;</span>';
}

