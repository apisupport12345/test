WITH gen5_base AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen5_lb_url,
        REPLACE(REPLACE(REPLACE(
            CASE 
                WHEN INSTR(lb_url, '/gateway/') > 0 
                    THEN SUBSTR(lb_url, INSTR(lb_url, '/gateway/') + 9)
                WHEN INSTR(lb_url, '/getway/') > 0 
                    THEN SUBSTR(lb_url, INSTR(lb_url, '/getway/') + 8)
                ELSE NULL
            END, CHR(10), ''), CHR(13), ''), CHR(9), '') AS gen5_path_op
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%GEN5%'
      AND (UPPER(lb_url) LIKE '%GATEWAY%' OR UPPER(lb_url) LIKE '%GETWAY%')
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_base AS (
    SELECT 
        ip, type, route_url, 
        lb_url AS gen6_lb_url,
        REPLACE(REPLACE(REPLACE(
            CASE 
                WHEN INSTR(lb_url, '/gateway/') > 0 
                    THEN SUBSTR(lb_url, INSTR(lb_url, '/gateway/') + 9)
                WHEN INSTR(lb_url, '/getway/') > 0 
                    THEN SUBSTR(lb_url, INSTR(lb_url, '/getway/') + 8)
                ELSE NULL
            END, CHR(10), ''), CHR(13), ''), CHR(9), '') AS gen6_path_op
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%GEN6%'
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_best AS (
    SELECT 
        g5.ip,
        g5.type,
        g5.route_url,
        g5.gen5_lb_url,
        g5.gen5_path_op,
        g6.gen6_lb_url,
        ROW_NUMBER() OVER (
            PARTITION BY g5.ip, g5.type, g5.route_url, g5.gen5_lb_url
            ORDER BY g6.gen6_lb_url
        ) AS rn
    FROM gen5_base g5
    LEFT JOIN gen6_base g6
      ON g5.ip = g6.ip
     AND g5.type = g6.type
     AND g5.route_url = g6.route_url
     AND g5.gen5_path_op = g6.gen6_path_op
)
SELECT 
    g5.ip, g5.type, g5.gen5_lb_url, g6.gen6_lb_url, g5.route_url
FROM gen5_base g5
LEFT JOIN gen6_best g6
  ON g5.ip = g6.ip
 AND g5.type = g6.type
 AND g5.route_url = g6.route_url
 AND g5.gen5_lb_url = g6.gen5_lb_url
 AND g6.rn = 1
WHERE g5.gen5_lb_url LIKE '%EKYC/AuthenticatEkycCertificate%'
FETCH FIRST 10 ROWS ONLY;
