<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="com.jdbc.QueryRunner" %>
<%@ page import="com.jdbc.QueryRunner.QueryResult" %>
<%@ page import="com.jdbc.QueryRunner.Suggestion" %>
<%@ page import="java.util.*" %>
<%
    String ajax = request.getParameter("ajax");

    // ---------- RUN ----------
    if ("run".equals(ajax)) {
        String runSql = request.getParameter("sql");
        String runDb  = request.getParameter("dbType");
        if (runDb == null) runDb = "IIB";
        QueryResult qr = QueryRunner.execute(runSql, runDb);

        StringBuilder sb = new StringBuilder("{");
        sb.append("\"success\":").append(qr.success).append(",");
        sb.append("\"message\":\"").append(QueryRunner.esc(qr.message)).append("\",");
        sb.append("\"queryType\":\"").append(qr.queryType == null ? "" : QueryRunner.esc(qr.queryType)).append("\",");
        sb.append("\"executionTimeMs\":").append(qr.executionTimeMs).append(",");
        sb.append("\"updateCount\":").append(qr.updateCount).append(",");
        sb.append("\"columns\":[");
        for (int i = 0; i < qr.columns.size(); i++) {
            if (i > 0) sb.append(",");
            sb.append("\"").append(QueryRunner.esc(qr.columns.get(i))).append("\"");
        }
        sb.append("],\"rows\":[");
        for (int r = 0; r < qr.rows.size(); r++) {
            if (r > 0) sb.append(",");
            sb.append("{");
            Map<String, Object> row = qr.rows.get(r);
            int c = 0;
            for (String col : qr.columns) {
                if (c++ > 0) sb.append(",");
                Object v = row.get(col);
                sb.append("\"").append(QueryRunner.esc(col)).append("\":");
                if (v == null) sb.append("null");
                else sb.append("\"").append(QueryRunner.esc(v.toString())).append("\"");
            }
            sb.append("}");
        }
        sb.append("]}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }

    // ---------- SUGGEST ----------
    if ("suggest".equals(ajax)) {
        String ajaxDb = request.getParameter("db");
        if (ajaxDb == null) ajaxDb = "IIB";

        List<Suggestion> schemas = new ArrayList<>();
        List<Suggestion> tables  = new ArrayList<>();
        String err = null;
        try { schemas = QueryRunner.getSchemaSuggestions(ajaxDb); }
        catch (Throwable t) { err = "schemas: " + t.getMessage(); }
        try { tables = QueryRunner.getTableSuggestions(ajaxDb); }
        catch (Throwable t) { err = (err == null ? "" : err + "; ") + "tables: " + t.getMessage(); }
        List<Suggestion> keywords = QueryRunner.getKeywordSuggestions();

        StringBuilder sb = new StringBuilder("{");
        if (err != null) sb.append("\"error\":\"").append(QueryRunner.esc(err)).append("\",");
        sb.append("\"schemas\":[");
        for (int i = 0; i < schemas.size(); i++) {
            Suggestion s = schemas.get(i);
            if (i > 0) sb.append(",");
            sb.append("{\"label\":\"").append(QueryRunner.esc(s.label))
              .append("\",\"insert\":\"").append(QueryRunner.esc(s.insert))
              .append("\",\"type\":\"SCHEMA\"}");
        }
        sb.append("],\"tables\":[");
        for (int i = 0; i < tables.size(); i++) {
            Suggestion s = tables.get(i);
            if (i > 0) sb.append(",");
            sb.append("{\"label\":\"").append(QueryRunner.esc(s.label))
              .append("\",\"insert\":\"").append(QueryRunner.esc(s.insert))
              .append("\",\"type\":\"TABLE\"}");
        }
        sb.append("],\"keywords\":[");
        for (int i = 0; i < keywords.size(); i++) {
            Suggestion s = keywords.get(i);
            if (i > 0) sb.append(",");
            sb.append("{\"label\":\"").append(QueryRunner.esc(s.label))
              .append("\",\"insert\":\"").append(QueryRunner.esc(s.insert))
              .append("\",\"type\":\"KEYWORD\"}");
        }
        sb.append("]}");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }

    // ---------- COLS ----------
    if ("cols".equals(ajax)) {
        String ajaxDb     = request.getParameter("db");
        String ajaxSchema = request.getParameter("schema");
        String ajaxTable  = request.getParameter("table");
        if (ajaxDb == null) ajaxDb = "IIB";
        if (ajaxTable == null) ajaxTable = "";
        List<Suggestion> cols = QueryRunner.getColumnSuggestions(ajaxDb, ajaxSchema, ajaxTable);
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < cols.size(); i++) {
            Suggestion s = cols.get(i);
            if (i > 0) sb.append(",");
            sb.append("{\"label\":\"").append(QueryRunner.esc(s.label))
              .append("\",\"insert\":\"").append(QueryRunner.esc(s.insert))
              .append("\",\"type\":\"").append(QueryRunner.esc(s.type)).append("\"}");
        }
        sb.append("]");
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        out.print(sb.toString()); out.flush();
        return;
    }

    String dbType = request.getParameter("dbType");
    if (dbType == null || dbType.trim().isEmpty()) dbType = "IIB";
%>
<!DOCTYPE html>
<html>
<head>
    <title>EIS Query Console</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%; width: 100%;
            font-family: 'Inter', 'Segoe UI', -apple-system, Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #0f1115;
            color: #e2e4e9;
            font-size: 15px;
            overflow: hidden;
        }

        /* ========== LAYOUT ========== */
        .app {
            display: grid;
            grid-template-rows: 56px 1fr 30px;
            grid-template-columns: 320px 1fr;
            grid-template-areas: "header header" "sidebar main" "status status";
            height: 100vh;
        }

        /* ========== HEADER ========== */
        .header {
            grid-area: header;
            background: linear-gradient(90deg, #14171d 0%, #1a1e26 100%);
            border-bottom: 1px solid #242932;
            display: flex; align-items: center;
            padding: 0 24px;
            gap: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.4);
        }
        .brand {
            display: flex; align-items: center; gap: 12px;
            font-weight: 800; font-size: 17px;
            color: #fff;
            letter-spacing: -0.2px;
        }
        .brand-mark {
            width: 30px; height: 30px;
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 15px; font-weight: 900;
            box-shadow: 0 4px 12px rgba(59,130,246,0.35);
        }
        .brand-sub {
            font-size: 11.5px; font-weight: 500;
            color: #6b7280;
            margin-left: 4px;
            padding: 3px 10px;
            background: #242932;
            border-radius: 10px;
            letter-spacing: 0.3px;
        }
        .header-spacer { flex: 1; }
        .conn-pill {
            display: flex; align-items: center; gap: 9px;
            padding: 7px 16px;
            background: rgba(74,222,128,0.08);
            border: 1px solid rgba(74,222,128,0.25);
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 700;
            color: #4ade80;
            letter-spacing: 0.5px;
        }
        .conn-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: #4ade80;
            box-shadow: 0 0 10px rgba(74,222,128,0.7);
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.35;} }

        .btn-new {
            padding: 9px 20px;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 700;
            cursor: pointer;
            display: flex; align-items: center; gap: 7px;
            transition: 0.18s;
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
        }
        .btn-new:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(59,130,246,0.45);
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            grid-area: sidebar;
            background: #14171d;
            border-right: 1px solid #242932;
            display: flex; flex-direction: column;
            overflow: hidden;
        }
        .sidebar-head {
            padding: 16px 20px 12px;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 1.3px;
            color: #6b7280;
            font-weight: 800;
            border-bottom: 1px solid #242932;
            display: flex; align-items: center; justify-content: space-between;
        }
        .sidebar-count {
            font-size: 11px;
            color: #4b5563;
            background: #1a1e26;
            padding: 2px 9px;
            border-radius: 10px;
            font-weight: 700;
        }
        .search-wrap { padding: 12px 16px; border-bottom: 1px solid #242932; }
        .search-input {
            width: 100%;
            padding: 9px 14px;
            background: #1a1e26;
            border: 1px solid #2a3038;
            border-radius: 8px;
            color: #e2e4e9;
            font-size: 13.5px;
            outline: none;
            font-family: inherit;
            transition: 0.15s;
        }
        .search-input:focus {
            border-color: #3b82f6;
            background: #1e242d;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        }

        .tree { flex: 1; overflow-y: auto; padding: 8px 0; }
        .tree::-webkit-scrollbar { width: 10px; }
        .tree::-webkit-scrollbar-thumb { background: #2a3038; border-radius: 5px; }
        .tree::-webkit-scrollbar-thumb:hover { background: #3a4048; }

        .tgroup { border-bottom: 1px solid #1a1e26; }
        .tgroup-head {
            padding: 11px 18px;
            cursor: pointer;
            font-size: 13.5px;
            font-weight: 700;
            color: #c7cad1;
            display: flex; align-items: center; gap: 9px;
            user-select: none;
            transition: background 0.12s;
        }
        .tgroup-head:hover { background: #1a1e26; }
        .tg-arrow {
            font-size: 10px; color: #6b7280;
            transition: transform 0.18s;
            width: 10px; display: inline-block;
        }
        .tgroup-head.open .tg-arrow { transform: rotate(90deg); }
        .tgroup-body { display: none; padding: 4px 0 10px; }
        .tgroup-body.open { display: block; }

        .qitem {
            padding: 9px 18px 9px 36px;
            cursor: pointer;
            font-size: 13px;
            color: #a8adb8;
            line-height: 1.45;
            transition: 0.1s;
            border-left: 3px solid transparent;
        }
        .qitem:hover {
            background: #1a1e26;
            color: #e2e4e9;
            border-left-color: #3b82f6;
        }
        .qitem.active {
            background: rgba(59,130,246,0.12);
            color: #fff;
            border-left-color: #3b82f6;
        }

        /* ========== MAIN ========== */
        .main {
            grid-area: main;
            display: flex; flex-direction: column;
            overflow: hidden;
            background: #0f1115;
        }

        .tabbar {
            background: #14171d;
            display: flex;
            border-bottom: 1px solid #242932;
            overflow-x: auto;
            min-height: 44px;
        }
        .tabbar::-webkit-scrollbar { height: 4px; }
        .tabbar::-webkit-scrollbar-thumb { background: #2a3038; }

        .tab {
            display: flex; align-items: center; gap: 10px;
            padding: 0 14px 0 18px;
            background: #14171d;
            border-right: 1px solid #242932;
            cursor: pointer;
            font-size: 13.5px;
            color: #6b7280;
            white-space: nowrap;
            min-width: 160px;
            max-width: 260px;
            position: relative;
            user-select: none;
            transition: 0.14s;
        }
        .tab:hover { background: #1a1e26; color: #c7cad1; }
        .tab.active {
            background: #0f1115;
            color: #e2e4e9;
            font-weight: 600;
        }
        .tab.active::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: #3b82f6;
        }
        .tab-dot {
            width: 9px; height: 9px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .tab-dot.db-IIB    { background: #4ade80; }
        .tab-dot.db-SI     { background: #fbbf24; }
        .tab-dot.db-REPORT { background: #c084fc; }

        .tab.running .tab-dot {
            animation: tabpulse 1s infinite;
            box-shadow: 0 0 10px currentColor;
        }
        @keyframes tabpulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }
        .tab-running-badge {
            font-size: 9.5px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #60a5fa;
            background: rgba(59,130,246,0.15);
            padding: 2px 7px;
            border-radius: 8px;
            border: 1px solid rgba(59,130,246,0.3);
            margin-left: auto;
        }

        .tab-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .tab-close {
            width: 20px; height: 20px;
            border-radius: 4px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
            color: #4b5563;
            line-height: 1;
            transition: 0.1s;
        }
        .tab-close:hover { background: #2a3038; color: #fff; }

        .tab-add {
            display: flex; align-items: center; justify-content: center;
            padding: 0 18px;
            cursor: pointer;
            color: #6b7280;
            font-size: 18px;
        }
        .tab-add:hover { background: #1a1e26; color: #e2e4e9; }

        .tab-content {
            flex: 1;
            display: flex; flex-direction: column;
            overflow: hidden;
            position: relative;
        }
        .pane {
            display: none;
            flex: 1;
            flex-direction: column;
            overflow: hidden;
        }
        .pane.active { display: flex; }

        /* ========== TOOLBAR ========== */
        .toolbar {
            background: #14171d;
            border-bottom: 1px solid #242932;
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .toolbar select {
            padding: 9px 14px;
            background: #1a1e26;
            color: #e2e4e9;
            border: 1px solid #2a3038;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            outline: none;
            font-family: inherit;
        }
        .toolbar select:focus { border-color: #3b82f6; }

        .tb {
            padding: 9px 18px;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 700;
            cursor: pointer;
            display: flex; align-items: center; gap: 7px;
            transition: 0.15s;
            border: 1px solid transparent;
            font-family: inherit;
            letter-spacing: 0.2px;
        }
        .tb:hover { transform: translateY(-1px); }
        .tb:active { transform: translateY(0); }

        .tb-run { background: #16a34a; color: #fff; box-shadow: 0 3px 10px rgba(22,163,74,0.25); }
        .tb-run:hover { background: #15803d; box-shadow: 0 5px 14px rgba(22,163,74,0.4); }

        .tb-suggest {
            background: #1a1e26; color: #60a5fa; border-color: #2a3038;
        }
        .tb-suggest:hover { background: #242932; color: #93c5fd; border-color: #3b82f6; }

        .tb-export {
            background: #1a1e26; color: #4ade80; border-color: #2a3038;
        }
        .tb-export:hover:not(:disabled) { background: #142a1e; color: #6ee7b7; border-color: #16a34a; }
        .tb-export:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }

        .tb-clear {
            background: #1a1e26; color: #c7cad1; border-color: #2a3038;
        }
        .tb-clear:hover { background: #242932; }

        .tb-close {
            background: #1a1e26; color: #f87171; border-color: #2a3038;
        }
        .tb-close:hover { background: #2a1616; color: #fca5a5; border-color: #ef4444; }

        .toolbar-spacer { flex: 1; }
        .chip {
            padding: 6px 14px;
            border-radius: 14px;
            font-size: 11.5px;
            font-weight: 800;
            background: #1a1e26;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.7px;
        }
        .chip.ok { background: rgba(74,222,128,0.12); color: #4ade80; }
        .chip.loading { background: rgba(251,191,36,0.12); color: #fbbf24; }
        .chip.err { background: rgba(248,113,113,0.12); color: #f87171; }

        /* ========== EDITOR ========== */
        .editor-wrap { padding: 14px 18px; background: #0f1115; }
        .editor-box {
            border: 1px solid #242932;
            border-radius: 10px;
            background: #0a0c10;
            overflow: hidden;
            transition: 0.15s;
        }
        .editor-box:focus-within {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
        }
        textarea.sql {
            width: 100%;
            min-height: 240px;
            max-height: 480px;
            padding: 16px 20px;
            background: #0a0c10;
            color: #e2e4e9;
            border: none;
            outline: none;
            resize: vertical;
            font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', 'Monaco', monospace;
            font-size: 14.5px;
            line-height: 1.7;
            caret-color: #3b82f6;
            tab-size: 4;
            display: block;
        }
        textarea.sql::placeholder { color: #4b5563; }

        /* ========== RESULTS ========== */
        .results {
            flex: 1;
            display: flex; flex-direction: column;
            overflow: hidden;
            border-top: 1px solid #242932;
            background: #0a0c10;
            min-height: 0;
        }
        .res-bar {
            padding: 10px 18px;
            background: #14171d;
            border-bottom: 1px solid #242932;
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 13px;
            flex-wrap: wrap;
        }
        .res-bar .label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.9px;
            color: #6b7280;
            font-weight: 800;
            margin-right: 6px;
        }
        .res-stat { color: #a8adb8; display: flex; align-items: center; }
        .res-stat b { color: #e2e4e9; font-weight: 700; margin-left: 4px; }
        .res-time.ok   { color: #4ade80; }
        .res-time.warn { color: #fbbf24; }
        .res-time.slow { color: #f87171; }
        .res-bar-spacer { flex: 1; }

        .res-search-wrap {
            position: relative;
            display: flex; align-items: center;
        }
        .res-search-icon {
            position: absolute;
            left: 10px;
            color: #4b5563;
            font-size: 14px;
            pointer-events: none;
        }
        .res-search {
            padding: 7px 12px 7px 32px;
            background: #1a1e26;
            border: 1px solid #2a3038;
            border-radius: 8px;
            color: #e2e4e9;
            font-size: 13px;
            width: 240px;
            outline: none;
            font-family: inherit;
            transition: 0.15s;
        }
        .res-search:focus {
            border-color: #3b82f6;
            width: 300px;
            background: #1e242d;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        }
        .res-search::placeholder { color: #4b5563; }

        .res-body {
            flex: 1;
            overflow: auto;
            position: relative;
        }
        .res-body::-webkit-scrollbar { width: 12px; height: 12px; }
        .res-body::-webkit-scrollbar-track { background: #0a0c10; }
        .res-body::-webkit-scrollbar-thumb {
            background: #2a3038;
            border-radius: 6px;
            border: 3px solid #0a0c10;
        }
        .res-body::-webkit-scrollbar-thumb:hover { background: #3a4048; }

        table.data {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            font-family: 'JetBrains Mono', 'Consolas', monospace;
        }
        table.data th {
            background: #14171d;
            color: #93c5fd;
            padding: 11px 14px;
            text-align: left;
            position: sticky;
            top: 0;
            z-index: 2;
            font-weight: 800;
            font-size: 12.5px;
            white-space: nowrap;
            border-bottom: 2px solid #242932;
            border-right: 1px solid #1a1e26;
            letter-spacing: 0.4px;
            cursor: pointer;
            user-select: none;
            transition: background 0.12s;
        }
        table.data th:hover { background: #1a1e26; color: #bfdbfe; }
        table.data th .sort-icon {
            display: inline-block;
            margin-left: 6px;
            font-size: 10px;
            color: #4b5563;
            transition: 0.15s;
        }
        table.data th.sorted-asc .sort-icon { color: #4ade80; }
        table.data th.sorted-desc .sort-icon { color: #f87171; }

        table.data td {
            padding: 9px 14px;
            border-bottom: 1px solid #14171d;
            border-right: 1px solid #14171d;
            color: #d1d5db;
            max-width: 450px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        table.data tr:nth-child(even) td { background: #0d1014; }
        table.data tr:hover td { background: #1a2332; }
        table.data td.row-no {
            color: #6b7280;
            background: #0a0c10 !important;
            width: 65px;
            text-align: right;
            font-size: 12px;
        }
        .null-cell { color: #4b5563; font-style: italic; }
        .hl-match { background: rgba(251,191,36,0.25); color: #fde68a; padding: 1px 3px; border-radius: 3px; }

        .alert {
            padding: 14px 22px;
            margin: 16px 22px;
            border-radius: 8px;
            font-size: 13.5px;
        }
        .alert-ok {
            background: rgba(22,163,74,0.1);
            border-left: 4px solid #16a34a;
            color: #86efac;
        }
        .alert-err {
            background: rgba(239,68,68,0.1);
            border-left: 4px solid #ef4444;
            color: #fca5a5;
            font-family: 'JetBrains Mono', monospace;
            white-space: pre-wrap;
            font-size: 12.5px;
        }

        /* ========== LOADER (big, visible) ========== */
        .loader-overlay {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            height: 100%;
            gap: 20px;
            padding: 40px;
        }
        .loader-big {
            width: 56px; height: 56px;
            border: 4px solid #1a1e26;
            border-top-color: #3b82f6;
            border-right-color: #60a5fa;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loader-text {
            font-size: 15px;
            font-weight: 600;
            color: #c7cad1;
            letter-spacing: 0.3px;
        }
        .loader-sub {
            font-size: 12.5px;
            color: #6b7280;
            margin-top: -12px;
        }
        .loader-dots {
            display: inline-block;
            animation: dots 1.4s infinite;
        }
        @keyframes dots {
            0%, 20% { content: '.'; }
            40% { content: '..'; }
            60%, 100% { content: '...'; }
        }

        .placeholder {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            height: 100%;
            color: #4b5563;
            gap: 14px;
            padding: 40px;
            text-align: center;
        }
        .placeholder .ph-icon { font-size: 48px; opacity: 0.35; }
        .placeholder .ph-title { font-size: 17px; color: #6b7280; font-weight: 600; }
        .placeholder .ph-sub { font-size: 13.5px; color: #4b5563; }

        /* ========== STATUS BAR ========== */
        .status {
            grid-area: status;
            background: #14171d;
            color: #8b909a;
            display: flex;
            align-items: center;
            font-size: 12.5px;
            padding: 0 22px;
            gap: 24px;
            border-top: 1px solid #242932;
        }
        .status .st-item { display: flex; align-items: center; gap: 8px; }
        .status .st-item b { color: #e2e4e9; font-weight: 700; }
        .status .right { margin-left: auto; display: flex; gap: 24px; }
        .st-dot {
            width: 9px; height: 9px; border-radius: 50%;
            background: #4ade80;
        }

        /* ========== AUTOCOMPLETE ========== */
        .ac-box {
            position: fixed;
            background: #1a1e26;
            border: 1px solid #2f3742;
            border-radius: 8px;
            box-shadow: 0 16px 44px rgba(0,0,0,0.75);
            max-height: 320px;
            overflow-y: auto;
            z-index: 9999;
            display: none;
            min-width: 340px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
        }
        .ac-box::-webkit-scrollbar { width: 8px; }
        .ac-box::-webkit-scrollbar-thumb { background: #2f3742; border-radius: 4px; }

        .ac-item {
            padding: 8px 14px;
            cursor: pointer;
            color: #d1d5db;
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: center;
            border-bottom: 1px solid #14171d;
        }
        .ac-item:last-child { border-bottom: none; }
        .ac-item:hover, .ac-item.active {
            background: #1e3a5f;
            color: #fff;
        }
        .ac-item.active { background: #2563eb; }
        .ac-tag {
            font-size: 10px;
            padding: 2px 9px;
            border-radius: 8px;
            font-weight: 800;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        .tag-KEYWORD { background: rgba(192,132,252,0.15); color: #c084fc; }
        .tag-SCHEMA  { background: rgba(96,165,250,0.15); color: #60a5fa; }
        .tag-TABLE   { background: rgba(74,222,128,0.15); color: #4ade80; }
        .tag-COLUMN  { background: rgba(251,191,36,0.15); color: #fbbf24; }

        .toast {
            position: fixed;
            bottom: 46px; right: 24px;
            background: #1a1e26;
            border-left: 4px solid #16a34a;
            color: #e2e4e9;
            padding: 15px 22px;
            border-radius: 8px;
            box-shadow: 0 12px 36px rgba(0,0,0,0.7);
            font-size: 13.5px;
            z-index: 10001;
            animation: slideIn 0.22s ease;
            max-width: 400px;
            font-weight: 600;
        }
        .toast.err { border-left-color: #ef4444; }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }
    </style>
</head>
<body>

<div class="app">

    <!-- HEADER -->
    <div class="header">
        <div class="brand">
            <div class="brand-mark">EIS</div>
            Query Console
            <span class="brand-sub">Production</span>
        </div>
        <div class="header-spacer"></div>
        <div class="conn-pill">
            <span class="conn-dot"></span> CONNECTED
        </div>
        <button class="btn-new" onclick="newTab()">+ New Query Tab</button>
    </div>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-head">
            SAVED QUERIES
            <span class="sidebar-count" id="qCount">0</span>
        </div>
        <div class="search-wrap">
            <input type="text" class="search-input" id="qSearch" placeholder="Search queries...">
        </div>
        <div class="tree" id="tree">

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> Gen 5 — Error Summary
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">
                        Broker-wise error count (last 5 min)
                        <script type="text/plain" class="q-sql">SELECT broker_eg, broker_name, ERROR_CODE, ERROR_DESCRIPTION, url, api_name,
COUNT(*) AS CNT FROM EISAPP.API_LOG WHERE Request_date_time>=SYSDATE - INTERVAL '05' MINUTE and
(substr(error_code,3,3) in ('001','002','007','051','014','111','570','569','052','005','077','003','017','015') and error_code<>'00014' OR error_code in ('401','500'))
and ERROR_DESCRIPTION is not null and error_description not like '%No active transaction found, please do check GCC machine and retry%'
GROUP BY broker_eg,broker_name, ERROR_CODE, error_description,url,api_name
ORDER BY CNT DESC;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> Daily Use (Last 10 min)
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">api_log — recent
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where
request_date_time >= sysdate - interval '10' minute
order by request_date_time desc;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">api_log — error summary
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.api_log where
request_date_time >= sysdate - interval '10' minute
GROUP by error_code, error_description;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log — recent
                        <script type="text/plain" class="q-sql">select * from eisapp.BACKEND_log where
request_date_time >= sysdate - interval '10' minute
order by request_date_time desc;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log — error summary
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.BACKEND_log where
request_date_time >= sysdate - interval '10' minute
GROUP by error_code, error_description;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> URN Search
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_details where URN in('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">orch_api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">orch_api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_details where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_log where URN in ('');</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">backend_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_details where URN in ('');</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> URL / Mappers
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">source_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.source_mapper;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">url_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.url_mapper;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">urn_details
                        <script type="text/plain" class="q-sql">select * from EISAPP.urn_details;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">cache_details
                        <script type="text/plain" class="q-sql">SELECT * FROM EISAPP.cache_details;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">Find API (NOMINEE)
                        <script type="text/plain" class="q-sql">select distinct api_name from eisapp.api_log where UPPER(api_name) like '%NOMINEE%';</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> API Log — TD/BD Summary
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">API-wise TD/BD (last 60 min)
                        <script type="text/plain" class="q-sql">select trim(API_NAME),
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) As "SI001",
SUM(CASE WHEN substr(error_code,3,3) ='002'then 1 else 0 end) As "002",
SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) As "SI007",
SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) As "SI051",
SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) AS "014",
SUM(CASE WHEN error_code ='SI569' then 1 else 0 end) As "SI569",
SUM(CASE WHEN error_code ='SI570' then 1 else 0 end) As "SI570",
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT
from eisapp.api_log where
request_date_time>=SYSDATE - INTERVAL '60' minute
GROUP BY trim(API_NAME)
ORDER BY TD_PERCENT DESC;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> SI Monitoring (SBISI)
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">SI_TRANS_DB — error summary
                        <script type="text/plain" class="q-sql">SELECT function_name,ERROR_CODE, ERROR_DESC, COUNT(*) AS CNT FROM SBISI.SI_TRANS_DB
WHERE SUBSTR(error_code,1,2) = 'SI'
and req_time>=SYSDATE - INTERVAL '10' MINUTE
GROUP BY ERROR_CODE,ERROR_DESC,function_name ORDER BY CNT DESC;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">EKYC_log — TD% (SI207, SI392)
                        <script type="text/plain" class="q-sql">select COUNT(1) as TOTAL_HITS,
SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN ERROR_CODE IS NOT NULL AND error_code NOT IN ('SI392','SI207') THEN 1 ELSE 0 END) "BD",
SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END) "SI392",
ROUND((SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI392%",
SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END) "SI207",
ROUND((SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END)/COUNT(1))*100,2) "TD%"
from SBISI.EKYC_log where resp_date_time >=sysdate - interval '15' minute;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">EKYC (SI392) — recent
                        <script type="text/plain" class="q-sql">select *  from SBISI.ekyc_log where
 error_code = 'SI392'
and req_date_time>=SYSDATE - INTERVAL '10' MINUTE  order by req_date_time desc;</script>
                    </div>
                </div>
            </div>

            <div class="tgroup">
                <div class="tgroup-head" onclick="toggleGroup(this)">
                    <span class="tg-arrow">▶</span> Performance / Latency
                </div>
                <div class="tgroup-body">
                    <div class="qitem" onclick="loadQuery(this)">EXP IP response-time buckets
                        <script type="text/plain" class="q-sql">SELECT exp_ip,COUNT(1),
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))between 0.1 AND 0.5 then 1 else 0 end ) as "between 100ms-500ms" ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC
FROM EISAPP.API_LOG WHERE broker_name = 'LOGGING_EXP' and
request_date_time>=SYSDATE-INTERVAL '02' MINUTE
group by exp_ip;</script>
                    </div>
                    <div class="qitem" onclick="loadQuery(this)">SYS latency — backend vs orch
                        <script type="text/plain" class="q-sql">SELECT b.sys_ip,COUNT(1),
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC
FROM  EISAPP.backend_log b , EISAPP.orch_api_log a WHERE a.urn=b.urn and b.sys_broker = 'LOGGING_SYS' and
b.creation_date_time>=SYSDATE-INTERVAL '02' MINUTE
group by b.sys_ip;</script>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- MAIN -->
    <div class="main">
        <div class="tabbar" id="tabbar">
            <div class="tab-add" onclick="newTab()" title="New Tab (Ctrl+T)">+</div>
        </div>
        <div class="tab-content" id="tabContent"></div>
    </div>

    <!-- STATUS BAR -->
    <div class="status">
        <div class="st-item">
            <span class="st-dot"></span>
            <b id="stDb">IIB DB (EISAPP)</b>
        </div>
        <div class="st-item" id="stTab">Tab: —</div>
        <div class="right">
            <div class="st-item" id="stLast">Last exec: —</div>
            <div class="st-item" id="stCount">1 tab</div>
        </div>
    </div>

</div>

<div id="acBox" class="ac-box"></div>

<script>
/* ============================================================
 * EIS QUERY CONSOLE — v3.0
 * ============================================================ */

var DB_META = {
    "IIB":    { label: "IIB DB (EISAPP)", dot: "db-IIB" },
    "SI":     { label: "SI DB (SBISI)",   dot: "db-SI" },
    "REPORT": { label: "Report DB",       dot: "db-REPORT" }
};
var DEFAULT_DB = "<%= dbType %>";

/* ============================================================
 * FALLBACK SUGGESTIONS — Always available instantly
 * (in case DB metadata is slow / fails)
 * ============================================================ */
var FALLBACK = {
    "IIB": {
        schemas: ["EISAPP"],
        tables: [
            "EISAPP.API_LOG", "EISAPP.API_DETAILS", "EISAPP.BACKEND_LOG",
            "EISAPP.BACKEND_DETAILS", "EISAPP.ORCH_API_LOG", "EISAPP.ORCH_API_DETAILS",
            "EISAPP.SOURCE_MAPPER", "EISAPP.URL_MAPPER", "EISAPP.URN_DETAILS",
            "EISAPP.CACHE_DETAILS", "EISAPP.CONNECTION_MASTER"
        ]
    },
    "SI": {
        schemas: ["SBISI"],
        tables: [
            "SBISI.SI_TRANS_DB", "SBISI.EKYC_LOG", "SBISI.EPAY_TXN_MASTER",
            "SBISI.EPAY_FEED_MASTER"
        ]
    },
    "REPORT": {
        schemas: ["EISAPP"],
        tables: [
            "EISAPP.CONNECTION_MASTER"
        ]
    }
};

var SUGGEST = {
    loaded: false, loading: false,
    schemas: [], tables: [], keywords: [],
    columnCache: {}, dbFetched: null
};

var tabs = [];
var activeTabId = null;
var usedNumbers = {};

/* ============================================================
 * BOOTSTRAP FALLBACK KEYWORDS (always loaded)
 * ============================================================ */
var BOOTSTRAP_KEYWORDS = ["SELECT","FROM","WHERE","AND","OR","NOT","NULL","IS","IN",
    "LIKE","BETWEEN","ORDER BY","GROUP BY","HAVING","JOIN","INNER JOIN","LEFT JOIN",
    "RIGHT JOIN","FULL JOIN","ON","AS","DISTINCT","COUNT","SUM","AVG","MIN","MAX",
    "INSERT INTO","VALUES","UPDATE","SET","DELETE FROM","UNION","UNION ALL","EXISTS",
    "CASE","WHEN","THEN","ELSE","END","ROWNUM","SYSDATE","DUAL","FETCH FIRST",
    "OFFSET","LIMIT","ASC","DESC","COMMIT","ROLLBACK","WITH","PARTITION","TRUNC"
].map(function(k){ return { label: k, insert: k, type: "KEYWORD" }; });

/* ============================================================
 * TAB
 * ============================================================ */
function Tab(num, db) {
    this.num = num;
    this.id = 'tab_' + num + '_' + Math.random().toString(36).substr(2, 9);
    this.db = db || DEFAULT_DB;
    this.title = "Query " + num;
    this.sql = "";
    this.editorEl = null;
    this.el = null;
    this.paneEl = null;
    this.currentItems = [];
    this.activeIdx = -1;
    this.lastExecMs = null;
    this.lastResult = null;
    this.running = false;
    this.rawRows = null;       // full data for sort/filter
    this.rawCols = null;
    this.filterText = "";
    this.sortCol = null;
    this.sortDir = null;
}

function nextFreeNum() {
    var n = 1;
    while (usedNumbers[n]) n++;
    usedNumbers[n] = true;
    return n;
}

function newTab() {
    var num = nextFreeNum();
    var t = new Tab(num, DEFAULT_DB);
    tabs.push(t);
    renderTab(t);
    switchTab(t.id);
    saveTabs();
    return t;
}

function renderTab(t) {
    var el = document.createElement('div');
    el.className = 'tab';
    el.dataset.tabId = t.id;
    el.innerHTML = buildTabHTML(t);

    el.addEventListener('click', function(e) {
        if (e.target.classList.contains('tab-close')) {
            e.stopPropagation();
            closeTab(t.id);
            return;
        }
        switchTab(t.id);
    });

    var tabAdd = document.querySelector('.tab-add');
    document.getElementById('tabbar').insertBefore(el, tabAdd);
    t.el = el;

    var pane = document.createElement('div');
    pane.className = 'pane';
    pane.dataset.tabId = t.id;
    pane.innerHTML = buildPaneHTML(t);
    document.getElementById('tabContent').appendChild(pane);
    t.paneEl = pane;
    t.editorEl = pane.querySelector('.sql');

    bindEditorEvents(t);
    updateCount();
}

function buildTabHTML(t) {
    var runningBadge = t.running ? '<span class="tab-running-badge">RUNNING</span>' : '';
    return '<span class="tab-dot ' + DB_META[t.db].dot + '"></span>' +
           '<span class="tab-name">' + t.title + '</span>' +
           runningBadge +
           '<span class="tab-close" title="Close (Ctrl+W)">×</span>';
}

function refreshTabHeader(t) {
    if (!t.el) return;
    t.el.innerHTML = buildTabHTML(t);
    t.el.classList.toggle('running', t.running);
}

function buildPaneHTML(t) {
    return '' +
    '<div class="toolbar">' +
        '<select class="db-sel">' +
            '<option value="IIB"'    + (t.db === "IIB"    ? " selected" : "") + '>IIB DB (eisapp)</option>' +
            '<option value="SI"'     + (t.db === "SI"     ? " selected" : "") + '>SI DB (sbisi)</option>' +
            '<option value="REPORT"' + (t.db === "REPORT" ? " selected" : "") + '>Report DB</option>' +
        '</select>' +
        '<button class="tb tb-run"     onclick="runQuery(\'' + t.id + '\')">▶ Run</button>' +
        '<button class="tb tb-suggest" onclick="doSuggest(\'' + t.id + '\')">💡 Suggest</button>' +
        '<button class="tb tb-export"  onclick="exportResult(\'' + t.id + '\')" disabled>↓ Export Excel</button>' +
        '<button class="tb tb-clear"   onclick="clearEditor(\'' + t.id + '\')">Clear</button>' +
        '<button class="tb tb-close"   onclick="closeTab(\'' + t.id + '\')">Close</button>' +
        '<div class="toolbar-spacer"></div>' +
        '<span class="chip" data-role="chip">idle</span>' +
    '</div>' +
    '<div class="editor-wrap">' +
        '<div class="editor-box">' +
            '<textarea class="sql" spellcheck="false" autocomplete="off" ' +
                'placeholder="-- Select a saved query, or write your SQL&#10;-- Ctrl+Space: suggestions  |  Ctrl+Enter: run  |  Ctrl+T: new tab">' + escapeHtml(t.sql) + '</textarea>' +
        '</div>' +
    '</div>' +
    '<div class="results">' +
        '<div class="res-bar" style="display:none;" data-role="resBar">' +
            '<span class="res-stat"><span class="label">Type</span><b data-role="qType">—</b></span>' +
            '<span class="res-stat"><span class="label">Rows</span><b data-role="qRows">—</b></span>' +
            '<span class="res-stat"><span class="label">Time</span><b data-role="qTime">—</b></span>' +
            '<span class="res-stat"><span class="label">DB</span><b data-role="qDb">—</b></span>' +
            '<div class="res-bar-spacer"></div>' +
            '<div class="res-search-wrap">' +
                '<span class="res-search-icon">🔍</span>' +
                '<input type="text" class="res-search" placeholder="Search in results..." data-role="resSearch">' +
            '</div>' +
        '</div>' +
        '<div class="res-body" data-role="resBody">' +
            '<div class="placeholder">' +
                '<div class="ph-icon">▶</div>' +
                '<div class="ph-title">Ready</div>' +
                '<div class="ph-sub">Write a query or pick one from the sidebar, then click <b>Run</b>.</div>' +
            '</div>' +
        '</div>' +
    '</div>';
}

/* ============================================================
 * SWITCH / CLOSE
 * ============================================================ */
function switchTab(id) {
    activeTabId = id;
    document.querySelectorAll('.tab').forEach(function(el) {
        el.classList.toggle('active', el.dataset.tabId === id);
    });
    document.querySelectorAll('.pane').forEach(function(el) {
        el.classList.toggle('active', el.dataset.tabId === id);
    });
    var t = getTab(id);
    if (t && t.editorEl) try { t.editorEl.focus(); } catch(e) {}
    updateStatus();
    saveTabs();
}

function getTab(id) {
    for (var i = 0; i < tabs.length; i++) if (tabs[i].id === id) return tabs[i];
    return null;
}

function closeTab(id) {
    var idx = -1;
    for (var i = 0; i < tabs.length; i++) if (tabs[i].id === id) { idx = i; break; }
    if (idx === -1) return;
    var t = tabs[idx];

    if (t.running) {
        if (!confirm('Query is still running in "' + t.title + '". Close anyway?')) return;
    } else if (t.sql && t.sql.trim()) {
        if (!confirm('Close "' + t.title + '"? Unsaved query will be lost.')) return;
    }

    delete usedNumbers[t.num];
    if (t.el) t.el.remove();
    if (t.paneEl) t.paneEl.remove();
    tabs.splice(idx, 1);

    if (tabs.length === 0) newTab();
    else if (activeTabId === id) switchTab(tabs[Math.max(0, idx - 1)].id);
    updateCount();
    saveTabs();
}

/* ============================================================
 * EDITOR EVENTS
 * ============================================================ */
function bindEditorEvents(t) {
    var ta = t.editorEl;
    var dbSel = t.paneEl.querySelector('.db-sel');
    var resSearch = t.paneEl.querySelector('[data-role="resSearch"]');

    ta.addEventListener('input', function() {
        t.sql = ta.value;
        clearTimeout(ta._tmr);
        ta._tmr = setTimeout(function() {
            saveTabs();
            autoSuggest(t);
        }, 130);
    });

    dbSel.addEventListener('change', function() {
        t.db = dbSel.value;
        t.el.querySelector('.tab-dot').className = 'tab-dot ' + DB_META[t.db].dot;
        if (SUGGEST.dbFetched && SUGGEST.dbFetched !== t.db) {
            SUGGEST.loaded = false; SUGGEST.dbFetched = null;
        }
        updateStatus();
        toast("DB switched to " + DB_META[t.db].label);
        saveTabs();
    });

    if (resSearch) {
        resSearch.addEventListener('input', function() {
            t.filterText = resSearch.value;
            renderFilteredResult(t);
        });
    }

    ta.addEventListener('keydown', function(e) {
        var boxOpen = document.getElementById('acBox').style.display === 'block';

        if (e.ctrlKey && e.key === ' ') { e.preventDefault(); doSuggest(t.id); return; }
        if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); runQuery(t.id); return; }
        if (e.ctrlKey && (e.key === 't' || e.key === 'T')) { e.preventDefault(); newTab(); return; }
        if (e.ctrlKey && (e.key === 'w' || e.key === 'W')) { e.preventDefault(); closeTab(t.id); return; }

        if (boxOpen && t.currentItems.length > 0) {
            if (e.key === 'ArrowDown') { e.preventDefault(); t.activeIdx = (t.activeIdx + 1) % t.currentItems.length; updateActive(t); return; }
            if (e.key === 'ArrowUp')   { e.preventDefault(); t.activeIdx = (t.activeIdx - 1 + t.currentItems.length) % t.currentItems.length; updateActive(t); return; }
            if (e.key === 'Enter' || e.key === 'Tab') {
                if (t.activeIdx >= 0) { e.preventDefault(); pickSuggestion(t, t.activeIdx); return; }
            }
            if (e.key === 'Escape') { e.preventDefault(); hideSuggest(t); return; }
        }
    });
}

/* ============================================================
 * SUGGESTIONS
 * ============================================================ */
function autoSuggest(t) {
    var ctx = getCtx(t);
    if ((ctx.word && ctx.word.length >= 1) || ctx.dotBefore) {
        showSuggestInstant(t, false);
    } else {
        hideSuggest(t);
    }
}

function doSuggest(id) {
    var t = getTab(id); if (!t) return;
    // Ensure suggestions loaded (fallback + background refresh)
    ensureSuggestLoaded(t);
    showSuggestInstant(t, true);
}

/* ============================================================
 * INSTANT suggestions: fallback + loaded data
 * ============================================================ */
function showSuggestInstant(t, forceAll) {
    var ctx = getCtx(t);
    var items;

    // Build items from current known data (fallback + loaded)
    var schemas, tables, keywords;
    if (SUGGEST.loaded && SUGGEST.dbFetched === t.db) {
        schemas  = SUGGEST.schemas;
        tables   = SUGGEST.tables;
        keywords = SUGGEST.keywords.length ? SUGGEST.keywords : BOOTSTRAP_KEYWORDS;
    } else {
        // Use fallback immediately
        var fb = FALLBACK[t.db] || { schemas: [], tables: [] };
        schemas  = fb.schemas.map(function(s){ return { label: s, insert: s + ".", type: "SCHEMA" }; });
        tables   = fb.tables.map(function(tb){ return { label: tb, insert: tb, type: "TABLE" }; });
        keywords = BOOTSTRAP_KEYWORDS;
        // Kick off background load
        ensureSuggestLoaded(t);
    }

    if (ctx.dotBefore) {
        var prefUp = ctx.prefix.toUpperCase();
        var isSchema = schemas.some(function(s){ return s.label.toUpperCase() === prefUp; });
        if (isSchema) {
            items = tables.filter(function(tb){
                return tb.label.toUpperCase().startsWith(prefUp + ".");
            }).map(function(tb){
                var shortName = tb.label.substring(tb.label.indexOf('.') + 1);
                return { label: shortName, insert: shortName, type: "TABLE" };
            });
            if (ctx.word) {
                var w = ctx.word.toLowerCase();
                items = items.filter(function(x){ return x.label.toLowerCase().indexOf(w) !== -1; });
            }
            renderSuggest(t, items);
        } else {
            fetchCols(t, ctx.prefix, function(cols){
                var w = (ctx.word || '').toLowerCase();
                var filtered = w ? cols.filter(function(c){ return c.label.toLowerCase().indexOf(w) !== -1; }) : cols;
                renderSuggest(t, filtered);
            });
        }
        return;
    }

    items = keywords.concat(schemas).concat(tables);
    var w = (ctx.word || '').toLowerCase();
    if (!forceAll && w) {
        var starts = [], contains = [];
        items.forEach(function(it){
            var l = it.label.toLowerCase();
            if (l.startsWith(w)) starts.push(it);
            else if (l.indexOf(w) !== -1) contains.push(it);
        });
        items = starts.concat(contains);
    }
    renderSuggest(t, items);
}

function ensureSuggestLoaded(t) {
    if (SUGGEST.loaded && SUGGEST.dbFetched === t.db) return;
    if (SUGGEST.loading) return;

    SUGGEST.loading = true;
    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'query.jsp?ajax=suggest&db=' + encodeURIComponent(t.db), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        SUGGEST.loading = false;
        if (xhr.status === 200) {
            try {
                var d = JSON.parse(xhr.responseText);
                // Merge with fallback (so we never lose anything)
                var fb = FALLBACK[t.db] || { schemas: [], tables: [] };
                var fbSchemas = fb.schemas.map(function(s){ return { label: s, insert: s + ".", type: "SCHEMA" }; });
                var fbTables  = fb.tables.map(function(tb){ return { label: tb, insert: tb, type: "TABLE" }; });

                var seenSchemas = {};
                var mergedSchemas = [];
                (d.schemas || []).concat(fbSchemas).forEach(function(s){
                    if (!seenSchemas[s.label.toUpperCase()]) {
                        seenSchemas[s.label.toUpperCase()] = true;
                        mergedSchemas.push(s);
                    }
                });
                var seenTables = {};
                var mergedTables = [];
                (d.tables || []).concat(fbTables).forEach(function(tb){
                    var key = tb.label.toUpperCase();
                    if (!seenTables[key]) {
                        seenTables[key] = true;
                        mergedTables.push(tb);
                    }
                });

                SUGGEST.schemas  = mergedSchemas;
                SUGGEST.tables   = mergedTables;
                SUGGEST.keywords = (d.keywords && d.keywords.length) ? d.keywords : BOOTSTRAP_KEYWORDS;
                SUGGEST.loaded = true;
                SUGGEST.dbFetched = t.db;
                if (d.error) console.warn("Suggest partial:", d.error);
            } catch(e) {
                console.error("Suggest parse error:", e);
            }
        } else {
            console.warn("Suggest HTTP " + xhr.status);
        }
    };
    xhr.send();
}

function renderSuggest(t, items) {
    var box = document.getElementById('acBox');
    if (!items || items.length === 0) { hideSuggest(t); return; }
    items = items.slice(0, 50);
    t.currentItems = items;
    t.activeIdx = 0;
    var html = '';
    items.forEach(function(it, i) {
        var cls = 'ac-item' + (i === 0 ? ' active' : '');
        var tag = it.type.split(':')[0];
        var tagTxt = tag === 'COLUMN' ? 'COL' : tag;
        html += '<div class="' + cls + '" onmousedown="event.preventDefault();" onclick="pickById(\'' + t.id + '\',' + i + ')">' +
                    '<span>' + escapeHtml(it.label) + '</span>' +
                    '<span class="ac-tag tag-' + tag + '">' + tagTxt + '</span>' +
                '</div>';
    });
    box.innerHTML = html;
    box.style.display = 'block';

    var p = caretXY(t.editorEl);
    var h = Math.min(320, items.length * 32 + 8);
    var top = p.top;
    if (top + h > window.innerHeight - 50) top = p.top - h - p.lineHeight - 6;
    box.style.left = Math.max(6, Math.min(p.left, window.innerWidth - 360)) + 'px';
    box.style.top  = top + 'px';
}

function hideSuggest(t) {
    document.getElementById('acBox').style.display = 'none';
    if (t) { t.currentItems = []; t.activeIdx = -1; }
}

function updateActive(t) {
    document.querySelectorAll('#acBox .ac-item').forEach(function(el, i){
        if (i === t.activeIdx) { el.classList.add('active'); el.scrollIntoView({block:'nearest'}); }
        else el.classList.remove('active');
    });
}

function pickById(tabId, idx) {
    var t = getTab(tabId); if (!t) return;
    pickSuggestion(t, idx);
}

function pickSuggestion(t, idx) {
    if (idx < 0 || idx >= t.currentItems.length) return;
    var it = t.currentItems[idx];
    var ctx = getCtx(t);
    var val = t.editorEl.value;
    var before = val.substring(0, ctx.start);
    var after = val.substring(ctx.end);
    t.editorEl.value = before + it.insert + after;
    var np = before.length + it.insert.length;
    t.editorEl.selectionStart = t.editorEl.selectionEnd = np;
    t.sql = t.editorEl.value;
    hideSuggest(t);
    t.editorEl.focus();
}

function fetchCols(t, schema, table, cb) {
    var key = (schema || '').toUpperCase() + '.' + table.toUpperCase();
    if (SUGGEST.columnCache[key]) { cb(SUGGEST.columnCache[key]); return; }
    var url = 'query.jsp?ajax=cols&db=' + encodeURIComponent(t.db) +
              '&schema=' + encodeURIComponent(schema || '') +
              '&table=' + encodeURIComponent(table);
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState === 4 && xhr.status === 200) {
            try {
                var d = JSON.parse(xhr.responseText);
                SUGGEST.columnCache[key] = d;
                cb(d);
            } catch(e){ cb([]); }
        }
    };
    xhr.send();
}

function getCtx(t) {
    var ta = t.editorEl;
    var pos = ta.selectionStart;
    var val = ta.value;
    var s = pos;
    while (s > 0 && /[A-Za-z0-9_$#]/.test(val.charAt(s - 1))) s--;
    var e = pos;
    while (e < val.length && /[A-Za-z0-9_$#]/.test(val.charAt(e))) e++;
    var word = val.substring(s, pos);
    var prefix = "";
    var dotBefore = false;
    if (s > 0 && val.charAt(s - 1) === '.') {
        dotBefore = true;
        var p = s - 2;
        while (p >= 0 && /[A-Za-z0-9_$#]/.test(val.charAt(p))) p--;
        prefix = val.substring(p + 1, s - 1);
    }
    return { word: word, start: s, end: e, dotBefore: dotBefore, prefix: prefix };
}

function caretXY(ta) {
    var d = document.createElement('div');
    var st = window.getComputedStyle(ta);
    var ps = ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing',
              'paddingTop','paddingLeft','paddingRight','paddingBottom',
              'borderTopWidth','borderLeftWidth','whiteSpace','wordWrap','wordBreak'];
    ps.forEach(function(p){ d.style[p] = st[p]; });
    d.style.position = 'fixed';
    d.style.visibility = 'hidden';
    d.style.whiteSpace = 'pre-wrap';
    d.style.wordWrap = 'break-word';
    d.style.width = (ta.clientWidth - parseInt(st.paddingLeft) - parseInt(st.paddingRight)) + 'px';
    d.style.top = '-9999px';
    d.textContent = ta.value.substring(0, ta.selectionStart);
    var span = document.createElement('span');
    span.textContent = ta.value.substring(ta.selectionStart) || '.';
    d.appendChild(span);
    document.body.appendChild(d);
    var sr = span.getBoundingClientRect();
    var lineH = parseInt(st.lineHeight) || 22;
    var pos = { left: sr.left, top: sr.bottom + 2, lineHeight: lineH };
    document.body.removeChild(d);
    return pos;
}

/* ============================================================
 * RUN QUERY
 * ============================================================ */
function runQuery(tabId) {
    var t = getTab(tabId); if (!t) return;
    var sql = t.editorEl.value.trim();
    if (!sql) { toast("Query is empty.", true); return; }

    if (t.running) { toast("Query already running in this tab.", true); return; }

    t.sql = t.editorEl.value;
    saveTabs();
    t.running = true;
    refreshTabHeader(t);
    setChip(t, "loading", "running");
    hideSuggest(t);

    // ===== CLEAR previous meta on new run =====
    var resBar = t.paneEl.querySelector('[data-role="resBar"]');
    resBar.style.display = 'none';
    resBar.querySelector('[data-role="qType"]').textContent = '—';
    resBar.querySelector('[data-role="qRows"]').textContent = '—';
    resBar.querySelector('[data-role="qTime"]').textContent = '—';
    var timeEl0 = resBar.querySelector('[data-role="qTime"]');
    timeEl0.className = '';
    resBar.querySelector('[data-role="qDb"]').textContent = '—';

    // Reset search + sort state
    t.filterText = "";
    t.sortCol = null;
    t.sortDir = null;
    var searchInp = t.paneEl.querySelector('[data-role="resSearch"]');
    if (searchInp) searchInp.value = '';
    t.rawRows = null;
    t.rawCols = null;
    t.lastResult = null;
    var expBtn = t.paneEl.querySelector('.tb-export');
    if (expBtn) expBtn.disabled = true;

    // Big visible loader
    var resBody = t.paneEl.querySelector('[data-role="resBody"]');
    resBody.innerHTML = '' +
        '<div class="loader-overlay">' +
            '<div class="loader-big"></div>' +
            '<div class="loader-text">Executing query<span class="loader-dots">...</span></div>' +
            '<div class="loader-sub">Target: ' + DB_META[t.db].label + '</div>' +
        '</div>';

    var xhr = new XMLHttpRequest();
    xhr.open('POST', 'query.jsp?ajax=run', true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
    var payload = 'sql=' + encodeURIComponent(sql) + '&dbType=' + encodeURIComponent(t.db);

    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        t.running = false;
        refreshTabHeader(t);

        if (xhr.status !== 200) {
            resBody.innerHTML = '<div class="alert alert-err">HTTP ' + xhr.status + ' — execution failed.</div>';
            setChip(t, "err", "error");
            updateStatus();
            toast("HTTP " + xhr.status, true);
            return;
        }
        try {
            var res = JSON.parse(xhr.responseText);
            t.lastExecMs = res.executionTimeMs;
            t.lastResult = res;

            resBar.style.display = 'flex';
            resBar.querySelector('[data-role="qType"]').textContent = res.queryType || '—';
            resBar.querySelector('[data-role="qRows"]').textContent = (res.rows ? res.rows.length : 0);
            resBar.querySelector('[data-role="qDb"]').textContent = DB_META[t.db].label;

            var tEl = resBar.querySelector('[data-role="qTime"]');
            tEl.textContent = res.executionTimeMs + ' ms';
            tEl.className = 'res-time ' + (res.executionTimeMs < 500 ? 'ok' : res.executionTimeMs < 3000 ? 'warn' : 'slow');

            if (res.success && res.columns && res.columns.length > 0) {
                t.rawCols = res.columns.slice();
                t.rawRows = res.rows ? res.rows.slice() : [];
            } else {
                t.rawCols = null;
                t.rawRows = null;
            }

            renderFilteredResult(t);

            setChip(t, res.success ? "ok" : "err", res.success ? "success" : "error");
            if (expBtn) expBtn.disabled = !(res.success && t.rawRows && t.rawRows.length > 0);

            updateStatus();
            toast(res.success ? "Query ran in " + res.executionTimeMs + " ms" : "Query failed", !res.success);
        } catch(e) {
            resBody.innerHTML = '<div class="alert alert-err">Parse error: ' + escapeHtml(e.message) + '</div>';
            setChip(t, "err", "parse error");
            updateStatus();
        }
    };
    xhr.send(payload);
}

/* ============================================================
 * FILTER + SORT + RENDER
 * ============================================================ */
function renderFilteredResult(t) {
    var resBody = t.paneEl.querySelector('[data-role="resBody"]');
    var res = t.lastResult;

    if (!res) {
        resBody.innerHTML = '<div class="placeholder"><div class="ph-icon">▶</div><div class="ph-title">Ready</div></div>';
        return;
    }

    if (!res.success) {
        resBody.innerHTML = '<div class="alert alert-err">' + escapeHtml(res.message) + '</div>';
        return;
    }

    if (!t.rawCols || !t.rawRows || t.rawRows.length === 0) {
        var msg = res.updateCount >= 0 ? ('Rows affected: ' + res.updateCount) : 'Query executed. 0 rows returned.';
        resBody.innerHTML = '<div class="alert alert-ok">' + escapeHtml(res.message) + '</div>' +
                            '<div class="placeholder"><div class="ph-title">0 rows</div><div class="ph-sub">' + escapeHtml(msg) + '</div></div>';
        return;
    }

    // 1. Filter
    var filter = (t.filterText || '').toLowerCase().trim();
    var rows = t.rawRows;
    if (filter) {
        rows = rows.filter(function(row){
            for (var i = 0; i < t.rawCols.length; i++) {
                var v = row[t.rawCols[i]];
                if (v != null && String(v).toLowerCase().indexOf(filter) !== -1) return true;
            }
            return false;
        });
    }

    // 2. Sort
    if (t.sortCol) {
        var col = t.sortCol;
        var dir = t.sortDir === 'desc' ? -1 : 1;
        rows = rows.slice().sort(function(a, b){
            var va = a[col], vb = b[col];
            if (va == null && vb == null) return 0;
            if (va == null) return 1;
            if (vb == null) return -1;
            // Numeric compare if both look numeric
            var na = parseFloat(va), nb = parseFloat(vb);
            if (!isNaN(na) && !isNaN(nb) && String(va).trim() === String(na) && String(vb).trim() === String(nb)) {
                return (na - nb) * dir;
            }
            return String(va).localeCompare(String(vb)) * dir;
        });
    }

    // 3. Render
    var html = '<div class="alert alert-ok">' + escapeHtml(res.message) +
               (filter ? ' <b>(' + rows.length + ' of ' + t.rawRows.length + ' shown)</b>' : '') + '</div>';
    html += '<table class="data"><thead><tr><th>#</th>';
    t.rawCols.forEach(function(c){
        var sortCls = '';
        var sortIcon = '⇅';
        if (t.sortCol === c) {
            if (t.sortDir === 'asc') { sortCls = 'sorted-asc'; sortIcon = '▲'; }
            else { sortCls = 'sorted-desc'; sortIcon = '▼'; }
        }
        html += '<th class="' + sortCls + '" onclick="sortByColumn(\'' + t.id + '\',\'' + escapeJs(c) + '\')">' +
                    escapeHtml(c) + '<span class="sort-icon">' + sortIcon + '</span>' +
                '</th>';
    });
    html += '</tr></thead><tbody>';
    rows.forEach(function(row, i){
        html += '<tr><td class="row-no">' + (i+1) + '</td>';
        t.rawCols.forEach(function(c){
            var v = row[c];
            if (v === null || v === undefined) html += '<td><span class="null-cell">NULL</span></td>';
            else {
                var s = String(v);
                var disp = filter ? highlightMatch(s, filter) : escapeHtml(s);
                html += '<td title="' + escapeHtml(s) + '">' + disp + '</td>';
            }
        });
        html += '</tr>';
    });
    html += '</tbody></table>';
    resBody.innerHTML = html;
}

function sortByColumn(tabId, col) {
    var t = getTab(tabId); if (!t) return;
    if (t.sortCol === col) {
        if (t.sortDir === 'asc') t.sortDir = 'desc';
        else if (t.sortDir === 'desc') { t.sortCol = null; t.sortDir = null; }
        else t.sortDir = 'asc';
    } else {
        t.sortCol = col;
        t.sortDir = 'asc';
    }
    renderFilteredResult(t);
}

function highlightMatch(text, filter) {
    var esc = escapeHtml(text);
    if (!filter) return esc;
    try {
        var re = new RegExp('(' + filter.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
        return esc.replace(re, '<span class="hl-match">$1</span>');
    } catch(e) { return esc; }
}

function escapeJs(s) {
    return String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g,'\\n');
}

/* ============================================================
 * EXPORT TO EXCEL (CSV)
 * ============================================================ */
function exportResult(tabId) {
    var t = getTab(tabId); if (!t) return;
    if (!t.rawCols || !t.rawRows || t.rawRows.length === 0) {
        toast("Nothing to export.", true);
        return;
    }
    var BOM = '\uFEFF';
    var lines = [];
    lines.push(t.rawCols.map(csvCell).join(','));
    t.rawRows.forEach(function(row){
        lines.push(t.rawCols.map(function(c){ return csvCell(row[c]); }).join(','));
    });
    var csv = BOM + lines.join('\r\n');
    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var stamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
    var fname = 'query_' + t.num + '_' + t.db + '_' + stamp + '.csv';
    var a = document.createElement('a');
    a.href = url;
    a.download = fname;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast("Exported " + t.rawRows.length + " rows → " + fname);
}

function csvCell(v) {
    if (v === null || v === undefined) return '';
    var s = String(v);
    if (/[",\n\r]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
    return s;
}

/* ============================================================
 * HELPERS
 * ============================================================ */
function setChip(t, type, text) {
    var el = t.paneEl.querySelector('[data-role="chip"]');
    if (!el) return;
    el.textContent = text || "idle";
    el.className = 'chip';
    if (type === 'ok') el.classList.add('ok');
    if (type === 'loading') el.classList.add('loading');
    if (type === 'err') el.classList.add('err');
}

function updateStatus() {
    var t = getTab(activeTabId);
    if (t) {
        document.getElementById('stDb').textContent = DB_META[t.db].label;
        document.getElementById('stTab').innerHTML = 'Tab: <b>' + escapeHtml(t.title) + '</b>' +
            (t.running ? ' <span style="color:#60a5fa;">● running</span>' : '');
        document.getElementById('stLast').innerHTML = 'Last exec: <b>' + (t.lastExecMs != null ? t.lastExecMs + ' ms' : '—') + '</b>';
    }
    document.getElementById('stCount').textContent = tabs.length + (tabs.length === 1 ? ' tab' : ' tabs');
    document.getElementById('qCount').textContent = document.querySelectorAll('.qitem').length;
}

function updateCount() { updateStatus(); }

function clearEditor(id) {
    var t = getTab(id); if (!t) return;
    t.editorEl.value = '';
    t.sql = '';
    t.editorEl.focus();
    hideSuggest(t);
    saveTabs();
}

/* ============================================================
 * SIDEBAR
 * ============================================================ */
function toggleGroup(el) {
    var body = el.nextElementSibling;
    var open = body.classList.toggle('open');
    el.classList.toggle('open', open);
}

function loadQuery(el) {
    var sqlEl = el.querySelector('.q-sql');
    if (!sqlEl) return;
    var text = (sqlEl.textContent || sqlEl.innerText).replace(/^\s*\n+/, '').replace(/\s+$/, '');
    var t = getTab(activeTabId);
    if (!t) return;
    t.editorEl.value = text;
    t.sql = text;
    t.editorEl.focus();
    t.editorEl.selectionStart = t.editorEl.selectionEnd = text.length;
    document.querySelectorAll('.qitem').forEach(function(i){ i.classList.remove('active'); });
    el.classList.add('active');
    saveTabs();
    toast("Loaded into " + t.title);
}

document.getElementById('qSearch').addEventListener('input', function(e) {
    var q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.tgroup').forEach(function(g){
        var items = g.querySelectorAll('.qitem');
        var any = false;
        items.forEach(function(it){
            var txt = it.textContent.toLowerCase();
            if (!q || txt.indexOf(q) !== -1) { it.style.display = ''; any = true; }
            else it.style.display = 'none';
        });
        g.style.display = (any || !q) ? '' : 'none';
        if (q && any) {
            g.querySelector('.tgroup-body').classList.add('open');
            g.querySelector('.tgroup-head').classList.add('open');
        }
    });
});

/* ============================================================
 * UTILS
 * ============================================================ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function(){
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function(){ el.remove(); }, 320);
    }, 2400);
}

/* ============================================================
 * PERSIST
 * ============================================================ */
function saveTabs() {
    try {
        localStorage.setItem('eis_qc_v3', JSON.stringify({
            tabs: tabs.map(function(t){ return { num: t.num, db: t.db, sql: t.sql }; }),
            active: activeTabId,
            usedNumbers: usedNumbers
        }));
    } catch(e){}
}

function restoreTabs() {
    try {
        var raw = localStorage.getItem('eis_qc_v3');
        if (!raw) return false;
        var d = JSON.parse(raw);
        if (!d || !d.tabs || !d.tabs.length) return false;
        usedNumbers = d.usedNumbers || {};
        d.tabs.forEach(function(td){
            var t = new Tab(td.num || nextFreeNum(), td.db || DEFAULT_DB);
            t.sql = td.sql || '';
            tabs.push(t);
            renderTab(t);
            t.editorEl.value = t.sql;
        });
        switchTab(d.active || tabs[0].id);
        return true;
    } catch(e){ return false; }
}

/* ============================================================
 * INIT
 * ============================================================ */
window.addEventListener('load', function() {
    if (!restoreTabs()) newTab();
    var firstBody = document.querySelector('.tgroup-body');
    var firstHead = document.querySelector('.tgroup-head');
    if (firstBody && firstHead) {
        firstBody.classList.add('open');
        firstHead.classList.add('open');
    }
    // Preload suggestions in background (won't block UI)
    setTimeout(function() {
        var t = getTab(activeTabId);
        if (t) ensureSuggestLoaded(t);
    }, 400);
    updateCount();
});

document.addEventListener('mousedown', function(e) {
    if (!e.target.closest('#acBox')) {
        var t = getTab(activeTabId);
        if (t) hideSuggest(t);
    }
});
</script>
