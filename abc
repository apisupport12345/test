SELECT 
    (SELECT COUNT(*) FROM daily_dpg_url_data WHERE UPPER(lb_url) LIKE '%GEN5%' AND UPPER(lb_url) LIKE '%GATEWAY%' AND UPPER(lb_url) NOT LIKE '%SIAPP3%') AS gen5_count,
    (SELECT COUNT(*) FROM daily_dpg_url_data WHERE UPPER(lb_url) LIKE '%GEN6%' AND UPPER(lb_url) NOT LIKE '%SIAPP3%') AS gen6_count,
    (SELECT COUNT(*) FROM daily_dpg_url_data WHERE UPPER(lb_url) LIKE '%SIAPP3%' AND UPPER(lb_url) LIKE '%GEN5%') AS gen5_siapp3_count,
    (SELECT COUNT(*) FROM daily_dpg_url_data WHERE UPPER(lb_url) LIKE '%SIAPP3%' AND UPPER(lb_url) LIKE '%GEN6%') AS gen6_siapp3_count
FROM dual;
