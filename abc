    // ============================================================
    // PARTITION NAME BUILDER
    //   Sep 2026 -> SEP_26
    //   Oct 2026 -> OCT_26
    //   Jan 2027 -> JAN_27
    //
    // IMPORTANT: Locale.ENGLISH forced so server locale
    // (Hindi/Chinese/Japanese) does not break month name.
    // ============================================================
    public static String getCurrentPartitionName() {
        Calendar cal = Calendar.getInstance();
        SimpleDateFormat sdf = new SimpleDateFormat("MMM", Locale.ENGLISH);
        String month = sdf.format(cal.getTime()).toUpperCase(Locale.ENGLISH);
        int year = cal.get(Calendar.YEAR);
        int shortYear = year % 100;
        String result = month + "_" + String.format(Locale.ENGLISH, "%02d", shortYear);

        if (DEBUG_PARTITIONS) {
            System.out.println("[IPO-PARTITION] Current calendar date = " + cal.getTime());
            System.out.println("[IPO-PARTITION] Year = " + year + ", shortYear = " + shortYear);
            System.out.println("[IPO-PARTITION] Locale = " + Locale.getDefault());
            System.out.println("[IPO-PARTITION] Generated partition name = [" + result + "]");
        }
        return result;
    }

    // ============================================================
    // TIME FILTER BUILDER
    // ============================================================
    private static String buildTimeFilter(boolean useCustom, String startTime, String endTime) {
        if (useCustom && startTime != null && !startTime.trim().isEmpty()
                       && endTime   != null && !endTime.trim().isEmpty()) {
            return " creation_date_time >= TO_DATE('" + sanitize(startTime)
                 + "','YYYY-MM-DD HH24:MI:SS') "
                 + " AND creation_date_time <= TO_DATE('" + sanitize(endTime)
                 + "','YYYY-MM-DD HH24:MI:SS') ";
        }
        return " creation_date_time >= sysdate - interval '" + WINDOW_MINUTES + "' minute ";
    }

    private static String sanitize(String s) {
        if (s == null) return "";
        return s.replace("'", "").replace(";", "").replace("--", "");
    }

    // ============================================================
    // LOGGING HELPERS
    // ============================================================
    private static void logSql(String name, String sql) {
        if (!DEBUG_SQL) return;
        System.out.println("============================================================");
        System.out.println("[IPO-SQL] QUERY: " + name);
        System.out.println("------------------------------------------------------------");
        System.out.println(sql);
        System.out.println("============================================================");
    }

    private static void logConnection(String name, Connection conn) {
        if (!DEBUG_PARTITIONS) return;
        try {
            DatabaseMetaData md = conn.getMetaData();
            System.out.println("[IPO-CONN][" + name + "] URL  = " + md.getURL());
            System.out.println("[IPO-CONN][" + name + "] User = " + md.getUserName());
            System.out.println("[IPO-CONN][" + name + "] DB   = "
                    + md.getDatabaseProductName() + " "
                    + md.getDatabaseProductVersion());
        } catch (Exception e) {
            System.out.println("[IPO-CONN][" + name + "] metadata fail: " + e.getMessage());
        }
    }

    private static void logVisiblePartitions(String name, Connection conn) {
        if (!DEBUG_PARTITIONS) return;
        Statement st = null;
        ResultSet rs = null;
        try {
            st = conn.createStatement();
            rs = st.executeQuery(
                "SELECT table_name, partition_name FROM all_tab_partitions " +
                "WHERE table_owner='EISAPP' " +
                "AND table_name IN ('BACKEND_LOG','API_LOG','API_LOG_BSE') " +
                "ORDER BY table_name, partition_position DESC");
            System.out.println("[IPO-PARTS][" + name + "] ---- visible partitions ----");
            int cnt = 0;
            while (rs.next() && cnt++ < 50) {
                System.out.println("[IPO-PARTS][" + name + "] "
                        + rs.getString(1) + " -> [" + rs.getString(2) + "]");
            }
            if (cnt == 0) {
                System.out.println("[IPO-PARTS][" + name + "] (none found)");
            }
        } catch (Exception e) {
            System.out.println("[IPO-PARTS][" + name + "] query fail: " + e.getMessage());
        } finally {
            if (rs != null) try { rs.close(); } catch (Exception x) {}
            if (st != null) try { st.close(); } catch (Exception x) {}
        }
    }

