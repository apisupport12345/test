WITH gen5_base AS (
    SELECT 
        ip, 
        type, 
        route_url, 
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen5_op
    FROM daily_dpg_url_data
    WHERE (UPPER(lb_url) LIKE 'GEN5/GATEWAY%'
        OR UPPER(lb_url) LIKE 'GEN5%GATEWAY%'
        OR UPPER(lb_url) LIKE '%GEN5/GETWAY%')
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_base AS (
    SELECT 
        ip, 
        type, 
        route_url, 
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen6_op
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) NOT LIKE '%GEN5%'
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
-- Har gen5 row ke liye best gen6 row (operation match priority)
gen6_best AS (
    SELECT 
        g5.ip,
        g5.type,
        g5.route_url,
        g5.gen5_lb_url,
        g5.gen5_op,
        g6.gen6_lb_url,
        ROW_NUMBER() OVER (
            PARTITION BY g5.ip, g5.type, g5.route_url, g5.gen5_lb_url
            ORDER BY 
                CASE 
                    WHEN g6.gen6_op = g5.gen5_op THEN 1 
                    ELSE 2 
                END,
                g6.gen6_lb_url
        ) AS rn
    FROM gen5_base g5
    LEFT JOIN gen6_base g6
      ON g5.ip = g6.ip
     AND g5.type = g6.type
     AND g5.route_url = g6.route_url
),
-- Har route_url ke liye ek fallback gen6 (agar koi match nahi mila)
gen6_fallback AS (
    SELECT 
        ip, 
        type, 
        route_url, 
        gen6_lb_url,
        ROW_NUMBER() OVER (PARTITION BY ip, type, route_url ORDER BY gen6_lb_url) AS rn
    FROM gen6_base
),
-- Siapp3 wali gen6 rows
gen6_siapp3 AS (
    SELECT 
        ip, 
        type, 
        route_url, 
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen6_op,
        ROW_NUMBER() OVER (PARTITION BY ip, type, route_url ORDER BY lb_url) AS rn
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%SIAPP3%'
      AND UPPER(lb_url) NOT LIKE '%GEN5/GATEWAY%'
),
-- Siapp3 wali gen5 rows
gen5_siapp3 AS (
    SELECT 
        ip, 
        type, 
        route_url, 
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen5_op,
        ROW_NUMBER() OVER (PARTITION BY ip, type, route_url ORDER BY lb_url) AS rn
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) LIKE '%SIAPP3%GEN5%'
)
-- Main output: Gen5 (non-siapp3) with best gen6 match
SELECT 
    g5.ip, 
    g5.type, 
    g5.gen5_lb_url,
    COALESCE(g6.gen6_lb_url, gf.gen6_lb_url) AS gen6_lb_url,
    g5.route_url,
    SYSDATE
FROM gen5_base g5
LEFT JOIN gen6_best g6
  ON g5.ip = g6.ip
 AND g5.type = g6.type
 AND g5.route_url = g6.route_url
 AND g5.gen5_lb_url = g6.gen5_lb_url
 AND g6.rn = 1
LEFT JOIN gen6_fallback gf
  ON g5.ip = gf.ip
 AND g5.type = gf.type
 AND g5.route_url = gf.route_url
 AND gf.rn = 1

UNION ALL

-- Siapp3 wali gen5 with siapp3 gen6
SELECT 
    g5.ip, 
    g5.type, 
    g5.gen5_lb_url,
    g6.gen6_lb_url,
    g5.route_url,
    SYSDATE
FROM gen5_siapp3 g5
LEFT JOIN gen6_siapp3 g6
  ON g5.ip = g6.ip
 AND g5.type = g6.type
 AND g5.route_url = g6.route_url
 AND g5.gen5_op = g6.gen6_op
 AND g6.rn = 1

UNION ALL

-- Siapp3 wali gen6 rows jinka gen5 match nahi mila (leftover)
SELECT 
    NULL AS ip,
    NULL AS type,
    NULL AS gen5_lb_url,
    g6.gen6_lb_url,
    g6.route_url,
    SYSDATE
FROM gen6_siapp3 g6
WHERE NOT EXISTS (
    SELECT 1 FROM gen5_siapp3 g5
    WHERE g5.ip = g6.ip
      AND g5.type = g6.type
      AND g5.route_url = g6.route_url
      AND g5.gen5_op = g6.gen6_op
)
AND g6.rn = 1

UNION ALL

-- Non-siapp3 gen6 rows jinka koi gen5 match nahi mila
SELECT 
    NULL AS ip,
    NULL AS type,
    NULL AS gen5_lb_url,
    g6.gen6_lb_url,
    g6.route_url,
    SYSDATE
FROM gen6_base g6
WHERE NOT EXISTS (
    SELECT 1 FROM gen5_base g5
    WHERE g5.ip = g6.ip
      AND g5.type = g6.type
      AND g5.route_url = g6.route_url
);
