WITH gen5_data AS (
    SELECT 
        ip, type, route_url,
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '(gen5|gen6)/(gateway|getway)/(.*)$', 1, 1, 'i', 3) AS gen5_path
    FROM daily_dpg_url_data
    WHERE lb_url IS NOT NULL
      AND UPPER(lb_url) LIKE '%GEN5%'
),
gen6_data AS (
    SELECT 
        ip, type, route_url,
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '(gen5|gen6)/(gateway|getway)/(.*)$', 1, 1, 'i', 3) AS gen6_path
    FROM daily_dpg_url_data
    WHERE lb_url IS NOT NULL
      AND UPPER(lb_url) LIKE '%GEN6%'
      AND UPPER(lb_url) NOT LIKE '%GEN5%'
),
-- SIAPP3 Gen5
gen5_siapp3 AS (
    SELECT 
        ip, type, route_url,
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '(gen5|gen6)/(gateway|getway)/(.*)$', 1, 1, 'i', 3) AS gen5_path,
        ROW_NUMBER() OVER (PARTITION BY ip, type, route_url ORDER BY lb_url) AS rn
    FROM daily_dpg_url_data
    WHERE lb_url IS NOT NULL
      AND UPPER(lb_url) LIKE '%SIAPP3%'
      AND UPPER(lb_url) LIKE '%GEN5%'
),
-- SIAPP3 Gen6
gen6_siapp3 AS (
    SELECT 
        ip, type, route_url,
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '(gen5|gen6)/(gateway|getway)/(.*)$', 1, 1, 'i', 3) AS gen6_path,
        ROW_NUMBER() OVER (PARTITION BY ip, type, route_url ORDER BY lb_url) AS rn
    FROM daily_dpg_url_data
    WHERE lb_url IS NOT NULL
      AND UPPER(lb_url) LIKE '%SIAPP3%'
      AND UPPER(lb_url) LIKE '%GEN6%'
)
-- 1. Gen5 (non-siapp3) + Gen6 (path match)
SELECT 
    g5.ip, g5.type, g5.gen5_lb_url, g6.gen6_lb_url, g5.route_url, SYSDATE
FROM gen5_data g5
LEFT JOIN gen6_data g6
  ON g5.ip = g6.ip
 AND g5.type = g6.type
 AND g5.route_url = g6.route_url
 AND g5.gen5_path = g6.gen6_path

UNION ALL

-- 2. SIAPP3 Gen5 + SIAPP3 Gen6 (path match)
SELECT 
    g5.ip, g5.type, g5.gen5_lb_url, g6.gen6_lb_url, g5.route_url, SYSDATE
FROM gen5_siapp3 g5
LEFT JOIN gen6_siapp3 g6
  ON g5.ip = g6.ip
 AND g5.type = g6.type
 AND g5.route_url = g6.route_url
 AND g5.gen5_path = g6.gen6_path
 AND g6.rn = 1
WHERE g5.rn = 1

UNION ALL

-- 3. SIAPP3 Gen6 leftover
SELECT 
    NULL, NULL, NULL, g6.gen6_lb_url, g6.route_url, SYSDATE
FROM gen6_siapp3 g6
WHERE NOT EXISTS (
    SELECT 1 FROM gen5_siapp3 g5
    WHERE g5.ip = g6.ip
      AND g5.type = g6.type
      AND g5.route_url = g6.route_url
      AND g5.gen5_path = g6.gen6_path
)
AND g6.rn = 1

UNION ALL

-- 4. Non-siapp3 Gen6 leftover
SELECT 
    NULL, NULL, NULL, g6.gen6_lb_url, g6.route_url, SYSDATE
FROM gen6_data g6
WHERE NOT EXISTS (
    SELECT 1 FROM gen5_data g5
    WHERE g5.ip = g6.ip
      AND g5.type = g6.type
      AND g5.route_url = g6.route_url
      AND g5.gen5_path = g6.gen6_path
);
