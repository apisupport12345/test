        .time-filter-form { display: flex; flex-direction: column; gap: 0.7rem; }
        .time-filter-group { display: flex; flex-direction: column; gap: 0.35rem; }
        .time-filter-label { font-size: 0.82rem; font-weight: 700; color: var(--text-secondary); }
        .time-filter-input {
            padding: 0.55rem 0.7rem;
            border: 1px solid var(--border-strong);
            border-radius: 0.5rem;
            font-size: 0.9rem;
            background: var(--bg-card);
            color: var(--text-primary);
            font-family: inherit;
            width: 100%;
        }
        .time-filter-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15); }
        .time-filter-actions { display: flex; gap: 0.45rem; }
        .time-filter-actions .btn { flex: 1; justify-content: center; }
        .quick-filter-buttons { display: flex; gap: 0.35rem; margin-top: 0.7rem; flex-wrap: wrap; }
        .quick-filter-btn {
            background: var(--bg-elevated);
            color: var(--text-secondary);
            border: 1px solid var(--border-strong);
            padding: 0.45rem 0.7rem;
            border-radius: 0.5rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.8rem;
            font-family: inherit;
            flex: 1;
            min-width: 0;
        }
        .quick-filter-btn:hover { background: var(--bg-hover); border-color: var(--primary); color: var(--primary); }
        .quick-filter-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

        /* BUTTONS */
        .btn {
            background: var(--bg-elevated);
            color: var(--text-secondary);
            border: 1px solid var(--border-strong);
            padding: 0.55rem 1rem;
            border-radius: 0.5rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.87rem;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            font-family: inherit;
            white-space: nowrap;
        }
        .btn:hover { background: var(--bg-hover); border-color: var(--primary); color: var(--primary); transform: translateY(-1px); }
        .btn.primary { background: var(--primary); color: white; border-color: var(--primary); }
        .btn.primary:hover { background: var(--primary-dark); color: white; }
        .btn.isolated { background: var(--isolated); color: white; border-color: var(--isolated); }
        .btn.isolated:hover { color: white; opacity: 0.9; }
        .btn.success { background: var(--success); color: white; border-color: var(--success); }
        .btn.success:hover { color: white; opacity: 0.9; }

        .controls-row { display: flex; gap: 0.45rem; flex-wrap: wrap; padding: 0.7rem; }
        .controls-row .btn { flex: 1; justify-content: center; }

        /* IMPACTED / ISOLATED — FLEX-FIT */
        .left-panel > .card { flex-shrink: 0; }
        .left-panel > .impacted-section {
            flex: 1 1 0;
            min-height: 140px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .impacted-section { border-left: 5px solid var(--danger); }
        .impacted-section.isolated { border-left-color: var(--isolated); }
        .impacted-header {
            padding: 0.7rem 1rem;
            display: flex; justify-content: space-between; align-items: center;
            gap: 0.5rem;
            border-bottom: 1px solid var(--border);
            background: var(--bg-elevated);
            flex-shrink: 0;
        }
        .impacted-title { font-size: 0.95rem; font-weight: 800; color: var(--danger); display: flex; align-items: center; gap: 0.45rem; }
        .impacted-title.isolated { color: var(--isolated); }
        .impacted-count {
            background: var(--danger); color: white;
            padding: 0.15rem 0.7rem;
            border-radius: 999px;
            font-size: 0.78rem; font-weight: 800;
            box-shadow: 0 2px 6px rgba(239, 68, 68, 0.3);
        }
        .impacted-count.isolated { background: var(--isolated); box-shadow: 0 2px 6px rgba(139, 92, 246, 0.3); }
        .impacted-content {
            padding: 0.65rem 0.85rem 0.85rem;
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }
        .impacted-list { display: flex; flex-direction: column; gap: 0.45rem; }
        .impacted-server-item {
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            border-radius: 0.55rem;
            padding: 0.6rem 0.85rem;
            display: flex; align-items: center; justify-content: space-between;
            gap: 0.55rem;
            font-size: 0.88rem;
            position: relative;
            overflow: hidden;
            transition: all 0.2s ease;
        }
        .impacted-server-item::before { content: ''; position: absolute; left: 0; top: 0; height: 100%; width: 4px; background: var(--danger); }
        .impacted-server-item.warning::before { background: var(--warning); }
        .impacted-server-item.isolated::before { background: var(--isolated); }
        .impacted-server-item:hover { background: var(--bg-hover); transform: translateX(3px); }
        .impacted-broker { font-weight: 800; color: var(--text-primary); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .impacted-ip { color: var(--text-muted); font-family: 'Courier New', monospace; flex-shrink: 0; font-weight: 700; font-size: 0.85rem; }
        .impacted-hits {
            color: white;
            padding: 0.2rem 0.6rem;
            border-radius: 0.4rem;
            font-weight: 800;
            font-size: 0.78rem;
            min-width: 55px;
            text-align: center;
        }
        .impacted-hits.critical { background: var(--danger); }
        .impacted-hits.warning { background: var(--warning); }
        .impacted-hits.isolated { background: var(--isolated); }

        /* BROKER CARDS */
        .broker-cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 0.9rem;
            width: 100%;
        }
        .broker-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 0.85rem;
            box-shadow: var(--shadow-sm);
            transition: all 0.25s ease;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            min-width: 0;
        }
        .broker-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; }
        .broker-card.critical::before { background: var(--danger); }
        .broker-card.warning::before { background: var(--warning); }
        .broker-card.healthy::before { background: var(--success); }
        .broker-card.isolated::before { background: var(--isolated); }
        .broker-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }

        .broker-header {
            padding: 0.9rem 1.1rem;
            border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: flex-start;
            gap: 0.7rem;
        }
        .broker-info { flex: 1; min-width: 0; }
        .broker-name {
            font-size: 1.15rem; font-weight: 800; color: var(--text-primary);
            margin-bottom: 0.25rem;
            display: flex; align-items: center; gap: 0.5rem;
            word-break: break-word;
            line-height: 1.2;
        }
        .broker-port { color: var(--text-muted); font-size: 0.85rem; font-weight: 700; }
        .broker-port i { margin-right: 0.3rem; color: var(--text-faint); }
        .broker-status { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; flex-shrink: 0; }
        .status-badge {
            padding: 0.3rem 0.75rem;
            border-radius: 999px;
            font-size: 0.72rem; font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
            color: white;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        }
        .status-badge.healthy { background: var(--success); }
        .status-badge.warning { background: var(--warning); }
        .status-badge.critical { background: var(--danger); }
        .status-badge.isolated { background: var(--isolated); }
        .total-hits { color: var(--text-primary); font-size: 1.2rem; font-weight: 800; white-space: nowrap; line-height: 1; }
        .total-hits-label { font-size: 0.68rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }

        .broker-body { padding: 0.9rem 1.1rem; flex: 1; display: flex; flex-direction: column; gap: 0.9rem; }
        .server-stats {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 0.4rem;
            padding-bottom: 0.85rem;
            border-bottom: 1px solid var(--border);
        }
        .server-stat {
            text-align: center;
            padding: 0.5rem 0.25rem;
            border-radius: 0.5rem;
            background: var(--bg-elevated);
            min-width: 0;
            transition: background 0.2s ease;
        }
        .server-stat:hover { background: var(--bg-hover); }
        .server-stat-value { font-size: 1.15rem; font-weight: 800; color: var(--text-primary); line-height: 1; margin-bottom: 0.25rem; }
        .server-stat-label { font-size: 0.68rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }

        .server-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 0.45rem;
        }
        .server-item {
            display: flex; justify-content: space-between; align-items: center;
            padding: 0.55rem 0.7rem;
            background: var(--bg-elevated);
            border-radius: 0.5rem;
            transition: all 0.2s;
            font-size: 0.85rem;
            border-left: 3px solid var(--border-strong);
            position: relative;
            min-width: 0;
        }
        .server-item:hover { background: var(--bg-hover); transform: translateX(2px); }
        .server-ip {
            font-weight: 800;
            color: var(--text-secondary);
            font-family: 'Courier New', monospace;
            display: flex; align-items: center; gap: 0.45rem;
            font-size: 0.85rem;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .server-hits {
            font-weight: 800;
            padding: 0.25rem 0.55rem;
            border-radius: 0.4rem;
            background: var(--bg-card);
            border: 1px solid var(--border);
            min-width: 3rem;
            text-align: center;
            font-size: 0.8rem;
            flex-shrink: 0;
            color: var(--text-secondary);
        }
        .server-hits.healthy { color: var(--success); border-color: var(--success); background: rgba(16, 185, 129, 0.12); }
        .server-hits.warning { color: var(--warning); border-color: var(--warning); background: rgba(245, 158, 11, 0.12); }
        .server-hits.critical, .server-hits.zero { color: var(--danger); border-color: var(--danger); background: rgba(239, 68, 68, 0.12); }
        .server-hits.isolated { color: var(--isolated); border-color: var(--isolated); background: rgba(139, 92, 246, 0.12); }

        .broker-footer {
            padding: 0.55rem 1.1rem;
            background: var(--bg-footer);
            border-top: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
            font-size: 0.78rem;
            color: var(--text-muted);
            font-weight: 600;
        }

        .status-indicator { display: inline-block; width: 11px; height: 11px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 0 3px rgba(0,0,0,0.05); }
        .status-indicator.healthy { background: var(--success); box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); }
        .status-indicator.warning { background: var(--warning); box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2); }
        .status-indicator.critical { background: var(--danger); box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2); }
        .status-indicator.isolated { background: var(--isolated); box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2); }

        [data-full-ip] { position: relative; cursor: help; }
        [data-full-ip]:hover::after {
            content: attr(data-full-ip);
            position: absolute; bottom: 100%; left: 50%;
            transform: translateX(-50%);
            padding: 0.4rem 0.8rem;
            background: var(--text-primary);
            color: var(--bg-card);
            border-radius: 0.4rem;
            font-size: 0.78rem;
            white-space: nowrap;
            z-index: 1000;
            pointer-events: none;
            margin-bottom: 0.4rem;
            box-shadow: var(--shadow-md);
            font-weight: 700;
        }

        .no-impacted {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center;
            color: var(--text-muted);
            padding: 1rem;
            height: 100%;
            min-height: 120px;
            font-size: 0.9rem;
        }
        .no-impacted i { font-size: 1.75rem; margin-bottom: 0.5rem; display: block; }
        .no-impacted p { margin-bottom: 0.2rem; font-weight: 700; color: var(--text-secondary); font-size: 0.95rem; }
        .no-impacted small { color: var(--text-faint); font-size: 0.78rem; font-weight: 500; }

        @keyframes softBlinkCritical { 0%, 90% { opacity: 1; } 92% { opacity: 0.85; } 94% { opacity: 1; } 96% { opacity: 0.85; } 98% { opacity: 1; } }
        @keyframes softBlinkWarning { 0%, 92% { opacity: 1; } 94% { opacity: 0.9; } 96% { opacity: 1; } 98% { opacity: 0.9; } }
        @keyframes softBlinkIsolated { 0%, 88% { opacity: 1; } 91% { opacity: 0.8; } 94% { opacity: 1; } 97% { opacity: 0.8; } }

        .broker-card.critical { border-left: 3px solid var(--danger); animation: softBlinkCritical 5s ease-in-out infinite; }
        .broker-card.warning { border-left: 3px solid var(--warning); animation: softBlinkWarning 7s ease-in-out infinite; }
        .broker-card.isolated { border-left: 3px solid var(--isolated); animation: softBlinkIsolated 3s ease-in-out infinite; }
        .status-badge.critical { animation: softBlinkCritical 5s ease-in-out infinite; }
        .status-badge.warning { animation: softBlinkWarning 7s ease-in-out infinite; }
        .status-badge.isolated { animation: softBlinkIsolated 3s ease-in-out infinite; }
        .impacted-count { animation: softBlinkCritical 5s ease-in-out infinite; }
        .impacted-count.isolated { animation: softBlinkIsolated 3s ease-in-out infinite; }
        .status-indicator.critical { animation: softBlinkCritical 5s ease-in-out infinite; }
        .status-indicator.warning { animation: softBlinkWarning 7s ease-in-out infinite; }
        .status-indicator.isolated { animation: softBlinkIsolated 3s ease-in-out infinite; }

        .no-blink .broker-card.critical, .no-blink .broker-card.warning, .no-blink .broker-card.isolated,
        .no-blink .status-badge.critical, .no-blink .status-badge.warning, .no-blink .status-badge.isolated,
        .no-blink .impacted-count, .no-blink .impacted-count.isolated,
        .no-blink .status-indicator.critical, .no-blink .status-indicator.warning, .no-blink .status-indicator.isolated { animation: none !important; opacity: 1 !important; }

        .impacted-content::-webkit-scrollbar,
        .right-panel::-webkit-scrollbar { width: 8px; }
        .impacted-content::-webkit-scrollbar-track,
        .right-panel::-webkit-scrollbar-track { background: var(--scrollbar-track); border-radius: 4px; }
        .impacted-content::-webkit-scrollbar-thumb,
        .right-panel::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 4px; }
        .impacted-content::-webkit-scrollbar-thumb:hover,
        .right-panel::-webkit-scrollbar-thumb:hover { background: var(--text-faint); }

        #chromeVoiceOverlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.95);
            z-index: 10000;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
        }
        .overlay-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 2rem;
            border-radius: 1rem;
            text-align: center;
            max-width: 420px;
            margin: 1rem;
            color: white;
        }
        .overlay-box i { font-size: 3rem; margin-bottom: 0.75rem; }
        .overlay-box h3 { margin-bottom: 0.5rem; font-size: 1.25rem; }
        .overlay-box p { margin-bottom: 1rem; line-height: 1.4; font-size: 0.9rem; opacity: 0.95; }
        .overlay-box button {
            background: white; color: #667eea;
            border: none;
            padding: 0.65rem 1.5rem;
            border-radius: 0.6rem;
            font-size: 0.9rem; font-weight: 600;
            cursor: pointer;
        }

        /* RESPONSIVE */
        @media (max-width: 1200px) {
            .stats-bar { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .main-content { grid-template-columns: 360px minmax(0, 1fr); }
            .broker-cards-container { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
        }
        @media (max-width: 1024px) {
            html, body { overflow-x: hidden; overflow-y: auto; }
            .main-content { grid-template-columns: 1fr; padding: 0.85rem; min-height: auto; align-items: stretch; }
            .left-panel, .right-panel { width: 100%; height: auto; max-height: none; overflow-y: visible; }
            .left-panel > .impacted-section { flex: 0 0 auto; min-height: 220px; max-height: 320px; }
            .impacted-content { max-height: 220px; }
            .broker-cards-container { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
            .topbar { padding: 0.6rem 1rem; }
            .topbar-center { justify-content: flex-start; }
        }
        @media (max-width: 768px) {
            body { font-size: 16px; }
            .stats-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0.6rem 0.85rem; }
            .stat-mini-value { font-size: 1.15rem; }
            .broker-cards-container { grid-template-columns: 1fr; gap: 0.8rem; }
            .server-list { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
            .topbar-center { display: none; }
            .brand-sub { display: none; }
        }
        @media (max-width: 480px) {
            .stats-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .controls-row { flex-direction: column; }
            .controls-row .btn { width: 100%; }
            .quick-filter-buttons { flex-direction: column; }
            .quick-filter-btn { width: 100%; }
        }
        @media print {
            .topbar, .stats-bar, .left-panel, .icon-btn { display: none; }
            .broker-cards-container { display: block; }
            .broker-card { page-break-inside: avoid; margin-bottom: 20px; }
        }
    </style>
    <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
</head>
<body>

<div id="chromeVoiceOverlay" style="display: none;">
    <div class="overlay-box">
        <i class="fas fa-volume-up"></i>
        <h3>Enable Voice Alerts</h3>
        <p>Click anywhere to enable automatic voice alerts for critical server monitoring.</p>
        <button id="enableVoiceNowBtn">Enable Voice Alerts</button>
    </div>
</div>

<%
    StringBuilder jsBrokerMap = new StringBuilder();
    if (criticalServersByBroker != null && !criticalServersByBroker.isEmpty()) {
        int brokerIndex = 0;
        for (Map.Entry<String, List<String>> entry : criticalServersByBroker.entrySet()) {
            if (brokerIndex > 0) jsBrokerMap.append(",");
            String broker = entry.getKey().replace("'", "\\'").replace("\"", "&quot;");
            jsBrokerMap.append("\"").append(broker).append("\":[");
            List<String> ips = entry.getValue();
            for (int i = 0; i < ips.size(); i++) {
                if (i > 0) jsBrokerMap.append(",");
                String ip = ips.get(i).replace("'", "\\'").replace("\"", "&quot;");
                jsBrokerMap.append("\"").append(ip).append("\"");
            }
            jsBrokerMap.append("]");
            brokerIndex++;
        }
    }
%>

<!-- TOPBAR -->
<div class="topbar">
    <div class="brand">
        <div class="brand-logo"><i class="fas fa-server"></i></div>
        <div>
            <div class="brand-title">SYS Broker Monitor</div>
            <div class="brand-sub">Rolling 60-min window · updated every 10 min</div>
        </div>
    </div>

    <div class="topbar-center">
        <span class="pill timer" id="refreshTimer"><i class="fas fa-sync-alt"></i> <span id="ten-countdown">10:00</span></span>
        <span class="pill window"><i class="fas fa-clock"></i> <%=runTimeDisplay%></span>
        <% if ("PR".equals(flagStatus)) { %>
            <span class="pill pr"><i class="fas fa-circle-check"></i> Production</span>
        <% } else if ("DR".equals(flagStatus)) { %>
            <span class="pill dr"><i class="fas fa-shield-halved"></i> DR</span>
        <% } %>
    </div>

    <div class="topbar-actions">
        <button class="icon-btn" id="themeToggle" onclick="toggleTheme()" title="Toggle theme (Ctrl+D)">
            <i class="fas fa-moon" id="themeIcon"></i>
        </button>
        <button class="icon-btn" onclick="toggleBlinking()" id="blinkToggleBtn" title="Toggle blinking">
            <i class="fas fa-eye" id="blinkIcon"></i>
        </button>
        <button class="icon-btn" onclick="testVoice()" title="Test voice">
            <i class="fas fa-play"></i>
        </button>
        <button class="icon-btn" onclick="toggleMute()" id="muteBtn" title="Mute/Unmute">
            <i class="fas fa-volume-up" id="muteIcon"></i>
        </button>
    </div>
</div>

<!-- STATS BAR -->
<div class="stats-bar">
    <div class="stat-mini">
        <div class="stat-mini-icon"><i class="fas fa-server"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=totalBrokers%></span>
            <span class="stat-mini-label">Brokers</span>
        </div>
    </div>
    <div class="stat-mini info">
        <div class="stat-mini-icon"><i class="fas fa-network-wired"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=totalServers%></span>
            <span class="stat-mini-label">Servers</span>
        </div>
    </div>
    <div class="stat-mini isolated">
        <div class="stat-mini-icon"><i class="fas fa-shield-alt"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=isolatedBrokersCount%></span>
            <span class="stat-mini-label">Isolated</span>
        </div>
    </div>
    <div class="stat-mini critical">
        <div class="stat-mini-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=criticalBrokers%></span>
            <span class="stat-mini-label">Critical</span>
        </div>
    </div>
    <div class="stat-mini warning">
        <div class="stat-mini-icon"><i class="fas fa-exclamation-circle"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=warningBrokers%></span>
            <span class="stat-mini-label">Warning</span>
        </div>
    </div>
    <div class="stat-mini healthy">
        <div class="stat-mini-icon"><i class="fas fa-check-circle"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=healthyBrokers%></span>
            <span class="stat-mini-label">Healthy</span>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<div class="main-content">
    <div class="left-panel">
        <!-- Time Filter -->
        <div class="card">
            <div class="time-filter-header" onclick="toggleTimeFilter()">
                <div class="time-filter-title"><i class="fas fa-filter"></i> Time Filter</div>
                <div class="time-filter-toggle"><i class="fas fa-chevron-down"></i></div>
            </div>
            <div class="time-filter-content" id="timeFilterContent">
                <form id="timeFilterForm" method="GET" class="time-filter-form">
                    <div class="time-filter-group">
                        <label class="time-filter-label" for="fromDateTime">From:</label>
                        <input type="datetime-local" id="fromDateTime" name="fromDateTime" class="time-filter-input" value="<%=fromDateTime%>">
                    </div>
                    <div class="time-filter-group">
                        <label class="time-filter-label" for="toDateTime">To:</label>
                        <input type="datetime-local" id="toDateTime" name="toDateTime" class="time-filter-input" value="<%=toDateTime%>">
                    </div>
                    <div class="time-filter-actions">
                        <button type="submit" class="btn primary"><i class="fas fa-search"></i> Apply</button>
                        <button type="button" class="btn" onclick="resetTimeFilter()"><i class="fas fa-rotate-left"></i> Reset</button>
                    </div>
                </form>
                <div class="quick-filter-buttons">
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(10)">10m</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(15)">15m</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(30)">30m</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(60)">1h</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(120)">2h</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(360)">6h</button>
                </div>
            </div>
        </div>

        <!-- Controls -->
        <div class="card">
            <div class="controls-row">
                <button class="btn primary" onclick="openNewPage()"><i class="fas fa-exchange-alt"></i> EXP</button>
                <button class="btn isolated" onclick="showIsolatedOnly()"><i class="fas fa-shield-alt"></i> ISO Only</button>
                <button class="btn success" onclick="showAllBrokers()" id="showAllBtn" style="display: none;"><i class="fas fa-globe"></i> All</button>
            </div>
        </div>

        <!-- Impacted -->
        <div class="card impacted-section">
            <div class="impacted-header">
                <div class="impacted-title"><i class="fas fa-exclamation-triangle"></i> Impacted Servers <span class="impacted-count"><%=impactedServers%></span></div>
            </div>
            <div class="impacted-content">
                <% if (impactedServers > 0) { %>
                <div class="impacted-list">
                    <% for (Map<String, String> server : impactedServersList) { %>
                    <div class="impacted-server-item <%=server.get("status")%>" data-full-ip="<%=server.get("ip")%>">
                        <span class="impacted-broker"><%=server.get("broker")%></span>
                        <span class="impacted-ip"><%=server.get("displayIP")%></span>
                        <span class="impacted-hits <%=server.get("status")%>"><%=String.format("%,d", Integer.parseInt(server.get("hits")))%></span>
                    </div>
                    <% } %>
                </div>
                <% } else { %>
                <div class="no-impacted">
                    <i class="fas fa-check-circle" style="color: var(--success);"></i>
                    <p>No Impacted Servers</p>
                    <small>All systems normal</small>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Isolated -->
        <div class="card impacted-section isolated">
            <div class="impacted-header">
                <div class="impacted-title isolated"><i class="fas fa-shield-alt"></i> Isolated Servers <span class="impacted-count isolated"><%=isolatedServers%></span></div>
            </div>
            <div class="impacted-content">
                <% if (isolatedServers > 0) { %>
                <div class="impacted-list">
                    <% for (Map<String, String> server : isolatedServersList) { %>
                    <div class="impacted-server-item isolated" data-full-ip="<%=server.get("ip")%>">
                        <span class="impacted-broker"><%=server.get("broker")%></span>
                        <span class="impacted-ip"><%=server.get("displayIP")%></span>
                        <span class="impacted-hits isolated">ISO</span>
                    </div>
                    <% } %>
                </div>
                <% } else { %>
                <div class="no-impacted">
                    <i class="fas fa-check-circle" style="color: var(--success);"></i>
                    <p>No Isolated Servers</p>
                    <small>All brokers normal</small>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="right-panel">
        <div class="broker-cards-container" id="brokerCardsContainer">
            <%
                if (brokerDataList.isEmpty()) {
            %>
                <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 3rem 1.5rem;">
                    <i class="fas fa-database" style="font-size: 3rem; color: var(--text-faint); margin-bottom: 0.9rem;"></i>
                    <h3 style="color: var(--text-secondary); margin-bottom: 0.5rem; font-size: 1.15rem;">No Brokers Found</h3>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">No data available for selected range.</p>
                    <button class="btn primary" onclick="location.reload(true)" style="margin-top: 1rem;"><i class="fas fa-rotate-right"></i> Refresh</button>
                </div>
            <%
                } else {
                    for (Map<String, Object> brokerData : brokerDataList) {
                        String broker = (String) brokerData.get("broker");
                        String port = (String) brokerData.get("port");
                        String brokerStatus = (String) brokerData.get("brokerStatus");
                        List<Map<String, String>> serverList = (List<Map<String, String>>) brokerData.get("serverList");
                        int totalHits = (Integer) brokerData.get("totalHits");
                        int criticalCount = (Integer) brokerData.get("criticalCount");
                        int warningCount = (Integer) brokerData.get("warningCount");
                        int isolatedCount = (Integer) brokerData.get("isolatedCount");
                        int serverCount = (Integer) brokerData.get("serverCount");
                        int healthyCount = (Integer) brokerData.get("healthyCount");
            %>
                <div class="broker-card <%= brokerStatus %>" data-status="<%= brokerStatus %>" data-broker="<%= broker %>">
                    <div class="broker-header">
                        <div class="broker-info">
                            <div class="broker-name"><span class="status-indicator <%= brokerStatus %>"></span><%= broker != null ? broker : "Unknown" %></div>
                            <div class="broker-port"><i class="fas fa-plug"></i>Port: <%= port != null ? port : "N/A" %></div>
                        </div>
                        <div class="broker-status">
                            <div class="status-badge <%= brokerStatus %>"><%= brokerStatus.equals("healthy") ? "Healthy" : brokerStatus.equals("warning") ? "Warning" : brokerStatus.equals("critical") ? "Critical" : "Isolated" %></div>
                            <div class="total-hits"><%= String.format("%,d", totalHits) %></div>
                            <div class="total-hits-label">Total Hits</div>
                        </div>
                    </div>
                    <div class="broker-body">
                        <div class="server-stats">
                            <div class="server-stat"><div class="server-stat-value"><%= serverCount %></div><div class="server-stat-label">Total</div></div>
                            <div class="server-stat"><div class="server-stat-value" style="color: var(--success);"><%= healthyCount %></div><div class="server-stat-label">OK</div></div>
                            <div class="server-stat"><div class="server-stat-value" style="color: var(--warning);"><%= warningCount %></div><div class="server-stat-label">Warn</div></div>
                            <div class="server-stat"><div class="server-stat-value" style="color: var(--danger);"><%= criticalCount %></div><div class="server-stat-label">Crit</div></div>
                            <div class="server-stat"><div class="server-stat-value" style="color: var(--isolated);"><%= isolatedCount %></div><div class="server-stat-label">ISO</div></div>
                        </div>
                        <div class="server-list">
                            <%
                                for (Map<String, String> server : serverList) {
                                    String ip = server.get("ip");
                                    String displayIP = server.get("displayIP");
                                    String hits = server.get("hits");
                                    String status = server.get("status");
                            %>
                                <div class="server-item" data-full-ip="<%= ip %>">
                                    <span class="server-ip"><span class="status-indicator <%= status %>"></span><%= displayIP %></span>
                                    <span class="server-hits <%= status %>">
                                        <% if (status.equals("isolated")) { %>ISO<% } else { %><%= String.format("%,d", Integer.parseInt(hits)) %><% } %>
                                    </span>
                                </div>
                            <%
                                }
                            %>
                        </div>
                    </div>
                    <div class="broker-footer">
                        <span><i class="far fa-clock"></i> <%=runTimeDisplay%></span>
                    </div>
                </div>
            <%
                    }
                }
            %>
        </div>
    </div>
</div>

<script>
    // ============================================================
    // THEME TOGGLE
    // ============================================================
    function applyTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        const icon = document.getElementById('themeIcon');
        if (icon) icon.className = theme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        try { localStorage.setItem('expTheme', theme); } catch(e) {}
    }
    function toggleTheme() {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        applyTheme(current === 'dark' ? 'light' : 'dark');
    }
    (function() {
        try {
            const saved = localStorage.getItem('expTheme');
            if (saved === 'dark' || saved === 'light') applyTheme(saved);
            else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) applyTheme('dark');
            else applyTheme('light');
        } catch(e) { applyTheme('light'); }
    })();

    // ============================================================
    // VOICE ALERT SYSTEM
    // ============================================================
    let speechSynthesis = window.speechSynthesis;
    let isVoiceEnabled = true;
    let isMuted = false;
    let isPlaying = false;
    let voices = [];
    let userInteracted = false;
    let voiceInitialized = false;
    let voicePlayCount = 0;
    const MAX_VOICE_PLAYS = 3;

    const criticalServersByBroker = { <%= jsBrokerMap.toString() %> };
    const hasUserInteracted = localStorage.getItem('voiceEnabled') === 'true' || localStorage.getItem('chromeVoiceEnabled') === 'true';

    function cleanForPronunciation(text) {
        if (!text) return '';
        let cleaned = text.replace(/SYS/gi, 'S Y S');
        cleaned = cleaned.replace(/NP_SPL/gi, 'N P S P L');
        cleaned = cleaned.replace(/_/g, ' ');
        cleaned = cleaned.replace(/\./g, ' dot ');
        return cleaned;
    }

    function buildSequentialMessage() {
        const brokerKeys = Object.keys(criticalServersByBroker);
        if (brokerKeys.length === 0) return '';
        let fullMessage = 'Alert! ';
        let messageParts = [];
        for (let i = 0; i < brokerKeys.length; i++) {
            let broker = brokerKeys[i];
            let servers = criticalServersByBroker[broker];
            let cleanBroker = cleanForPronunciation(broker);
            if (servers.length === 1) messageParts.push(cleanBroker + ' server ' + cleanForPronunciation(servers[0]));
            else {
                let serverList = servers.map(s => cleanForPronunciation(s)).join(', ');
                messageParts.push(cleanBroker + ' servers ' + serverList);
            }
        }
        if (messageParts.length === 1) return fullMessage + messageParts[0];
        return fullMessage + messageParts.join(', then ');
    }

    function getTotalCriticalCount() {
        let count = 0;
        for (let broker in criticalServersByBroker) count += criticalServersByBroker[broker].length;
        return count;
    }

    function loadVoices() { try { voices = speechSynthesis.getVoices(); } catch(e) {} }
    if (speechSynthesis) {
        loadVoices();
        if (speechSynthesis.onvoiceschanged !== undefined) speechSynthesis.onvoiceschanged = loadVoices;
    }

    function getBestVoice() {
        if (voices.length === 0) return null;
        const preferred = ['Google UK English Female','Google US English','Microsoft David','Microsoft Zira','Samantha','Alex','Google UK English Male','en-US','en-GB','English'];
        for (let p of preferred) {
            let voice = voices.find(v => v.name.includes(p) || v.lang.includes(p));
            if (voice) return voice;
        }
        return voices.find(v => v.lang.startsWith('en'));
    }

    function updateVoiceUI() {
        const muteIcon = document.getElementById('muteIcon');
        const muteBtn = document.getElementById('muteBtn');
        if (!muteIcon || !muteBtn) return;
        if (isMuted) {
            muteIcon.className = 'fas fa-volume-mute';
            muteBtn.style.color = 'var(--danger)';
            muteBtn.style.borderColor = 'var(--danger)';
        } else {
            muteIcon.className = 'fas fa-volume-up';
            const criticalCount = getTotalCriticalCount();
            muteBtn.style.color = criticalCount > 0 ? 'var(--danger)' : '';
            muteBtn.style.borderColor = criticalCount > 0 ? 'var(--danger)' : '';
        }
    }

    function speakMessage(message, callback) {
        if (!isVoiceEnabled || isMuted || !speechSynthesis || !message) { if (callback) callback(); return false; }
        try { speechSynthesis.cancel(); } catch(e) {}
        try {
            const utterance = new SpeechSynthesisUtterance(message);
            utterance.rate = 0.85; utterance.pitch = 1.1; utterance.volume = 1; utterance.lang = 'en-US';
            const bestVoice = getBestVoice();
            if (bestVoice) utterance.voice = bestVoice;
            utterance.onerror = function() { if(callback) callback(); };
            utterance.onend = function() { if(callback) callback(); };
            setTimeout(() => { try { speechSynthesis.speak(utterance); } catch(e) { if(callback) callback(); } }, 50);
            return true;
        } catch(e) { if(callback) callback(); return false; }
    }

    function playVoiceAlert() {
        if (voicePlayCount >= MAX_VOICE_PLAYS) return;
        const criticalCount = getTotalCriticalCount();
        if (criticalCount === 0) return;
        if (!isVoiceEnabled || isMuted) return;
        const message = buildSequentialMessage();
        isPlaying = true;
        voicePlayCount++;
        speakMessage(message, function() { isPlaying = false; updateVoiceUI(); });
        updateVoiceUI();
    }

    function toggleMute() {
        isMuted = !isMuted;
        saveVoicePreferences();
        if (isMuted) try { speechSynthesis.cancel(); } catch(e) {}
        isPlaying = false;
        updateVoiceUI();
    }

    function loadVoicePreferences() {
        try {
            const saved = localStorage.getItem('voiceEnabled');
            if (saved !== null) isVoiceEnabled = saved === 'true';
            const muted = localStorage.getItem('voiceMuted');
            if (muted !== null) isMuted = muted === 'true';
        } catch(e) {}
    }
    function saveVoicePreferences() {
        try {
            localStorage.setItem('voiceEnabled', isVoiceEnabled);
            localStorage.setItem('voiceMuted', isMuted);
        } catch(e) {}
    }
    function testVoice() {
        if (!userInteracted) { showOverlayAndInitialize(); return; }
        if (!isVoiceEnabled) { alert('Voice system active. Click Unmute if muted.'); return; }
        if (isMuted) { alert('Please unmute first'); return; }
        speakMessage('Voice alert system is working correctly. This is a test message.', function() { alert('Voice test completed!'); });
    }
    function showOverlayAndInitialize() { document.getElementById('chromeVoiceOverlay').style.display = 'flex'; }
    function hideOverlayAndInitialize() {
        document.getElementById('chromeVoiceOverlay').style.display = 'none';
        initializeVoiceSystem();
    }
    function initializeVoiceSystem() {
        if (voiceInitialized) return;
        voiceInitialized = true;
        userInteracted = true;
        localStorage.setItem('voiceEnabled', 'true');
        localStorage.setItem('chromeVoiceEnabled', 'true');
        loadVoicePreferences();
        updateVoiceUI();
        try {
            const silent = new SpeechSynthesisUtterance('');
            silent.volume = 0;
            speechSynthesis.speak(silent);
        } catch(e) {}
        setTimeout(function() {
            if (getTotalCriticalCount() > 0 && !isMuted && voicePlayCount < MAX_VOICE_PLAYS) playVoiceAlert();
        }, 1500);
    }
    function playRefreshVoiceAnnouncement() {
        if (getTotalCriticalCount() > 0 && isVoiceEnabled && !isMuted && userInteracted && voicePlayCount < MAX_VOICE_PLAYS) {
            setTimeout(playVoiceAlert, 1500);
        }
    }

    // ============================================================
    // UI FUNCTIONS
    // ============================================================
    function countdown(elementName, minutes, seconds) {
        var element, endTime, time;
        function twoDigits(n) { return (n <= 9 ? "0" + n : n); }
        function updateTimer() {
            var msLeft = endTime - (+new Date);
            if (msLeft < 1000) {
                element.innerHTML = "...";
                document.getElementById('refreshTimer').classList.add('warning-state');
                setTimeout(function() { location.reload(true); }, 1000);
            } else {
                time = new Date(msLeft);
                var hours = time.getUTCHours();
                var mins = time.getUTCMinutes();
                element.innerHTML = (hours ? hours + ':' + twoDigits(mins) : mins) + ':' + twoDigits(time.getUTCSeconds());
                if (msLeft < 60000) document.getElementById('refreshTimer').classList.add('warning-state');
                else document.getElementById('refreshTimer').classList.remove('warning-state');
                setTimeout(updateTimer, time.getUTCMilliseconds() + 500);
            }
        }
        element = document.getElementById(elementName);
        endTime = (+new Date) + 1000 * (60 * minutes + seconds) + 500;
        updateTimer();
    }

    function toggleTimeFilter() {
        var content = document.getElementById('timeFilterContent');
        var toggle = document.querySelector('.time-filter-toggle');
        content.classList.toggle('expanded');
        toggle.classList.toggle('expanded');
    }
    function resetTimeFilter() {
        document.getElementById('fromDateTime').value = '';
        document.getElementById('toDateTime').value = '';
        document.getElementById('timeFilterForm').submit();
    }
    function setQuickFilter(minutes) {
        var now = new Date();
        var start = new Date(now.getTime() - minutes * 60000);
        document.getElementById('fromDateTime').value = formatDateForInput(start);
        document.getElementById('toDateTime').value = formatDateForInput(now);
        document.querySelectorAll('.quick-filter-btn').forEach(b => b.classList.remove('active'));
        event.target.classList.add('active');
        document.getElementById('timeFilterForm').submit();
    }
    function formatDateForInput(date) {
        var y = date.getFullYear();
        var m = String(date.getMonth()+1).padStart(2,'0');
        var d = String(date.getDate()).padStart(2,'0');
        var h = String(date.getHours()).padStart(2,'0');
        var min = String(date.getMinutes()).padStart(2,'0');
        return y + '-' + m + '-' + d + 'T' + h + ':' + min;
    }
    function toggleBlinking() {
        var body = document.body;
        var icon = document.getElementById('blinkIcon');
        if (body.classList.contains('no-blink')) {
            body.classList.remove('no-blink');
            icon.className = 'fas fa-eye';
            localStorage.setItem('blinkingEnabled', 'true');
        } else {
            body.classList.add('no-blink');
            icon.className = 'fas fa-eye-slash';
            localStorage.setItem('blinkingEnabled', 'false');
        }
    }
    function showIsolatedOnly() {
        var cards = document.querySelectorAll('.broker-card');
        var isolatedCount = 0;
        cards.forEach(function(card) {
            if (card.classList.contains('isolated')) { card.style.display = 'flex'; isolatedCount++; }
            else card.style.display = 'none';
        });
        document.getElementById('showAllBtn').style.display = 'inline-flex';
        var container = document.getElementById('brokerCardsContainer');
        var existing = document.getElementById('noIsolatedMessage');
        if (isolatedCount === 0 && !existing) {
            var div = document.createElement('div');
            div.id = 'noIsolatedMessage';
            div.className = 'card';
            div.style.cssText = 'grid-column: 1 / -1; text-align: center; padding: 3rem 1.5rem;';
            div.innerHTML = '<i class="fas fa-shield-alt" style="font-size: 3rem; color: var(--text-faint); margin-bottom: 0.9rem;"></i><h3 style="color: var(--text-secondary); margin-bottom: 0.5rem; font-size: 1.15rem;">No Isolated Brokers</h3><button class="btn primary" onclick="showAllBrokers()" style="margin-top: 1rem;"><i class="fas fa-globe"></i> Show All</button>';
            container.appendChild(div);
        } else if (existing && isolatedCount > 0) existing.remove();
    }
    function showAllBrokers() {
        document.querySelectorAll('.broker-card').forEach(c => c.style.display = 'flex');
        document.getElementById('showAllBtn').style.display = 'none';
        var msg = document.getElementById('noIsolatedMessage');
        if (msg) msg.remove();
    }
    function openNewPage() {
        var a = '<%= request.getContextPath() + "/jsp/A_EXP_SERVERWISE_COUNT_LDAP.jsp" %>';
        window.open(a, '_blank');
    }

    document.addEventListener('keydown', function(e) {
        var isRefreshKey = (e.key === 'F5') ||
                           (e.ctrlKey && (e.key === 'r' || e.key === 'R')) ||
                           (e.metaKey && (e.key === 'r' || e.key === 'R'));
        if (isRefreshKey) {
            var hasFilter = window.location.search && window.location.search.length > 1;
            if (hasFilter) { e.preventDefault(); window.location.href = window.location.pathname; return false; }
        }
        if (e.ctrlKey && e.key === 'b') { e.preventDefault(); toggleBlinking(); }
        if (e.ctrlKey && e.key === 'i') { e.preventDefault(); showIsolatedOnly(); }
        if (e.ctrlKey && e.key === 'a') { e.preventDefault(); showAllBrokers(); }
        if (e.ctrlKey && e.key === 'v') { e.preventDefault(); testVoice(); }
        if (e.ctrlKey && e.key === 'm') { e.preventDefault(); toggleMute(); }
        if (e.ctrlKey && e.key === 'd') { e.preventDefault(); toggleTheme(); }
    });

    document.addEventListener('DOMContentLoaded', function() {
        var overlay = document.getElementById('chromeVoiceOverlay');
        var enableBtn = document.getElementById('enableVoiceNowBtn');
        if (overlay) overlay.addEventListener('click', function(e) {
            if (e.target === overlay || e.target === enableBtn) hideOverlayAndInitialize();
        });
        if (enableBtn) enableBtn.addEventListener('click', hideOverlayAndInitialize);

        var blinkingPref = localStorage.getItem('blinkingEnabled');
        if (blinkingPref === 'false') {
            document.body.classList.add('no-blink');
            document.getElementById('blinkIcon').className = 'fas fa-eye-slash';
        }

        countdown('ten-countdown', 10, 0);

        var urlParams = new URLSearchParams(window.location.search);
        var fromDateTime = urlParams.get('fromDateTime');
        var toDateTime = urlParams.get('toDateTime');
        if (fromDateTime && toDateTime) {
            var diffMinutes = Math.round((new Date(toDateTime) - new Date(fromDateTime)) / (1000 * 60));
            document.querySelectorAll('.quick-filter-btn').forEach(function(btn) {
                btn.classList.remove('active');
                var minutes = parseInt(btn.getAttribute('onclick')?.match(/\d+/) || '60');
                if (Math.abs(diffMinutes - minutes) < 5) btn.classList.add('active');
            });
        }

        if (hasUserInteracted) {
            userInteracted = true;
            voiceInitialized = true;
            loadVoicePreferences();
            updateVoiceUI();
            setTimeout(playRefreshVoiceAnnouncement, 1500);
        } else {
            setTimeout(function() { if (!userInteracted) showOverlayAndInitialize(); }, 500);
        }
    });

    window.addEventListener('beforeunload', function() {
        saveVoicePreferences();
        try { speechSynthesis.cancel(); } catch(e) {}
    });
</script>

</body>
</html>
