            font-family: 'Consolas', monospace;
            white-space: pre-wrap;
            font-size: 12.5px;
        }

        .table-wrap {
            max-height: 60vh;
            overflow: auto;
            border: 1px solid #313244;
            border-radius: 10px;
            background: #1e1e2e;
        }
        .table-wrap::-webkit-scrollbar { width: 10px; height: 10px; }
        .table-wrap::-webkit-scrollbar-track { background: #181825; }
        .table-wrap::-webkit-scrollbar-thumb {
            background: #45475a; border-radius: 5px;
            border: 2px solid #181825;
        }
        .table-wrap::-webkit-scrollbar-thumb:hover { background: #585b70; }

        table {
            width: 100%; border-collapse: collapse;
            font-size: 12.5px;
        }
        th {
            background: #1a3d6d; color: #fff;
            padding: 11px 13px; text-align: left;
            position: sticky; top: 0; z-index: 2;
            font-weight: 600; white-space: nowrap;
            border-bottom: 2px solid #2b5ba0;
        }
        td {
            padding: 9px 13px;
            border-bottom: 1px solid #282838;
            color: #cdd6f4;
            max-width: 400px; overflow: hidden;
            text-overflow: ellipsis; white-space: nowrap;
        }
        tr:nth-child(even) td { background: #1a1a2a; }
        tr:hover td { background: #2a2a3e; }
        td.idx {
            color: #7f849c; font-weight: 600;
            font-size: 11.5px;
            background: #181825 !important;
            width: 50px; text-align: center;
        }
        .null-val { color: #585b70; font-style: italic; }
        .empty {
            text-align: center; padding: 50px;
            color: #7f849c; font-size: 13.5px;
            background: #1e1e2e; border-radius: 10px;
            border: 1px dashed #313244;
        }
        .welcome {
            text-align: center; padding: 70px 20px;
            color: #585b70;
        }
        .welcome h2 {
            color: #45475a; font-size: 20px;
            margin-bottom: 10px; font-weight: 600;
        }
        .welcome p { font-size: 13.5px; color: #7f849c; margin-top: 4px; }
    </style>
</head>
<body>

<!-- ============ TOP BAR ============ -->
<div class="topbar">
    <div class="brand">
        <span class="brand-icon">⚡</span>
        Query Runner
        <small>SQL Developer Style</small>
    </div>
    <div class="db-indicator">
        <span class="db-dot"></span>
        <span>Active: <b style="color:#89b4fa;"><%= dbLabel %></b></span>
    </div>
</div>

<div class="layout">

    <!-- ============ SIDEBAR (SAVED QUERIES) ============ -->
    <div class="sidebar">
        <h3>📚 Saved Queries</h3>
        <input type="text" class="search-box" id="qSearch" placeholder="🔍 Search queries...">

        <div id="queryList">

            <!-- ================= GEN 5 ================= -->
            <div class="query-group" data-group="Gen 5">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>🔴 Gen 5 — Error Summary</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>Gen 5 — Broker-wise error count (last 5 min)
                        <script type="text/plain" class="q-sql">SELECT broker_eg, broker_name, ERROR_CODE, ERROR_DESCRIPTION, url, api_name,
COUNT(*) AS CNT FROM EISAPP.API_LOG WHERE Request_date_time>=SYSDATE - INTERVAL '05' MINUTE and
(substr(error_code,3,3) in ('001','002','007','051','014','111','570','569','052','005','077','003','017','015') and error_code<>'00014' OR error_code in ('401','500'))
and ERROR_DESCRIPTION is not null and error_description not like '%No active transaction found, please do check GCC machine and retry%'
GROUP BY broker_eg,broker_name, ERROR_CODE, error_description,url,api_name
ORDER BY CNT DESC;</script>
                    </div>
                </div>
            </div>

            <!-- ================= DAILY USE ================= -->
            <div class="query-group" data-group="Daily Use">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>📅 Daily Use (Last 10 min)</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>api_log — last 10 minutes
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where
request_date_time >= sysdate - interval '10' minute
--and api_name = ''
--and url = ''
--and ERROR_CODE = ''
--and error_code is null
order by request_date_time desc;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>api_log — error summary by api
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.api_log where
request_date_time >= sysdate - interval '10' minute
and api_name = ''
GROUP by error_code, error_description;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>backend_log — last 10 minutes
                        <script type="text/plain" class="q-sql">select * from eisapp.BACKEND_log where
request_date_time >= sysdate - interval '10' minute
--and api_name = ''
--AND txn_endpoint = ''
--and END_POINT_URL = ''
--and error_code is null
order by request_date_time desc;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>backend_log — error summary by api
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.BACKEND_log where
request_date_time >= sysdate - interval '10' minute
and api_name = ''
GROUP by error_code, error_description;</script>
                    </div>
                </div>
            </div>

            <!-- ================= URN SEARCH ================= -->
            <div class="query-group" data-group="URN Search">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>🔑 URN Search (All Tables)</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where URN in ('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_details where URN in('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>orch_api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_log where URN in ('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>orch_api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_details where URN in ('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>backend_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_log where URN in ('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>backend_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_details where URN in ('');</script>
                    </div>
                </div>
            </div>

            <!-- ================= URL / MAPPERS ================= -->
            <div class="query-group" data-group="Mappers">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>🗺 URL / Mappers</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>source_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.source_mapper;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>url_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.url_mapper;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>urn_details
                        <script type="text/plain" class="q-sql">select * from EISAPP.urn_details;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>cache_details
                        <script type="text/plain" class="q-sql">SELECT * FROM EISAPP.cache_details;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>Find API by name (NOMINEE)
                        <script type="text/plain" class="q-sql">select distinct api_name from eisapp.api_log where UPPER(api_name) like '%NOMINEE%';</script>
                    </div>
                </div>
            </div>

            <!-- ================= API LOG SUMMARY ================= -->
            <div class="query-group" data-group="API Log">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>📊 API Log — TD/BD Summary</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>API-wise TD/BD (last 60 min)
                        <script type="text/plain" class="q-sql">select trim(API_NAME),
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) As "SI001",
SUM(CASE WHEN substr(error_code,3,3) ='002'then 1 else 0 end) As "002",
SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) As "SI007",
SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) As "SI051",
SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) AS "014",
SUM(CASE WHEN error_code ='SI569' then 1 else 0 end) As "SI569",
SUM(CASE WHEN error_code ='SI570' then 1 else 0 end) As "SI570",
SUM(CASE WHEN error_code ='SI052' then 1 else 0 end) As "SI052",
SUM(CASE WHEN error_code ='SI005' then 1 else 0 end) As "SI005",
SUM(CASE WHEN error_code ='SI077' then 1 else 0 end) As "SI077",
SUM(CASE WHEN error_code ='SI003' then 1 else 0 end) As "SI003",
SUM(CASE WHEN error_code ='SI017' then 1 else 0 end) As "SI017",
SUM(CASE WHEN error_code ='SI015' then 1 else 0 end) As "SI015",
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT,
SUM(CASE WHEN (nvl( substr(error_code,3,3),'A') NOT in ('001','002','007','051','014','015') OR error_code IN ('00014','70007') ) and RESPONSE_STATUS not in ('0','SUCCESS') THEN 1 ELSE 0 END) AS BD,
ROUND((SUM(CASE WHEN (nvl( substr(error_code,3,3),'A') NOT in ('001','002','007','051','014','015') OR error_code IN ('00014','70007') ) and RESPONSE_STATUS not in ('0','SUCCESS') THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS BD_PERCENT
from eisapp.api_log where
request_date_time>=SYSDATE - INTERVAL '60' minute
GROUP BY trim(API_NAME)
ORDER BY TD_PERCENT DESC;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>Backend-wise TD/BD (last 60 min)
                        <script type="text/plain" class="q-sql">select TRIM(api_name),
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN error_code is null THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) As "SI001",
SUM(CASE WHEN substr(error_code,3,3) ='002' then 1 else 0 end) As "002",
SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) As "SI007",
SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) As "SI051",
SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) AS "014",
SUM(CASE WHEN error_code ='SI569' then 1 else 0 end) As "SI569",
SUM(CASE WHEN error_code ='SI570' then 1 else 0 end) As "SI570",
SUM(CASE WHEN error_code ='SI052' then 1 else 0 end) As "SI052",
SUM(CASE WHEN error_code ='SI005' then 1 else 0 end) As "SI005",
SUM(CASE WHEN error_code ='SI077' then 1 else 0 end) As "SI077",
SUM(CASE WHEN error_code ='SI003' then 1 else 0 end) As "SI003",
SUM(CASE WHEN error_code ='SI017' then 1 else 0 end) As "SI017",
SUM(CASE WHEN error_code ='SI015' then 1 else 0 end) As "SI015",
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT,
SUM(CASE WHEN (nvl( substr(error_code,3,3),'A') NOT in ('001','002','007','051','014','015') OR error_code IN ('00014','70007') ) and error_code IS NOT NULL THEN 1 ELSE 0 END) AS BD,
ROUND((SUM(CASE WHEN (nvl( substr(error_code,3,3),'A') NOT in ('001','002','007','051','014','015') OR error_code IN ('00014','70007') ) and error_code IS NOT NULL THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS BD_PERCENT
from eisapp.BACKEND_LOG  WHERE
REQUEST_DATE_TIME>=SYSDATE - INTERVAL '60' minute
GROUP BY TRIM(api_name)
ORDER BY TD_PERCENT DESC;</script>
                    </div>
                </div>
            </div>

            <!-- ================= THIRD PARTY ================= -->
            <div class="query-group" data-group="Third Party">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>🌐 Third Party / SUP_URL</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>Third Party — TD/BD by SUP_URL (last 60 min)
                        <script type="text/plain" class="q-sql">select SUP_URL,ORIGINAL_URN,TRANSACTION_URN,source_id,
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') or error_code in('SI001','SI007','SI017','SI569','SI570','SI051','SI111')) and error_code<>'00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') or error_code in('SI001','SI007','SI017','SI569','SI570','SI051','SI111')) and error_code<>'00014' THEN 1 ELSE 0 END)*100)/COUNT(1)) AS TD_PERCENT,
SUM(CASE WHEN substr(error_code,3,3) in ('002') THEN 1 ELSE 0 END) AS "002",
SUM(CASE WHEN substr(error_code,3,3) in ('014') THEN 1 ELSE 0 END) AS "014",
SUM(CASE WHEN ERROR_CODE='SI001'  THEN 1 ELSE 0 END) AS SI001,
SUM(CASE WHEN ERROR_CODE='SI007'  THEN 1 ELSE 0 END) AS SI007,
SUM(CASE WHEN ERROR_CODE='SI017'  THEN 1 ELSE 0 END) AS SI017,
SUM(CASE WHEN ERROR_CODE='SI569'  THEN 1 ELSE 0 END) AS SI569,
SUM(CASE WHEN ERROR_CODE='SI570'  THEN 1 ELSE 0 END) AS SI570,
SUM(CASE WHEN ERROR_CODE='SI051'  THEN 1 ELSE 0 END) AS SI051,
SUM(CASE WHEN ERROR_CODE='SI111'  THEN 1 ELSE 0 END) AS SI111,
SUM(CASE WHEN ERROR_CODE ='SI052' THEN 1 ELSE 0 end) As SI052,
SUM(CASE WHEN error_code ='SI005' then 1 else 0 end) As "SI005",
SUM(CASE WHEN error_code ='SI077' then 1 else 0 end) As "SI077",
SUM(CASE WHEN error_code ='SI003' then 1 else 0 end) As "SI003",
SUM(CASE WHEN error_code ='SI017' then 1 else 0 end) As "SI017",
SUM(CASE  WHEN ((nvl( substr(error_code,3,3),'A') not in  ('002','014') and  error_code not in('SI001','SI007','SI017','SI569','SI570','SI051','SI111','SI052','SI005','SI077','SI003','SI017')) OR error_code IN ('00014','70007') ) and RESPONSE_STATUS not in ('0','SUCCESS') THEN 1 ELSE 0 END) AS BD_new,
ROUND((SUM(CASE  WHEN ((nvl( substr(error_code,3,3),'A') not in  ('002','014') and  error_code not in('SI001','SI007','SI017','SI569','SI570','SI051','SI111','SI052','SI005','SI077','SI003','SI017')) OR error_code IN ('00014','70007') ) and RESPONSE_STATUS not in ('0','SUCCESS') THEN 1 ELSE 0 END)*100)/count(1),2) AS BD_per_new
from eisapp.api_LOG where
creation_date_time>=SYSDATE - INTERVAL '60' minute
GROUP BY SUP_URL,ORIGINAL_URN,TRANSACTION_URN,source_id
HAVING (SUM(CASE WHEN (RESPONSE_STATUS  not in ('0','SUCCESS') and error_code is not null) THEN 1 ELSE 0 END)*100)/COUNT(1)=100
order by TD_PERCENT desc;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>Find particular service by URL/URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_LOG where  
URL = 'http://eispri.sbi.co.in:3017/thirdParty/wrapper/services/misc'
and SUP_URL = ''
and ORIGINAL_URN = ''
and TRANSACTION_URN = ''
and source_id = ''
and trunc(request_date_time)=trunc(sysdate)
order by creation_date_time desc;</script>
                    </div>
                </div>
            </div>

            <!-- ================= SI MONITORING ================= -->
            <div class="query-group" data-group="SI Monitoring">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>🔷 SI Monitoring (SBISI schema)</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>SI_TRANS_DB — error summary (last 10 min)
                        <script type="text/plain" class="q-sql">SELECT function_name,ERROR_CODE, ERROR_DESC, COUNT(*) AS CNT FROM SBISI.SI_TRANS_DB
WHERE SUBSTR(error_code,1,2) = 'SI'
and req_time>=SYSDATE - INTERVAL '10' MINUTE
GROUP BY ERROR_CODE,ERROR_DESC,function_name ORDER BY CNT DESC;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>EKYC_log — TD% (SI207, SI392)
                        <script type="text/plain" class="q-sql">select COUNT(1) as TOTAL_HITS,
SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN ERROR_CODE IS NOT NULL AND error_code NOT IN ('SI392','SI207') THEN 1 ELSE 0 END) "BD",
SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END) "SI392",
ROUND((SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI392%",
SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END) "SI207",
ROUND((SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI207%",
ROUND((SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END)/COUNT(1))*100,2) "TD%"
from SBISI.EKYC_log where resp_date_time >=sysdate - interval '15' minute;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>EKYC (SI392) — recent transactions
                        <script type="text/plain" class="q-sql">select *  from SBISI.ekyc_log where
 error_code = 'SI392'
and req_date_time>=SYSDATE - INTERVAL '10' MINUTE  order by req_date_time desc;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>EKYC + SI_TRANS_DB combined TD%
                        <script type="text/plain" class="q-sql">select 'ekyc' as FUNCTION_NAME, COUNT(1) as TOTAL_HITS,
SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN ERROR_CODE IS NOT NULL AND error_code NOT IN ('SI392','SI207') THEN 1 ELSE 0 END) "BD",
SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END) "SI392",
ROUND((SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI392%",
SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END) "SI207",
ROUND((SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI207%",
SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END) TD_COUNT,
ROUND((SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END)/COUNT(1))*100,2) "TD%"
from SBISI.EKYC_log where resp_date_time >=sysdate - interval '15' minute
union all
select FUNCTION_NAME ,COUNT(1) as TOTAL_HITS,
SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN ERROR_CODE IS NOT NULL AND error_code NOT IN ('SI392','SI207') THEN 1 ELSE 0 END) "BD",
SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END) "SI392",
ROUND((SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI392%",
SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END) "SI207",
ROUND((SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI207%",
SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END) TD_COUNT,
ROUND((SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END)/COUNT(1))*100,2) "TD%"
from SBISI.si_trans_db where reQ_time >=sysdate - interval '15' minute
GROUP BY FUNCTION_NAME
ORDER BY TD_COUNT DESC;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>NPCI Escalation — error_desc count
                        <script type="text/plain" class="q-sql">select count(1), nvl(error_desc,'Success')
from SBISI.EKYC_log
where resp_date_time >=sysdate - interval '10' minute
group by nvl(error_desc,'Success')
order by 1 desc;</script>
                    </div>
                </div>
            </div>

            <!-- ================= PERFORMANCE ================= -->
            <div class="query-group" data-group="Performance">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>⚡ Performance / Response Time</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>High response — EXP IP response buckets
                        <script type="text/plain" class="q-sql">SELECT exp_ip,COUNT(1),
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') or error_code in('SI001','SI007','SI017','SI569','SI570','SI051','SI111','SI015')) and error_code<>'00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') or error_code in('SI001','SI007','SI017','SI569','SI570','SI051','SI111','SI015')) and error_code
<>'00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT,
SUM(CASE WHEN  error_code in('SI001','SI002','SI014','SI007','SI017','SI569','SI570','SI051','SI111','SI015') THEN 1 ELSE 0 END) AS EIS_TD,
ROUND((SUM(CASE WHEN  error_code in('SI001','SI002','SI014','SI007','SI017','SI569','SI570','SI051','SI111','SI015') THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS EIS_TD_PER,
SUM(CASE  WHEN ((nvl( substr(error_code,3,3),'A') not in  ('002','014') and  error_code not in('SI001','SI007','SI017','SI569','SI570','SI051','SI111','SI015')) OR error_code IN ('00014','70007') ) and RESPONSE_STATUS not in ('0','SUCCESS') THEN 1 ELSE 0 END) AS BD_new,
ROUND((SUM(CASE  WHEN ((nvl( substr(error_code,3,3),'A') not in  ('002','014') and  error_code not in('SI001','SI007','SI017','SI569','SI570','SI051','SI111','SI015')) OR error_code IN ('00014','70007') ) and RESPONSE_STATUS not in ('0','SUCCESS') THEN 1 ELSE 0 END)*100)/count(1),2) AS BD_per_new,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))between 0.1 AND 0.5 then 1 else 0 end ) as "between 100ms-500ms" ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))between 0.5 AND 1 then 1 else 0 end ) as "between 500ms-1s" ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18)) between 1.001 and 5 then 1 else 0 end ) as ONE_TO_5_SEC,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC
FROM EISAPP.API_LOG WHERE broker_name = 'LOGGING_EXP' and
request_date_time>=SYSDATE-INTERVAL '02' MINUTE
group by exp_ip;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>SYS latency — backend vs orch (last 2 min)
                        <script type="text/plain" class="q-sql">SELECT b.sys_ip,COUNT(1),
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))between 0.1 AND 0.5 then 1 else 0 end ) as "between 100ms-500ms" ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))between 0.5 AND 1 then 1 else 0 end ) as "between 500ms-1s" ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18)) between 1.001 and 5 then 1 else 0 end ) as ONE_TO_5_SEC,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC
FROM  EISAPP.backend_log b , EISAPP.orch_api_log a WHERE a.urn=b.urn and b.sys_broker = 'LOGGING_SYS' and
b.creation_date_time>=SYSDATE-INTERVAL '02' MINUTE
group by b.sys_ip;</script>
                    </div>
                </div>
            </div>

            <!-- ================= EPAY ================= -->
            <div class="query-group" data-group="EPAY">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span>💳 EPAY</span>
                    <span class="arrow">▶</span>
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        <span class="q-dot"></span>EPAY send vs post summary
                        <script type="text/plain" class="q-sql">WITH CTE AS (select
SUM(CASE WHEN a.payment_status='Y' THEN 1 ELSE 0 END) AS EPAY_SEND,
MAX(A.payment_date_time) AS EPAY_LAST_SEND_DATE,
SUM(CASE WHEN b.POST_FLAG='Y' THEN 1 ELSE 0 END) AS EPAY_POST,
MAX(B.POST_DATE_TIME) AS EPAY_LAST_POST_DATE
from EPAY_txn_master a INNER JOIN EPAY_feed_master b ON a.REFERENCE_NO=b.REFERENCE_NO
WHERE
A.PAYMENT_DATE_TIME between
to_date('06-NOV-24 19:00:00','DD-MM-YY HH24:MI:SS') and to_date('06-11-24 20:00:00','DD-MM-YY HH24:MI:SS'))
SELECT CTE.EPAY_SEND, CTE.EPAY_LAST_SEND_DATE,CTE.EPAY_POST,CTE.EPAY_LAST_POST_DATE
FROM CTE;</script>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ============ MAIN ============ -->
    <div class="main-panel">

        <!-- EDITOR -->
        <div class="editor-panel">
            <form method="post" action="query.jsp" id="qForm">
                <div class="editor-wrap">
                    <textarea name="sql" id="sql" class="sql-editor"
                              spellcheck="false" autocomplete="off"
                              placeholder="-- Left sidebar se query select karo&#10;-- ya yahan type karo (Ctrl+Space for suggestions)&#10;-- Ctrl+Enter to run"><%= sql != null ? sql : "" %></textarea>
                    <div id="suggestBox" class="suggest-box"></div>
                </div>

                <div class="toolbar">
                    <select name="dbType" id="dbType" class="db-sel" onchange="switchDb()">
                        <option value="IIB"    <%= "IIB".equals(dbType)    ? "selected" : "" %>>IIB DB (eisapp)</option>
                        <option value="SI"     <%= "SI".equals(dbType)     ? "selected" : "" %>>SI DB (sbisi)</option>
                        <option value="REPORT" <%= "REPORT".equals(dbType) ? "selected" : "" %>>Report DB</option>
                    </select>
                    <button type="submit" class="btn-run">▶ Run Query</button>
                    <button type="button" class="btn-clear" onclick="clearAll()">🗑 Clear</button>
                    <div class="hint-inline">
                        <code>Ctrl+Space</code> suggest &nbsp;·&nbsp;
                        <code>Ctrl+Enter</code> run &nbsp;·&nbsp;
                        <code>Esc</code> close
                    </div>
                </div>
            </form>
        </div>

        <!-- RESULT -->
        <div class="result-panel">
            <% if (qr == null) { %>
                <div class="welcome">
                    <h2>👋 Ready to run your query</h2>
                    <p>Left sidebar se query choose karo ya khud likho, phir <b>Run Query</b> dabao.</p>
                </div>
            <% } else { %>
                <div class="result-header">
                    <div class="result-title">📊 Result</div>
                    <div class="meta-bar">
                        <span><b>DB:</b> <%= dbType %></span>
                        <% if (qr.queryType != null) { %>
                            <span><b>Type:</b> <%= qr.queryType %></span>
                        <% } %>
                        <span><b>Time:</b> <%= qr.executionTimeMs %> ms</span>
                        <span><b>Rows:</b> <%= qr.rows.size() %></span>
                        <% if (qr.updateCount >= 0) { %>
                            <span><b>Affected:</b> <%= qr.updateCount %></span>
                        <% } %>
                    </div>
                </div>

                <% if (qr.success) { %>
                    <div class="alert alert-success">✅ <%= qr.message %></div>
                <% } else { %>
                    <div class="alert alert-error">❌ <%= qr.message %></div>
                <% } %>

                <% if (qr.success && !qr.columns.isEmpty()) { %>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <% for (String col : qr.columns) { %>
                                        <th><%= col %></th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <%
                                    int i = 1;
                                    for (Map<String, Object> row : qr.rows) {
                                %>
                                    <tr>
                                        <td class="idx"><%= i++ %></td>
                                        <% for (String col : qr.columns) {
                                               Object val = row.get(col);
                                        %>
                                            <td title="<%= val == null ? "NULL" : val.toString().replace("\"","&quot;") %>">
                                                <%= val == null ? "<span class='null-val'>NULL</span>" : val.toString() %>
                                            </td>
                                        <% } %>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                <% } else if (qr.success && qr.columns.isEmpty()) { %>
                    <div class="empty">✅ Query execute ho gayi — koi row return nahi hui.</div>
                <% } %>
            <% } %>
        </div>
    </div>
</div>

<!-- ============ JS ============ -->
<script>
    var SERVER_SCHEMAS  = <%= schJson.toString() %>;
    var SERVER_TABLES   = <%= tblJson.toString() %>;
    var SERVER_KEYWORDS = <%= kwJson.toString() %>;
    var CURRENT_DB      = "<%= dbType %>";

    var editor     = document.getElementById('sql');
    var suggestBox = document.getElementById('suggestBox');
    var editorWrap = editor.parentElement;
    var activeIdx  = -1;
    var currentItems = [];
    var columnCache = {};

    /* ========== SIDEBAR: Toggle Group ========== */
    function toggleGroup(header) {
        var body = header.nextElementSibling;
        var isOpen = body.classList.contains('open');
        body.classList.toggle('open', !isOpen);
        header.classList.toggle('open', !isOpen);
    }

    /* ========== SIDEBAR: Load Query ========== */
    function loadQuery(el) {
        var sqlEl = el.querySelector('.q-sql');
        if (!sqlEl) return;
        var text = sqlEl.textContent || sqlEl.innerText;
        // Trim leading blank lines
        text = text.replace(/^\s*\n+/, '').replace(/\s+$/, '');
        editor.value = text;
        editor.focus();
        // Highlight selected
        document.querySelectorAll('.q-item').forEach(function(i){ i.classList.remove('highlight'); });
        el.classList.add('highlight');
        // Auto-scroll to editor on mobile
        if (window.innerWidth < 1000) {
            editor.scrollIntoView({behavior:'smooth', block:'start'});
        }
    }

    /* ========== SIDEBAR: Search ========== */
    document.getElementById('qSearch').addEventListener('input', function(e) {
        var q = e.target.value.toLowerCase().trim();
        var groups = document.querySelectorAll('.query-group');
        groups.forEach(function(g) {
            var items = g.querySelectorAll('.q-item');
            var anyVisible = false;
            items.forEach(function(it) {
                var text = it.textContent.toLowerCase();
                if (!q || text.indexOf(q) !== -1) {
                    it.style.display = '';
                    anyVisible = true;
                } else {
                    it.style.display = 'none';
                }
            });
            g.style.display = anyVisible || !q ? '' : 'none';
            // Auto open if searching
            if (q && anyVisible) {
                var h = g.querySelector('.group-header');
                var b = g.querySelector('.group-body');
                b.classList.add('open');
                h.classList.add('open');
            }
        });
    });

    /* ========== SUGGESTIONS ========== */
    function allSuggestions() {
        return SERVER_KEYWORDS.concat(SERVER_SCHEMAS).concat(SERVER_TABLES);
    }

    function getCaretPosition(el) {
        var div = document.createElement('div');
        var style = window.getComputedStyle(el);
        var props = ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing',
                     'paddingTop','paddingLeft','paddingRight','paddingBottom',
                     'borderTopWidth','borderLeftWidth','whiteSpace','wordWrap','wordBreak'];
        props.forEach(function(p){ div.style[p] = style[p]; });
        div.style.position = 'absolute';
        div.style.visibility = 'hidden';
        div.style.whiteSpace = 'pre-wrap';
        div.style.wordWrap = 'break-word';
        div.style.width = (el.clientWidth - parseInt(style.paddingLeft) - parseInt(style.paddingRight)) + 'px';

        var value = el.value.substring(0, el.selectionStart);
        div.textContent = value;
        var span = document.createElement('span');
        span.textContent = el.value.substring(el.selectionStart) || '.';
        div.appendChild(span);
        document.body.appendChild(div);

        var rect = span.getBoundingClientRect();
        var editorRect = el.getBoundingClientRect();
        var lineH = parseInt(style.lineHeight) || 22;
        var pos = {
            left: rect.left - editorRect.left + el.scrollLeft,
            top:  rect.top  - editorRect.top  + el.scrollTop + lineH,
            lineHeight: lineH
        };
        document.body.removeChild(div);
        return pos;
    }

    function getContext() {
        var pos = editor.selectionStart;
        var val = editor.value;
        var start = pos;
        while (start > 0 && /[A-Za-z0-9_$#]/.test(val.charAt(start - 1))) start--;
        var end = pos;
        while (end < val.length && /[A-Za-z0-9_$#]/.test(val.charAt(end))) end++;
        var word = val.substring(start, pos);

        var prefix = "";
        var dotBefore = false;
        if (start > 0 && val.charAt(start - 1) === '.') {
            dotBefore = true;
            var p = start - 2;
            while (p >= 0 && /[A-Za-z0-9_$#]/.test(val.charAt(p))) p--;
            prefix = val.substring(p + 1, start - 1);
        }
        return { word: word, start: start, end: end, dotBefore: dotBefore, prefix: prefix };
    }

    function fetchColumns(schema, table, callback) {
        var key = (schema || '').toUpperCase() + '.' + table.toUpperCase();
        if (columnCache[key]) { callback(columnCache[key]); return; }
        var url = 'query.jsp?ajax=cols&db=' + encodeURIComponent(CURRENT_DB) +
                  '&schema=' + encodeURIComponent(schema || '') +
                  '&table=' + encodeURIComponent(table);
        var xhr = new XMLHttpRequest();
        xhr.open('GET', url, true);
        xhr.onreadystatechange = function() {
            if (xhr.readyState === 4 && xhr.status === 200) {
                try {
                    var data = JSON.parse(xhr.responseText);
                    columnCache[key] = data;
                    callback(data);
                } catch(e) { callback([]); }
            }
        };
        xhr.send();
    }

    function showSuggestions(forceAll) {
        var ctx = getContext();
        var items;

        if (ctx.dotBefore) {
            var prefixUpper = ctx.prefix.toUpperCase();
            var isSchema = SERVER_SCHEMAS.some(function(s) {
                return s.label.toUpperCase() === prefixUpper;
            });
            if (isSchema) {
                items = SERVER_TABLES.filter(function(t) {
                    return t.label.toUpperCase().startsWith(prefixUpper + ".");
                }).map(function(t) {
                    var shortName = t.label.substring(t.label.indexOf('.') + 1);
                    return { label: shortName, insert: shortName, type: "TABLE" };
                });
                if (ctx.word) {
                    var w = ctx.word.toLowerCase();
                    items = items.filter(function(t){ return t.label.toLowerCase().indexOf(w) !== -1; });
                }
                renderAndPosition(items);
            } else {
                fetchColumns(null, ctx.prefix, function(cols) {
                    var w = (ctx.word || '').toLowerCase();
                    var filtered = cols;
                    if (w) filtered = cols.filter(function(c){ return c.label.toLowerCase().indexOf(w) !== -1; });
                    renderAndPosition(filtered);
                });
            }
            return;
        }

        items = allSuggestions();
        var w = (ctx.word || '').toLowerCase();
        if (!forceAll && w) {
            var starts = [], contains = [];
            items.forEach(function(it) {
                var lbl = it.label.toLowerCase();
                if (lbl.startsWith(w)) starts.push(it);
                else if (lbl.indexOf(w) !== -1) contains.push(it);
            });
            items = starts.concat(contains);
        }
        renderAndPosition(items);
    }

    function renderAndPosition(items) {
        if (!items || items.length === 0) { hideSuggestions(); return; }
        items = items.slice(0, 30);
        currentItems = items;
        activeIdx = 0;
        var html = '';
        items.forEach(function(it, i) {
            var cls = 'suggest-item' + (i === 0 ? ' active' : '');
            var t = it.type.split(':')[0];
            var tagClass = 'tag-' + t;
            var tagText = t === 'COLUMN' ? 'COL' : t;
            html += '<div class="' + cls + '" data-i="' + i + '" onclick="pickSuggestion(' + i + ')">' +
                        '<span>' + escapeHtml(it.label) + '</span>' +
                        '<span class="tag ' + tagClass + '">' + tagText + '</span>' +
                    '</div>';
        });
        suggestBox.innerHTML = html;
        suggestBox.style.display = 'block';

        var p = getCaretPosition(editor);
        var boxH = Math.min(280, items.length * 34 + 6);
        var editorH = editor.clientHeight;
        var topPos = p.top;
        if (topPos + boxH > editorH) topPos = Math.max(0, p.top - boxH - p.lineHeight);
        suggestBox.style.left = Math.max(0, Math.min(p.left, editor.clientWidth - 290)) + 'px';
        suggestBox.style.top = topPos + 'px';
    }

    function hideSuggestions() {
        suggestBox.style.display = 'none';
        currentItems = [];
        activeIdx = -1;
    }

    function escapeHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function pickSuggestion(idx) {
        if (idx < 0 || idx >= currentItems.length) return;
        var item = currentItems[idx];
        var ctx = getContext();
        var val = editor.value;
        var before = val.substring(0, ctx.start);
        var after  = val.substring(ctx.end);
        editor.value = before + item.insert + after;
        var newPos = before.length + item.insert.length;
        editor.selectionStart = editor.selectionEnd = newPos;
        hideSuggestions();
        editor.focus();
    }

    editor.addEventListener('keydown', function(e) {
        var boxVisible = suggestBox.style.display === 'block';
        if (e.key === ' ' && e.ctrlKey) { e.preventDefault(); showSuggestions(true); return; }
        if (boxVisible) {
            if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = (activeIdx + 1) % currentItems.length; updateActive(); return; }
            if (e.key === 'ArrowUp')   { e.preventDefault(); activeIdx = (activeIdx - 1 + currentItems.length) % currentItems.length; updateActive(); return; }
            if (e.key === 'Enter' || e.key === 'Tab') {
                if (activeIdx >= 0) { e.preventDefault(); pickSuggestion(activeIdx); return; }
            }
            if (e.key === 'Escape') { e.preventDefault(); hideSuggestions(); return; }
        }
        if (e.key === 'Enter' && e.ctrlKey) {
            e.preventDefault();
            document.getElementById('qForm').submit();
        }
    });

    function updateActive() {
        var items = suggestBox.querySelectorAll('.suggest-item');
        items.forEach(function(el, i) {
            if (i === activeIdx) { el.classList.add('active'); el.scrollIntoView({block:'nearest'}); }
            else { el.classList.remove('active'); }
        });
    }

    var inputTimer = null;
    editor.addEventListener('input', function() {
        clearTimeout(inputTimer);
        inputTimer = setTimeout(function() {
            var ctx = getContext();
            if (ctx.word.length >= 1 || ctx.dotBefore) showSuggestions(false);
            else hideSuggestions();
        }, 100);
    });

    document.addEventListener('click', function(e) {
        if (!editorWrap.contains(e.target)) hideSuggestions();
    });

    editor.addEventListener('scroll', function() {
        if (suggestBox.style.display === 'block') {
            var p = getCaretPosition(editor);
            suggestBox.style.top = p.top + 'px';
        }
    });

    function clearAll() {
        editor.value = '';
        editor.focus();
        hideSuggestions();
        document.querySelectorAll('.q-item').forEach(function(i){ i.classList.remove('highlight'); });
    }

    function switchDb() {
        var db = document.getElementById('dbType').value;
        var url = window.location.pathname + '?dbType=' + encodeURIComponent(db);
        window.location.href = url;
    }

    window.addEventListener('load', function() {
        editor.focus();
        editor.selectionStart = editor.selectionEnd = editor.value.length;
        // Auto-open first group for convenience
        var firstBody = document.querySelector('.group-body');
        var firstHead = document.querySelector('.group-header');
        if (firstBody && firstHead) {
            firstBody.classList.add('open');
            firstHead.classList.add('open');
        }
    });
</script>
</body>
</html>
