            --red-dim: rgba(255, 85, 119, 0.14);
            --purple: #b47cff;
            --purple-dim: rgba(180, 124, 255, 0.14);
            --cyan: #4fd1ff;
            --bg-scroll: rgba(120, 150, 210, 0.22);
            --bg-scroll-hover: rgba(120, 150, 210, 0.4);
            --modal-backdrop: rgba(0, 0, 0, 0.78);
        }

        html[data-theme="light"] {
            --bg-base: #eef2f8;
            --bg-grad-1: #e6ecf5;
            --bg-grad-2: #f3eef8;
            --bg-grad-3: #eaf0f8;
            --glass: rgba(255, 255, 255, 0.85);
            --glass-2: rgba(255, 255, 255, 0.7);
            --glass-3: rgba(0, 0, 0, 0.04);
            --glass-border: rgba(70, 100, 160, 0.15);
            --glass-border-hi: rgba(70, 100, 160, 0.35);
            --text-0: #0a1124;
            --text-1: #2e3a52;
            --text-2: #64738c;
            --text-3: #8895ab;
            --accent: #2f6ee0;
            --green: #0ea875;
            --green-dim: rgba(14, 168, 117, 0.12);
            --amber: #e08a12;
            --amber-dim: rgba(224, 138, 18, 0.12);
            --red: #e02550;
            --red-dim: rgba(224, 37, 80, 0.12);
            --purple: #8243e0;
            --purple-dim: rgba(130, 67, 224, 0.12);
            --cyan: #0e9ec8;
            --bg-scroll: rgba(70, 100, 160, 0.28);
            --bg-scroll-hover: rgba(70, 100, 160, 0.5);
            --modal-backdrop: rgba(20, 30, 50, 0.6);
        }

        html, body {
            height: 100vh;
            overflow: hidden;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--text-0);
            background: var(--bg-base);
            font-size: 14px;
            -webkit-font-smoothing: antialiased;
            transition: background 0.3s, color 0.3s;
        }

        body::before {
            content: '';
            position: fixed; inset: 0;
            background:
                radial-gradient(ellipse at 0% 0%, rgba(79, 140, 255, 0.20), transparent 45%),
                radial-gradient(ellipse at 100% 0%, rgba(180, 124, 255, 0.16), transparent 45%),
                radial-gradient(ellipse at 50% 100%, rgba(34, 230, 164, 0.10), transparent 50%),
                linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-3) 50%, var(--bg-grad-2) 100%);
            z-index: -2;
        }
        body::after {
            content: '';
            position: fixed; inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1; pointer-events: none;
        }
        html[data-theme="light"] body::after {
            background-image:
                linear-gradient(rgba(0,0,0,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,0,0,0.02) 1px, transparent 1px);
        }

        .app {
            height: 100vh;
            display: grid;
            grid-template-rows: 64px 1fr;
            overflow: hidden;
        }

        /* HEADER */
        .header {
            display: flex; align-items: center;
            padding: 0 22px; gap: 14px;
            border-bottom: 1px solid var(--glass-border);
            background: var(--glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 100; flex-shrink: 0;
        }
        .logo {
            display: flex; align-items: center; gap: 12px;
            font-size: 18px; font-weight: 800;
            letter-spacing: -0.4px; color: var(--text-0);
        }
        .logo-mark {
            width: 36px; height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4f8cff 0%, #b47cff 100%);
            display: flex; align-items: center; justify-content: center;
            font-size: 17px;
            box-shadow: 0 6px 20px rgba(79, 140, 255, 0.45), inset 0 1px 0 rgba(255,255,255,0.3);
        }
        .logo-pill {
            font-size: 10.5px; font-weight: 800;
            padding: 3px 9px;
            background: var(--green-dim);
            border: 1px solid rgba(34, 230, 164, 0.35);
            color: var(--green);
            border-radius: 6px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            display: flex; align-items: center; gap: 6px;
        }
        .pulse-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
            animation: pulse 1.5s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.35; transform: scale(0.85); }
        }
        .hdr-spacer { flex: 1; }

        .hdr-stat {
            display: flex; align-items: center; gap: 7px;
            padding: 7px 13px;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            font-size: 13px; font-weight: 700;
            color: var(--text-1);
        }
        .hdr-stat .num { color: var(--text-0); font-weight: 800; font-size: 15px; }
        .hdr-stat .num.green { color: var(--green); }
        .hdr-stat .num.amber { color: var(--amber); }
        .hdr-stat .num.red   { color: var(--red); }
        .hdr-stat .num.purple{ color: var(--purple); }
        .hdr-stat .dot { width: 8px; height: 8px; border-radius: 50%; }
        .hdr-stat .dot.g { background: var(--green); box-shadow: 0 0 6px var(--green); }
        .hdr-stat .dot.a { background: var(--amber); box-shadow: 0 0 6px var(--amber); }
        .hdr-stat .dot.r { background: var(--red); box-shadow: 0 0 6px var(--red); }
        .hdr-stat .dot.p { background: var(--purple); box-shadow: 0 0 6px var(--purple); }

        .countdown-pill {
            display: flex; align-items: center; gap: 9px;
            padding: 8px 14px;
            background: linear-gradient(135deg, rgba(79, 140, 255, 0.15), rgba(180, 124, 255, 0.12));
            border: 1px solid rgba(79, 140, 255, 0.35);
            border-radius: 10px;
            font-size: 13px; font-weight: 700;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
        }
        .countdown-pill .cd-val { color: var(--accent); font-size: 15px; font-weight: 800; letter-spacing: 0.3px; }

        .theme-toggle {
            width: 52px; height: 28px;
            border-radius: 14px;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            position: relative; cursor: pointer;
            transition: 0.25s; flex-shrink: 0;
        }
        .theme-toggle:hover { border-color: var(--accent); }
        .theme-toggle .icon {
            position: absolute; top: 50%; transform: translateY(-50%);
            font-size: 13px; transition: 0.25s; pointer-events: none;
        }
        .theme-toggle .icon.sun  { left: 6px;  opacity: 0; }
        .theme-toggle .icon.moon { right: 6px; opacity: 1; }
        html[data-theme="light"] .theme-toggle .icon.sun  { opacity: 1; }
        html[data-theme="light"] .theme-toggle .icon.moon { opacity: 0; }
        .theme-toggle .knob {
            position: absolute;
            top: 3px; left: 3px;
            width: 20px; height: 20px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f8cff, #3866dd);
            transition: 0.25s cubic-bezier(0.4,0,0.2,1);
            box-shadow: 0 2px 6px rgba(0,0,0,0.35);
        }
        html[data-theme="light"] .theme-toggle .knob {
            left: 27px;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
        }

        .btn-refresh {
            width: 40px; height: 40px;
            background: linear-gradient(135deg, #4f8cff, #3866dd);
            border: none; border-radius: 10px;
            color: #fff; font-size: 17px; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: 0.22s;
            box-shadow: 0 6px 18px rgba(79, 140, 255, 0.4);
            flex-shrink: 0;
        }
        .btn-refresh:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(79, 140, 255, 0.6);
        }
        .btn-refresh:disabled { opacity: 0.7; cursor: not-allowed; }
        .btn-refresh.spinning { animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* MAIN LAYOUT — Info | Content */
        .main-wrap {
            display: grid;
            grid-template-columns: 270px 1fr;
            gap: 12px;
            padding: 12px 16px;
            min-height: 0;
            overflow: hidden;
        }

        /* ============================================================
         * INFO PANEL
         * ============================================================ */
        .info-panel {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 10px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            display: flex; flex-direction: column;
            gap: 8px;
            overflow-y: auto;
            box-shadow: 0 4px 22px rgba(0,0,0,0.2);
        }
        .info-panel::-webkit-scrollbar { width: 5px; }
        .info-panel::-webkit-scrollbar-thumb {
            background: var(--bg-scroll);
            border-radius: 3px;
        }

        .info-top-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }
        .info-mini {
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 8px;
            padding: 6px 8px;
            display: flex; flex-direction: column; gap: 2px;
        }
        .info-mini-label {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--text-3);
        }
        .info-mini-value {
            font-size: 13px;
            font-weight: 800;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
            line-height: 1.1;
        }
        .info-mini-value.small { font-size: 11px; }

        .info-status {
            display: flex; align-items: center; gap: 7px;
            padding: 7px 10px;
            background: var(--green-dim);
            border: 1px solid rgba(34,230,164,0.3);
            border-radius: 8px;
            font-size: 11.5px;
            font-weight: 700;
            color: var(--green);
        }
        .info-status.loading {
            background: var(--amber-dim);
            border-color: rgba(255,184,77,0.3);
            color: var(--amber);
        }
        .info-status-dot {
            width: 7px; height: 7px;
            border-radius: 50%;
            background: currentColor;
            box-shadow: 0 0 8px currentColor;
            animation: pulse 1.5s ease-in-out infinite;
        }

        .info-section-title {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: var(--text-3);
            display: flex; align-items: center; gap: 6px;
            padding: 3px 0 2px;
            margin-top: 4px;
        }
        .info-section-title::before {
            content: '';
            width: 3px; height: 10px;
            background: var(--accent);
            border-radius: 2px;
            box-shadow: 0 0 8px rgba(79,140,255,0.5);
        }
        .info-section-title.red::before    { background: var(--red);    box-shadow: 0 0 8px rgba(255,85,119,0.6); }
        .info-section-title.amber::before  { background: var(--amber);  box-shadow: 0 0 8px rgba(255,184,77,0.6); }
        .info-section-title.purple::before { background: var(--purple); box-shadow: 0 0 8px rgba(180,124,255,0.6); }

        .info-section-title .count-pill {
            margin-left: auto;
            font-size: 10px;
            padding: 1px 7px;
            border-radius: 5px;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            color: var(--text-1);
            letter-spacing: 0.3px;
        }
        .info-section-title.red .count-pill    { background: var(--red-dim); color: var(--red); border-color: rgba(255,85,119,0.35); }
        .info-section-title.amber .count-pill  { background: var(--amber-dim); color: var(--amber); border-color: rgba(255,184,77,0.35); }
        .info-section-title.purple .count-pill { background: var(--purple-dim); color: var(--purple); border-color: rgba(180,124,255,0.35); }

        /* Short list */
        .short-list {
            display: flex; flex-direction: column; gap: 4px;
        }
        .short-item {
            display: grid;
            grid-template-columns: 1fr auto;
            grid-template-rows: auto auto;
            gap: 2px 6px;
            padding: 6px 9px;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 7px;
            border-left: 3px solid var(--glass-border);
            transition: 0.15s;
        }
        .short-item:hover {
            background: var(--glass-3);
            transform: translateX(2px);
        }
        .short-item.red    { border-left-color: var(--red);    background: var(--red-dim); }
        .short-item.amber  { border-left-color: var(--amber);  background: var(--amber-dim); }
        .short-item.purple { border-left-color: var(--purple); background: var(--purple-dim); }

        .short-item .ip-line {
            grid-column: 1;
            grid-row: 1;
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 12px;
            font-weight: 800;
            color: var(--text-0);
            letter-spacing: 0.2px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .short-item .api-line {
            grid-column: 1;
            grid-row: 2;
            font-size: 10px;
            color: var(--text-2);
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-family: 'JetBrains Mono', 'Consolas', monospace;
        }
        .short-item .api-line.red    { color: var(--red); }
        .short-item .api-line.amber  { color: var(--amber); }
        .short-item .api-line.purple { color: var(--purple); }

        .short-item .value-line {
            grid-column: 2;
            grid-row: 1 / span 2;
            align-self: center;
            font-size: 14px;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
            padding: 3px 9px;
            border-radius: 6px;
            white-space: nowrap;
        }
        .short-item .value-line.red    { color: var(--red);    background: var(--red-dim); }
        .short-item .value-line.amber  { color: var(--amber);  background: var(--amber-dim); }
        .short-item .value-line.purple { color: var(--purple); background: var(--purple-dim); }

        .short-empty {
            padding: 8px 10px;
            text-align: center;
            background: var(--green-dim);
            border: 1px solid rgba(34,230,164,0.25);
            border-radius: 7px;
            font-size: 11px;
            font-weight: 700;
            color: var(--green);
            letter-spacing: 0.3px;
        }

        /* ============================================================
         * CONTENT
         * ============================================================ */
        .main-content {
            display: grid;
            grid-template-rows: 100px 1fr;
            gap: 12px;
            min-height: 0;
            overflow: hidden;
            min-width: 0;
        }

        .kpis {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
            min-height: 0;
        }
        .kpi {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 13px;
            padding: 10px 14px;
            display: flex; flex-direction: column; justify-content: center;
            position: relative; overflow: hidden;
            backdrop-filter: blur(20px);
            transition: 0.22s;
        }
        .kpi:hover {
            transform: translateY(-2px);
            border-color: var(--glass-border-hi);
            box-shadow: 0 12px 32px rgba(0,0,0,0.35);
        }
        .kpi::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--accent);
            box-shadow: 0 0 16px rgba(79, 140, 255, 0.5);
        }
        .kpi.green::before { background: var(--green); box-shadow: 0 0 16px rgba(34, 230, 164, 0.6); }
        .kpi.amber::before { background: var(--amber); box-shadow: 0 0 16px rgba(255, 184, 77, 0.6); }
        .kpi.red::before   { background: var(--red); box-shadow: 0 0 16px rgba(255, 85, 119, 0.6); }

        .kpi-label {
            font-size: 11px; font-weight: 800;
            letter-spacing: 1.1px; text-transform: uppercase;
            color: var(--text-3);
            margin-bottom: 4px;
        }
        .kpi-value {
            font-size: 26px; font-weight: 800;
            color: var(--text-0);
            letter-spacing: -0.7px; line-height: 1;
            font-variant-numeric: tabular-nums;
        }
        .kpi-value.green { color: var(--green); }
        .kpi-value.amber { color: var(--amber); }
        .kpi-value.red   { color: var(--red); }
        .kpi-sub {
            font-size: 11.5px; color: var(--text-3);
            font-weight: 600; margin-top: 3px;
        }

        .panels {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            min-height: 0;
            overflow: hidden;
        }
        .panel {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            display: flex; flex-direction: column;
            overflow: hidden;
            min-height: 0;
            backdrop-filter: blur(20px);
            box-shadow: 0 4px 22px rgba(0,0,0,0.2);
        }
        .panel-head {
            padding: 11px 14px;
            border-bottom: 1px solid var(--glass-border);
            display: flex; align-items: center; gap: 10px;
            background: var(--glass-2);
            flex-shrink: 0;
        }
        .ph-icon {
            width: 32px; height: 32px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }
        .ph-icon.green  { background: var(--green-dim); color: var(--green); }
        .ph-icon.blue   { background: rgba(79, 140, 255, 0.15); color: var(--accent); }
        .ph-icon.purple { background: var(--purple-dim); color: var(--purple); }

        .ph-text { flex: 1; min-width: 0; }
        .ph-title {
            font-size: 15px; font-weight: 800;
            color: var(--text-0);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .ph-sub {
            font-size: 11px; color: var(--text-3);
            font-weight: 700;
            letter-spacing: 0.6px; text-transform: uppercase;
            margin-top: 1px;
        }
        .ph-badge {
            font-size: 11px; font-weight: 800;
            padding: 3px 9px;
            border-radius: 7px;
            background: var(--glass-2);
            color: var(--text-2);
            letter-spacing: 0.4px;
            white-space: nowrap;
            border: 1px solid var(--glass-border);
        }

        /* 2 CARDS PER ROW — simple 1fr 1fr */
        .panel-body {
            flex: 1; min-height: 0;
            overflow-y: auto; overflow-x: hidden;
            padding: 12px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            align-content: start;
        }
        .panel-body::-webkit-scrollbar { width: 8px; }
        .panel-body::-webkit-scrollbar-track { background: transparent; }
        .panel-body::-webkit-scrollbar-thumb {
            background: var(--bg-scroll);
            border-radius: 4px;
        }

        /* IP CARD */
        .ip-card {
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 12px 14px;
            display: flex; flex-direction: column; gap: 10px;
            transition: 0.22s;
            position: relative; overflow: hidden;
            min-height: 225px;
            cursor: pointer;
            min-width: 0;
        }
        .ip-card:hover {
            background: var(--glass-3);
            border-color: var(--glass-border-hi);
            transform: translateY(-3px);
            box-shadow: 0 14px 34px rgba(0,0,0,0.4);
        }
        .ip-card::after {
            content: '👁';
            position: absolute;
            top: 12px; right: 12px;
            font-size: 14px;
            opacity: 0;
            transition: opacity 0.22s;
            color: var(--text-2);
            pointer-events: none;
        }
        .ip-card:hover::after { opacity: 0.7; }

        .ip-card.td-card {
            background: var(--red-dim);
            border: 2px solid rgba(255, 85, 119, 0.55);
            animation: tdPulse 2.6s ease-in-out infinite;
        }
        .ip-card.td-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 6px;
            background: var(--red);
            box-shadow: 0 0 20px var(--red);
        }
        @keyframes tdPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 85, 119, 0.0); }
            50%      { box-shadow: 0 0 28px 3px rgba(255, 85, 119, 0.4); }
        }

        .ip-card.bd-card {
            background: var(--amber-dim);
            border: 2px solid rgba(255, 184, 77, 0.55);
            animation: bdPulse 2.6s ease-in-out infinite;
        }
        .ip-card.bd-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 6px;
            background: var(--amber);
            box-shadow: 0 0 20px var(--amber);
        }
        @keyframes bdPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 184, 77, 0.0); }
            50%      { box-shadow: 0 0 28px 3px rgba(255, 184, 77, 0.4); }
        }

        .ip-card.zero-card {
            background: linear-gradient(135deg, rgba(180, 124, 255, 0.16), rgba(90, 100, 120, 0.10));
            border: 2px solid rgba(180, 124, 255, 0.55);
            animation: zeroPulse 2.6s ease-in-out infinite;
        }
        .ip-card.zero-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 6px;
            background: var(--purple);
            box-shadow: 0 0 20px var(--purple);
        }
        @keyframes zeroPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(180, 124, 255, 0.0); }
            50%      { box-shadow: 0 0 28px 3px rgba(180, 124, 255, 0.4); }
        }

        .ip-card.healthy-card { border-color: var(--glass-border); }
        .ip-card.healthy-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; bottom: 0;
            width: 4px;
            background: var(--green);
        }

        .ip-head {
            display: flex; align-items: center; justify-content: space-between; gap: 8px;
        }
        .ip-addr {
            font-family: 'JetBrains Mono', 'SF Mono', 'Consolas', monospace;
            font-size: 16px; font-weight: 800;
            color: var(--text-0);
            letter-spacing: 0.3px;
        }
        .ip-badge {
            font-size: 11px; font-weight: 900;
            padding: 4px 11px;
            border-radius: 7px;
            letter-spacing: 1.3px;
            text-transform: uppercase;
            flex-shrink: 0;
        }
        .ip-badge.healthy-card { background: var(--green-dim); color: var(--green); border: 1px solid rgba(34,230,164,0.4); }
        .ip-badge.td-card      { background: var(--red-dim);   color: var(--red);   border: 1px solid rgba(255,85,119,0.45); }
        .ip-badge.bd-card      { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(255,184,77,0.45); }
        .ip-badge.zero-card    { background: var(--purple-dim); color: var(--purple); border: 1px solid rgba(180,124,255,0.5); }

        .ip-api {
            font-size: 12px;
            color: var(--text-2);
            font-weight: 700;
            line-height: 1.4;
            margin-top: -4px;
            word-break: break-all;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            min-height: 34px;
            font-family: 'JetBrains Mono', 'Consolas', monospace;
        }

        /* 4 BOX GRID — Fixed proper fit */
        .ip-metrics {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            width: 100%;
        }
        .ip-metric {
            background: var(--glass-3);
            border-radius: 8px;
            padding: 10px 12px;
            border: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 56px;
        }
        .ip-metric-label {
            font-size: 10.5px;
            color: var(--text-3);
            font-weight: 800;
            letter-spacing: 0.7px;
            text-transform: uppercase;
            margin-bottom: 5px;
            white-space: nowrap;
        }
        .ip-metric-value {
            font-size: 18px;
            font-weight: 800;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
            line-height: 1;
            white-space: nowrap;
        }
        .ip-metric-value.green { color: var(--green); }
        .ip-metric-value.amber { color: var(--amber); }
        .ip-metric-value.red   { color: var(--red); }
        .ip-metric-value.purple{ color: var(--purple); }

        .succ-bar {
            height: 8px;
            background: var(--glass-3);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 2px;
        }
        .succ-bar-inner {
            height: 100%;
            background: linear-gradient(90deg, var(--green), var(--cyan));
            border-radius: 4px;
            transition: width 0.4s ease;
            box-shadow: 0 0 12px rgba(34, 230, 164, 0.5);
        }
        .succ-bar-inner.warn { background: linear-gradient(90deg, var(--amber), #ff8a4d); box-shadow: 0 0 12px rgba(255,184,77,0.5); }
        .succ-bar-inner.bad  { background: linear-gradient(90deg, var(--red), #ff3d5f); box-shadow: 0 0 12px rgba(255,85,119,0.5); }
        .succ-bar-inner.zero { background: linear-gradient(90deg, var(--purple), #c4a6ff); box-shadow: 0 0 12px rgba(180,124,255,0.5); }

        .err-chips {
            display: flex; flex-wrap: wrap; gap: 5px;
            padding-top: 8px;
            border-top: 1px dashed var(--glass-border);
            min-height: 28px;
        }
        .err-chip {
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 11px; font-weight: 800;
            padding: 3px 9px;
            border-radius: 5px;
            letter-spacing: 0.3px;
            white-space: nowrap;
        }
        .err-chip.td {
            background: var(--red-dim);
            color: var(--red);
            border: 1px solid rgba(255, 85, 119, 0.45);
        }
        .err-chip.bd {
            background: var(--amber-dim);
            color: var(--amber);
            border: 1px solid rgba(255, 184, 77, 0.45);
        }
        .err-chip.ok {
            background: var(--green-dim);
            color: var(--green);
            border: 1px solid rgba(34, 230, 164, 0.3);
            font-family: inherit;
        }
        .err-chip.zero {
            background: var(--purple-dim);
            color: var(--purple);
            border: 1px solid rgba(180, 124, 255, 0.5);
            font-family: inherit;
            font-weight: 900;
            letter-spacing: 0.6px;
        }

        /* STATES */
        .state {
            grid-column: 1 / -1;
            padding: 40px 20px;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center;
            color: var(--text-2);
            min-height: 200px;
        }
        .state .ico { font-size: 44px; opacity: 0.35; margin-bottom: 12px; }
        .state .ttl { font-size: 15px; font-weight: 700; color: var(--text-1); margin-bottom: 4px; }
        .state .sub { font-size: 13px; color: var(--text-3); }

        .loader-spin {
            width: 44px; height: 44px;
            border: 4px solid rgba(79, 140, 255, 0.15);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin-bottom: 16px;
        }

        /* MODAL */
        .modal-backdrop {
            position: fixed; inset: 0;
            background: var(--modal-backdrop);
            backdrop-filter: blur(10px);
            z-index: 1000;
            display: none;
            align-items: center; justify-content: center;
            padding: 24px;
            animation: fadeIn 0.22s ease;
        }
        .modal-backdrop.active { display: flex; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .modal {
            background: var(--bg-base);
            border-radius: 20px;
            width: 100%;
            max-width: 800px;
            max-height: 88vh;
            display: flex; flex-direction: column;
            overflow: hidden;
            position: relative;
            animation: modalSlide 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 40px 100px rgba(0,0,0,0.75), 0 0 0 1px rgba(255,255,255,0.06) inset;
        }
        html[data-theme="dark"] .modal {
            background: linear-gradient(180deg, #121826 0%, #0a0e18 100%);
        }
        html[data-theme="light"] .modal {
            background: linear-gradient(180deg, #ffffff 0%, #f6f8fc 100%);
            box-shadow: 0 40px 100px rgba(20, 40, 80, 0.28), 0 0 0 1px rgba(20, 40, 80, 0.06) inset;
        }
        @keyframes modalSlide {
            from { opacity: 0; transform: translateY(30px) scale(0.94); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: var(--accent);
            box-shadow: 0 0 20px rgba(79, 140, 255, 0.6);
        }
        .modal.td::before   { background: linear-gradient(90deg, var(--red), #ff8a9e); box-shadow: 0 0 20px rgba(255,85,119,0.7); }
        .modal.bd::before   { background: linear-gradient(90deg, var(--amber), #ffd27a); box-shadow: 0 0 20px rgba(255,184,77,0.7); }
        .modal.zero::before { background: linear-gradient(90deg, var(--purple), #c4a6ff); box-shadow: 0 0 20px rgba(180,124,255,0.7); }
        .modal.healthy::before { background: linear-gradient(90deg, var(--green), var(--cyan)); box-shadow: 0 0 20px rgba(34,230,164,0.6); }

        .modal-head {
            padding: 26px 28px 20px;
            display: flex; align-items: flex-start; justify-content: space-between; gap: 18px;
            flex-shrink: 0;
            border-bottom: 1px solid var(--glass-border);
        }
        .modal-head-left {
            display: flex; align-items: center; gap: 16px;
            min-width: 0; flex: 1;
        }
        .modal-status-icon {
            width: 56px; height: 56px;
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 26px;
            flex-shrink: 0;
        }
        .modal-status-icon.td {
            background: linear-gradient(135deg, rgba(255,85,119,0.22), rgba(255,85,119,0.08));
            color: var(--red);
            border: 1.5px solid rgba(255, 85, 119, 0.4);
            box-shadow: 0 0 24px rgba(255, 85, 119, 0.25);
        }
        .modal-status-icon.bd {
            background: linear-gradient(135deg, rgba(255,184,77,0.22), rgba(255,184,77,0.08));
            color: var(--amber);
            border: 1.5px solid rgba(255, 184, 77, 0.4);
            box-shadow: 0 0 24px rgba(255, 184, 77, 0.25);
        }
        .modal-status-icon.zero {
            background: linear-gradient(135deg, rgba(180,124,255,0.22), rgba(180,124,255,0.08));
            color: var(--purple);
            border: 1.5px solid rgba(180, 124, 255, 0.4);
            box-shadow: 0 0 24px rgba(180, 124, 255, 0.3);
        }
        .modal-status-icon.healthy {
            background: linear-gradient(135deg, rgba(34,230,164,0.22), rgba(34,230,164,0.08));
            color: var(--green);
            border: 1.5px solid rgba(34, 230, 164, 0.4);
            box-shadow: 0 0 24px rgba(34, 230, 164, 0.25);
        }

        .modal-head-text { min-width: 0; flex: 1; }
        .modal-tag {
            display: inline-block;
            font-size: 11px;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 6px;
            letter-spacing: 1.3px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        .modal-tag.td { background: var(--red-dim); color: var(--red); border: 1px solid rgba(255, 85, 119, 0.4); }
        .modal-tag.bd { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(255, 184, 77, 0.4); }
        .modal-tag.zero { background: var(--purple-dim); color: var(--purple); border: 1px solid rgba(180, 124, 255, 0.4); }
        .modal-tag.healthy { background: var(--green-dim); color: var(--green); border: 1px solid rgba(34, 230, 164, 0.4); }

        .modal-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-0);
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            letter-spacing: 0.2px;
            margin-bottom: 4px;
        }
        .modal-subtitle {
            font-size: 14px;
            color: var(--text-2);
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .modal-close {
            width: 40px; height: 40px;
            border-radius: 10px;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            color: var(--text-1);
            font-size: 22px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: 0.2s;
            flex-shrink: 0;
            line-height: 1;
            font-family: inherit;
            font-weight: 400;
        }
        .modal-close:hover {
            background: var(--red-dim);
            color: var(--red);
            border-color: rgba(255,85,119,0.4);
            transform: rotate(90deg) scale(1.05);
        }

        .modal-body {
            padding: 24px 28px 28px;
            overflow-y: auto;
            flex: 1;
        }
        .modal-body::-webkit-scrollbar { width: 8px; }
        .modal-body::-webkit-scrollbar-thumb {
            background: var(--bg-scroll);
            border-radius: 4px;
        }

        .health-banner {
            padding: 16px 20px;
            border-radius: 14px;
            display: flex; align-items: center; gap: 16px;
            margin-bottom: 24px;
        }
        .health-banner.healthy {
            background: linear-gradient(135deg, rgba(34,230,164,0.15), rgba(34,230,164,0.05));
            border: 1px solid rgba(34, 230, 164, 0.35);
        }
        .health-banner.td {
            background: linear-gradient(135deg, rgba(255,85,119,0.15), rgba(255,85,119,0.05));
            border: 1px solid rgba(255, 85, 119, 0.4);
        }
        .health-banner.bd {
            background: linear-gradient(135deg, rgba(255,184,77,0.15), rgba(255,184,77,0.05));
            border: 1px solid rgba(255, 184, 77, 0.4);
        }
        .health-banner.zero {
            background: linear-gradient(135deg, rgba(180,124,255,0.15), rgba(180,124,255,0.05));
            border: 1px solid rgba(180, 124, 255, 0.4);
        }
        .health-banner .hb-icon {
            width: 44px; height: 44px;
            border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }
        .health-banner.healthy .hb-icon { background: rgba(34,230,164,0.2); color: var(--green); }
        .health-banner.td .hb-icon { background: rgba(255,85,119,0.2); color: var(--red); }
        .health-banner.bd .hb-icon { background: rgba(255,184,77,0.2); color: var(--amber); }
        .health-banner.zero .hb-icon { background: rgba(180,124,255,0.2); color: var(--purple); }

        .health-banner .hb-text { flex: 1; min-width: 0; }
        .health-banner .hb-title {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: -0.1px;
            margin-bottom: 3px;
        }
        .health-banner.healthy .hb-title { color: var(--green); }
        .health-banner.td .hb-title { color: var(--red); }
        .health-banner.bd .hb-title { color: var(--amber); }
        .health-banner.zero .hb-title { color: var(--purple); }
        .health-banner .hb-sub {
            font-size: 13.5px;
            color: var(--text-2);
            font-weight: 500;
        }

        .modal-section { margin-bottom: 24px; }
        .modal-section:last-child { margin-bottom: 0; }
        .modal-section-title {
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            color: var(--text-3);
            margin-bottom: 14px;
            display: flex; align-items: center; gap: 9px;
        }
        .modal-section-title::before {
            content: '';
            width: 3px; height: 13px;
            background: var(--accent);
            border-radius: 2px;
            box-shadow: 0 0 10px rgba(79,140,255,0.5);
        }

        .tiles-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }
        .tile {
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 14px 16px;
            display: flex; flex-direction: column; gap: 6px;
            position: relative; overflow: hidden;
        }
        .tile::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: var(--accent);
        }
        .tile.green::before { background: var(--green); }
        .tile.amber::before { background: var(--amber); }
        .tile.red::before   { background: var(--red); }
        .tile.purple::before{ background: var(--purple); }

        .tile-label {
            font-size: 11px;
            color: var(--text-3);
            font-weight: 800;
            letter-spacing: 0.9px;
            text-transform: uppercase;
        }
        .tile-value {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
            line-height: 1;
            letter-spacing: -0.5px;
        }
        .tile-value.green { color: var(--green); }
        .tile-value.amber { color: var(--amber); }
        .tile-value.red   { color: var(--red); }
        .tile-value.purple{ color: var(--purple); }

        .modal-progress {
            height: 10px;
            background: var(--glass-3);
            border-radius: 5px;
            overflow: hidden;
            margin-top: 14px;
        }
        .modal-progress-inner {
            height: 100%;
            border-radius: 5px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            background: linear-gradient(90deg, var(--green), var(--cyan));
            box-shadow: 0 0 14px rgba(34,230,164,0.6);
        }
        .modal-progress-inner.warn { background: linear-gradient(90deg, var(--amber), #ff8a4d); }
        .modal-progress-inner.bad  { background: linear-gradient(90deg, var(--red), #ff3d5f); }
        .modal-progress-inner.zero { background: linear-gradient(90deg, var(--purple), #c4a6ff); }

        .err-list {
            display: flex; flex-direction: column; gap: 10px;
        }
        .err-row {
            display: grid;
            grid-template-columns: 130px 1fr 90px;
            gap: 14px;
            align-items: center;
            padding: 13px 16px;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 11px;
            transition: 0.15s;
        }
        .err-row:hover {
            background: var(--glass-3);
            border-color: var(--glass-border-hi);
            transform: translateX(2px);
        }
        .err-code {
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 13px;
            font-weight: 800;
            padding: 6px 10px;
            border-radius: 7px;
            text-align: center;
            letter-spacing: 0.5px;
        }
        .err-code.td { background: var(--red-dim); color: var(--red); border: 1px solid rgba(255,85,119,0.4); }
        .err-code.bd { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(255,184,77,0.4); }
        .err-bar {
            height: 26px;
            background: var(--glass-3);
            border-radius: 7px;
            overflow: hidden;
        }
        .err-bar-fill {
            height: 100%;
            border-radius: 7px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            padding-left: 10px;
            font-size: 12px;
            font-weight: 800;
            color: #fff;
            text-shadow: 0 1px 3px rgba(0,0,0,0.5);
        }
        .err-bar-fill.td { background: linear-gradient(90deg, var(--red), #ff3d5f); box-shadow: 0 0 14px rgba(255,85,119,0.6); }
        .err-bar-fill.bd { background: linear-gradient(90deg, var(--amber), #ff8a4d); box-shadow: 0 0 14px rgba(255,184,77,0.6); }
        .err-count {
            text-align: right;
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 17px;
            font-weight: 800;
            color: var(--text-0);
            font-variant-numeric: tabular-nums;
        }
        .err-count small {
            display: block;
            font-size: 11px;
            color: var(--text-3);
            font-weight: 700;
            margin-top: 2px;
        }

        .err-empty {
            padding: 32px 24px;
            text-align: center;
            background: linear-gradient(135deg, rgba(34,230,164,0.12), rgba(34,230,164,0.03));
            border: 1px solid rgba(34, 230, 164, 0.35);
            border-radius: 14px;
            color: var(--green);
            font-size: 15px;
            font-weight: 700;
        }
        .err-empty.zero {
            background: linear-gradient(135deg, rgba(180,124,255,0.12), rgba(180,124,255,0.03));
            border: 1px solid rgba(180, 124, 255, 0.4);
            color: var(--purple);
        }
        .err-empty .big-ic {
            font-size: 44px;
            display: block;
            margin-bottom: 8px;
            filter: drop-shadow(0 0 12px rgba(34,230,164,0.6));
        }
        .err-empty.zero .big-ic {
            filter: drop-shadow(0 0 12px rgba(180,124,255,0.6));
        }
        .err-empty .sub {
            color: var(--text-2);
            font-size: 13px;
            font-weight: 500;
            margin-top: 6px;
        }

        .raw-table {
            display: flex; flex-direction: column;
            background: var(--glass-2);
            border: 1px solid var(--glass-border);
            border-radius: 11px;
            overflow: hidden;
        }
        .raw-row {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 16px;
            align-items: center;
            padding: 12px 16px;
            border-bottom: 1px solid var(--glass-border);
            transition: background 0.15s;
        }
        .raw-row:last-child { border-bottom: none; }
        .raw-row:hover { background: var(--glass-3); }
        .raw-row .key {
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-2);
            letter-spacing: 0.3px;
        }
        .raw-row .val {
            font-family: 'JetBrains Mono', 'Consolas', monospace;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-0);
            text-align: right;
            word-break: break-word;
        }
        .raw-row .val.red   { color: var(--red); }
        .raw-row .val.amber { color: var(--amber); }
        .raw-row .val.green { color: var(--green); }
        .raw-row .val.purple{ color: var(--purple); }

        /* TOAST */
        .toast {
            position: fixed;
            bottom: 24px; right: 24px;
            padding: 13px 22px;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-left: 4px solid var(--green);
            border-radius: 10px;
            color: var(--text-0);
            font-size: 14px;
            font-weight: 700;
            backdrop-filter: blur(20px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.5);
            z-index: 9999;
            animation: slideIn 0.25s ease;
        }
        .toast.err { border-left-color: var(--red); }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* RESPONSIVE */
        @media (max-width: 1500px) {
            .kpis { grid-template-columns: repeat(3, 1fr); }
            .main-content { grid-template-rows: 200px 1fr; }
            .panel-body { grid-template-columns: 1fr; }
        }
        @media (max-width: 1300px) {
            .main-wrap { grid-template-columns: 240px 1fr; }
            .panel-body { grid-template-columns: 1fr; }
        }
        @media (max-width: 1100px) {
            .main-wrap { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
            .info-panel { max-height: 320px; }
            .panels { grid-template-columns: 1fr; }
            .main-content { grid-template-rows: auto 1fr; overflow-y: auto; }
            .tiles-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 700px) {
            .kpis { grid-template-columns: repeat(2, 1fr); }
            .main-wrap { padding: 8px; }
            .header { padding: 0 10px; }
            .panel-body { grid-template-columns: 1fr; }
            .modal-backdrop { padding: 8px; }
            .modal { max-height: 95vh; border-radius: 16px; }
            .modal-head { padding: 20px 20px 16px; }
            .modal-body { padding: 18px 20px 22px; }
            .tiles-grid { grid-template-columns: 1fr 1fr; }
            .err-row { grid-template-columns: 100px 1fr 70px; gap: 10px; padding: 10px; }
            .modal-title { font-size: 20px; }
        }
    </style>
</head>
<body>

<div class="app">

    <div class="header">
        <div class="logo">
            <div class="logo-mark">&#128200;</div>
