WITH gen5_base AS (
    SELECT 
        ip, 
        type, 
        route_url, 
        lb_url AS gen5_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen5_op
    FROM daily_dpg_url_data
    WHERE (UPPER(lb_url) LIKE 'GEN5/GATEWAY%'
        OR UPPER(lb_url) LIKE 'GEN5%GATEWAY%'
        OR UPPER(lb_url) LIKE '%GEN5/GETWAY%')
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_base AS (
    SELECT 
        ip, 
        type, 
        route_url,
        lb_url AS gen6_lb_url,
        REGEXP_SUBSTR(lb_url, '[^/]+$') AS gen6_op
    FROM daily_dpg_url_data
    WHERE UPPER(lb_url) NOT LIKE '%GEN5%'
      AND UPPER(lb_url) NOT LIKE '%SIAPP3%'
),
gen6_priority AS (
    SELECT 
        g6.ip, 
        g6.type, 
        g6.route_url,
        g6.gen6_lb_url,
        g6.gen6_op,
        ROW_NUMBER() OVER (
            PARTITION BY g6.ip, g6.type, g6.route_url
            ORDER BY 
                CASE 
                    WHEN g6.gen6_op = g5.gen5_op THEN 1
                    ELSE 2
                END,
                g6.gen6_lb_url
        ) rn
    FROM gen6_base g6
    JOIN gen5_base g5
      ON g5.ip = g6.ip
     AND g5.type = g6.type
     AND g5.route_url = g6.route_url
)
SELECT 
    g5.ip, 
    g5.type, 
    g5.gen5_lb_url,
    g6.gen6_lb_url,
    g5.route_url,
    SYSDATE
FROM gen5_base g5
LEFT JOIN gen6_priority g6
  ON g5.ip = g6.ip
 AND g5.type = g6.type
 AND g5.route_url = g6.route_url
 AND g6.rn = 1;
