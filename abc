                    </div>
                    <div class="panel-body" id="apiNBody">
                        <div class="state"><div class="loader-spin"></div><div class="ttl">Loading NSE/INB data...</div></div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-head">
                        <div class="ph-icon purple">&#128226;</div>
                        <div class="ph-text">
                            <div class="ph-title">API LOG · BSE</div>
                            <div class="ph-sub">BSE IPO_ORDER</div>
                        </div>
