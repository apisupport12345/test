</div>

<!-- MODAL -->
<div class="modal-backdrop" id="modalBackdrop" onclick="closeModalFromBackdrop(event)">
    <div class="modal" id="modalBox" onclick="event.stopPropagation()">
        <div class="modal-head">
            <div class="modal-head-left">
                <div class="modal-status-icon" id="modalIcon">&#128225;</div>
                <div class="modal-head-text">
                    <span class="modal-tag" id="modalTag">—</span>
                    <div class="modal-title" id="modalTitle">—</div>
                    <div class="modal-subtitle" id="modalSubtitle">—</div>
                </div>
            </div>
            <button class="modal-close" onclick="closeModal()" title="Close (Esc)">&#215;</button>
        </div>
        <div class="modal-body" id="modalBody"></div>
    </div>
</div>

<script>
/* ============================================================
 * IPO MONITORING DASHBOARD — v12.2
 * ============================================================ */

var REFRESH_INTERVAL_SEC = 300;
var secondsLeft = 0;
var countdownTimer = null;
var isRefreshing = false;
var refreshCount = 0;
var __panelRows = {};

(function initTheme() {
    try {
        var saved = localStorage.getItem('ipo_theme');
        if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
        }
    } catch(e) {}
})();

function toggleTheme() {
    var current = document.documentElement.getAttribute('data-theme') || 'dark';
    var next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('ipo_theme', next); } catch(e) {}
    toast('Switched to ' + next + ' mode');
}

/* ============ COUNTDOWN ============ */
function startCountdown() {
    if (countdownTimer) clearInterval(countdownTimer);
    secondsLeft = REFRESH_INTERVAL_SEC;
    renderCountdown();
    countdownTimer = setInterval(function() {
        secondsLeft--;
        if (secondsLeft <= 0) { secondsLeft = REFRESH_INTERVAL_SEC; refreshNow(); }
        renderCountdown();
    }, 1000);
}
function stopCountdown() { if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; } }
function renderCountdown() {
    var el = document.getElementById('cdVal');
    if (!el) return;
    if (isRefreshing) { el.textContent = '...'; el.style.color = 'var(--amber)'; return; }
    el.style.color = '';
    var m = Math.floor(secondsLeft / 60);
    var s = secondsLeft % 60;
    el.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
}

/* ============ INFO PANEL ============ */
function setInfoStatus(text, isLoading) {
    var statusEl = document.getElementById('infoStatus');
    document.getElementById('infoStatusText').textContent = text;
    statusEl.classList.toggle('loading', !!isLoading);
}

function renderShortList(containerId, countId, items, type) {
    var container = document.getElementById(containerId);
    var countEl = document.getElementById(countId);
    countEl.textContent = items.length;
    if (items.length === 0) {
        container.innerHTML = '<div class="short-empty">&#10003; None</div>';
        return;
    }
    var html = '';
    items.slice(0, 20).forEach(function(it) {
        // FULL service name — no trimming
        var serviceName = it.api || '—';
        var cls = type;
        var valueText = '';
        if (type === 'td') valueText = it.tdPct.toFixed(1) + '%';
        else if (type === 'bd') valueText = it.bdPct.toFixed(1) + '%';
        else valueText = '0';

        html += '<div class="short-item ' + cls + '" title="' + escapeHtml(it.ip) + ' · ' + escapeHtml(serviceName) + '">';
        html +=   '<div class="ip-line">' + escapeHtml(it.ip) + '</div>';
        html +=   '<div class="api-line ' + cls + '" title="' + escapeHtml(serviceName) + '">' + escapeHtml(serviceName) + '</div>';
        html +=   '<div class="value-line ' + cls + '">' + valueText + '</div>';
        html += '</div>';
    });
    container.innerHTML = html;
}

function updateInfoPanel(allRows, elapsed) {
    var tdItems = [];
    var bdItems = [];
    var zeroItems = [];
    for (var key in allRows) {
        allRows[key].forEach(function(r) {
            if (r.category === 'td-card') tdItems.push(r);
            else if (r.category === 'bd-card') bdItems.push(r);
            else if (r.category === 'zero-card') zeroItems.push(r);
        });
    }
    tdItems.sort(function(a, b) { return b.tdPct - a.tdPct; });
    bdItems.sort(function(a, b) { return b.bdPct - a.bdPct; });
    zeroItems.sort(function(a, b) { return String(a.ip).localeCompare(String(b.ip)); });

    renderShortList('tdList', 'tdListCount', tdItems, 'td');
    renderShortList('bdList', 'bdListCount', bdItems, 'bd');
    renderShortList('zeroList', 'zeroListCount', zeroItems, 'purple');

    var now = new Date();
    var hh = String(now.getHours()).padStart(2,'0');
    var mm = String(now.getMinutes()).padStart(2,'0');
    var ss = String(now.getSeconds()).padStart(2,'0');
    document.getElementById('infoLastRefresh').textContent = hh + ':' + mm + ':' + ss;

    refreshCount++;
    document.getElementById('infoRefreshCount').textContent = refreshCount;
}

/* ============ REFRESH ============ */
function refreshNow() {
    if (isRefreshing) return;
    isRefreshing = true;
    stopCountdown();
    renderCountdown();
    setInfoStatus('Refreshing...', true);

    var btn = document.getElementById('refreshBtn');
    btn.classList.add('spinning');
    btn.disabled = true;

    showState('apiNBody', 'Loading NSE/INB data...');
    showState('apiBBody', 'Loading BSE data...');
    showState('backendBody', 'Loading backend data...');

    var t0 = Date.now();
    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'ipo-monitor.jsp?ajax=fetch&_=' + Date.now(), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        btn.classList.remove('spinning');
        btn.disabled = false;
        isRefreshing = false;
        var elapsed = Date.now() - t0;

        if (xhr.status !== 200) {
            toast('HTTP ' + xhr.status + ' — refresh failed', true);
            setInfoStatus('Error ' + xhr.status, false);
            startCountdown();
            renderCountdown();
            return;
        }
        try {
            var data = JSON.parse(xhr.responseText);
            renderAll(data, elapsed);
            toast('Data refreshed');
            setInfoStatus('Live · Active', false);
        } catch(e) {
            toast('Parse error', true);
            setInfoStatus('Parse error', false);
            console.error(e);
        }
        startCountdown();
        renderCountdown();
    };
    xhr.send();
}

function showState(id, text) {
    var el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = '<div class="state"><div class="loader-spin"></div><div class="ttl">' + escapeHtml(text) + '</div></div>';
}

/* ============ RENDER ALL ============ */
function renderAll(data, elapsed) {
    var s1 = renderPanel(data.API_NSE_INB, 'apiNBody', 'apiNBadge');
    var s2 = renderPanel(data.API_BSE, 'apiBBody', 'apiBBadge');
    var s3 = renderPanel(data.BACKEND_LOG, 'backendBody', 'backendBadge');

    updateKpis(data);

    var totals = {
        healthy: s1.healthy + s2.healthy + s3.healthy,
        td: s1.td + s2.td + s3.td,
        bd: s1.bd + s2.bd + s3.bd,
        zero: s1.zero + s2.zero + s3.zero
    };

    document.getElementById('hdrHealthy').textContent = totals.healthy;
    document.getElementById('hdrWarn').textContent = totals.bd;
    document.getElementById('hdrCrit').textContent = totals.td;
    document.getElementById('hdrZero').textContent = totals.zero;

    var totalCombos = totals.healthy + totals.td + totals.bd + totals.zero;
    document.getElementById('infoTotalCombos').textContent = totalCombos;

    updateInfoPanel(__panelRows, elapsed);
}

/* ============ PANEL RENDER ============ */
function renderPanel(qr, bodyId, badgeId) {
    var body = document.getElementById(bodyId);
    var badge = document.getElementById(badgeId);
    var stats = { healthy: 0, td: 0, bd: 0, zero: 0 };

    if (!qr || !qr.success) {
        body.innerHTML = '<div class="state"><div class="ico">&#9888;</div><div class="ttl">Could not load</div></div>';
        badge.textContent = 'ERROR';
        return stats;
    }

    badge.textContent = qr.rows.length + ' combos';

    if (!qr.rows || qr.rows.length === 0) {
        body.innerHTML = '<div class="state"><div class="ico">&#128269;</div><div class="ttl">No data</div></div>';
        return stats;
    }

    var cols = qr.columns;
    var ipCol   = findCol(cols, ['SYS_IP', 'EXP_IP', 'IP']);
    var apiCol  = findCol(cols, ['API_NAME']);
    var hitsCol = findCol(cols, ['TOTAL_HITS', 'HITS']);
    var succCol = findCol(cols, ['SUCCESS']);
    var tdCol   = findCol(cols, ['TD']);
    var tdpCol  = findCol(cols, ['TD_PERCENT']);
    var bdCol   = findCol(cols, ['BD']);
    var bdpCol  = findCol(cols, ['BD_PERCENT']);

    var errCols = [];
    cols.forEach(function(c) {
        if (c === ipCol || c === apiCol || c === hitsCol || c === succCol ||
            c === tdCol || c === tdpCol || c === bdCol || c === bdpCol) return;
        errCols.push(c);
    });

    var rows = qr.rows.map(function(row) {
        var ip    = row[ipCol] || '-';
        var api   = row[apiCol] || '';
        var hits  = parseInt(row[hitsCol] || 0);
        var succ  = parseInt(row[succCol] || 0);
        var td    = parseInt(row[tdCol] || 0);
        var tdPct = parseFloat(row[tdpCol] || 0);
        var bd    = parseInt(row[bdCol] || 0);
        var bdPct = parseFloat(row[bdpCol] || 0);

        var category;
        if (hits === 0) category = 'zero-card';
        else if (td > 0 || tdPct > 0) category = 'td-card';
        else if (bd > 0 || bdPct > 0) category = 'bd-card';
        else category = 'healthy-card';

        var errChips = [];
        errCols.forEach(function(c) {
            var v = parseInt(row[c] || 0);
            if (v > 0) {
                var chipCls = category === 'bd-card' ? 'bd' : 'td';
                errChips.push('<span class="err-chip ' + chipCls + '">' + escapeHtml(c) + ' · ' + v + '</span>');
            }
        });

        return {
            ip: ip, api: api, hits: hits, succ: succ,
            td: td, tdPct: tdPct, bd: bd, bdPct: bdPct,
            category: category, errChips: errChips,
            allData: row
        };
    });

    rows.sort(function(a, b) {
        var priority = { 'zero-card': 0, 'td-card': 1, 'bd-card': 2, 'healthy-card': 3 };
        var pa = priority[a.category], pb = priority[b.category];
        if (pa !== pb) return pa - pb;
        var apiCmp = String(a.api).localeCompare(String(b.api));
        if (apiCmp !== 0) return apiCmp;
        return String(a.ip).localeCompare(String(b.ip));
    });

    var panelKey = bodyId.replace('Body', '');
    __panelRows[panelKey] = rows;

    var html = '';
    rows.forEach(function(r, idx) {
        if (r.category === 'td-card') stats.td++;
        else if (r.category === 'bd-card') stats.bd++;
        else if (r.category === 'zero-card') stats.zero++;
        else stats.healthy++;

        var succPct = r.hits > 0 ? (r.succ * 100 / r.hits) : 0;
        var succCls = r.hits === 0 ? 'purple' : succPct >= 99 ? 'green' : succPct >= 95 ? 'amber' : 'red';
        var barCls  = r.hits === 0 ? 'zero' : succPct >= 99 ? '' : succPct >= 95 ? 'warn' : 'bad';
        var barWidth = r.hits === 0 ? 100 : Math.min(100, Math.max(2, succPct));

        var tdColorCls = r.tdPct > 0 ? 'red' : 'green';
        var bdColorCls = r.bdPct > 0 ? 'amber' : 'green';

        var badgeText = r.category === 'zero-card' ? 'ZERO' :
                        r.category === 'td-card' ? 'TD' :
                        r.category === 'bd-card' ? 'BD' : 'OK';

        var apiDisplay = r.api || '—';

        html += '<div class="ip-card ' + r.category + '" onclick="openIpModal(\'' + panelKey + '\',' + idx + ')">';

        html +=   '<div class="ip-head">';
        html +=     '<div class="ip-addr">' + escapeHtml(r.ip) + '</div>';
        html +=     '<div class="ip-badge ' + r.category + '">' + badgeText + '</div>';
        html +=   '</div>';

        html += '<div class="ip-api" title="' + escapeHtml(r.api) + '">' + escapeHtml(apiDisplay) + '</div>';

        html +=   '<div class="ip-metrics">';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">Hits</div><div class="ip-metric-value ' + (r.hits === 0 ? 'purple' : '') + '">' + r.hits + '</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">Success</div><div class="ip-metric-value ' + succCls + '">' + r.succ + '</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">TD%</div><div class="ip-metric-value ' + tdColorCls + '">' + r.tdPct.toFixed(2) + '%</div></div>';
        html +=     '<div class="ip-metric"><div class="ip-metric-label">BD%</div><div class="ip-metric-value ' + bdColorCls + '">' + r.bdPct.toFixed(2) + '%</div></div>';
        html +=   '</div>';

        html +=   '<div class="succ-bar"><div class="succ-bar-inner ' + barCls + '" style="width:' + barWidth.toFixed(1) + '%"></div></div>';

        html +=   '<div class="err-chips">';
        if (r.hits === 0) {
            html += '<span class="err-chip zero">&#9888; ZERO HITS</span>';
        } else if (r.errChips.length > 0) {
            html += r.errChips.join('');
        } else {
            html += '<span class="err-chip ok">&#10003; No errors</span>';
        }
        html +=   '</div>';

        html += '</div>';
    });

    body.innerHTML = html;
    return stats;
}

function findCol(cols, names) {
    for (var i = 0; i < names.length; i++) {
        var n = names[i].toUpperCase();
        for (var j = 0; j < cols.length; j++) {
            if (cols[j].toUpperCase() === n) return cols[j];
        }
    }
    return null;
}

/* ============ MODAL ============ */
function openIpModal(panelKey, idx) {
    var rows = __panelRows[panelKey];
    if (!rows || !rows[idx]) return;
    var r = rows[idx];
    var row = r.allData;

    var panelInfo = {
        'apiN':    { title: 'API LOG · NSE/INB', sub: 'Routing Services' },
        'apiB':    { title: 'API LOG · BSE',     sub: 'BSE IPO_ORDER' },
        'backend': { title: 'BACKEND LOG',       sub: 'IPO Auth' }
    };
    var pInfo = panelInfo[panelKey] || { title: 'IP Detail', sub: '' };

    var catShort = r.category === 'zero-card' ? 'zero' :
                   r.category === 'td-card' ? 'td' :
                   r.category === 'bd-card' ? 'bd' : 'healthy';

    var modalBox = document.getElementById('modalBox');
    modalBox.className = 'modal ' + catShort;

    var iconEl = document.getElementById('modalIcon');
    iconEl.className = 'modal-status-icon ' + catShort;
    iconEl.innerHTML = catShort === 'healthy' ? '&#10003;' : catShort === 'zero' ? '&#9940;' : '&#9888;';

    var tagEl = document.getElementById('modalTag');
    tagEl.className = 'modal-tag ' + catShort;
    tagEl.textContent = catShort === 'td' ? 'TECHNICAL DECLINE' :
                        catShort === 'bd' ? 'BUSINESS DECLINE' :
                        catShort === 'zero' ? 'ZERO HITS' : 'HEALTHY';

    document.getElementById('modalTitle').textContent = r.ip;
    document.getElementById('modalSubtitle').textContent = pInfo.title + ' · ' + (r.api || 'Unknown API');

    var succPct = r.hits > 0 ? (r.succ * 100 / r.hits) : 0;
    var barCls = r.hits === 0 ? 'zero' : succPct >= 99 ? '' : succPct >= 95 ? 'warn' : 'bad';

    var html = '';

    var bannerTitle = catShort === 'td' ? 'Critical — Technical Decline Detected' :
                      catShort === 'bd' ? 'Warning — Business Decline Detected' :
                      catShort === 'zero' ? 'Zero Hits Detected' :
                      'All Good — No Errors';
    var bannerSub = catShort === 'td' ? 'This IP/Service is experiencing TD errors.' :
                    catShort === 'bd' ? 'This IP/Service is experiencing BD errors.' :
                    catShort === 'zero' ? 'No traffic received for this service on this server.' :
                    'This IP/Service is operating normally.';

    html += '<div class="health-banner ' + catShort + '">';
    html +=   '<div class="hb-icon">' + (catShort === 'healthy' ? '&#9989;' : catShort === 'zero' ? '&#9940;' : '&#9888;') + '</div>';
    html +=   '<div class="hb-text">';
    html +=     '<div class="hb-title">' + bannerTitle + '</div>';
    html +=     '<div class="hb-sub">' + bannerSub + '</div>';
    html +=   '</div>';
    html += '</div>';

    html += '<div class="modal-section">';
    html +=   '<div class="modal-section-title">Performance Metrics</div>';
    html +=   '<div class="tiles-grid">';

    var succCls2 = r.hits === 0 ? 'purple' : succPct >= 99 ? 'green' : succPct >= 95 ? 'amber' : 'red';
    var tdCls = r.td > 0 ? 'red' : 'green';
    var bdCls = r.bd > 0 ? 'amber' : 'green';
    var tdPctCls = r.tdPct > 0 ? 'red' : 'green';
    var bdPctCls = r.bdPct > 0 ? 'amber' : 'green';
    var hitsCls = r.hits === 0 ? 'purple' : 'green';

    html += '<div class="tile ' + hitsCls + '"><div class="tile-label">Total Hits</div><div class="tile-value ' + hitsCls + '">' + r.hits + '</div></div>';
    html += '<div class="tile ' + succCls2 + '"><div class="tile-label">Success</div><div class="tile-value ' + succCls2 + '">' + r.succ + '</div></div>';
    html += '<div class="tile ' + succCls2 + '"><div class="tile-label">Success %</div><div class="tile-value ' + succCls2 + '">' + succPct.toFixed(2) + '%</div></div>';
    html += '<div class="tile ' + (r.td > 0 ? 'red' : 'green') + '"><div class="tile-label">TD Count</div><div class="tile-value ' + tdCls + '">' + r.td + '</div></div>';
    html += '<div class="tile ' + (r.tdPct > 0 ? 'red' : 'green') + '"><div class="tile-label">TD %</div><div class="tile-value ' + tdPctCls + '">' + r.tdPct.toFixed(2) + '%</div></div>';
    html += '<div class="tile ' + (r.bd > 0 ? 'amber' : 'green') + '"><div class="tile-label">BD Count</div><div class="tile-value ' + bdCls + '">' + r.bd + '</div></div>';
    html += '<div class="tile ' + (r.bdPct > 0 ? 'amber' : 'green') + '"><div class="tile-label">BD %</div><div class="tile-value ' + bdPctCls + '">' + r.bdPct.toFixed(2) + '%</div></div>';
    html += '<div class="tile ' + ((r.td + r.bd) > 0 ? 'red' : 'green') + '"><div class="tile-label">Errors</div><div class="tile-value ' + ((r.td + r.bd) > 0 ? 'red' : 'green') + '">' + (r.td + r.bd) + '</div></div>';

    html +=   '</div>';
    html +=   '<div class="modal-progress">';
    html +=     '<div class="modal-progress-inner ' + barCls + '" style="width:' + (r.hits === 0 ? 100 : Math.min(100, Math.max(2, succPct))).toFixed(1) + '%"></div>';
    html +=   '</div>';
    html += '</div>';

    html += '<div class="modal-section">';
    html +=   '<div class="modal-section-title">Error Code Breakdown</div>';

    var errList = [];
    Object.keys(row).forEach(function(key) {
        var upper = key.toUpperCase();
        if (upper === 'API_NAME' || upper === 'SYS_IP' || upper === 'EXP_IP' ||
            upper === 'IP' || upper === 'TOTAL_HITS' || upper === 'SUCCESS' ||
            upper === 'TD' || upper === 'TD_PERCENT' || upper === 'BD' ||
            upper === 'BD_PERCENT') return;
        var val = parseInt(row[key] || 0);
        if (val > 0) {
            errList.push({ code: key, count: val, isBD: (catShort === 'bd') });
        }
    });
    if (r.td > 0 && !errList.some(function(e){ return e.code.toUpperCase() === 'TD'; })) {
        errList.push({ code: 'TD', count: r.td, isBD: false });
    }
    if (r.bd > 0 && !errList.some(function(e){ return e.code.toUpperCase() === 'BD'; })) {
        errList.push({ code: 'BD', count: r.bd, isBD: true });
    }
    errList.sort(function(a, b) { return b.count - a.count; });

    if (r.hits === 0 && errList.length === 0) {
        html += '<div class="err-empty zero"><span class="big-ic">&#9940;</span>ZERO HITS — No traffic received<div class="sub">This service did not process any requests on this server</div></div>';
    } else if (errList.length === 0) {
        html += '<div class="err-empty"><span class="big-ic">&#10003;</span>No errors detected — 100% healthy</div>';
    } else {
        var maxCount = errList.reduce(function(m, e){ return Math.max(m, e.count); }, 1);
        html += '<div class="err-list">';
        errList.forEach(function(e) {
            var pct = (e.count / maxCount) * 100;
            var chipCls = e.isBD ? 'bd' : 'td';
            var barCls2 = e.isBD ? 'bd' : 'td';
            var pctOfTotal = r.hits > 0 ? ((e.count / r.hits) * 100).toFixed(2) : '0.00';
            html += '<div class="err-row">';
            html +=   '<div class="err-code ' + chipCls + '">' + escapeHtml(e.code) + '</div>';
            html +=   '<div class="err-bar"><div class="err-bar-fill ' + barCls2 + '" style="width:' + Math.max(10, pct).toFixed(1) + '%">' + e.count + '</div></div>';
            html +=   '<div class="err-count">' + e.count + '<small>' + pctOfTotal + '%</small></div>';
            html += '</div>';
        });
        html += '</div>';
    }
    html += '</div>';

    html += '<div class="modal-section">';
    html +=   '<div class="modal-section-title">Raw Data</div>';
    html +=   '<div class="raw-table">';
    Object.keys(row).forEach(function(key) {
        var v = row[key];
        var display = (v === null || v === undefined || v === '') ? '—' : String(v);
        var valCls = '';
        var upper = key.toUpperCase();
        var numVal = parseInt(v || 0);
        if ((upper === 'TD' || upper.indexOf('SI') === 0) && numVal > 0) valCls = 'red';
        else if ((upper === 'BD' || upper === 'BD_NEW') && numVal > 0) valCls = 'amber';
        else if (upper === 'SUCCESS') valCls = 'green';
        html += '<div class="raw-row"><div class="key">' + escapeHtml(key) + '</div><div class="val ' + valCls + '">' + escapeHtml(display) + '</div></div>';
    });
    html +=   '</div>';
    html += '</div>';

    document.getElementById('modalBody').innerHTML = html;
    document.getElementById('modalBackdrop').classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeModal() {
    document.getElementById('modalBackdrop').classList.remove('active');
    document.body.style.overflow = '';
}
function closeModalFromBackdrop(e) {
    if (e.target.id === 'modalBackdrop') closeModal();
}

/* ============ KPIS ============ */
function updateKpis(data) {
    var b = data.BACKEND_LOG, n = data.API_NSE_INB, x = data.API_BSE;
    function agg(qr) {
        var hits = 0, tdSum = 0, count = 0;
        if (qr && qr.success && qr.rows) {
            qr.rows.forEach(function(r) {
                hits += parseInt(r.TOTAL_HITS || 0);
                tdSum += parseFloat(r.TD_PERCENT || 0);
                count++;
            });
        }
        return { hits: hits, tdAvg: count > 0 ? (tdSum / count) : null, ips: count };
    }
    var bA = agg(b), nA = agg(n), xA = agg(x);
    setKpi('kpiApiNHits', 'kpiApiNHitsVal', 'kpiApiNHitsSub', nA.hits, nA.ips + ' combos', null);
    setKpi('kpiApiNTD',   'kpiApiNTDVal',   'kpiApiNTDSub',   null, null, nA.tdAvg);
    setKpi('kpiApiBHits', 'kpiApiBHitsVal', 'kpiApiBHitsSub', xA.hits, xA.ips + ' combos', null);
    setKpi('kpiApiBTD',   'kpiApiBTDVal',   'kpiApiBTDSub',   null, null, xA.tdAvg);
    setKpi('kpiBackendHits', 'kpiBackendHitsVal', 'kpiBackendHitsSub', bA.hits, bA.ips + ' combos', null);
    setKpi('kpiBackendTD',   'kpiBackendTDVal',   'kpiBackendTDSub',   null, null, bA.tdAvg);
}

function setKpi(wrapperId, valId, subId, hits, hitsSub, tdPct) {
    var wrap = document.getElementById(wrapperId);
    var val  = document.getElementById(valId);
    var sub  = document.getElementById(subId);
    if (!wrap || !val) return;
    wrap.classList.remove('green', 'amber', 'red');
    val.classList.remove('green', 'amber', 'red');
    if (hits !== null && hits !== undefined) {
        val.textContent = hits.toLocaleString();
        val.classList.add('green');
        wrap.classList.add('green');
        if (sub && hitsSub) sub.textContent = hitsSub;
    } else if (tdPct !== null && tdPct !== undefined && !isNaN(tdPct)) {
        val.textContent = tdPct.toFixed(2) + '%';
        if (tdPct > 0) {
            val.classList.add('red'); wrap.classList.add('red');
            sub.textContent = tdPct <= 5 ? 'Technical' : 'High decline';
        } else {
            val.classList.add('green'); wrap.classList.add('green');
            sub.textContent = 'No decline';
        }
    } else {
        val.textContent = '—';
        wrap.classList.add('green'); val.classList.add('green');
    }
}

/* ============ HELPERS ============ */
function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function toast(msg, isErr) {
    var el = document.createElement('div');
    el.className = 'toast' + (isErr ? ' err' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function() {
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function() { el.remove(); }, 320);
    }, 2200);
}

/* ============ KEYBOARD ============ */
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
    if (e.ctrlKey && (e.key === 'r' || e.key === 'R')) { e.preventDefault(); refreshNow(); }
    if (e.ctrlKey && (e.key === 't' || e.key === 'T')) { e.preventDefault(); toggleTheme(); }
});

/* ============ INIT ============ */
window.addEventListener('load', function() { refreshNow(); });
</script>

