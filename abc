            border: 1px solid #4e4e4e;
        }
        .tb-clear:hover { background: #4e4e4e; }

        .tb-close {
            background: #3c3c3c;
            color: #f48771;
            border: 1px solid #4e4e4e;
        }
        .tb-close:hover { background: #5a2a2a; color: #ffab91; }

        .toolbar-spacer { flex: 1; }

        .status-pill {
            padding: 4px 10px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 600;
            background: #3c3c3c;
            color: #858585;
        }
        .status-pill.ok {
            background: #2d3a2e;
            color: #4ec9b0;
        }
        .status-pill.loading {
            background: #3a302d;
            color: #dcb67a;
        }

        /* ============ EDITOR ============ */
        .editor-wrap {
            position: relative;
            padding: 8px 12px;
            background: #1e1e1e;
        }
        .editor-inner {
            position: relative;
            border: 1px solid #3e3e42;
            border-radius: 4px;
            overflow: hidden;
            background: #1e1e1e;
        }
        .editor-inner:focus-within {
            border-color: #0e639c;
            box-shadow: 0 0 0 2px rgba(14,99,156,0.25);
        }
        textarea.sql-editor {
            width: 100%;
            min-height: 180px;
            max-height: 380px;
            padding: 10px 14px;
            background: #1e1e1e;
            color: #d4d4d4;
            border: none;
            outline: none;
            resize: vertical;
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 13px;
            line-height: 1.55;
            caret-color: #aeafad;
            tab-size: 4;
            display: block;
        }
        textarea.sql-editor::placeholder { color: #6a6a6a; }

        /* ============ AUTOCOMPLETE ============ */
        .suggest-box {
            position: fixed;
            background: #252526;
            border: 1px solid #454545;
            border-radius: 3px;
            box-shadow: 0 6px 24px rgba(0,0,0,0.6);
            max-height: 260px;
            overflow-y: auto;
            z-index: 10000;
            display: none;
            min-width: 280px;
            font-family: 'Consolas', monospace;
            font-size: 12.5px;
        }
        .suggest-box::-webkit-scrollbar { width: 8px; }
        .suggest-box::-webkit-scrollbar-thumb { background: #424242; }

        .suggest-item {
            padding: 5px 12px;
            cursor: pointer;
            color: #d4d4d4;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            border-bottom: 1px solid #2a2a2a;
        }
        .suggest-item:last-child { border-bottom: none; }
        .suggest-item:hover, .suggest-item.active {
            background: #094771;
            color: #fff;
        }
        .suggest-item .tag {
            font-size: 9.5px;
            padding: 1px 7px;
            border-radius: 8px;
            font-weight: 700;
            letter-spacing: 0.4px;
            white-space: nowrap;
        }
        .tag-KEYWORD { background: #3a2d52; color: #c586c0; }
        .tag-SCHEMA  { background: #1e3a5f; color: #4fc1ff; }
        .tag-TABLE   { background: #1e4d3a; color: #4ec9b0; }
        .tag-COLUMN  { background: #4d3a1e; color: #dcb67a; }

        /* ============ RESULT ============ */
        .result-panel {
            flex: 1;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border-top: 1px solid #3e3e42;
            background: #1e1e1e;
            min-height: 0;
        }
        .result-header {
            padding: 6px 14px;
            background: #252526;
            border-bottom: 1px solid #3e3e42;
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 12px;
            flex-wrap: wrap;
        }
        .result-header .rh-title {
            font-weight: 700;
            color: #4ec9b0;
        }
        .rh-meta {
            display: flex;
            gap: 14px;
            color: #858585;
        }
        .rh-meta b { color: #d4d4d4; }
        .rh-time-ok { color: #4ec9b0 !important; }
        .rh-time-warn { color: #dcb67a !important; }
        .rh-time-slow { color: #f48771 !important; }

        .result-body {
            flex: 1;
            overflow: auto;
            position: relative;
        }
        .result-body::-webkit-scrollbar { width: 12px; height: 12px; }
        .result-body::-webkit-scrollbar-track { background: #1e1e1e; }
        .result-body::-webkit-scrollbar-thumb {
            background: #424242;
            border: 3px solid #1e1e1e;
            border-radius: 6px;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
            font-family: 'Consolas', monospace;
        }
        .data-table th {
            background: #252526;
            color: #4ec9b0;
            padding: 8px 12px;
            text-align: left;
            position: sticky;
            top: 0;
            z-index: 2;
            font-weight: 700;
            font-size: 12px;
            white-space: nowrap;
            border-bottom: 1px solid #3e3e42;
            border-right: 1px solid #2d2d30;
        }
        .data-table td {
            padding: 6px 12px;
            border-bottom: 1px solid #2a2a2a;
            border-right: 1px solid #2a2a2a;
            color: #d4d4d4;
            max-width: 400px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .data-table tr:nth-child(even) td { background: #232323; }
        .data-table tr:hover td { background: #2a2d2e; }
        .data-table td.idx {
            color: #585858;
            background: #1e1e1e !important;
            width: 52px;
            text-align: right;
            font-size: 11.5px;
        }
        .null-val { color: #6a6a6a; font-style: italic; }

        .alert {
            padding: 10px 14px;
            margin: 10px 14px;
            border-radius: 3px;
            font-size: 12.5px;
        }
        .alert-success {
            background: #1e2d22;
            border-left: 3px solid #4ec9b0;
            color: #a8e6d3;
        }
        .alert-error {
            background: #2d1e1e;
            border-left: 3px solid #f48771;
            color: #ffb3a3;
            font-family: 'Consolas', monospace;
            white-space: pre-wrap;
            font-size: 12px;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: #585858;
            gap: 10px;
            font-size: 13px;
            padding: 40px;
            text-align: center;
        }
        .empty-state .icon {
            font-size: 40px;
            opacity: 0.4;
        }

        /* ============ STATUS BAR ============ */
        .statusbar {
            grid-area: statusbar;
            background: #0e639c;
            color: #fff;
            display: flex;
            align-items: center;
            font-size: 11.5px;
            padding: 0 12px;
            gap: 16px;
            user-select: none;
        }
        .statusbar .sb-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0 8px;
            height: 100%;
        }
        .statusbar .sb-right { margin-left: auto; display: flex; gap: 16px; }

        .spinner {
            display: inline-block;
            width: 12px; height: 12px;
            border: 2px solid #dcb67a;
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            vertical-align: middle;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .toast {
            position: fixed;
            bottom: 40px; right: 20px;
            background: #252526;
            border-left: 4px solid #4ec9b0;
            color: #d4d4d4;
            padding: 12px 18px;
            border-radius: 4px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            font-size: 12.5px;
            z-index: 10001;
            animation: slideIn 0.25s ease;
            max-width: 340px;
        }
        .toast.error { border-left-color: #f48771; }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }
    </style>
</head>
<body>

<div class="app">

    <!-- HEADER -->
    <div class="header">
        <div class="logo">
            <div class="logo-mark">Q</div>
            Query Runner
        </div>
        <div class="menubar">
            <div class="menu-item">File</div>
            <div class="menu-item">Edit</div>
            <div class="menu-item">Run</div>
            <div class="menu-item">View</div>
            <div class="menu-item">Help</div>
        </div>
        <div class="header-right">
            <span class="env-badge" id="envBadge">● CONNECTED</span>
            <button class="btn-new-tab" onclick="newTab()">+ New Tab</button>
        </div>
    </div>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-header">Saved Queries</div>
        <input type="text" class="search-box" id="qSearch" placeholder="Search queries...">

        <div id="queryList">

            <div class="query-group">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-arrow">▶</span> Gen 5 — Error Summary
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        Broker-wise error count (last 5 min)
                        <script type="text/plain" class="q-sql">SELECT broker_eg, broker_name, ERROR_CODE, ERROR_DESCRIPTION, url, api_name,
COUNT(*) AS CNT FROM EISAPP.API_LOG WHERE Request_date_time>=SYSDATE - INTERVAL '05' MINUTE and
(substr(error_code,3,3) in ('001','002','007','051','014','111','570','569','052','005','077','003','017','015') and error_code<>'00014' OR error_code in ('401','500'))
and ERROR_DESCRIPTION is not null and error_description not like '%No active transaction found, please do check GCC machine and retry%'
GROUP BY broker_eg,broker_name, ERROR_CODE, error_description,url,api_name
ORDER BY CNT DESC;</script>
                    </div>
                </div>
            </div>

            <div class="query-group">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-arrow">▶</span> Daily Use (Last 10 min)
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">
                        api_log — recent
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where
request_date_time >= sysdate - interval '10' minute
order by request_date_time desc;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        api_log — error summary
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.api_log where
request_date_time >= sysdate - interval '10' minute
GROUP by error_code, error_description;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        backend_log — recent
                        <script type="text/plain" class="q-sql">select * from eisapp.BACKEND_log where
request_date_time >= sysdate - interval '10' minute
order by request_date_time desc;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">
                        backend_log — error summary
                        <script type="text/plain" class="q-sql">select error_code, error_description, count(1) from eisapp.BACKEND_log where
request_date_time >= sysdate - interval '10' minute
GROUP by error_code, error_description;</script>
                    </div>
                </div>
            </div>

            <div class="query-group">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-arrow">▶</span> URN Search
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_log where URN in ('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.api_details where URN in('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">orch_api_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_log where URN in ('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">orch_api_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.orch_api_details where URN in ('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">backend_log by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_log where URN in ('');</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">backend_details by URN
                        <script type="text/plain" class="q-sql">select * from eisapp.backend_details where URN in ('');</script>
                    </div>
                </div>
            </div>

            <div class="query-group">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-arrow">▶</span> URL / Mappers
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">source_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.source_mapper;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">url_mapper
                        <script type="text/plain" class="q-sql">select * from EISAPP.url_mapper;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">urn_details
                        <script type="text/plain" class="q-sql">select * from EISAPP.urn_details;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">cache_details
                        <script type="text/plain" class="q-sql">SELECT * FROM EISAPP.cache_details;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">Find API by name (NOMINEE)
                        <script type="text/plain" class="q-sql">select distinct api_name from eisapp.api_log where UPPER(api_name) like '%NOMINEE%';</script>
                    </div>
                </div>
            </div>

            <div class="query-group">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-arrow">▶</span> API Log — TD/BD Summary
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">API-wise TD/BD (last 60 min)
                        <script type="text/plain" class="q-sql">select trim(API_NAME),
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) As "SI001",
SUM(CASE WHEN substr(error_code,3,3) ='002'then 1 else 0 end) As "002",
SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) As "SI007",
SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) As "SI051",
SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) AS "014",
SUM(CASE WHEN error_code ='SI569' then 1 else 0 end) As "SI569",
SUM(CASE WHEN error_code ='SI570' then 1 else 0 end) As "SI570",
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT
from eisapp.api_log where
request_date_time>=SYSDATE - INTERVAL '60' minute
GROUP BY trim(API_NAME)
ORDER BY TD_PERCENT DESC;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">Backend-wise TD/BD (last 60 min)
                        <script type="text/plain" class="q-sql">select TRIM(api_name),
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN error_code is null THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN error_code ='SI001' then 1 else 0 end) As "SI001",
SUM(CASE WHEN substr(error_code,3,3) ='002' then 1 else 0 end) As "002",
SUM(CASE WHEN error_code ='SI007' and error_code<> '70007' then 1 else 0 end) As "SI007",
SUM(CASE WHEN error_code ='SI051' then 1 else 0 end) As "SI051",
SUM(CASE WHEN substr(error_code,3,3) ='014' and error_code <> '00014' then 1 else 0 end) AS "014",
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI051','SI569','SI570','SI052','SI005','SI077','SI003','SI017','SI015')) and error_code <> '00014' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT
from eisapp.BACKEND_LOG  WHERE
REQUEST_DATE_TIME>=SYSDATE - INTERVAL '60' minute
GROUP BY TRIM(api_name)
ORDER BY TD_PERCENT DESC;</script>
                    </div>
                </div>
            </div>

            <div class="query-group">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-arrow">▶</span> Third Party
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">Third Party — TD/BD by SUP_URL (last 60 min)
                        <script type="text/plain" class="q-sql">select SUP_URL,ORIGINAL_URN,TRANSACTION_URN,source_id,
COUNT(1) "TOTAL_HITS",
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') or error_code in('SI001','SI007','SI017','SI569','SI570','SI051','SI111')) and error_code<>'00014' THEN 1 ELSE 0 END) AS TD,
ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') or error_code in('SI001','SI007','SI017','SI569','SI570','SI051','SI111')) and error_code<>'00014' THEN 1 ELSE 0 END)*100)/COUNT(1)) AS TD_PERCENT,
SUM(CASE WHEN ERROR_CODE='SI001'  THEN 1 ELSE 0 END) AS SI001,
SUM(CASE WHEN ERROR_CODE='SI007'  THEN 1 ELSE 0 END) AS SI007,
SUM(CASE WHEN ERROR_CODE='SI051'  THEN 1 ELSE 0 END) AS SI051
from eisapp.api_LOG where
creation_date_time>=SYSDATE - INTERVAL '60' minute
GROUP BY SUP_URL,ORIGINAL_URN,TRANSACTION_URN,source_id
HAVING (SUM(CASE WHEN (RESPONSE_STATUS  not in ('0','SUCCESS') and error_code is not null) THEN 1 ELSE 0 END)*100)/COUNT(1)=100
order by TD_PERCENT desc;</script>
                    </div>
                </div>
            </div>

            <div class="query-group">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-arrow">▶</span> SI Monitoring (SBISI)
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">SI_TRANS_DB — error summary (last 10 min)
                        <script type="text/plain" class="q-sql">SELECT function_name,ERROR_CODE, ERROR_DESC, COUNT(*) AS CNT FROM SBISI.SI_TRANS_DB
WHERE SUBSTR(error_code,1,2) = 'SI'
and req_time>=SYSDATE - INTERVAL '10' MINUTE
GROUP BY ERROR_CODE,ERROR_DESC,function_name ORDER BY CNT DESC;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">EKYC_log — TD% (SI207, SI392)
                        <script type="text/plain" class="q-sql">select COUNT(1) as TOTAL_HITS,
SUM(CASE WHEN ERROR_CODE IS NULL THEN 1 ELSE 0 END) AS SUCCESS,
SUM(CASE WHEN ERROR_CODE IS NOT NULL AND error_code NOT IN ('SI392','SI207') THEN 1 ELSE 0 END) "BD",
SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END) "SI392",
ROUND((SUM(CASE WHEN ERROR_CODE='SI392' THEN 1 ELSE 0 END)/COUNT(1))*100,2) "SI392%",
SUM(CASE WHEN ERROR_CODE='SI207' THEN 1 ELSE 0 END) "SI207",
ROUND((SUM(CASE WHEN error_code IN ('SI392','SI207') THEN 1 ELSE 0 END)/COUNT(1))*100,2) "TD%"
from SBISI.EKYC_log where resp_date_time >=sysdate - interval '15' minute;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">EKYC (SI392) — recent
                        <script type="text/plain" class="q-sql">select *  from SBISI.ekyc_log where
 error_code = 'SI392'
and req_date_time>=SYSDATE - INTERVAL '10' MINUTE  order by req_date_time desc;</script>
                    </div>
                </div>
            </div>

            <div class="query-group">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-arrow">▶</span> Performance / Latency
                </div>
                <div class="group-body">
                    <div class="q-item" onclick="loadQuery(this)">EXP IP response-time buckets (last 2 min)
                        <script type="text/plain" class="q-sql">SELECT exp_ip,COUNT(1),
SUM(CASE WHEN RESPONSE_STATUS in ('0','SUCCESS') THEN 1 ELSE 0 END) AS SUCCESS,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))between 0.1 AND 0.5 then 1 else 0 end ) as "between 100ms-500ms" ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(RESPONSE_DATE_TIME-dpg_request_date_time),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC
FROM EISAPP.API_LOG WHERE broker_name = 'LOGGING_EXP' and
request_date_time>=SYSDATE-INTERVAL '02' MINUTE
group by exp_ip;</script>
                    </div>
                    <div class="q-item" onclick="loadQuery(this)">SYS latency — backend vs orch (last 2 min)
                        <script type="text/plain" class="q-sql">SELECT b.sys_ip,COUNT(1),
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))< 0.1 then 1 else 0 end ) as BELOW_100MSEC ,
sum(case when TO_NUMBER(SUBSTR(TO_CHAR(b.request_DATE_TIME-a.request_DATE_TIME),18))> 5 then 1 else 0 end ) as ABOVE_FIVE_SEC
FROM  EISAPP.backend_log b , EISAPP.orch_api_log a WHERE a.urn=b.urn and b.sys_broker = 'LOGGING_SYS' and
b.creation_date_time>=SYSDATE-INTERVAL '02' MINUTE
group by b.sys_ip;</script>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- MAIN -->
    <div class="main">
        <div class="tabbar" id="tabbar">
            <div class="tab-add" onclick="newTab()" title="New Tab (Ctrl+T)">+</div>
        </div>
        <div class="tab-content-area" id="tabContentArea"></div>
    </div>

    <!-- STATUS BAR -->
    <div class="statusbar">
        <div class="sb-item" id="sbDb">● IIB DB (EISAPP)</div>
        <div class="sb-item" id="sbStatus">Ready</div>
        <div class="sb-right">
            <div class="sb-item" id="sbLastTime">Last exec: —</div>
            <div class="sb-item" id="sbTabs">1 tab</div>
        </div>
    </div>

</div>

<div id="suggestBox" class="suggest-box"></div>

<script>
/* ============================================================
 * MULTI-TAB QUERY RUNNER
 * ============================================================ */

var DB_META = {
    "IIB":    { label: "IIB DB (EISAPP)", color: "#4ec9b0", dot: "db-IIB" },
    "SI":     { label: "SI DB (SBISI)",   color: "#dcb67a", dot: "db-SI" },
    "REPORT": { label: "Report DB",       color: "#c586c0", dot: "db-REPORT" }
};

var DEFAULT_DB = "<%= dbType %>";

var SUGGEST = {
    loaded: false,
    loading: false,
    schemas: [],
    tables: [],
    keywords: [],
    columnCache: {},
    dbFetched: null
};

var tabs = [];
var activeTabId = null;
var tabCounter = 0;

/* ============ TAB CLASS ============ */
function Tab(id, db) {
    this.id = id;
    this.db = db || DEFAULT_DB;
    this.sql = "";
    this.title = "Query " + id;
    this.el = null;
    this.paneEl = null;
    this.editorEl = null;
    this.activeIdx = -1;
    this.currentItems = [];
    this.lastExecMs = null;
    this.lastSavedSql = "";
}

/* ============ CREATE TAB ============ */
function newTab() {
    tabCounter++;
    var t = new Tab(tabCounter, DEFAULT_DB);
    t.title = "Query " + tabCounter;
    tabs.push(t);
    renderTab(t);
    switchTab(t.id);
    saveTabsToStorage();
    return t;
}

function renderTab(t) {
    var tabEl = document.createElement('div');
    tabEl.className = 'tab';
    tabEl.dataset.tabId = t.id;
    tabEl.innerHTML =
        '<span class="tab-dot ' + DB_META[t.db].dot + '"></span>' +
        '<span class="tab-name">' + t.title + '</span>' +
        '<span class="tab-close" title="Close">×</span>';

    tabEl.addEventListener('click', function(e) {
        if (e.target.classList.contains('tab-close')) {
            e.stopPropagation();
            closeTab(t.id);
            return;
        }
        switchTab(t.id);
    });

    var tabAdd = document.querySelector('.tab-add');
    document.getElementById('tabbar').insertBefore(tabEl, tabAdd);
    t.el = tabEl;

    var pane = document.createElement('div');
    pane.className = 'tab-pane';
    pane.dataset.tabId = t.id;
    pane.innerHTML = buildPaneHTML(t);
    document.getElementById('tabContentArea').appendChild(pane);
    t.paneEl = pane;
    t.editorEl = pane.querySelector('.sql-editor');

    attachEditorEvents(t);
    updateTabCount();
}

function buildPaneHTML(t) {
    return '' +
    '<div class="editor-toolbar">' +
        '<select class="toolbar-select db-sel">' +
            '<option value="IIB"'    + (t.db === "IIB"    ? " selected" : "") + '>IIB DB (eisapp)</option>' +
            '<option value="SI"'     + (t.db === "SI"     ? " selected" : "") + '>SI DB (sbisi)</option>' +
            '<option value="REPORT"' + (t.db === "REPORT" ? " selected" : "") + '>Report DB</option>' +
        '</select>' +
        '<button type="button" class="tb-btn tb-run"     onclick="runQuery(' + t.id + ')">▶ Run</button>' +
        '<button type="button" class="tb-btn tb-suggest" onclick="doSuggest(' + t.id + ')">Suggest</button>' +
        '<button type="button" class="tb-btn tb-clear"   onclick="clearEditor(' + t.id + ')">Clear</button>' +
        '<button type="button" class="tb-btn tb-close"   onclick="closeTab(' + t.id + ')">Close Tab</button>' +
        '<div class="toolbar-spacer"></div>' +
        '<span class="status-pill" data-role="status">idle</span>' +
    '</div>' +
    '<div class="editor-wrap">' +
        '<div class="editor-inner">' +
            '<textarea class="sql-editor" spellcheck="false" autocomplete="off" ' +
                'placeholder="-- Pick a saved query, or write your SQL here&#10;-- Ctrl+Space for suggestions, Ctrl+Enter to run">' + escapeHtml(t.sql) + '</textarea>' +
        '</div>' +
    '</div>' +
    '<div class="result-panel">' +
        '<div class="result-header" style="display:none;" data-role="resultHeader">' +
            '<span class="rh-title">RESULT</span>' +
            '<div class="rh-meta">' +
                '<span>Type: <b data-role="qType">—</b></span>' +
                '<span>Rows: <b data-role="qRows">—</b></span>' +
                '<span>Time: <b data-role="qTime">—</b></span>' +
            '</div>' +
        '</div>' +
        '<div class="result-body" data-role="resultBody">' +
            '<div class="empty-state">' +
                '<div class="icon">▶</div>' +
                '<div>Ready — write or pick a query, then click <b>Run</b>.</div>' +
                '<div style="font-size:11.5px;color:#4a4a4a;">Tab DB: ' + DB_META[t.db].label + '</div>' +
            '</div>' +
        '</div>' +
    '</div>';
}

/* ============ SWITCH TAB ============ */
function switchTab(id) {
    activeTabId = id;
    document.querySelectorAll('.tab').forEach(function(el) {
        el.classList.toggle('active', el.dataset.tabId == id);
    });
    document.querySelectorAll('.tab-pane').forEach(function(el) {
        el.classList.toggle('active', el.dataset.tabId == id);
    });
    updateStatusBar();
    var t = getTab(id);
    if (t && t.editorEl) {
        try { t.editorEl.focus(); } catch(e) {}
    }
    saveTabsToStorage();
}

function getTab(id) {
    for (var i = 0; i < tabs.length; i++) if (tabs[i].id == id) return tabs[i];
    return null;
}

/* ============ CLOSE TAB ============ */
function closeTab(id) {
    var idx = -1;
    for (var i = 0; i < tabs.length; i++) if (tabs[i].id == id) { idx = i; break; }
    if (idx === -1) return;
    var t = tabs[idx];

    if (t.sql && t.sql.trim() && t.sql.trim() !== (t.lastSavedSql || "")) {
        if (!confirm("Close tab \"" + t.title + "\"? Unsaved changes will be lost.")) return;
    }

    if (t.el) t.el.remove();
    if (t.paneEl) t.paneEl.remove();
    tabs.splice(idx, 1);

    if (tabs.length === 0) {
        newTab();
    } else if (activeTabId === id) {
        switchTab(tabs[Math.max(0, idx - 1)].id);
    }
    updateTabCount();
    saveTabsToStorage();
}

/* ============ EDITOR EVENTS ============ */
function attachEditorEvents(t) {
    var ta = t.editorEl;
    var dbSel = t.paneEl.querySelector('.db-sel');

    ta.addEventListener('input', function() {
        t.sql = ta.value;
        clearTimeout(ta._timer);
        ta._timer = setTimeout(function() {
            saveTabsToStorage();
            autoTriggerSuggest(t);
        }, 120);
    });

    dbSel.addEventListener('change', function() {
        t.db = dbSel.value;
        var dot = t.el.querySelector('.tab-dot');
        dot.className = 'tab-dot ' + DB_META[t.db].dot;
        updateStatusBar();
        if (SUGGEST.dbFetched && SUGGEST.dbFetched !== t.db) {
            SUGGEST.loaded = false;
            SUGGEST.dbFetched = null;
        }
        toast("DB switched to " + DB_META[t.db].label + " for " + t.title);
        saveTabsToStorage();
    });

    ta.addEventListener('keydown', function(e) {
        var boxVisible = document.getElementById('suggestBox').style.display === 'block';

        if (e.key === ' ' && e.ctrlKey) {
            e.preventDefault();
            doSuggest(t.id);
            return;
        }
        if (e.key === 'Enter' && e.ctrlKey) {
            e.preventDefault();
            runQuery(t.id);
            return;
        }
        if ((e.key === 't' || e.key === 'T') && e.ctrlKey) {
            e.preventDefault();
            newTab();
            return;
        }
        if ((e.key === 'w' || e.key === 'W') && e.ctrlKey) {
            e.preventDefault();
            closeTab(t.id);
            return;
        }

        if (boxVisible && t.currentItems.length > 0) {
            if (e.key === 'ArrowDown') { e.preventDefault(); t.activeIdx = (t.activeIdx + 1) % t.currentItems.length; updateActive(t); return; }
            if (e.key === 'ArrowUp')   { e.preventDefault(); t.activeIdx = (t.activeIdx - 1 + t.currentItems.length) % t.currentItems.length; updateActive(t); return; }
            if (e.key === 'Enter' || e.key === 'Tab') {
                if (t.activeIdx >= 0) { e.preventDefault(); pickSuggestion(t, t.activeIdx); return; }
            }
            if (e.key === 'Escape') { e.preventDefault(); hideSuggest(t); return; }
        }
    });
}

/* ============ AUTO-TRIGGER SUGGEST ============ */
function autoTriggerSuggest(t) {
    var ctx = getContext(t);
    if ((ctx.word && ctx.word.length >= 1) || ctx.dotBefore) {
        ensureSuggestLoaded(t, function() { showSuggest(t, false); });
    } else {
        hideSuggest(t);
    }
}

/* ============ DO SUGGEST (button) ============ */
function doSuggest(tabId) {
    var t = getTab(tabId);
    if (!t) return;
    ensureSuggestLoaded(t, function() {
        showSuggest(t, true);
    });
}

/* ============ LOAD SUGGESTIONS (AJAX) ============ */
function ensureSuggestLoaded(t, cb) {
    if (SUGGEST.loaded && SUGGEST.dbFetched === t.db) { cb(); return; }
    if (SUGGEST.loading) {
        var wait = setInterval(function() {
            if (!SUGGEST.loading) {
                clearInterval(wait);
                if (SUGGEST.dbFetched === t.db) cb();
                else ensureSuggestLoaded(t, cb);
            }
        }, 100);
        return;
    }
    SUGGEST.loading = true;
    setStatus(t, "loading", "Loading suggestions...");

    var xhr = new XMLHttpRequest();
    xhr.open('GET', 'query.jsp?ajax=suggest&db=' + encodeURIComponent(t.db), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState === 4) {
            if (xhr.status === 200) {
                try {
                    var data = JSON.parse(xhr.responseText);
                    SUGGEST.schemas  = data.schemas  || [];
                    SUGGEST.tables   = data.tables   || [];
                    SUGGEST.keywords = data.keywords || [];
                    SUGGEST.loaded = true;
                    SUGGEST.dbFetched = t.db;
                    setStatus(t, "ok", "Suggestions ready");
                    setTimeout(function(){ setStatus(t, null, "idle"); }, 2000);
                } catch(e) {
                    setStatus(t, null, "Suggest load failed");
                    console.error(e);
                }
            } else {
                setStatus(t, null, "Suggest load failed (HTTP " + xhr.status + ")");
            }
            SUGGEST.loading = false;
            cb();
        }
    };
    xhr.send();
}

/* ============ CONTEXT ============ */
function getContext(t) {
    var ta = t.editorEl;
    var pos = ta.selectionStart;
    var val = ta.value;
    var start = pos;
    while (start > 0 && /[A-Za-z0-9_$#]/.test(val.charAt(start - 1))) start--;
    var end = pos;
    while (end < val.length && /[A-Za-z0-9_$#]/.test(val.charAt(end))) end++;
    var word = val.substring(start, pos);

    var prefix = "";
    var dotBefore = false;
    if (start > 0 && val.charAt(start - 1) === '.') {
        dotBefore = true;
        var p = start - 2;
        while (p >= 0 && /[A-Za-z0-9_$#]/.test(val.charAt(p))) p--;
        prefix = val.substring(p + 1, start - 1);
    }
    return { word: word, start: start, end: end, dotBefore: dotBefore, prefix: prefix };
}

/* ============ CARET PIXEL POSITION ============ */
function getCaretPixel(ta) {
    var div = document.createElement('div');
    var style = window.getComputedStyle(ta);
    var props = ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing',
                 'paddingTop','paddingLeft','paddingRight','paddingBottom',
                 'borderTopWidth','borderLeftWidth','whiteSpace','wordWrap','wordBreak'];
    props.forEach(function(p){ div.style[p] = style[p]; });
    div.style.position = 'fixed';
    div.style.visibility = 'hidden';
    div.style.whiteSpace = 'pre-wrap';
    div.style.wordWrap = 'break-word';
    div.style.width = (ta.clientWidth - parseInt(style.paddingLeft) - parseInt(style.paddingRight)) + 'px';
    div.style.top = '-9999px';
    div.style.left = '0';

    var value = ta.value.substring(0, ta.selectionStart);
    div.textContent = value;
    var span = document.createElement('span');
    span.textContent = ta.value.substring(ta.selectionStart) || '.';
    div.appendChild(span);
    document.body.appendChild(div);

    var spanRect = span.getBoundingClientRect();
    var lineH = parseInt(style.lineHeight) || 20;
    var pos = {
        left: spanRect.left,
        top:  spanRect.bottom + 2,
        lineHeight: lineH
    };

    document.body.removeChild(div);
    return pos;
}

/* ============ SHOW SUGGESTIONS ============ */
function showSuggest(t, forceAll) {
    var box = document.getElementById('suggestBox');
    var ctx = getContext(t);
    var items;

    if (ctx.dotBefore) {
        var prefixUpper = ctx.prefix.toUpperCase();
        var isSchema = SUGGEST.schemas.some(function(s) {
            return s.label.toUpperCase() === prefixUpper;
        });
        if (isSchema) {
            items = SUGGEST.tables.filter(function(tb) {
                return tb.label.toUpperCase().startsWith(prefixUpper + ".");
            }).map(function(tb) {
                var shortName = tb.label.substring(tb.label.indexOf('.') + 1);
                return { label: shortName, insert: shortName, type: "TABLE" };
            });
            if (ctx.word) {
                var w = ctx.word.toLowerCase();
                items = items.filter(function(x){ return x.label.toLowerCase().indexOf(w) !== -1; });
            }
            renderSuggest(t, items);
        } else {
            fetchColumns(t, null, ctx.prefix, function(cols) {
                var w = (ctx.word || '').toLowerCase();
                var filtered = cols;
                if (w) filtered = cols.filter(function(c){ return c.label.toLowerCase().indexOf(w) !== -1; });
                renderSuggest(t, filtered);
            });
        }
        return;
    }

    items = SUGGEST.keywords.concat(SUGGEST.schemas).concat(SUGGEST.tables);
    var w = (ctx.word || '').toLowerCase();
    if (!forceAll && w) {
        var starts = [], contains = [];
        items.forEach(function(it) {
            var lbl = it.label.toLowerCase();
            if (lbl.startsWith(w)) starts.push(it);
            else if (lbl.indexOf(w) !== -1) contains.push(it);
        });
        items = starts.concat(contains);
    }
    renderSuggest(t, items);
}

function renderSuggest(t, items) {
    var box = document.getElementById('suggestBox');
    if (!items || items.length === 0) { hideSuggest(t); return; }
    items = items.slice(0, 40);
    t.currentItems = items;
    t.activeIdx = 0;
    var html = '';
    items.forEach(function(it, i) {
        var cls = 'suggest-item' + (i === 0 ? ' active' : '');
        var tag = it.type.split(':')[0];
        var tagText = tag === 'COLUMN' ? 'COL' : tag;
        html += '<div class="' + cls + '" data-i="' + i + '" onmousedown="event.preventDefault();" onclick="pickSuggestionById(' + t.id + ',' + i + ')">' +
                    '<span>' + escapeHtml(it.label) + '</span>' +
                    '<span class="tag tag-' + tag + '">' + tagText + '</span>' +
                '</div>';
    });
    box.innerHTML = html;
    box.style.display = 'block';

    var pos = getCaretPixel(t.editorEl);
    var boxH = Math.min(260, items.length * 26 + 4);
    var winH = window.innerHeight;
    var top = pos.top;
    if (top + boxH > winH - 40) top = pos.top - boxH - pos.lineHeight - 6;
    box.style.left = Math.max(4, Math.min(pos.left, window.innerWidth - 300)) + 'px';
    box.style.top  = top + 'px';
}

function hideSuggest(t) {
    document.getElementById('suggestBox').style.display = 'none';
    if (t) {
        t.currentItems = [];
        t.activeIdx = -1;
    }
}

function updateActive(t) {
    var items = document.querySelectorAll('#suggestBox .suggest-item');
    items.forEach(function(el, i) {
        if (i === t.activeIdx) { el.classList.add('active'); el.scrollIntoView({block:'nearest'}); }
        else el.classList.remove('active');
    });
}

function pickSuggestionById(tabId, idx) {
    var t = getTab(tabId);
    if (!t) return;
    pickSuggestion(t, idx);
}

function pickSuggestion(t, idx) {
    if (idx < 0 || idx >= t.currentItems.length) return;
    var item = t.currentItems[idx];
    var ctx = getContext(t);
    var val = t.editorEl.value;
    var before = val.substring(0, ctx.start);
    var after  = val.substring(ctx.end);
    t.editorEl.value = before + item.insert + after;
    var newPos = before.length + item.insert.length;
    t.editorEl.selectionStart = t.editorEl.selectionEnd = newPos;
    t.sql = t.editorEl.value;
    hideSuggest(t);
    t.editorEl.focus();
}

/* ============ FETCH COLUMNS ============ */
function fetchColumns(t, schema, table, cb) {
    var key = (schema || '').toUpperCase() + '.' + table.toUpperCase();
    if (SUGGEST.columnCache[key]) { cb(SUGGEST.columnCache[key]); return; }
    var url = 'query.jsp?ajax=cols&db=' + encodeURIComponent(t.db) +
              '&schema=' + encodeURIComponent(schema || '') +
              '&table=' + encodeURIComponent(table);
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState === 4 && xhr.status === 200) {
            try {
                var data = JSON.parse(xhr.responseText);
                SUGGEST.columnCache[key] = data;
                cb(data);
            } catch(e) { cb([]); }
        }
    };
    xhr.send();
}

/* ============ RUN QUERY ============ */
function runQuery(tabId) {
    var t = getTab(tabId);
    if (!t) return;
    var sql = t.editorEl.value.trim();
    if (!sql) { toast("Query is empty.", true); return; }

    t.sql = t.editorEl.value;
    saveTabsToStorage();

    setStatus(t, "loading", "Executing...");
    hideSuggest(t);

    var body = t.paneEl.querySelector('[data-role="resultBody"]');
    var header = t.paneEl.querySelector('[data-role="resultHeader"]');
    body.innerHTML = '<div class="empty-state"><div class="spinner"></div><div>Executing query on ' + DB_META[t.db].label + '...</div></div>';

    var t0 = Date.now();
    var xhr = new XMLHttpRequest();
    xhr.open('POST', 'query.jsp?ajax=run', true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
    var payload = 'sql=' + encodeURIComponent(sql) + '&dbType=' + encodeURIComponent(t.db);

    xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;

        if (xhr.status !== 200) {
            body.innerHTML = '<div class="alert alert-error">HTTP ' + xhr.status + ' — failed to execute.</div>';
            setStatus(t, null, "Error");
            toast("HTTP " + xhr.status, true);
            return;
        }

        try {
            var res = JSON.parse(xhr.responseText);
            var roundTrip = Date.now() - t0;
            t.lastExecMs = res.executionTimeMs;

            header.style.display = 'flex';
            header.querySelector('[data-role="qType"]').textContent = res.queryType || '—';
            header.querySelector('[data-role="qRows"]').textContent = (res.rows ? res.rows.length : 0);
            var timeEl = header.querySelector('[data-role="qTime"]');
            timeEl.textContent = res.executionTimeMs + ' ms';
            timeEl.className = '';
            if (res.executionTimeMs < 500) timeEl.classList.add('rh-time-ok');
            else if (res.executionTimeMs < 3000) timeEl.classList.add('rh-time-warn');
            else timeEl.classList.add('rh-time-slow');

            body.innerHTML = renderResult(res);
            setStatus(t, res.success ? "ok" : null, res.success ? "Success" : "Error");
            updateStatusBar();

            if (res.success) {
                toast("Query ran in " + res.executionTimeMs + " ms");
            } else {
                toast("Query failed", true);
            }
        } catch(e) {
            body.innerHTML = '<div class="alert alert-error">Parse error: ' + escapeHtml(e.message) + '</div>';
            setStatus(t, null, "Parse error");
        }
    };
    xhr.send(payload);
}

/* ============ RENDER RESULT ============ */
function renderResult(res) {
    if (!res.success) {
        return '<div class="alert alert-error">' + escapeHtml(res.message) + '</div>';
    }
    var html = '<div class="alert alert-success">' + escapeHtml(res.message) + '</div>';
    if (res.columns && res.columns.length > 0 && res.rows && res.rows.length > 0) {
        html += '<table class="data-table"><thead><tr><th>#</th>';
        res.columns.forEach(function(c) { html += '<th>' + escapeHtml(c) + '</th>'; });
        html += '</tr></thead><tbody>';
        res.rows.forEach(function(row, i) {
            html += '<tr><td class="idx">' + (i + 1) + '</td>';
            res.columns.forEach(function(c) {
                var v = row[c];
                if (v === null || v === undefined) {
                    html += '<td><span class="null-val">NULL</span></td>';
                } else {
                    var s = String(v);
                    html += '<td title="' + escapeHtml(s) + '">' + escapeHtml(s) + '</td>';
                }
            });
            html += '</tr>';
        });
        html += '</tbody></table>';
    } else if (res.updateCount >= 0) {
        html += '<div class="alert alert-success">Rows affected: ' + res.updateCount + '</div>';
    } else {
        html += '<div class="empty-state"><div>Query returned 0 rows.</div></div>';
    }
    return html;
}

/* ============ STATUS ============ */
function setStatus(t, type, text) {
    var el = t.paneEl.querySelector('[data-role="status"]');
    if (!el) return;
    el.textContent = text || "idle";
    el.className = 'status-pill';
    if (type === 'ok') el.classList.add('ok');
    if (type === 'loading') el.classList.add('loading');
}

function updateStatusBar() {
    var t = getTab(activeTabId);
    var sbDb = document.getElementById('sbDb');
    var sbSt = document.getElementById('sbStatus');
    var sbTime = document.getElementById('sbLastTime');
    if (t) {
        sbDb.textContent = '● ' + DB_META[t.db].label;
        sbSt.textContent = 'Tab: ' + t.title;
        sbTime.textContent = 'Last exec: ' + (t.lastExecMs != null ? t.lastExecMs + ' ms' : '—');
    }
    var sbTabs = document.getElementById('sbTabs');
    sbTabs.textContent = tabs.length + (tabs.length === 1 ? ' tab' : ' tabs');
}

function updateTabCount() {
    updateStatusBar();
}

/* ============ CLEAR EDITOR ============ */
function clearEditor(tabId) {
    var t = getTab(tabId);
    if (!t) return;
    t.editorEl.value = '';
    t.sql = '';
    t.editorEl.focus();
    hideSuggest(t);
    saveTabsToStorage();
}

/* ============ SIDEBAR ============ */
function toggleGroup(el) {
    var body = el.nextElementSibling;
    var open = body.classList.toggle('open');
    el.classList.toggle('open', open);
}

function loadQuery(el) {
    var sqlEl = el.querySelector('.q-sql');
    if (!sqlEl) return;
    var text = (sqlEl.textContent || sqlEl.innerText).replace(/^\s*\n+/, '').replace(/\s+$/, '');

    var t = getTab(activeTabId);
    if (!t) return;
    t.editorEl.value = text;
    t.sql = text;
    t.editorEl.focus();
    t.editorEl.selectionStart = t.editorEl.selectionEnd = text.length;

    document.querySelectorAll('.q-item').forEach(function(i){ i.classList.remove('selected'); });
    el.classList.add('selected');
    saveTabsToStorage();
    toast("Query loaded into " + t.title);
}

/* Search */
document.getElementById('qSearch').addEventListener('input', function(e) {
    var q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.query-group').forEach(function(g) {
        var items = g.querySelectorAll('.q-item');
        var any = false;
        items.forEach(function(it) {
            var txt = it.textContent.toLowerCase();
            if (!q || txt.indexOf(q) !== -1) { it.style.display = ''; any = true; }
            else it.style.display = 'none';
        });
        g.style.display = (any || !q) ? '' : 'none';
        if (q && any) {
            g.querySelector('.group-body').classList.add('open');
            g.querySelector('.group-header').classList.add('open');
        }
    });
});

/* ============ HELPERS ============ */
function escapeHtml(s) {
    if (s == null) return "";
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function toast(msg, isError) {
    var el = document.createElement('div');
    el.className = 'toast' + (isError ? ' error' : '');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function() {
        el.style.transition = 'opacity 0.3s, transform 0.3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(30px)';
        setTimeout(function(){ el.remove(); }, 320);
    }, 2200);
}

/* ============ LOCAL STORAGE ============ */
function saveTabsToStorage() {
    try {
        var data = tabs.map(function(t) {
            return { id: t.id, db: t.db, sql: t.sql, title: t.title };
        });
        localStorage.setItem('qr_tabs', JSON.stringify({
            tabs: data, activeId: activeTabId, counter: tabCounter
        }));
    } catch(e) {}
}

function restoreTabs() {
    try {
        var raw = localStorage.getItem('qr_tabs');
        if (!raw) return false;
        var data = JSON.parse(raw);
        if (!data || !data.tabs || !data.tabs.length) return false;
        tabCounter = data.counter || 0;
        data.tabs.forEach(function(td) {
            tabCounter++;
            var t = new Tab(tabCounter, td.db || DEFAULT_DB);
            t.sql = td.sql || "";
            t.title = td.title || ("Query " + tabCounter);
            t.lastSavedSql = t.sql;
            tabs.push(t);
            renderTab(t);
            t.editorEl.value = t.sql;
        });
        switchTab(data.activeId || tabs[0].id);
        return true;
    } catch(e) { return false; }
}

/* ============ CLICK OUTSIDE ============ */
document.addEventListener('mousedown', function(e) {
    if (!e.target.closest('#suggestBox')) {
        var active = getTab(activeTabId);
        if (active) hideSuggest(active);
    }
});

/* ============ INIT ============ */
window.addEventListener('load', function() {
    if (!restoreTabs()) {
        newTab();
    }
    var firstBody = document.querySelector('.group-body');
    var firstHead = document.querySelector('.group-header');
    if (firstBody && firstHead) {
        firstBody.classList.add('open');
        firstHead.classList.add('open');
    }
    updateTabCount();
});
</script>
