        try { tables = QueryRunner.getTableSuggestions(ajaxDb); }
        catch (Throwable t) { err = (err == null ? "" : err + "; ") + "tables: " + t.getMessage(); }
        List<Suggestion> keywords = QueryRunner.getKeywordSuggestions();

