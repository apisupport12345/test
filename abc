            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        select, textarea {
            width: 100%;
            padding: 12px 14px;
            border: 2px solid #dbe4ef;
            border-radius: 10px;
            font-size: 14px;
            transition: 0.2s;
            background: #fafcff;
        }
        select:focus, textarea:focus {
            outline: none;
            border-color: #1a3d6d;
            background: #fff;
